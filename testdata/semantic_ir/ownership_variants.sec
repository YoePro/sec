module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }

    fn Positive() bool {
        return self.id > 0
    }

    fn Get() int {
        return self.id
    }
}

type Failure union error {
    Lost(Handle),
    Other,
}

type Figure union {
    Round(Handle),
    Size(int),
    Empty,
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn Sink(->handle: Handle) void {
}

fn FreshResult(id: int) Result[Handle, IndexError] {
    return Ok(Make(id))
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

fn FreshFailure(id: int) Result[int, Failure] {
    return Err(Failure.Lost(Make(id)))
}

fn FreshShape(id: int) Figure {
    return Figure.Round(Make(id))
}

fn MovedInto() Option[Handle] {
    let handle := Make(1)
    return Some(<-handle)
}

fn MovedOk() Result[Handle, IndexError] {
    let handle := Make(1)
