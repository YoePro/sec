    testing.ExpectEqual(5, count)
}

test "CountBusinessDays excludes the final date" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let wednesday := try ResolveMonthlyDate(
        2026, 7, MonthlyDateRule.DayOfMonth(1),
    )

    let count := try CountBusinessDays(
        monday, wednesday, rules,
