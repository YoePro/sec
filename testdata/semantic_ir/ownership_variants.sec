}

fn ReplaceAfterNestedFieldMove(flag: bool) void {
    let mut nest := Nest { inner: MakePair(), tag: 1 }
    Sink(<-nest.inner.left)
    if flag {
        nest = Nest { inner: MakePair(), tag: 2 }
    }
}

fn ReplaceAfterConditionalFieldMove(flag: bool) void {
