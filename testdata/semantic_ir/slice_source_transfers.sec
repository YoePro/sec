module main

// P16-36 (package16 §§ 39–41): a shared slice holder is copied with
// slice.copy-shared under the same borrow; a mutable slice holder is moved
// with slice.move-mut and the source becomes unavailable.
fn Copy(values: int[4]) int {
    let source := ref values[1..<3]
    let copied := source
    let first := copied[0]
    discard copied
    discard source
    return first
}

fn Move() int {
    let mut values := [1, 2, 3, 4]
    let source := ref mut values[..]
    let moved :<- source
    moved[1] = 7
    let second := moved[1]
    discard moved
    return second
}

// An explicit `ref holder` reborrows the holder's complete extent under a
// new borrow derived from it.
fn Reborrow(values: int[4]) int {
    let source := ref values[..]
    let child := ref source
    let last := child[3]
    discard child
    discard source
    return last
}

fn ReborrowMutable() int {
    let mut values := [1, 2, 3, 4]
    let source := ref mut values[..]
    let child := ref mut source
    child[0] = 9
    discard child
    let first := source[0]
    discard source
    return first
}
