module test
// Direct elements may repeat internally; unique compares the whole elements.
type Row int[2]
type Rows Row[2] unique
type UniqueNumbers int[2] unique
type UniqueEmpty int[0] unique
type UniqueSingleton int[1] unique
fn Check(value: int) void {
    let rows: Rows := [[1, 1], [2, 2]]
    // Unknown direct values receive no fabricated compile-time equality proof.
    let numbers: UniqueNumbers := [value, value]
    let empty: UniqueEmpty := []
    let singleton: UniqueSingleton := [1]
}
