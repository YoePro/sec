module main
enum Wide uint16 { Small = 1, Large = 300 }
enum Signed int16 { Low = -129, High = 127 }
enum Open bit[16] { Zero = 0 }
fn Constructed() uint8 { return uint8(Wide(300)) }
fn Bound() uint8 { let value := Wide.Large
    return uint8(value) }
fn SignedBound() int8 { let value := Signed.Low
    return int8(value) }
fn OpenConstructed() uint8 { return uint8(Open(256)) }
