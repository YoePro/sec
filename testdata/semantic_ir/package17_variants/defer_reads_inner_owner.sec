module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn Log(number: int) void {
}

fn T(ready: bool) void {
    if ready {
        let handle := Make(1)
        defer {
            Log(handle.id)
        }
    }
    Log(0)
}
