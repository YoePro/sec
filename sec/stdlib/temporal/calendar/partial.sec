module calendar

/*
 * Sec Standard Library — temporal/calendar
 * File: calendar/partial.sec
 * Purpose: Partial calendar coordinates and date compatibility queries.
 * Status: Draft candidate API v0.3; NOT IMPLEMENTED, not compiler-verified
 * Revision: 0.3
 * Updated: 2026-11-15
 * Rulebook: stdlib/temporal/calendar/std-temporal-calendar.md
 * References: rules/types/temporal.md; Library of Congress EDTF;
 *             GEDCOM 7 (comparison and scope references, not full conformance).
 */

/**
 * Stores exactly the calendar coordinates known from an incomplete date.
 *
 * Description:
 * None denotes a component not supplied, NOT a default value, an
 * approximate component, or an uncertain interpretation. The year is
 * expressed using the chosen calendar's year numbering. Month identity
 * is stable and independent of its ordinal within a given year.
 * CalendarSystem is supplied separately to the operations below.
 * Values are unvalidated until ValidatePartial succeeds.
 * Ownership: Copyable value; no allocation.
 * Standards: EDTF reduced-precision dates are related, but a missing year
 * with known day/month is a Sec-specific extension, not an EDTF claim.
 */
type PartialDate struct {
    /** Known calendar year; None if it was not supplied. */
    Year: Option[int],
    /** Known stable calendar month; None if it was not supplied. */
    Month: Option[CalendarMonth],
    /** Known day-of-month; None if it was not supplied. */
    Day: Option[int],
}

/**
 * Validates that a partial date can describe at least one day.
 *
 * Description:
 * Supports Gregorian, Julian, fixed Hebrew and civil
 * tabular Islamic calendars.
 *
 * Missing components remain unspecified.
 * At least one matching day must fit core date.
 *
 * Parameters:
 * - value: Partial calendar coordinates.
 * - system: Calendar system for interpretation.
 *
 * Returns:
 * Ok() when at least one matching date exists.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid year.
 * - CalendarError.InvalidMonth: Invalid month identity.
 * - CalendarError.InvalidDay: Invalid day.
 * - CalendarError.OutOfRange: No representable date.
 * - CalendarError.NotImplemented: Unsupported calendar.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn ValidatePartial(value: PartialDate, system: CalendarSystem) Result[void, CalendarError] {
    // Future calendar systems require their own witness rules.
    if system not in [
        CalendarSystem.Gregorian,
        CalendarSystem.Julian,
        CalendarSystem.Hebrew,
        CalendarSystem.IslamicTabular,
    ] {
        return Err(CalendarError.NotImplemented)
    }

    return _validatePartialCalendar(value, system)
}

/**
 * Validates a partial Gregorian date.
 *
 * Description:
 * Missing date components remain unspecified.
 * The operation does not invent missing values.
 *
 * Parameters:
 * - value: Partial calendar coordinates.
 * Returns: Ok() when at least one valid date is possible.
 * Errors: Propagates CalendarError from ValidatePartial.
 * Ownership: Pure, no allocation.
 */
fn ValidatePartial(value: PartialDate) Result[void, CalendarError] {
    return ValidatePartial(value, CalendarSystem.Gregorian)
}

/**
 * Tests whether a known date satisfies a partial date.
 *
 * Description:
 * Converts the candidate to the selected calendar and
 * compares only components present in the partial date.
 * Missing components act as wildcards.
 *
 * The partial date must be valid before comparison.
 * An invalid partial date produces an error, not false.
 *
 * Parameters:
 * - value: Partial date to match.
 * - candidate: Absolute date to examine.
 * - system: Calendar system used for comparison.
 *
 * Returns:
 * True if every specified component matches.
 *
 * Errors:
 * - CalendarError: Propagated from ValidatePartial
 *     or FromDate.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn MatchesDate(value: PartialDate, candidate: date, system: CalendarSystem) Result[bool, CalendarError] {
    // Reject invalid partial dates before comparing.
    try ValidatePartial(value, system)

    // Convert the candidate into the requested calendar.
    let fields := try FromDate(candidate, system)

    // Compare the year only when explicitly specified.
    if value.Year is Some(year) {
        if fields.Year != year {
            return Ok(false)
        }
    }

    // Compare stable month identities, including leap status.
    if value.Month is Some(month) {
        if fields.Month.Number != month.Number || fields.Month.IsLeap != month.IsLeap {
            return Ok(false)
        }
    }

    // Compare the day only when explicitly specified.
    if value.Day is Some(day) {
        if fields.Day != day {
            return Ok(false)
        }
    }

    return Ok(true)
}

/**
 * Tests whether an absolute date matches a partial Gregorian date.
 *
 * Parameters:
 * - value: Partial Gregorian date.
 * - candidate: Absolute date to examine.
 * Returns: True if every known component matches.
 * Errors: Propagates CalendarError from MatchesDate.
 * Ownership: Pure, no allocation.
 */
fn MatchesDate(value: PartialDate, candidate: date) Result[bool, CalendarError] {
    return MatchesDate(value, candidate, CalendarSystem.Gregorian)
}

/**
 * Tests whether two partial dates can represent the same day.
 *
 * Description:
 * Combines all known components from both partial dates.
 * Conflicting components produce false.
 *
 * Both inputs must be independently valid. A combined
 * date that cannot exist produces false rather than
 * an invalid-date error.
 *
 * Compatibility does not establish event identity.
 *
 * Parameters:
 * - left: First partial date.
 * - right: Second partial date.
 * - system: Calendar system used for both values.
 *
 * Returns:
 * True if at least one representable date satisfies both.
 *
 * Errors:
 * - CalendarError: Invalid original input or an
 *     unsupported calendar operation.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn MayDescribeSameDate(left: PartialDate, right: PartialDate, system: CalendarSystem) Result[bool, CalendarError] {
    // Validate both descriptions independently.
    try ValidatePartial(left, system)
    try ValidatePartial(right, system)

    // Begin with the first description.
    let mut combined := left

    // Merge the known years.
    if right.Year is Some(year) {
        if combined.Year is Some(existing) {
            if existing != year {
                return Ok(false)
            }
        }

        combined.Year = Some(year)
    }

    // Merge stable month identities.
    if right.Month is Some(month) {
        if combined.Month is Some(existing) {
            if existing.Number != month.Number || existing.IsLeap != month.IsLeap {
                return Ok(false)
            }
        }

        combined.Month = Some(month)
    }

    // Merge the known days.
    if right.Day is Some(day) {
        if combined.Day is Some(existing) {
            if existing != day {
                return Ok(false)
            }
        }

        combined.Day = Some(day)
    }

    // Each original description was valid, but their
    // combination might describe an impossible date.
    try ValidatePartial(combined, system) {
        Err(CalendarError.InvalidYear) => return Ok(false)
        Err(CalendarError.InvalidMonth) => return Ok(false)
        Err(CalendarError.InvalidDay) => return Ok(false)
        Err(CalendarError.OutOfRange) => return Ok(false)
        Err(e) => return Err(e)
    }

    return Ok(true)
}

/**
 * Tests whether two partial Gregorian dates can overlap.
 *
 * Description:
 * Tests date compatibility, not event identity.
 * Missing components remain unspecified.
 *
 * Parameters:
 * - left: First partial date.
 * - right: Second partial date.
 * Returns: True if at least one common date is possible.
 * Errors: Propagates CalendarError from MayDescribeSameDate.
 * Ownership: Pure, no allocation.
 */
fn MayDescribeSameDate(left: PartialDate, right: PartialDate) Result[bool, CalendarError] {
    return MayDescribeSameDate(left, right, CalendarSystem.Gregorian)
}

/**
 * Converts a complete partial date into an absolute date.
 *
 * Description:
 * Returns Some(date) when year, month and day are all
 * present and valid.
 *
 * Returns None for an incomplete but valid date.
 * Missing components are never filled automatically.
 *
 * Parameters:
 * - value: Partial calendar coordinates.
 * - system: Calendar system used for interpretation.
 *
 * Returns:
 * Some(date) for a complete date, otherwise None.
 *
 * Errors:
 * - CalendarError: Propagated from validation
 *     or calendar conversion.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn ToDateIfComplete(value: PartialDate, system: CalendarSystem) Result[Option[date], CalendarError] {
    // Even an incomplete date must be valid.
    try ValidatePartial(value, system)

    // Conversion requires all three components.
    if value.Year is Some(year) {
        if value.Month is Some(month) {
            if value.Day is Some(day) {
                let fields := CalendarFields {
                    Year: year,
                    Month: month,
                    Day: day,
                }

                let result := try ToDate(fields, system)

                return Ok(Some(result))
            }
        }
    }

    // Missing components remain unspecified.
    return Ok(None)
}

/**
 * Converts a complete partial Gregorian date into an absolute date.
 *
 * Description:
 * Returns None when any required component is missing.
 * Missing values are never filled automatically.
 *
 * Parameters:
 * - value: Partial Gregorian date.
 * Returns: Some(date) when complete, otherwise None.
 * Errors: Propagates CalendarError from ToDateIfComplete.
 * Ownership: Pure, no allocation.
 */
fn ToDateIfComplete(value: PartialDate) Result[Option[date], CalendarError] {
    return ToDateIfComplete(value, CalendarSystem.Gregorian)
}
