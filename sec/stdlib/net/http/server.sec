import (
    "net/ip"
)

type ServerOptions struct {
    Protocols: Protocols,
    MaxRequestHeaderBytes: uint,
    MaxRequestBodyBytes: Option[uint64],
    MaxConcurrentRequests: uint,
}

interface Handler {
    fn Handle(->request: ServerRequest, response: ref mut ResponseWriter) Result[void, error]
}

@noCopy
type Server struct {
    // Private listeners/transports/handler/connections.
}

impl Server {
    static fn Bind(endpoint: ip.Endpoint, -> handler: Handler, options: ServerOptions) Result[Server, ServerError] {
        return Err(ServerError.ResourceLimitExceeded)
    }

    fn Serve() Result[void, ServerError] {
        return Err(ServerError.ResourceLimitExceeded)
    }

    fn Close() Result[void, ServerError] {
        return Err(ServerError.ResourceLimitExceeded)
    }
}
