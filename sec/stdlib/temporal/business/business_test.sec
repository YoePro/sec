            Monday: false,
            Tuesday: false,
            Wednesday: false,
            Thursday: false,
            Friday: false,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    let count := try CountBusinessDays(first, last, data)

    testing.ExpectEqual(0, count)

    match AddBusinessDays(first, 1, data) {
        Ok(_) => testing.Fail("Expected OutsideCoverage")
