/**
 * Determines whether a rune has the Unicode White_Space property.
 *
 * Description:
 * Implements the White_Space property from Unicode 18.0.0.
 * Does not classify zero-width format characters as whitespace.
 *
 * Parameters:
 * - character: The Unicode scalar value to classify.
 *
 * Returns:
 * True if the rune has the White_Space property.
 *
 * Allocation:
 * Does not allocate.
 */
fn _IsWhitespaceRune(character: rune) bool {
    return character in 9r..13r ||
        character == 32r ||
        character == 133r ||
        character == 160r ||
        character == 5760r ||
        character in 8192r..8202r ||
        character in 8232r..8233r ||
        character == 8239r ||
        character == 8287r ||
        character == 12288r
}

/**
 * Appends a line after removing the common indentation.
 *
 * Description:
 * Removes the exact indentation prefix when present.
 * Otherwise preserves the entire line unchanged.
 *
 * Parameters:
 * - builder: Destination for the resulting text.
 * - line: The line without its line separator.
 * - indentation: The common indentation to remove.
 *
 * Errors:
 * - CollectionError: Appending the line failed.
 *
 * Allocation:
 * May grow the destination builder.
 */
fn _AppendDedentedLine(builder: ref mut Builder, line: string, indentation: string) Result[void, CollectionError] {
    if line.StartsWith(indentation) {
        let suffix := try line.Slice(indentation.Len, line.Len) {
            Err(_) => {
                panic "Dedent: invalid line suffix bounds"
            }
        }

        try builder.Append(suffix)
    } else {
        try builder.Append(line)
    }

    return Ok()
}

/**
 * Updates the common indentation prefix using one line.
 *
 * Description:
 * Considers ASCII spaces and tabs as indentation.
 * Ignores empty and whitespace-only indentation lines.
 *
 * The common prefix must match exactly, including
 * the distinction between spaces and tabs.
 *
 * Parameters:
 * - current: Previously established common indentation.
 * - line: The line to examine, without its line separator.
 *
 * Returns:
 * The updated common indentation, or None when no
 * content-bearing line has been encountered.
 *
 * Allocation:
 * Uses non-allocating string slices.
 */
fn _UpdateDedentPrefix(current: Option[string], line: string) Option[string] {
    let mut length: uint := 0

    while length < line.Len {
        let character := line.ByteAt(length)

        if character != 32 && character != 9 {
            break
        }

        length += 1
    }

    // Ignore empty or indentation-only lines.
    if length == line.Len {
        return current
    }

    let indentation := try line.Slice(0, length) {
        Err(_) => {
            panic "Dedent: invalid indentation bounds"
        }
    }

    match current {
        None => {
            return Some(indentation)
        }
        Some(previous) => {
            let mut matched: uint := 0

            while matched < previous.Len &&
            matched < indentation.Len {
                if previous.ByteAt(matched) !=
                    indentation.ByteAt(matched) {
                    break
                }

                matched += 1
            }

            let shared := try previous.Slice(0, matched) {
                Err(_) => {
                    panic "Dedent: invalid common prefix bounds"
                }
            }

            return Some(shared)
        }
    }
}
