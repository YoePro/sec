{
  "name": "sec-syntax",
  "displayName": "SEC Language",
  "description": "SEC is a compiled, high-performance language with strong static typing, semantic typing, units-of-measure, generics, explicit unsafe code, and support for comments and string interpolation.",
  "version": "0.1.0",
  "publisher": "sec-lang",
  "license": "MIT",
  "icon": "images/sec-language.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoePro/sec-syntax"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sec"
  ],
  "categories": ["Programming Languages"],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "sec",
        "aliases": ["SEC", "SEC Language", "sec"],
        "extensions": [".sec", ".se"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/sec-language.svg",
          "dark": "./images/sec-language.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sec",
        "scopeName": "source.sec",
        "path": "./syntaxes/sec.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "modulePrivate",
        "description": "Sec name with a single leading underscore, visible throughout its declaring module."
      },
      {
        "id": "ownerPrivate",
        "description": "Sec name with a double leading underscore, private to its declaring owner."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sec",
        "scopes": {
          "variable": ["variable.other.readwrite.sec"],
          "variable.readonly": ["variable.other.constant.sec"],
          "type.defaultLibrary": ["support.type.primitive.sec"]
        }
      }
    ],
    "configurationDefaults": {
      "[sec]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "sec-lang.sec-syntax",
        "editor.semanticHighlighting.enabled": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "variable.other.readwrite.sec",
            "settings": {
              "foreground": "#9CDCFE"
            }
          },
          {
            "scope": "variable.other.constant.sec",
            "settings": {
              "foreground": "#4FC1FF"
            }
          },
          {
            "scope": "support.type.unit.sec",
            "settings": {
              "foreground": "#4F7A5A"
            }
          },
          {
            "scope": "keyword.other.unit-metadata.sec",
            "settings": {
              "foreground": "#9A6A2F",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "constant.language.unit-status.sec",
            "settings": {
              "foreground": "#B44A3A",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "keyword.other.implements.sec",
            "settings": {
              "fontStyle": "italic"
            }
          },
          {
            "scope": "storage.modifier.static.sec",
            "settings": {
              "foreground": "#7A5AA6",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.type.concurrency.sec",
            "settings": {
              "foreground": "#3F6F9F",
              "fontStyle": "bold"
            }
          },
          {
            "scope": "support.function.concurrency.sec",
            "settings": {
              "foreground": "#5B7F8C"
            }
          },
          {
            "scope": "constant.language.memory-order.sec",
            "settings": {
              "foreground": "#8A6A2A",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "storage.modifier.contract.sec",
            "settings": {
              "foreground": "#8A6A2A",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "storage.modifier.spawn.sec",
            "settings": {
              "foreground": "#3F6F9F",
              "fontStyle": "italic"
            }
          }
        ]
      },
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "variable:sec": "#9CDCFE",
          "variable.readonly:sec": "#4FC1FF"
        }
      }
    },
    "configuration": {
      "title": "SEC",
      "properties": {
        "sec.languageServer.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the SEC language server. Leave empty to use `bin/lsp-sec` or `bin/lsp-sec.exe` inside the extension. Windows example: `C:\\\\Users\\\\Accountname\\\\.vscode\\\\extensions\\\\sec-lang.sec-syntax\\\\bin\\\\lsp-sec.exe`."
        },
        "sec.analysis.parameters.hover": {
          "type": "string",
          "enum": ["off", "concise", "detailed"],
          "default": "off",
          "markdownDescription": "Optional compiler-owned parameter demand in hover. Concise shows access/lifetime; detailed adds capabilities, precision, candidates and blockers. Analysis depth follows the project's `[analysis].lsp_depth`."
        },
        "sec.analysis.parameters.advisories": {
          "type": "string",
          "enum": ["off", "info", "warning", "error"],
          "default": "off",
          "markdownDescription": "Presentation severity for optional A2001 large-value parameter advice. Does not change compiler validity or hide language-safety errors."
        },
        "sec.inlayHints.types": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show inferred types after `let` bindings without a declared type."
        },
        "sec.inlayHints.parameters": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show parameter names before the arguments of calls with two or more arguments."
        },
        "sec.inlayHints.ownership": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show ownership effects the source does not spell: implicit `ref`/`ref mut` call-site borrows, semantic copies, and match bindings that move a payload if their arm is selected."
        }
      }
    }
  }
}
