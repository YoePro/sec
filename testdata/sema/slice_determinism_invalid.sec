module main

fn PastEnd(values: int[4]) int {
    let view := ref values[1..<3]
    return view[2]
}

fn Empty(values: int[0]) int {
    let view := ref values[..]
    return view[0]
}

fn Negative(values: ref int[]) int {
    return values[int256(-1)]
}

fn Wide(values: int[4]) void {
    let view := ref values[..<uint256(340282366920938463463374607431768211456)]
    discard view
}
