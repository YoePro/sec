module main

enum ZeroWidth: bit[0] {
    Zero,
}

enum TooWideValue: bit[2] {
    Invalid = 0b100,
}

enum PlainEnum {
    First,
    Second,
}

enum ClockSource: bit[2] {
    Internal = 0,
    External = 1,
}

type InvalidConfig register[4] {
    Plain: PlainEnum,
    _: ClockSource,
}

type ClockConfig register[2] {
    Source: ClockSource,
}

impl ClockConfig {
    fn InvalidWrite() void {
        self.Source = 5
    }
}

@address(ClockConfigEndpoint)
let mut clockConfig: ClockConfig

fn InvalidWrites() void {
    clockConfig.Source = ClockSource(0)
    let invalid := ClockSource(5)
}

fn InvalidDynamicConversion(value: int) ClockSource {
    return ClockSource(value)
}

hardware region RegisterSpace {
    domain: "cpu-physical",
    kind: HardwareRegionKind.MMIO,
    base: 0x40020000,
    size: 0x10000,
    readable: true,
    writable: true,
}
hardware resource ClockConfigState { width: 8, }
hardware endpoint ClockConfigEndpoint {
    kind: HardwareEndpointKind.MemoryMapped,
    region: RegisterSpace,
    resource: ClockConfigState,
    offset: 0x1000,
    size: 1,
    alignment: 1,
    read_widths: [8],
    write_widths: [8],
    read_footprint: HardwareFootprintKind.Whole,
    write_footprint: HardwareFootprintKind.Whole,
    read_effect: HardwareReadEffect.NonDestructive,
    write_operation: HardwareWriteOperation.Replace,
    ordering: HardwareOrdering.Volatile,
    completion: HardwareCompletion.Issued,
    atomicity: HardwareAtomicity.Unspecified,
    context: HardwareAccessContext.Current,
    fault: HardwareFaultContract.Platform,
}
