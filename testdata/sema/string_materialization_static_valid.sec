module main

fn Borrowed(data: ref mut byte[], runes: ref mut rune[]) Result[uint, StringError] {
    let bytesText := try string.FromByteArray(data)
    let runeText := try string.FromRuneArray(runes)
    data[0] = 65
    runes[0] = 65r
    return Ok(data.Len + runes.Len)
}

fn Named() Result[uint, StringError] {
    let data: byte[2] := [65, 66]
    let runes: rune[2] := [65r, 66r]
    let bytesText := try string.FromByteArray(data)
    let runeText := try string.FromRuneArray(runes)
    let description := try data.ToString()
    return Ok(data.Len + runes.Len)
}

fn Bytes(data: ref byte[]) Result[string, StringError] {
    return string.FromByteArray(data)
}
fn Runes(data: ref rune[]) Result[string, StringError] {
    return string.FromRuneArray(data)
}
