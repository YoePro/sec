/**
 * Starts enumeration of the network interfaces available to the process.
 *
 * Returns:
 * - An owning iterator positioned before the first interface.
 *
 * Errors:
 * - NetworkError: Interface enumeration could not be initialized.
 *
 * Ownership:
 * - The returned InterfaceIterator is owned by the caller and is move-only.
 */
fn Interfaces() Result[InterfaceIterator, NetworkError] {
    // TODO: Implement through the target network-interface adapter.
    return Err(NetworkError.NotImplemented)
}

/**
 * Finds a network interface by its interface index.
 *
 * Parameters:
 * - index: The interface index to locate.
 *
 * Returns:
 * - Some(interface) when a matching interface exists.
 * - None when no interface has that index.
 *
 * Errors:
 * - NetworkError: Interface enumeration failed.
 */
fn InterfaceByIndex(index: InterfaceIndex) Result[Option[NetworkInterface], NetworkError] {
    let mut iterator := try Interfaces()

    for {
        let next := try iterator.Next()
        match next {
            Some(networkInterface) => {
                if networkInterface.Index == index {
                    try iterator.Close()
                    return Ok(Some(networkInterface))
                }
            }

            None => {
                try iterator.Close()
                return Ok(None)
            }
        }
    }
}

/**
 * Finds a network interface by its platform interface name.
 *
 * Parameters:
 * - name: The exact interface name to locate.
 *
 * Returns:
 * - Some(interface) when a matching interface exists.
 * - None when no matching interface exists.
 *
 * Errors:
 * - NetworkError: Interface enumeration failed.
 */
fn InterfaceByName(name: string) Result[Option[NetworkInterface], NetworkError] {
    let mut iterator := try Interfaces()

    for {
        let next := try iterator.Next()
        match next {
            Some(networkInterface) => {
                if networkInterface.Name == name {
                    try iterator.Close()
                    return Ok(Some(networkInterface))
                }
            }

            None => {
                try iterator.Close()
                return Ok(None)
            }
        }
    }
}

