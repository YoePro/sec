}

test "ModifiedFollowing preserves the nominal month" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    // Saturday May 30, 2026.
    // Following gives June 1, so modified gives May 29.
    let original := try ResolveMonthlyDate(
        2026, 5, MonthlyDateRule.DayOfMonth(30),
    )

    let result := try AdjustBusinessDay(
        original, rules,
        BusinessDayAdjustment.ModifiedFollowing,
    )

    testing.Expect(try _matchesGregorianDate(
        result, 2026, 5, 29,
    ))
}

test "ModifiedPreceding preserves the nominal month" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    // Sunday May 1, 2022.
    // Preceding gives April 29, so modified gives May 2.
    let original := try ResolveMonthlyDate(
        2022, 5, MonthlyDateRule.DayOfMonth(1),
    )

    let result := try AdjustBusinessDay(
        original, rules,
        BusinessDayAdjustment.ModifiedPreceding,
    )

    testing.Expect(try _matchesGregorianDate(
        result, 2022, 5, 2,
    ))
}

