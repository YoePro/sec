module main
type Device register[8] {
    Ready: bit,
    _: bit[7],
}
impl Device {
    property IsReady: bool {
        get {
            return self.Ready
        }
        set ready {
            self.Ready = ready
        }
    }
}
@address(DeviceEndpoint)
let mut device: Device
@address(LocalEndpoint)
let mut local: Device
@noAlloc
fn Read() bool { return device.IsReady }
@noAlloc
fn Write(ready: bool) void { device.IsReady = ready }
@noAlloc
fn Bind() void {
    local.IsReady = true
    discard local.IsReady
}
@noAlloc
fn Volatile(pointer: RawPtr[int], value: int) int {
    unsafe {
        pointer.VolatileWrite(value)
        return pointer.VolatileRead()
    }
}
@noAlloc
fn Forward(pointer: RawPtr[int]) int { return Volatile(pointer, 1) }
fn Mixed(pointer: RawPtr[int]) void {
    discard Forward(pointer)
    discard Arena.WithCapacity(64u)
}
type Lookalike struct {}
impl Lookalike {
    fn VolatileRead() void { discard Arena.WithCapacity(64u) }
}
fn UserMember(value: ref Lookalike) void { value.VolatileRead() }
extern "Sec" fn MapRegion() void
fn UnknownMapping() void { MapRegion() }
@noAlloc
fn main() void {
    Bind()
    Write(true)
    discard Read()
}

hardware region RegisterSpace {
    domain: "cpu-physical",
    kind: HardwareRegionKind.MMIO,
    base: 0x40020000,
    size: 0x10000,
    readable: true,
    writable: true,
}
hardware resource DeviceState { width: 8, }
hardware endpoint DeviceEndpoint {
    kind: HardwareEndpointKind.MemoryMapped,
    region: RegisterSpace,
    resource: DeviceState,
    offset: 0x1000,
    size: 1,
    alignment: 1,
    read_widths: [8],
    write_widths: [8],
    read_footprint: HardwareFootprintKind.Whole,
    write_footprint: HardwareFootprintKind.Whole,
    read_effect: HardwareReadEffect.NonDestructive,
    write_operation: HardwareWriteOperation.Replace,
    ordering: HardwareOrdering.Volatile,
    completion: HardwareCompletion.Issued,
    atomicity: HardwareAtomicity.Unspecified,
    context: HardwareAccessContext.Current,
    fault: HardwareFaultContract.Platform,
}
hardware resource LocalState { width: 8, }
hardware endpoint LocalEndpoint {
    kind: HardwareEndpointKind.MemoryMapped,
    region: RegisterSpace,
    resource: LocalState,
    offset: 0x1004,
    size: 1,
    alignment: 1,
    read_widths: [8],
    write_widths: [8],
    read_footprint: HardwareFootprintKind.Whole,
    write_footprint: HardwareFootprintKind.Whole,
    read_effect: HardwareReadEffect.NonDestructive,
    write_operation: HardwareWriteOperation.Replace,
    ordering: HardwareOrdering.Volatile,
    completion: HardwareCompletion.Issued,
    atomicity: HardwareAtomicity.Unspecified,
    context: HardwareAccessContext.Current,
    fault: HardwareFaultContract.Platform,
}
