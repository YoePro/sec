// Actual core time catalog conversions; uint128 retains exact sub-second test values.
module main

fn Convert_s() bool {
    let value: uint128<s> := 1
    let seconds: uint128<s> := value
    let reverseSource: uint128<s> := 1
    let restored: uint128<s> := reverseSource
    discard restored
    return <s>.Kind == UnitKind.Time
}

