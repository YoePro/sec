module http

/*
* Sec Standard Library - net/http - Version-independent HTTP request values and server request metadata
*
* File:        stdlib/net/http/request.sec
* Module:      http
* Revision:    2
* Updated:     2026-09-08
* Author:      Jonas Engström
*
* Purpose:
*   Version-independent HTTP request values and server request metadata.
*
* Standards:
*   - RFC 9110
*     https://www.rfc-editor.org/rfc/rfc9110
*
* Rulebook:
*   stdlib/net/http/std-net-http.md
*/

import (
    "net/url"
    "net/ip"
)

// HTTP request.
//
// Request represents the protocol-level HTTP message.
//
// Transport-specific information such as the remote network endpoint,
// TLS connection state, cancellation and server context does not belong
// directly in this type and will be modeled separately.
type Request struct {
    // HTTP method, including extension methods.
    Method: Method,

    // Raw request-target as it appeared on the wire.
    //
    // Examples:
    //   /
    //   /users/42
    //   /search?q=sec
    //   *
    //
    // Parsing into path/query components will be provided by Request
    // behavior and/or the future URL support.
    Target: string,

    // HTTP protocol version.
    Version: VersionNumber,

    // Request headers.
    //
    // Header will become a dedicated HTTP type because field names are
    // case-insensitive and one field may contain multiple values.
    Headers: Header,

    // Request trailers.
    Trailers: Header,

    // Effective host/authority for the request.
    Host: string,

    // Message body.
    //
    // byte[] is a temporary groundwork representation.
    // The final API should support streamed bodies without requiring the
    // complete request body to be allocated in memory.
    Body: byte[],

    // Declared content length.
    //
    // None means that no Content-Length is known or declared.
    ContentLength: Option[uint64],
}

impl Request {
    // -------------------------------------------------------------------------
    // Target helpers
    // -------------------------------------------------------------------------

    property Path: string {
        get {
            // TODO:
            // Parse and return the path portion of Target.
            return self.Target
        }
    }

    property Query: string {
        get {
            // TODO:
            // Return the query component without the leading '?'.
            return ""
        }
    }

    // -------------------------------------------------------------------------
    // Body helpers
    // -------------------------------------------------------------------------

    property HasBody: bool {
        get {
            // TODO:
            // This must be revisited when Body becomes stream-capable.
            return !self.Body.IsEmpty
        }
    }

    // -------------------------------------------------------------------------
    // Header helpers
    // -------------------------------------------------------------------------

    fn HeaderValue(Name: string) Option[string] {
        // TODO:
        // Header lookup is case-insensitive.
        //
        // Define how multiple field values are treated by this helper.
        discard Name
        return None
    }

    fn HeaderValues(Name: string) string[] {
        // TODO:
        // Return all values for the requested field name.
        discard Name

        let mut values: string[]
        return values
    }

    fn SetHeader(
        Name: string,
        Value: string,
    ) void {
        // TODO:
        // Replace existing values for Name.
        discard Name
        discard Value
    }

    fn AddHeader(Name: string, Value: string) void {
        // TODO: Implement request.AddHeader
        // Append another field value without replacing existing values.
        discard Name
        discard Value
    }

    fn RemoveHeader(Name: string) void {
        // TODO: Implement request.RemoveHeaders
        discard Name
    }

    // -------------------------------------------------------------------------
    // Common HTTP conveniences
    // -------------------------------------------------------------------------

    property UserAgent: string {
        get {
            // TODO: Implement request.UserAgent
            return ""
        }
    }

    property Referer: string {
        get {
            // TODO: Implement request.Referer
            return ""
        }
    }

    property ContentType: string {
        get {
            // TODO:
            return ""
        }
    }

    // -------------------------------------------------------------------------
    // Authentication helpers
    // -------------------------------------------------------------------------

    fn BasicAuth() Option[BasicAuthentication] {
        // TODO:
        // Decode Authorization: Basic ...
        return None
    }

    /**
    * Parse validates an HTTP origin-form request target.
    *
    * Description:
    *   Origin-form consists of an absolute path beginning with '/' followed by an
    *   optional query component. Fragments, whitespace, non-ASCII characters,
    *   and malformed percent-encoded sequences are rejected.
    *
    * Parameters:
    *   - value: Raw origin-form request target.
    *
    * Returns:
    *   A validated OriginTarget preserving the original wire representation.
    *
    * Errors:
    *   - MessageError.InvalidTarget: value is not a valid origin-form target.
    *
    * Standards:
    *   - RFC 9112 Section 3.2.1
    */
    static fn Parse(value: string) Result[OriginTarget, MessageError] {
        if value.IsEmpty || !value.StartsWith("/") {
            return Err(MessageError.InvalidTarget)
        }

        let mut index: uint := 0

        while index < value.Len {
            let current := char(value.ByteAt(index))

            if !current.IsAscii || current.IsWhitespace || current == '#' {
                return Err(MessageError.InvalidTarget)
            }

            if current == '%' {
                if index + 2 >= value.Len {
                    return Err(MessageError.InvalidTarget)
                }

                let high := char(value.ByteAt(index + 1))
                let low := char(value.ByteAt(index + 2))

                if !high.IsHexDigit || !low.IsHexDigit {
                    return Err(MessageError.InvalidTarget)
                }

                index += 3
                continue
            }

            index += 1
        }

        return Ok(OriginTarget(value))
    }

    // -------------------------------------------------------------------------
    // Serialization
    // -------------------------------------------------------------------------

    /**
    * Returns the validated origin-form request target.
    */
    fn ToString() string {
        // TODO: Implement http.Request.ToString()
        // return string(self)
        return ""
    }
}

// Parsed HTTP Basic authentication credentials.
//
// This is intentionally a struct instead of returning two unrelated strings.
type BasicAuthentication struct {
    Username: string,
    Password: string,
}

type OriginTarget string

type AuthorityTarget string

type RequestTarget union {
    Origin(OriginTarget),
    Absolute(url.URL),
    Authority(AuthorityTarget),
    Asterisk,
}

type ConnectionInfo struct {
    LocalEndpoint: ip.Endpoint,
    RemoteEndpoint: ip.Endpoint,
    Version: Version,
    Secure: bool,
}

@noCopy
type ServerRequest struct {
    Message: Request,
    Connection: ConnectionInfo,
}
