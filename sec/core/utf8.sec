module core

// Rulebook: library/core-library.md § 5.4 (bytes and runes) and the UTF-8
// well-formedness table of Unicode § 3.9 (table 3-7).

/**
 * One Unicode scalar value decoded from UTF-8 bytes.
 */
type Utf8DecodedRune struct {
    /** The decoded Unicode scalar value. */
    Value: rune,
    /** The number of bytes consumed, 1 to 4. */
    Width: uint,
}

/**
 * Decodes the UTF-8 sequence that starts at index.
 *
 * Description:
 * Accepts only well-formed sequences: no overlong encodings, no
 * surrogates (U+D800-U+DFFF) and nothing above U+10FFFF. A sequence
 * truncated by the end of value is invalid. Continue decoding at
 * index + Width.
 *
 * Parameters:
 * - value: The bytes to read; they are borrowed and not changed.
 * - index: The byte offset of the first byte of the sequence.
 *
 * Returns:
 * The scalar value and the number of bytes it used.
 *
 * Errors:
 * - StringError.OutOfBounds: index is at or past value.Len.
 * - StringError.InvalidUtf8(index): The bytes at index are not a
 * well-formed sequence; the payload is the start index.
 * - StringError.InvalidCodePoint: Kept as a defensive path; the byte
 * checks already exclude every value it could report.
 *
 * Allocation:
 * None.
 */
fn DecodeUtf8(value: ref byte[], index: uint) Result[Utf8DecodedRune, StringError] {
    if index >= value.Len {
        return Err(StringError.OutOfBounds)
    }

    let first := value[index]

    // ASCII
    if first <= 0x7F {
        return Ok(Utf8DecodedRune {
            Value: rune(uint(first)),
            Width: 1,
        })
    }

    // Two-byte sequence:
    // C2..DF 80..BF
    if first in 0xC2..0xDF {
        if value.Len - index < 2 {
            return Err(StringError.InvalidUtf8(index))
        }

        let second := value[index + 1]

        if second not in 0x80..0xBF {
            return Err(StringError.InvalidUtf8(index))
        }

        let codePoint := (uint(first & 0x1F) << 6) | uint(second & 0x3F)

        return Ok(Utf8DecodedRune {
            Value: rune(codePoint),
            Width: 2,
        })
    }

    // Three-byte sequence
    if first in 0xE0..0xEF {
        if value.Len - index < 3 {
            return Err(StringError.InvalidUtf8(index))
        }

        let second := value[index + 1]
        let third := value[index + 2]

        if third not in 0x80..0xBF {
            return Err(StringError.InvalidUtf8(index))
        }

        // E0 must start at A0 to prevent overlong encoding.
        if first == 0xE0 {
            if second not in 0xA0..0xBF {
                return Err(StringError.InvalidUtf8(index))
            }
        } else if first == 0xED {
            // ED A0..BF would encode UTF-16 surrogate values.
            if second not in 0x80..0x9F {
                return Err(StringError.InvalidUtf8(index))
            }
        } else if second not in 0x80..0xBF {
            return Err(StringError.InvalidUtf8(index))
        }

        let codePoint := (uint(first & 0x0F) << 12) | (uint(second & 0x3F) << 6) | uint(third & 0x3F)

        // The byte checks above exclude surrogates and values above
        // U+10FFFF; the checked conversion keeps that proof explicit
        // (types.md "Explicit conversions").
        let scalar := try rune(codePoint) {
            Err(_) => {
                return Err(StringError.InvalidCodePoint)
            }
        }

        return Ok(Utf8DecodedRune {
            Value: scalar,
            Width: 3,
        })
    }

    // Four-byte sequence
    if first in 0xF0..0xF4 {
        if value.Len - index < 4 {
            return Err(StringError.InvalidUtf8(index))
        }

        let second := value[index + 1]
        let third := value[index + 2]
        let fourth := value[index + 3]

        if third not in 0x80..0xBF ||
        fourth not in 0x80..0xBF {
            return Err(StringError.InvalidUtf8(index))
        }

        if first == 0xF0 {
            // Prevent overlong encoding below U+10000.
            if second not in 0x90..0xBF {
                return Err(StringError.InvalidUtf8(index))
            }
        } else if first == 0xF4 {
            // Unicode ends at U+10FFFF.
            if second not in 0x80..0x8F {
                return Err(StringError.InvalidUtf8(index))
            }
        } else if second not in 0x80..0xBF {
            return Err(StringError.InvalidUtf8(index))
        }

        let codePoint :=
        (uint(first & 0x07) << 18) |
        (uint(second & 0x3F) << 12) |
        (uint(third & 0x3F) << 6) |
        uint(fourth & 0x3F)

        // The byte checks above exclude surrogates and values above
        // U+10FFFF; the checked conversion keeps that proof explicit
        // (types.md "Explicit conversions").
        let scalar := try rune(codePoint) {
            Err(_) => {
                return Err(StringError.InvalidCodePoint)
            }
        }

        return Ok(Utf8DecodedRune {
            Value: scalar,
            Width: 4,
        })
    }

    return Err(StringError.InvalidUtf8(index))
}
