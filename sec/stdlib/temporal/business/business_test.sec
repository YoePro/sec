test "Combined business arithmetic handles overlapping exceptions" {
    let thursday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(25),
    )

    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let tuesday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(30),
    )

    // Calendar A closes Friday and opens Saturday.
    let exceptionsA: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    // Calendar B explicitly confirms Friday as working.
    // Friday therefore appears in both exception lists.
    let exceptionsB: BusinessDayException[1] := [
        BusinessDayException {
            Day: friday,
            Working: true,
        },
    ]

    let week := BusinessWeekPattern {
        Monday: true,
        Tuesday: true,
        Wednesday: true,
        Thursday: true,
        Friday: true,
        Saturday: false,
        Sunday: false,
    }

    let calendars: BusinessCalendarData[2] := [
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:A",
                Revision: "1",
            },
            FirstDay: thursday,
            LastDay: monday,
            Week: week,
            Exceptions: ref exceptionsA[..],
        },
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:B",
                Revision: "1",
            },
            FirstDay: thursday,
            LastDay: monday,
            Week: week,
            Exceptions: ref exceptionsB[..],
        },
    ]

    // [Thursday, Tuesday) contains:
    //
    // All: Thursday and Monday = 2 days.
    // Any: Thursday, Friday, Saturday, Monday = 4 days.
    let allCount := try CountBusinessDays(
        thursday,
        tuesday,
        ref calendars[..],
        BusinessCalendarCombination.All,
    )

    let anyCount := try CountBusinessDays(
        thursday,
        tuesday,
        ref calendars[..],
        BusinessCalendarCombination.Any,
    )

    testing.ExpectEqual(2, allCount)
    testing.ExpectEqual(4, anyCount)

    // Moving forward from Thursday.
    let nextAll := try AddBusinessDays(
        thursday,
        1,
        ref calendars[..],
        BusinessCalendarCombination.All,
    )

    let nextAny := try AddBusinessDays(
        thursday,
        1,
        ref calendars[..],
        BusinessCalendarCombination.Any,
    )

    testing.ExpectEqual(monday.EpochDays, nextAll.EpochDays)
    testing.ExpectEqual(friday.EpochDays, nextAny.EpochDays)

    // Moving backward from Monday.
    let previous: int := -1

    let priorAll := try AddBusinessDays(
        monday,
        previous,
        ref calendars[..],
        BusinessCalendarCombination.All,
    )

    let priorAny := try AddBusinessDays(
        monday,
        previous,
        ref calendars[..],
        BusinessCalendarCombination.Any,
    )

    testing.ExpectEqual(thursday.EpochDays, priorAll.EpochDays)
    testing.ExpectEqual(saturday.EpochDays, priorAny.EpochDays)

    // Reversed intervals must negate the result.
    let reversed := try CountBusinessDays(
        tuesday,
        thursday,
        ref calendars[..],
        BusinessCalendarCombination.Any,
    )

    testing.ExpectEqual(-4, reversed)
}

test "Combined arithmetic rejects missing target business day" {
    let saturday := try ResolveMonthlyDate(
