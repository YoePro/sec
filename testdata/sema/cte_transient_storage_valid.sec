module main

type Pair struct { left: int, right: int }

fn Compute(seed: int) int {
    let mut value := Pair { left: seed, right: 7 }
    for index in 0..<6 {
        value.left = value.left + value.right
    }
    return value.left
}

fn Text() string { return "Sec " + "\u{1F600}" }

let Answer: int := Compute(0)
let Message: string := Text()

fn main() int { return Answer - 42 }
