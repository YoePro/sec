module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

fn Log(number: int) void {
}

fn T() void {
    let mut handle := Make(1)
    defer {
        Log(handle.id)
    }
    handle = Make(2)
}
