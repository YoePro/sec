module main

type Left int
type Right int
type Small int range 1..3
type Box[T] struct { value: T }
unit DiagnosticLength physical
unit DiagnosticTime physical

fn Nominal(value: Right) Left { return value }
fn Contract() Small { return 8 }
fn Generic(value: Box[string]) Box[int] { return value }
fn Shape(value: int[3]) int[2] { return value }
fn Dimension(value: decimal<DiagnosticTime>) decimal<DiagnosticLength> { return value }
fn Conversion(value: bool) int { return int(value) }

impl DiagnosticLength {
 Dimension: [length^1]
}
impl DiagnosticTime {
 Dimension: [time^1]
}
