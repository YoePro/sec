module main

fn Sum(limit: int) int {
    let mut total: int := 0
    let mut i: int := 1
    while i <= limit {
        total += i
        i += 1
    }
    return total
}

fn IsEven(value: int) bool {
    return value % 2 == 0
}

fn main() int {
    let s := Sum(10)
    if IsEven(s) && s != 0 {
        return 1
    }
    return s - 50
}
