module str

/*
 * Sec Standard Library - str - Collect transformation tests
 *
 * File:        stdlib/str/collection_test.sec
 * Module:      str
 * Revision:    1
 * Updated:     2026-10-15
 *
 * Purpose:
 * Tests Collect and CollectIndexed in transform.sec, including
 * expansion, deletion, UTF-8 preservation, rune indexing, and
 * exact propagation of CollectionError from transformation callbacks.
 *
 * Contract:
 * Both callbacks return Result[string, CollectionError].
 * Both public functions return Result[string, CollectionError].
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 */

// Test callbacks for Collect(rune -> Result[string, CollectionError]).

fn _CollectionTestExpand(character: rune) Result[string, CollectionError] {
    switch character {
        case 97r:
            return Ok("[A]")
        case 98r:
            return Ok("")
        case 99r:
            return Ok("CC")
        default:
            return Ok("-")
    }
}

fn _CollectionTestKeepA(character: rune) Result[string, CollectionError] {
    if character == 97r {
        return Ok("a")
    }

    return Ok("")
}

fn _CollectionTestUnicode(character: rune) Result[string, CollectionError] {
    switch character {
        case 97r:
            return Ok("å")
        case 98r:
            return Ok("€")
        case 99r:
            return Ok("🦊")
        default:
            return Ok("?")
    }
}

fn _CollectionTestKeepUnicode(character: rune) Result[string, CollectionError] {
    switch character {
        case 229r:
            return Ok("å")
        case 8364r:
            return Ok("€")
        case 129418r:
            return Ok("🦊")
        default:
            return Ok("")
    }
}

fn _CollectionTestCombining(character: rune) Result[string, CollectionError] {
    if character == 101r {
        return Ok("e")
    }

    if character == 769r {
        return Ok("\u{0301}")
    }

    return Ok("")
}

fn _CollectionTestNul(character: rune) Result[string, CollectionError] {
    if character == 0r {
        return Ok("\0")
    }

    return Ok("X")
}

fn _CollectionTestAlwaysFail(character: rune) Result[string, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}

fn _CollectionTestFailOnB(character: rune) Result[string, CollectionError] {
    if character == 98r {
        return Err(CollectionError.SizeOverflow)
    }

    return Ok("x")
}

fn _CollectionTestFailOnUnicode(character: rune) Result[string, CollectionError] {
    if character == 129418r {
        return Err(CollectionError.SizeOverflow)
    }

    return Ok("x")
}

// Test callbacks for CollectIndexed((uint, rune) -> Result[string, CollectionError]).

fn _CollectionTestIndexedPositions(index: uint, character: rune) Result[string, CollectionError] {
    switch index {
        case 0:
            return Ok("[0]")
        case 1:
            return Ok("[1]")
        case 2:
            return Ok("[2]")
        default:
            return Ok("[n]")
    }
}

fn _CollectionTestIndexedEven(index: uint, character: rune) Result[string, CollectionError] {
    if index % 2 == 0 {
        return Ok("X")
    }

    return Ok("")
}

fn _CollectionTestIndexedValue(index: uint, character: rune) Result[string, CollectionError] {
    if index == 0 && character == 97r {
        return Ok("A")
    }

    if index == 1 && character == 229r {
        return Ok("åå")
    }

    if index == 2 && character == 129418r {
        return Ok("🦊")
    }

    return Ok("?")
}

fn _CollectionTestIndexedExpand(index: uint, character: rune) Result[string, CollectionError] {
    switch index {
        case 0:
            return Ok("[A]")
        case 1:
            return Ok("")
        case 2:
            return Ok("CC")
        default:
            return Ok("-")
    }
}

fn _CollectionTestIndexedAlwaysFail(index: uint, character: rune) Result[string, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}

fn _CollectionTestIndexedFailAtOne(index: uint, character: rune) Result[string, CollectionError] {
    if index == 1 {
        return Err(CollectionError.SizeOverflow)
    }

    return Ok("x")
}

fn _CollectionTestIndexedFailOnUnicode(index: uint, character: rune) Result[string, CollectionError] {
    if index == 1 && character == 129418r {
        return Err(CollectionError.SizeOverflow)
    }

    return Ok("x")
}

// Collect: zero, one, or several output runes per input rune.

test "Collect accepts empty input" {
    let result := try Collect("", _CollectionTestExpand)
    testing.ExpectEqual("", result)
}

test "Collect does not invoke callback for empty input" {
    let result := try Collect("", _CollectionTestAlwaysFail)
    testing.ExpectEqual("", result)
}

test "Collect expands a single rune" {
    let result := try Collect("a", _CollectionTestExpand)
    testing.ExpectEqual("[A]", result)
}

test "Collect deletes a single rune" {
    let result := try Collect("b", _CollectionTestExpand)
    testing.ExpectEqual("", result)
}

test "Collect expands multiple runes" {
    let result := try Collect("cc", _CollectionTestExpand)
    testing.ExpectEqual("CCCC", result)
}

test "Collect mixes expansion deletion and preservation" {
    let result := try Collect("abc", _CollectionTestExpand)
    testing.ExpectEqual("[A]CC", result)
}

test "Collect preserves input order after transformation" {
    let result := try Collect("caba", _CollectionTestExpand)
    testing.ExpectEqual("CC[A][A]", result)
}

test "Collect repeats transformations for repeated runes" {
    let result := try Collect("aaa", _CollectionTestExpand)
    testing.ExpectEqual("[A][A][A]", result)
}

test "Collect handles a fallback transformation" {
    let result := try Collect("ad", _CollectionTestExpand)
    testing.ExpectEqual("[A]-", result)
}

test "Collect filters out all unmatched runes" {
    let result := try Collect("xyz", _CollectionTestKeepA)
    testing.ExpectEqual("", result)
}

test "Collect filters while keeping source order" {
    let result := try Collect("baacaba", _CollectionTestKeepA)
    testing.ExpectEqual("aaaa", result)
}

test "Collect produces Unicode output of different byte widths" {
    let result := try Collect("abc", _CollectionTestUnicode)
    testing.ExpectEqual("å€🦊", result)
}

test "Collect preserves multibyte input runes" {
    let result := try Collect("å€🦊", _CollectionTestKeepUnicode)
    testing.ExpectEqual("å€🦊", result)
}

test "Collect deletes other runes between Unicode runes" {
    let result := try Collect("åx€y🦊", _CollectionTestKeepUnicode)
    testing.ExpectEqual("å€🦊", result)
}

test "Collect preserves decomposed Unicode without normalization" {
    let result := try Collect("e\u{0301}", _CollectionTestCombining)
    testing.ExpectEqual("e\u{0301}", result)
}

test "Collect can emit NUL inside a string" {
    let result := try Collect("a\0b", _CollectionTestNul)
    testing.ExpectEqual("X\0X", result)
}

test "Collect propagates an immediate allocation error from callback" {
    try Collect("abc", _CollectionTestAlwaysFail) {
        Err(CollectionError.AllocationFailed) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.AllocationFailed")
}

test "Collect propagates SizeOverflow without rewriting it" {
    try Collect("abc", _CollectionTestFailOnB) {
        Err(CollectionError.SizeOverflow) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.SizeOverflow")
}

test "Collect propagates an error after multibyte input" {
    try Collect("å🦊B", _CollectionTestFailOnUnicode) {
        Err(CollectionError.SizeOverflow) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.SizeOverflow")
}

// CollectIndexed: rune positions are zero-based and count scalar values.

test "CollectIndexed accepts empty input" {
    let result := try CollectIndexed("", _CollectionTestIndexedPositions)
    testing.ExpectEqual("", result)
}

test "CollectIndexed does not invoke callback for empty input" {
    let result := try CollectIndexed("", _CollectionTestIndexedAlwaysFail)
    testing.ExpectEqual("", result)
}

test "CollectIndexed receives index zero for a single rune" {
    let result := try CollectIndexed("a", _CollectionTestIndexedPositions)
    testing.ExpectEqual("[0]", result)
}

test "CollectIndexed receives consecutive rune indexes" {
    let result := try CollectIndexed("abc", _CollectionTestIndexedPositions)
    testing.ExpectEqual("[0][1][2]", result)
}

test "CollectIndexed indexes runes rather than UTF-8 bytes" {
    let result := try CollectIndexed("å🦊€", _CollectionTestIndexedPositions)
    testing.ExpectEqual("[0][1][2]", result)
}

test "CollectIndexed index starts at zero for Unicode input" {
    let result := try CollectIndexed("🦊", _CollectionTestIndexedPositions)
    testing.ExpectEqual("[0]", result)
}

test "CollectIndexed indexes decomposed Unicode by rune" {
    let result := try CollectIndexed("e\u{0301}", _CollectionTestIndexedPositions)
    testing.ExpectEqual("[0][1]", result)
}

test "CollectIndexed indexes after a deleted rune" {
    let result := try CollectIndexed("abcd", _CollectionTestIndexedEven)
    testing.ExpectEqual("XX", result)
}

test "CollectIndexed retains even indexed Unicode runes" {
    let result := try CollectIndexed("å🦊€b", _CollectionTestIndexedEven)
    testing.ExpectEqual("XX", result)
}

test "CollectIndexed handles a single rejected position" {
    let result := try CollectIndexed("a", _CollectionTestIndexedEven)
    testing.ExpectEqual("X", result)
}

test "CollectIndexed combines rune values and indexes" {
    let result := try CollectIndexed("aå🦊", _CollectionTestIndexedValue)
    testing.ExpectEqual("Aåå🦊", result)
}

test "CollectIndexed uses fallback for unmatched rune and index" {
    let result := try CollectIndexed("abc", _CollectionTestIndexedValue)
    testing.ExpectEqual("A??", result)
}

test "CollectIndexed supports expansion and deletion" {
    let result := try CollectIndexed("abc", _CollectionTestIndexedExpand)
    testing.ExpectEqual("[A]CC", result)
}

test "CollectIndexed supports expansion beyond three input positions" {
    let result := try CollectIndexed("abcd", _CollectionTestIndexedExpand)
    testing.ExpectEqual("[A]CC-", result)
}

test "CollectIndexed propagates immediate allocation error" {
    try CollectIndexed("abc", _CollectionTestIndexedAlwaysFail) {
        Err(CollectionError.AllocationFailed) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.AllocationFailed")
}

test "CollectIndexed propagates SizeOverflow unchanged" {
    try CollectIndexed("abc", _CollectionTestIndexedFailAtOne) {
        Err(CollectionError.SizeOverflow) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.SizeOverflow")
}

test "CollectIndexed propagates error at a Unicode rune index" {
    try CollectIndexed("å🦊€", _CollectionTestIndexedFailOnUnicode) {
        Err(CollectionError.SizeOverflow) => {
            testing.Pass()
        }
    }

    testing.Fail("expected CollectionError.SizeOverflow")
}

// Consistency between positional and non-positional collection.

test "Collect and CollectIndexed agree on matching callbacks" {
    let basic := try Collect("abc", _CollectionTestExpand)
    let indexed := try CollectIndexed("abc", _CollectionTestIndexedExpand)
    testing.ExpectEqual(basic, indexed)
}

test "Collect and CollectIndexed both accept an empty string" {
    let basic := try Collect("", _CollectionTestExpand)
    let indexed := try CollectIndexed("", _CollectionTestIndexedExpand)
    testing.ExpectEqual(basic, indexed)
}
