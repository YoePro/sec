test "Built-in business calendar recognizes weekdays" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    testing.Expect(!(try IsBusinessDay(saturday, rules)))
    testing.Expect(try IsBusinessDay(monday, rules))
}

test "Business weekday calculation supports negative epoch days" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    // 1969-12-31 is Wednesday.
    let wednesday := new date(int32(-1))

    // 1969-12-27 is Saturday.
    let saturday := new date(int32(-5))

    testing.Expect(try IsBusinessDay(wednesday, rules))
    testing.Expect(!(try IsBusinessDay(saturday, rules)))
}

test "Following moves Saturday to Monday" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    let original := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let result := try AdjustBusinessDay(
        original, rules, BusinessDayAdjustment.Following,
    )

    testing.Expect(try _matchesGregorianDate(
        result, 2026, 6, 29,
    ))
}

test "Preceding moves Sunday to Friday" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    let original := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(28),
