/** Unicode simple titlecase mapping of a scalar; unmapped scalars map to themselves. Rules: rules/library/core-library.md §11.3. */
fn _UnicodeSimpleTitle(ch: rune) rune {
    let mut low: uint := 0
    let mut high: uint := _unicodeCaseTitleStrides.Len
    while low < high {
        let middle := low + (high - low) / 2
        if ch > _unicodeCaseTitleRanges[2 * middle + 1] {
            low = middle + 1
        } else if ch < _unicodeCaseTitleRanges[2 * middle] {
            high = middle
        } else {
            let offset := uint(ch) - uint(_unicodeCaseTitleRanges[2 * middle])
            if offset % _unicodeCaseTitleStrides[middle] != 0 {
                return ch
            }
            return try rune(int(ch) + _unicodeCaseTitleDeltas[middle]) {
                Err(_) => ch
            }
        }
    }
    return ch
}
