module main

type Counter struct { current: int }
impl Counter implements Iterator[int] {
    fn Next() Option[int] {
        self.current += 1
        return Some(self.current)
    }
}

fn Pull[T: Iterator[int]](value: ref mut T) Option[int] {
    return value.Next()
}

fn Require[T: Iterator[int]](value: T) void { discard value }

fn Loop() void {
    let mut counter := Counter{}
    Require(counter)
    for value in counter { let typed: int := value }
}
