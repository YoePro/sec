module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

type Lost union error {
    Gone(Handle),
    Other,
}

fn Fail(id: int) Result[int, Lost] {
    return Err(Lost.Gone(Make(id)))
}

fn T() int {
    let number := try Fail(1) {
        Err(Lost.Gone(handle)) where handle.id > 0 => {
            return handle.id
        }
        Err(_) => {
            return 0
        }
    }
    return number
}
