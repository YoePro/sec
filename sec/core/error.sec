module core

enum OverflowError error {
    Overflow,
}

enum DivisionByZeroError error {
    DivisionByZero,
}

enum RangeError error {
    InvalidRange,
    StartAfterEnd,
    OutOfBounds,
}

enum IndexError error {
    OutOfBounds,
}

enum PrecisionError error {
    PrecisionLoss,
    ScaleOverflow,
    PrecisionExhausted,
}

enum FormatError error {
    InvalidFormat,
    UnsupportedFormat,
    InvalidSpecifier,
    InvalidPrecision,
}

enum EncodingError error {
    InvalidEncoding,
    InvalidUtf8,
    InvalidCodePoint,
}

enum MathError error {
    DomainError,
    Overflow,
    Underflow,
    NotFinite,
}
