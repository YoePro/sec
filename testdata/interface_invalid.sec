module interfaces

// Every marked declaration in this file is expected to produce an interface or
// impl conformance diagnostic. Cases are kept independent to reduce cascades.

// =============================================================================
// Unknown and non-interface implementation targets
// =============================================================================

type UnknownInterfaceTarget struct {
}

impl UnknownInterfaceTarget implements DoesNotExist {
}

type OrdinaryContract struct {
}

type NonInterfaceTarget struct {
}

impl NonInterfaceTarget implements OrdinaryContract {
}

// =============================================================================
// Duplicate implemented interfaces
// =============================================================================

interface DuplicateMarker {
}

type DuplicateImplementation struct {
}

impl DuplicateImplementation implements DuplicateMarker, DuplicateMarker {
}

// =============================================================================
// Missing methods
// =============================================================================

interface RequiresRun {
    fn Run() void
}

type MissingMethod struct {
}

impl MissingMethod implements RequiresRun {
}

interface RequiresStop {
    fn Stop() void
}

type WrongMethodName struct {
}

impl WrongMethodName implements RequiresStop {
    // ERROR: Halt does not satisfy Stop.
    fn Halt() void {
    }
}

// =============================================================================
// Receiver compatibility
// =============================================================================

interface RequiresSharedReceiver {
    fn Inspect() void
}

type MutableInsteadOfShared struct {
	value: int,
}

impl MutableInsteadOfShared implements RequiresSharedReceiver {
    // ERROR: Body analysis infers a mutable receiver, stronger than plain fn.
    fn Inspect() void {
		self.value = 1
    }
}

interface RequiresInstanceReceiver {
    fn Value() int
}

type StaticInsteadOfInstance struct {
}

impl StaticInsteadOfInstance implements RequiresInstanceReceiver {
    // ERROR: A static method does not satisfy an instance method requirement.
    static fn Value() int {
        return 0
    }
}

// =============================================================================
// Parameter count, order and type
// =============================================================================

interface RequiresOneParameter {
    fn Set(value: int) void
}

type MissingParameter struct {
}

impl MissingParameter implements RequiresOneParameter {
    // ERROR: Missing required int parameter.
    fn Set() void {
    }
}

type ExtraParameter struct {
}

impl ExtraParameter implements RequiresOneParameter {
    // ERROR: The implementation has one extra parameter.
    fn Set(value: int, extra: int) void {
    }
}

interface RequiresOrderedParameters {
    fn Configure(count: int, enabled: bool) void
}

type WrongParameterOrder struct {
}

impl WrongParameterOrder implements RequiresOrderedParameters {
    // ERROR: Parameter order and types do not match.
    fn Configure(enabled: bool, count: int) void {
    }
}

interface RequiresIntegerParameter {
    fn Accept(value: int) bool
}

type WrongParameterType struct {
}

impl WrongParameterType implements RequiresIntegerParameter {
    // ERROR: string is incompatible with int.
    fn Accept(value: string) bool {
        return false
    }
}

// =============================================================================
// Parameter ownership and mutability
// =============================================================================

type Buffer struct {
    value: int,
}

interface RequiresSharedParameter {
    fn Use(buffer: ref Buffer) void
}

type OwnedParameterInsteadOfReference struct {
}

impl OwnedParameterInsteadOfReference implements RequiresSharedParameter {
    // ERROR: Buffer does not match ref Buffer.
    fn Use(buffer: Buffer) void {
    }
}

interface RequiresMutableParameter {
    fn Update(buffer: ref mut Buffer) void
}

type SharedParameterInsteadOfMutable struct {
}

impl SharedParameterInsteadOfMutable implements RequiresMutableParameter {
    // ERROR: ref Buffer does not match ref mut Buffer.
    fn Update(buffer: ref Buffer) void {
    }
}

// =============================================================================
// Return type compatibility
// =============================================================================

interface RequiresIntegerResult {
    fn Measure() int
}

type WrongReturnType struct {
}

impl WrongReturnType implements RequiresIntegerResult {
    // ERROR: bool does not match int.
    fn Measure() bool {
        return false
    }
}

interface RequiresValueResult {
    fn Read() int
}

type VoidReturnInsteadOfValue struct {
}

impl VoidReturnInsteadOfValue implements RequiresValueResult {
    // ERROR: void does not match int.
    fn Read() void {
    }
}

// =============================================================================
// Missing and incompatible properties
// =============================================================================

interface RequiresNameProperty {
    property Name: string {
        get
    }
}

type MissingProperty struct {
    _name: string,
}

impl MissingProperty implements RequiresNameProperty {
}

// A stored field does not satisfy a property requirement.
type FieldInsteadOfProperty struct {
    Name: string,
}

impl FieldInsteadOfProperty implements RequiresNameProperty {
}

interface RequiresIntegerProperty {
    property Value: int {
        get
    }
}

type WrongPropertyType struct {
    _value: string,
}

impl WrongPropertyType implements RequiresIntegerProperty {
    // ERROR: Property type string does not match int.
    property Value: string {
        get {
            return _value
        }
    }
}

interface RequiresReadableProperty {
    property Value: int {
        get
    }
}

type SetterOnlyProperty struct {
    _value: int,
}

impl SetterOnlyProperty implements RequiresReadableProperty {
    // ERROR: The required getter is missing.
    property Value: int {
        set value {
            _value = value
        }
    }
}

interface RequiresReadWriteProperty {
    property Value: int {
        get
        set value
    }
}

type GetterOnlyProperty struct {
    _value: int,
}

impl GetterOnlyProperty implements RequiresReadWriteProperty {
    // ERROR: The required setter is missing.
    property Value: int {
        get {
            return _value
        }
    }
}

// =============================================================================
// Missing inherited requirements
// =============================================================================

interface BaseRead {
    fn Read() int
}

interface DerivedRead implements BaseRead {
    fn Revision() int
}

type MissingInheritedMethod struct {
}

impl MissingInheritedMethod implements DerivedRead {
    // ERROR: Read inherited from BaseRead is missing.
    fn Revision() int {
        return 1
    }
}

interface FirstLevel {
    fn First() int
}

interface SecondLevel implements FirstLevel {
    fn Second() int
}

interface ThirdLevel implements SecondLevel {
    fn Third() int
}

type MissingDeepRequirement struct {
}

impl MissingDeepRequirement implements ThirdLevel {
    fn Second() int {
        return 2
    }

    fn Third() int {
        return 3
    }

    // ERROR: First is still required through two inheritance levels.
}

// =============================================================================
// Invalid inherited targets
// =============================================================================

interface UnknownBase implements MissingBase {
}

type NotAnInterface struct {
}

interface NonInterfaceBase implements NotAnInterface {
}

interface RepeatedBase {
}

interface DuplicateInheritedInterface implements RepeatedBase, RepeatedBase {
}

// =============================================================================
// Interface inheritance cycles
// =============================================================================

// ERROR S1012: An interface cannot inherit from itself.
interface SelfInheritanceCycle implements SelfInheritanceCycle {
}

// ERROR S1012: These interfaces form a direct inheritance cycle.
interface DirectCycleLeft implements DirectCycleRight {
}

interface DirectCycleRight implements DirectCycleLeft {
}

// ERROR S1012: The complete indirect cycle is reported on the edge that closes
// it: IndirectCycleFirst -> IndirectCycleSecond -> IndirectCycleThird ->
// IndirectCycleFirst.
interface IndirectCycleFirst implements IndirectCycleSecond {
}

interface IndirectCycleSecond implements IndirectCycleThird {
}

interface IndirectCycleThird implements IndirectCycleFirst {
}

// =============================================================================
// Incompatible duplicate inherited requirements
// =============================================================================

interface IntegerState {
    fn State() int
}

interface BooleanState {
    fn State() bool
}

// ERROR: The inherited State declarations are incompatible.
interface ConflictingState implements IntegerState, BooleanState {
}

interface ReadOnlyCode {
    property Code: int {
        get
    }
}

interface StringCode {
    property Code: string {
        get
    }
}

// ERROR: The inherited Code property types are incompatible.
interface ConflictingCode implements ReadOnlyCode, StringCode {
}

// =============================================================================
// Duplicate and conflicting members inside one interface
// =============================================================================

interface DuplicateMethodRequirement {
    fn Execute() void
    // ERROR: Duplicate method requirement.
    fn Execute() void
}

interface DuplicatePropertyRequirement {
    property Name: string {
        get
    }

    // ERROR: Duplicate property requirement.
    property Name: string {
        get
    }
}

interface MethodPropertyConflict {
    fn Value() int

    // ERROR: A property and method cannot share the same member name.
    property Value: int {
        get
    }
}

// =============================================================================
// Ordinary impl blocks cannot target interfaces
// =============================================================================

interface ContractOnly {
    fn Execute() void
}

// ERROR: An interface is not a valid ordinary impl target.
impl ContractOnly {
    fn Execute() void {
    }
}
