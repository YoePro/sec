#target(os: "linux", arch: "any")
module linux

import "platform/linux/amd64"

let OpenReadOnlyFlag := 0
let OpenWriteOnlyFlag := 1
let OpenReadWriteFlag := 2
let OpenCreateFlag := 64
let OpenTruncateFlag := 512
let OpenAppendFlag := 1024
let OpenDirectoryFlag := 65536
let OpenCloseOnExecFlag := 524288
let DefaultFilePermissions := 438 // 0666, filtered by the process umask.

/**
 * Converts the positive errno payload from a failed Linux syscall into the
 * platform error carrier. rules/declarations/enums.md section 12.3 makes a
 * runtime integer-to-closed-enum conversion fallible, so an errno not present
 * in the declared table is handled locally and conservatively becomes ioError.
 */
fn _linuxError(errno: int) LinuxError {
    let fallback := LinuxError.ioError
    return try LinuxError(errno) {
        Err(_) => fallback
    }
}

fn _copyPath(path: string, destination: ref mut byte[]) Result[uint, LinuxError] {
    if path.Len + 1u > destination.Len {
        return Err(LinuxError.nameTooLong)
    }

    let mut index := 0
    while index < int(path.Len) {
        unsafe {
            let value := path.Ptr.Offset(index).Read()
            if value == 0 {
                return Err(LinuxError.invalidArg)
            }
            destination[index] = value
        }
        index += 1
    }
    destination[index] = 0
    return Ok(uint(index))
}

fn Open(path: string, flags: int, permissions: int) Result[int, LinuxError] {
    let mut encodedPath: byte[4096]
    match _copyPath(path, ref mut encodedPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.Open),
            uint(encodedPath[0].Ptr),
            uint(flags),
            uint(permissions),
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(result)
    }
}

fn OpenReadOnly(path: string) Result[int, LinuxError] {
    match Open(path, OpenReadOnlyFlag | OpenCloseOnExecFlag, 0) {
        Ok(fd) => return Ok(fd)
        Err(error) => return Err(error)
    }
}

fn OpenWriteOnly(path: string, create: bool, truncate: bool, append: bool) Result[int, LinuxError] {
    let mut flags := OpenWriteOnlyFlag | OpenCloseOnExecFlag
    if create {
        flags |= OpenCreateFlag
    }
    if truncate {
        flags |= OpenTruncateFlag
    }
    if append {
        flags |= OpenAppendFlag
    }
    match Open(path, flags, DefaultFilePermissions) {
        Ok(fd) => return Ok(fd)
        Err(error) => return Err(error)
    }
}

fn OpenReadWrite(path: string, create: bool) Result[int, LinuxError] {
    let mut flags := OpenReadWriteFlag | OpenCloseOnExecFlag
    if create {
        flags |= OpenCreateFlag
    }
    match Open(path, flags, DefaultFilePermissions) {
        Ok(fd) => return Ok(fd)
        Err(error) => return Err(error)
    }
}

fn OpenDirectory(path: string) Result[int, LinuxError] {
    match Open(path, OpenReadOnlyFlag | OpenDirectoryFlag | OpenCloseOnExecFlag, 0) {
        Ok(fd) => return Ok(fd)
        Err(error) => return Err(error)
    }
}

fn Read(fd: int, data: ref mut byte[]) Result[uint, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.Read),
            uint(fd),
            uint(data.Ptr),
            data.Len,
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(uint(result))
    }
}

fn Write(fd: int, data: ref byte[]) Result[uint, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.Write),
            uint(fd),
            uint(data.Ptr),
            data.Len,
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(uint(result))
    }
}

fn WriteString(fd: int, data: string) Result[uint, LinuxError] {
    match WriteStringFrom(fd, data, 0u) {
        Ok(count) => return Ok(count)
        Err(error) => return Err(error)
    }
}

fn WriteStringFrom(fd: int, data: string, offset: uint) Result[uint, LinuxError] {
    if offset > data.Len {
        return Err(LinuxError.invalidArg)
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.Write),
            uint(fd),
            uint(data.Ptr.Offset(int(offset))),
            data.Len - offset,
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(uint(result))
    }
}

fn Seek(fd: int, offset: int, origin: int) Result[uint, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysLseek),
            uint(fd),
            uint(offset),
            uint(origin),
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(uint(result))
    }
}

fn Flush(fd: int) Result[void, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(uint(amd64.SysCall.sysFsync), uint(fd))
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn ReadDirectory(fd: int, data: ref mut byte[]) Result[uint, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysGetdents64),
            uint(fd),
            uint(data.Ptr),
            data.Len,
        )

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok(uint(result))
    }
}

fn Access(path: string, mode: int) Result[void, LinuxError] {
    let mut encodedPath: byte[4096]
    match _copyPath(path, ref mut encodedPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysAccess),
            uint(encodedPath[0].Ptr),
            uint(mode),
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn CreateDirectory(path: string, permissions: int) Result[void, LinuxError] {
    let mut encodedPath: byte[4096]
    match _copyPath(path, ref mut encodedPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysMkdir),
            uint(encodedPath[0].Ptr),
            uint(permissions),
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn RemoveFile(path: string) Result[void, LinuxError] {
    let mut encodedPath: byte[4096]
    match _copyPath(path, ref mut encodedPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysUnlink),
            uint(encodedPath[0].Ptr),
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn RemoveDirectory(path: string) Result[void, LinuxError] {
    let mut encodedPath: byte[4096]
    match _copyPath(path, ref mut encodedPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysRmdir),
            uint(encodedPath[0].Ptr),
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn Rename(oldPath: string, newPath: string) Result[void, LinuxError] {
    let mut encodedOldPath: byte[4096]
    let mut encodedNewPath: byte[4096]
    match _copyPath(oldPath, ref mut encodedOldPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }
    match _copyPath(newPath, ref mut encodedNewPath[..]) {
        Err(error) => return Err(error)
        Ok(_) => { }
    }

    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysRename),
            uint(encodedOldPath[0].Ptr),
            uint(encodedNewPath[0].Ptr),
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn Truncate(fd: int, size: uint) Result[void, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(
            uint(amd64.SysCall.sysFtruncate),
            uint(fd),
            size,
        )
        if result < 0 {
            return Err(_linuxError(-result))
        }
        return Ok()
    }
}

fn Close(fd: int) Result[void, LinuxError] {
    unsafe {
        let result := amd64.RawSyscall(uint(amd64.SysCall.Close), uint(fd))

        if result < 0 {
            return Err(_linuxError(-result))
        }

        return Ok()
    }
}

let STDIN := 0i
let STDOUT := 1i
let STDERR := 2i
