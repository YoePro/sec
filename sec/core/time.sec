module core

type time struct {
    _nanosecondsSinceMidnight: uint64,
}

unit h uint physical

type HourOfDay uint<h> range 0..23

impl time {

    enum Format {
        HHMM,          // 15:04
        HHMMSS,        // 15:04:05
        HHMMSSNano,    // 15:04:05.999999999
    }

    // Internt / lågnivå
    init(nanosecondsSinceMidnight: uint64) TimeError {
        if nanosecondsSinceMidnight >= 86400000000000 {
            return Err(TimeError.OutOfRange)
        }
        self._nanosecondsSinceMidnight = nanosecondsSinceMidnight
    }

    // Vanlig konstruktion
    init(hour: int, minute: int, second: int) TimeError {
        if hour not in 0..23 || minute not in 0..59 || second not in 0..59 {
            return Err(TimeError.OutOfRange)
        }

        let ns := uint64(hour) * 3600000000000 +  uint64(minute) * 60000000000 + uint64(second) * 1000000000
        self._nanosecondsSinceMidnight = ns
    }

    init(hour: int, minute: int, second: int, nanosecond: int) TimeError {
        if hour not in 0..23 || minute not in 0..59 || second not in 0..59 || nanosecond not in 0..999999999 {
            return Err(TimeError.OutOfRange)
        }

        let ns := uint64(hour) * 3600000000000 +  uint64(minute) * 60000000000 + uint64(second) * 1000000000 + uint64(nanosecond)
        self._nanosecondsSinceMidnight = ns
    }

    static property Now: time {
        get {
            let now: datetime := _now
            return time { _nanosecondsSinceMidnight: now._nanosecondsSinceMidnight }
        }
    }

    static property Hour: int {
        get {
            return 0
        }
    }

    static property Minute: int {
        get {
            return 0
        }
    }

    static property Second: int {
        get {
            return 0
        }
    }

    static property Nanosecond: int {
        get {
            return 0
        }
    }

    fn ToString(format: datetime.Format) string {
        return ""
    }

    fn ToString(layout: string) string {
        return ""
    }

    fn FromNanosecondsSinceMidnight(ns: uint64) Result[time, TimeError] {
        if ns >= 86_400_000_000_000 {
            return Err(TimeError.OutOfRange)
        }
        return Ok(time { _nanosecondsSinceMidnight: ns })
    }

    fn FromHMS(hour: int, minute: int, second: int) Result[time, TimeError] {
        // TODO: validera 0–23, 0–59, 0–59 + räkna om till ns
        return Ok(time { _nanosecondsSinceMidnight: 0 })
    }

    // fn FromHMSNano(hour: int, minute: int, second: int, nano: int) Result[time, TimeError] {
    // // ...
    // }

}
