module main

fn NestedAccess() int {
    let mut values := [1, 2, 3, 4]
    let parent := ref mut values[..]
    let child := ref mut parent[1..<3]
    let nested := ref mut child[..]
    nested[0] = 9
    let result := nested[0]
    discard nested
    let shared := ref child[..]
    let observed := shared[0]
    discard shared
    discard child
    discard parent
    return result + observed
}
