module main

@noPanic
fn Signed128(values: int128[4], start: int128, finish: uint128, index: int256) uint {
    let full := ref values[..]
    let first := full[0]
    discard full
    let empty := ref values[4..<4]
    let emptyCount := empty.Len
    discard empty
    let dynamic := try ref values[start..finish] {
        Err(_) => return emptyCount
    }
    let child := ref dynamic[..]
    let picked := try child[index] {
        Err(_) => first
    }
    discard picked
    discard first
    let count := len(child)
    discard child
    discard dynamic
    return count
}

@noPanic
fn Signed256(values: int256[4], start: int256, finish: uint256, index: uint128) uint {
    let mut storage := values
    let full := ref mut storage[..]
    let first := full[0]
    full[0] = first
    discard full
    let empty := ref storage[4..<4]
    let emptyCount := empty.Len
    discard empty
    let dynamic := try ref storage[start..finish] {
        Err(_) => return emptyCount
    }
    let child := ref dynamic[..]
    let picked := try child[index] {
        Err(_) => first
    }
    discard picked
    discard first
    let count := len(child)
    discard child
    discard dynamic
    return count
}

