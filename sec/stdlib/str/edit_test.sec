module str

/*
 * Sec Standard Library - str - Immutable rune-range editing tests
 *
 * File:        stdlib/str/edit_test.sec
 * Module:      str
 * Revision:    2
 * Updated:     2026-11-17
 *
 * Purpose:
 * Tests immutable insertion, deletion, and replacement at rune indexes
 * (MD-090), including multibyte runes, combining runes, empty ranges,
 * error variants and their precedence. Rune Len and byte SizeOf are never
 * conflated.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md § 11
 */


// Insert(string): beginning, middle, end, empty input and multibyte runes.

test "Insert string at beginning" {
    let result := try Insert("abc", 0, "X")
    testing.ExpectEqual("Xabc", result)
}

test "Insert string in middle" {
    let result := try Insert("abc", 1, "XYZ")
    testing.ExpectEqual("aXYZbc", result)
}

test "Insert string at end" {
    let result := try Insert("abc", 3, "!")
    testing.ExpectEqual("abc!", result)
}

test "Insert string into empty input" {
    let result := try Insert("", 0, "Text")
    testing.ExpectEqual("Text", result)
}

test "Insert empty string leaves content unchanged" {
    let result := try Insert("abc", 1, "")
    testing.ExpectEqual("abc", result)
}

test "Insert empty string at end leaves content unchanged" {
    let result := try Insert("abc", 3, "")
    testing.ExpectEqual("abc", result)
}

test "Insert before multibyte rune using rune index" {
    let result := try Insert("AåB", 1, "!")
    testing.ExpectEqual("A!åB", result)
}

test "Insert after multibyte rune using rune index" {
    let result := try Insert("AåB", 2, "!")
    testing.ExpectEqual("Aå!B", result)
}

test "Insert at end of multibyte text uses rune Len" {
    let result := try Insert("AåB", 3, "!")
    testing.ExpectEqual("AåB!", result)
}

test "Insert between emoji and suffix" {
    let result := try Insert("A🦊B", 2, ":")
    testing.ExpectEqual("A🦊:B", result)
}

test "Insert between base and combining rune without normalization" {
    let result := try Insert("é", 1, "X")
    testing.ExpectEqual("eX́", result)
}

test "Insert at an IndexOf result" {
    let text := "AåB"
    let position := match text.IndexOf("B") {
        Some(index) => index
        None => 0
    }
    let result := try Insert(text, position, "!")
    testing.ExpectEqual("Aå!B", result)
}

test "Insert string rejects rune index beyond Len" {
    try Insert("AåB", 4, "!") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "Insert string does not accept a byte SizeOf as an index" {
    try Insert("A🦊B", 6, "!") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(6, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "Insert string rejects invalid index even if insertion empty" {
    try Insert("AåB", 4, "") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "Insert string rejects nonzero index into empty input" {
    try Insert("", 1, "X") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(1, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}


// Insert(rune): direct rune encoding at rune indexes.

test "Insert ASCII rune at beginning" {
    let result := try Insert("abc", 0, 88r)
    testing.ExpectEqual("Xabc", result)
}

test "Insert two-byte rune in middle" {
    let result := try Insert("AB", 1, 229r)
    testing.ExpectEqual("AåB", result)
}

test "Insert three-byte rune in middle" {
    let result := try Insert("AB", 1, 8364r)
    testing.ExpectEqual("A€B", result)
}

test "Insert four-byte rune in middle" {
    let result := try Insert("AB", 1, 129418r)
    testing.ExpectEqual("A🦊B", result)
}

test "Insert rune into empty input" {
    let result := try Insert("", 0, 129418r)
    testing.ExpectEqual("🦊", result)
}

test "Insert rune at end" {
    let result := try Insert("abc", 3, 88r)
    testing.ExpectEqual("abcX", result)
}

test "Insert rune after two-byte rune" {
    let result := try Insert("AåB", 2, 88r)
    testing.ExpectEqual("AåXB", result)
}

test "Insert rune rejects rune index beyond Len" {
    try Insert("A🦊B", 4, 88r) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}


// RemoveRange: rune ranges, multibyte runes, empty ranges and errors.

test "RemoveRange removes middle runes" {
    let result := try RemoveRange("abcdef", 2, 4)
    testing.ExpectEqual("abef", result)
}

test "RemoveRange removes prefix" {
    let result := try RemoveRange("abcdef", 0, 2)
    testing.ExpectEqual("cdef", result)
}

test "RemoveRange removes suffix" {
    let result := try RemoveRange("abcdef", 4, 6)
    testing.ExpectEqual("abcd", result)
}

test "RemoveRange removes complete content" {
    let result := try RemoveRange("abc", 0, 3)
    testing.ExpectEqual("", result)
}

test "RemoveRange removes complete multibyte content by rune Len" {
    let result := try RemoveRange("A🦊B", 0, 3)
    testing.ExpectEqual("", result)
}

test "RemoveRange leaves an empty middle interval unchanged" {
    let result := try RemoveRange("abc", 1, 1)
    testing.ExpectEqual("abc", result)
}

test "RemoveRange leaves an empty interval at end unchanged" {
    let result := try RemoveRange("abc", 3, 3)
    testing.ExpectEqual("abc", result)
}

test "RemoveRange leaves an empty source unchanged" {
    let result := try RemoveRange("", 0, 0)
    testing.ExpectEqual("", result)
}

test "Remove full two-byte rune using rune indexes" {
    let result := try RemoveRange("AåB", 1, 2)
    testing.ExpectEqual("AB", result)
}

test "Remove full three-byte rune using rune indexes" {
    let result := try RemoveRange("A€B", 1, 2)
    testing.ExpectEqual("AB", result)
}

test "Remove full multibyte rune using rune indexes" {
    let result := try RemoveRange("A🦊B", 1, 2)
    testing.ExpectEqual("AB", result)
}

test "RemoveRange removes a combining rune without normalization" {
    let result := try RemoveRange("é", 1, 2)
    testing.ExpectEqual("e", result)
}

test "RemoveRange rejects reversed range" {
    try RemoveRange("abc", 2, 1) {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "RemoveRange prioritizes reversed range over out of bounds" {
    try RemoveRange("abc", 9, 8) {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "RemoveRange rejects end beyond rune Len" {
    try RemoveRange("AåB", 1, 4) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "RemoveRange validates an empty range beyond rune Len" {
    try RemoveRange("abc", 4, 4) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}


// ReplaceRange: shorter, equal and longer replacements at rune ranges.

test "ReplaceRange with shorter text" {
    let result := try ReplaceRange("abcdef", 1, 5, "X")
    testing.ExpectEqual("aXf", result)
}

test "ReplaceRange with equal-length text" {
    let result := try ReplaceRange("abcdef", 1, 3, "XY")
    testing.ExpectEqual("aXYdef", result)
}

test "ReplaceRange with longer text" {
    let result := try ReplaceRange("abc", 1, 2, "XYZ")
    testing.ExpectEqual("aXYZc", result)
}

test "ReplaceRange inserts with an empty range" {
    let result := try ReplaceRange("abc", 1, 1, "X")
    testing.ExpectEqual("aXbc", result)
}

test "ReplaceRange removes with an empty replacement" {
    let result := try ReplaceRange("abc", 1, 2, "")
    testing.ExpectEqual("ac", result)
}

test "ReplaceRange leaves an empty edit unchanged" {
    let result := try ReplaceRange("abc", 1, 1, "")
    testing.ExpectEqual("abc", result)
}

test "ReplaceRange replaces a two-byte rune by rune index" {
    let result := try ReplaceRange("AåB", 1, 2, "a")
    testing.ExpectEqual("AaB", result)
}

test "ReplaceRange replaces a three-byte rune by rune index" {
    let result := try ReplaceRange("A€B", 1, 2, "E")
    testing.ExpectEqual("AEB", result)
}

test "ReplaceRange replaces a four-byte rune by rune index" {
    let result := try ReplaceRange("A🦊B", 1, 2, "fox")
    testing.ExpectEqual("AfoxB", result)
}

test "ReplaceRange replaces complete multibyte content" {
    let result := try ReplaceRange("A🦊B", 0, 3, "x")
    testing.ExpectEqual("x", result)
}

test "ReplaceRange rejects reversed range" {
    try ReplaceRange("abc", 2, 1, "X") {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "ReplaceRange prioritizes reversed range over out of bounds" {
    try ReplaceRange("abc", 9, 8, "X") {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "ReplaceRange rejects out of bounds end" {
    try ReplaceRange("abc", 1, 5, "X") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(5, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "ReplaceRange rejects a byte SizeOf end on multibyte text" {
    try ReplaceRange("AåB", 1, 4, "X") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "ReplaceRange validates empty edit beyond rune Len" {
    try ReplaceRange("abc", 4, 4, "") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}


// The source is unchanged by a failed or a successful edit.
test "Edits leave the source unchanged" {
    let source := "AåB"
    let edited := try ReplaceRange(source, 0, 3, "x")
    testing.ExpectEqual("x", edited)
    testing.ExpectEqual("AåB", source)
    try RemoveRange(source, 2, 1) {
        Err(EditError.StartAfterEnd) => {
            testing.ExpectEqual("AåB", source)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}
