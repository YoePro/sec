module main

static let mut Trace: int := 0

fn Mark(value: int) int {
    Trace = Trace * 10 + value
    return value
}

fn PairSource() int[2] {
    discard Mark(2)
    return [2, 3]
}

fn EmptySource() int[0] {
    discard Mark(9)
    return []
}

fn Four(a: int, b: int, c: int, d: int) int {
    return a * 1000 + b * 100 + c * 10 + d
}

fn One(value: int) int { return value }
fn Consume(-> first: int, -> second: int) int { return first + second }
fn Pick(first: int, second: int) int { return second }
fn Pick(first: int, second: int, third: int) int { return third }
fn Generic[T](first: T, second: T) T { return first }

fn main() int {
    if Four(Mark(1), PairSource()..., Mark(4)) != 1234 { return 1 }
    if Trace != 124 { return 2 }
    Trace = 0
    if Four(PairSource()..., PairSource()...) != 2323 { return 3 }
    if Trace != 22 { return 4 }
    Trace = 0
    if One(EmptySource()..., Mark(5)) != 5 { return 5 }
    if Trace != 95 { return 6 }
    let values: int[2] := [2, 3]
    if Consume(values...) != 5 { return 7 }
    if values[0] != 2 || values[1] != 3 { return 8 }
    if Pick(values...) != 3 { return 9 }
    if Generic[int](values...) != 2 { return 10 }
    return 0
}
