enum RouterError error {
    InvalidPattern,
    DuplicateRoute,
    ConflictingRoute,
}

type RouteParam struct {
    Name: string,
    Value: string,
}

type RouteParams struct {
    Values: RouteParam[],
}

@noCopy
type Router struct {
    // Private route table and owned handlers.
}

impl Router {
    // TODO: Implement http.Router.Handle
    fn Handle(method: Method, pattern: string, ->handler:  Handler) Result[void, RouterError] {
        return Err(RouterError.InvalidPattern)
    }

    // TODO: Implement http.Router.HandleAny
    fn HandleAny(pattern: string, ->handler: Handler) Result[void, RouterError] {
        return Err(RouterError.InvalidPattern)
    }

}
