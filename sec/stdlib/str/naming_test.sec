module str

/*
 * Sec Standard Library - str - Naming conversion tests
 *
 * File:        stdlib/str/naming_test.sec
 * Module:      str
 * Revision:    1
 * Updated:     2026-10-17
 *
 * Purpose:
 * Verify naming convention transformations, acronym boundaries,
 * digits, repeated separators, Unicode preservation, configurable
 * delimiters, and consistency between specialized conversions.
 *
 * Contract:
 * Acronyms are split structurally, without a known-acronym table.
 * The final uppercase rune before a lowercase rune starts a word.
 * Only ASCII '_' and '-' plus core rune whitespace are separators.
 * Unicode case mapping follows the available core implementation.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 *
 * Note:
 * This file specifies expected behavior. It has not been executed.
 */

// ToSnakeCase: conversion and boundary regression tests.

test "ToSnakeCase empty input" {
    let result := try ToSnakeCase("")
    testing.ExpectEqual("", result)
}

test "ToSnakeCase single lowercase word" {
    let result := try ToSnakeCase("hello")
    testing.ExpectEqual("hello", result)
}

test "ToSnakeCase single uppercase word" {
    let result := try ToSnakeCase("HELLO")
    testing.ExpectEqual("hello", result)
}

test "ToSnakeCase simple PascalCase" {
    let result := try ToSnakeCase("HelloWorld")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase simple camelCase" {
    let result := try ToSnakeCase("helloWorld")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase HTTP acronym" {
    let result := try ToSnakeCase("HTTPServer")
    testing.ExpectEqual("http_server", result)
}

test "ToSnakeCase XML acronym" {
    let result := try ToSnakeCase("XMLParser")
    testing.ExpectEqual("xml_parser", result)
}

test "ToSnakeCase acronym inside name" {
    let result := try ToSnakeCase("parseHTTPResponse")
    testing.ExpectEqual("parse_http_response", result)
}

test "ToSnakeCase camelCase ending in acronym" {
    let result := try ToSnakeCase("userID")
    testing.ExpectEqual("user_id", result)
}

test "ToSnakeCase adjacent acronyms without a dictionary" {
    let result := try ToSnakeCase("XMLHTTPRequest")
    testing.ExpectEqual("xmlhttp_request", result)
}

test "ToSnakeCase all capitals without a lowercase suffix" {
    let result := try ToSnakeCase("HTTP")
    testing.ExpectEqual("http", result)
}

test "ToSnakeCase two capitals and a lowercase suffix" {
    let result := try ToSnakeCase("ABc")
    testing.ExpectEqual("a_bc", result)
}

test "ToSnakeCase digits inside the first word" {
    let result := try ToSnakeCase("Version2Beta")
    testing.ExpectEqual("version2_beta", result)
}

test "ToSnakeCase digits following acronym" {
    let result := try ToSnakeCase("MyHTTP2Server")
    testing.ExpectEqual("my_http2_server", result)
}

test "ToSnakeCase digit before uppercase" {
    let result := try ToSnakeCase("a2B")
    testing.ExpectEqual("a2_b", result)
}

test "ToSnakeCase digit prefix before capitals" {
    let result := try ToSnakeCase("123ABC")
    testing.ExpectEqual("123_abc", result)
}

test "ToSnakeCase trailing digits" {
    let result := try ToSnakeCase("Server42")
    testing.ExpectEqual("server42", result)
}

test "ToSnakeCase underscore separated" {
    let result := try ToSnakeCase("hello_world")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase hyphen separated" {
    let result := try ToSnakeCase("hello-world")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase space separated" {
    let result := try ToSnakeCase("hello world")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase tabs as separators" {
    let result := try ToSnakeCase("hello\tworld")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase newlines as separators" {
    let result := try ToSnakeCase("hello\nworld")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase mixed repeated separators" {
    let result := try ToSnakeCase("hello--__  world")
    testing.ExpectEqual("hello_world", result)
}

test "ToSnakeCase leading and trailing separators" {
    let result := try ToSnakeCase("___hello---")
    testing.ExpectEqual("hello", result)
}

test "ToSnakeCase separators only" {
    let result := try ToSnakeCase("_-_  _")
    testing.ExpectEqual("", result)
}

test "ToSnakeCase Unicode lowercase retained" {
    let result := try ToSnakeCase("å🦊ö")
    testing.ExpectEqual("å🦊ö", result)
}

test "ToSnakeCase combining rune preserved" {
    let result := try ToSnakeCase("e\u{0301}clair")
    testing.ExpectEqual("e\u{0301}clair", result)
}

test "ToSnakeCase NUL in the name preserved" {
    let result := try ToSnakeCase("a\0b")
    testing.ExpectEqual("a\0b", result)
}

// ToCamelCase: conversion and boundary regression tests.

test "ToCamelCase empty input" {
    let result := try ToCamelCase("")
    testing.ExpectEqual("", result)
}

test "ToCamelCase single lowercase word" {
    let result := try ToCamelCase("hello")
    testing.ExpectEqual("hello", result)
}

test "ToCamelCase single uppercase word" {
    let result := try ToCamelCase("HELLO")
    testing.ExpectEqual("hello", result)
}

test "ToCamelCase PascalCase" {
    let result := try ToCamelCase("HelloWorld")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase already camelCase" {
    let result := try ToCamelCase("helloWorld")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase acronym leading" {
    let result := try ToCamelCase("HTTPServer")
    testing.ExpectEqual("httpServer", result)
}

test "ToCamelCase acronym trailing" {
    let result := try ToCamelCase("userID")
    testing.ExpectEqual("userId", result)
}

test "ToCamelCase acronym between words" {
    let result := try ToCamelCase("parseHTTPResponse")
    testing.ExpectEqual("parseHttpResponse", result)
}

test "ToCamelCase underscore" {
    let result := try ToCamelCase("hello_world")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase hyphen" {
    let result := try ToCamelCase("hello-world")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase spaces" {
    let result := try ToCamelCase("hello world")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase repeated separators" {
    let result := try ToCamelCase("__HELLO---WORLD__")
    testing.ExpectEqual("helloWorld", result)
}

test "ToCamelCase digit before capital" {
    let result := try ToCamelCase("Version2Beta")
    testing.ExpectEqual("version2Beta", result)
}

test "ToCamelCase digits within acronym" {
    let result := try ToCamelCase("MyHTTP2Server")
    testing.ExpectEqual("myHttp2Server", result)
}

test "ToCamelCase digits-only input" {
    let result := try ToCamelCase("123")
    testing.ExpectEqual("123", result)
}

test "ToCamelCase no word characters" {
    let result := try ToCamelCase("")
    testing.ExpectEqual("", result)
}

test "ToCamelCase Unicode rune inside word preserved" {
    let result := try ToCamelCase("a🦊b")
    testing.ExpectEqual("a🦊b", result)
}

