module main

fn Fixed() void {
    let mut values := [1, 2, 3, 4]
    let all := ref values[..]
    discard all
    let inclusive := ref mut values[1..2]
    discard inclusive
    let view := ref values[1..<4]
    let tail := ref view[1..]
    discard tail
    let direct := ref values
    discard direct
}

fn Wide(values: int[8], start: int128, finish: uint256) void {
    let dynamic := ref values[start..<finish]
    discard dynamic
}

fn Slice(values: ref int[]) void {
    let unknown := ref values[..]
    discard unknown
}

fn Owner(values: int[]) void {
    let ownedView := ref values[1..<3]
    discard ownedView
}

fn Empty() void {
    let mut values: int[0]
    let empty := ref values[..]
    discard empty
}
