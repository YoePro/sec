    LongName: "Mole per Litre"
    Symbol: "mol/L"
    BaseUnit: false
    Status: active
    Dimension: [amount_of_substance^1, length^-3]
    Scale: 1000
    System: SI
}

/** Joule per kelvin */
unit J_K physical
impl J_K {
    LongName: "Joule per Kelvin"
    Symbol: "J/K"
    BaseUnit: false
    Status: active
    Dimension: [mass^1, length^2, time^-2, thermodynamic_temperature^-1]
    Scale: 1
    System: SI
}

/** Joule per kilogram kelvin */
unit J_kg_K physical
impl J_kg_K {
    LongName: "Joule per Kilogram Kelvin"
    Symbol: "J/(kg·K)"
    BaseUnit: false
    Status: active
    Dimension: [length^2, time^-2, thermodynamic_temperature^-1]
    Scale: 1
    System: SI
}

/** Watt per metre kelvin */
unit W_m_K physical
impl W_m_K {
    LongName: "Watt per Metre Kelvin"
    Symbol: "W/(m·K)"
    BaseUnit: false
    Status: active
    Dimension: [mass^1, length^1, time^-3, thermodynamic_temperature^-1]
    Scale: 1
    System: SI
}

/** Newton metre */
unit Nm physical
impl Nm {
    LongName: "Newton Metre"
    Symbol: "N·m"
    BaseUnit: false
    Status: active
    Dimension: [mass^1, length^2, time^-2]
    Scale: 1
    System: SI
}

/** Reciprocal metre */
unit per_m physical
impl per_m {
    LongName: "Reciprocal Metre"
    Symbol: "m⁻¹"
    BaseUnit: false
    Status: active
    Dimension: [length^-1]
    Scale: 1
    System: SI
}

