/** Reports whether ch is a Unicode letter. */
fn _UnicodeIsLetter(ch: rune) bool {
    if ch < 0r || ch > 0x10FFFFr {
        return false
    }

    if ch <= 0x007Fr {
        return ch in 0x0041r..0x005Ar || ch in 0x0061r..0x007Ar
    }

    let mut low := 0
    let mut high := 693
    while low <= high {
        let middle := low + (high - low) / 2
        let current := _unicodeLetterRanges[middle]

        if ch < current.start {
            high = middle - 1
            continue
        }
        if ch > current.end {
            low = middle + 1
            continue
        }

        return true
    }

    return false
}
