module core

type date struct {
    _epochDays: int32,
}

impl date {
    // int32

    enum Format {
        YYYYMMDD,                                    // 2006-01-02
        DDMMYYYY,                                    // 02-01-2006
        MMDDYYYY,                                    // 01-02-2006
        YYYYMMDDCompact,                             // 20060102
        DDMMYYYYCompact,                             // 02012006
        MMDDYYYYCompact,                             // 01022006
        YYYYMMDDSlash,                               // 2006/01/02
        DDMMYYYYSlash,                               // 02/01/2006
        MMDDYYYYSlash,                               // 01/02/2006
        YYYYMMDDDot,                                 // 2006.01.02
        DDMMYYYYDot,                                 // 02.01.2006
        MMDDYYYYDot,                                 // 01.02.2006
        YYYYMMDDSpace,                               // 2006 01 02
        DDMMYYYYSpace,                               // 02 01 2006
        MMDDYYYYSpace,                               // 01 02 2006
        YYYYMMDDHyphen,                              // 2006-01-02
        DDMMYYYYHyphen,                              // 02-01-2006
        MMDDYYYYHyphen,                              // 01-02-2006
        YYYYMMDDUnderscore,                          // 2006_01_02
        DDMMYYYYUnderscore,                          // 02_01_2006
        MMDDYYYYUnderscore,                          // 01_02_2006
        YYYYMonthDD,                                 // 2006-Jan-02
        DDMonthYYYY,                                 // 02-Jan-2006
        MonthDDYYYY,                                 // Jan-02-2006
        YYYYMonthDDCompact,                          // 2006Jan02
        DDMonthYYYYCompact,                          // 02Jan2006
        MonthDDYYYYCompact,                          // Jan022006
        YYYYMonthDDSlash,                            // 2006/Jan/02
        DDMonthYYYYSlash,                            // 02/Jan/2006
        MonthDDYYYYSlash,                            // Jan/02/2006
        YYYYMonthDDDot,                              // 2006.Jan.02
        DDMonthYYYYDot,                              // 02.Jan.2006
        MonthDDYYYYDot,                              // Jan.02.2006
        YYYYMonthDDSpace,                            // 2006 Jan 02
        DDMonthYYYYSpace,                            // 02 Jan 2006
        DDMonthYYYYLongSpace,                        // 02 January 2006
        DDMonthYYYYLongHyphen,                       // 02-January-2006
        DDMonthYYYYLongSlash,                        // 02/January/2006
        DDMonthYYYYLongDot,                          // 02.January.2006
        MonthDDYYYYSpace,                            // Jan 02 2006
        YYYYMonthDDHyphen,                           // 2006-Jan-02
        DDMonthYYYYHyphen,                           // 02-Jan-2006
        MonthDDYYYYHyphen,                           // Jan-02-2006
        YYYYMonthHyphen,                             // 2006-Jan
        MonthYYYYHyphen,                             // Jan-2006
        YYYYMONTHHyphen,                             // 2006-01
        MONTHYYYYHyphen,                             // 01-2006
        YYYYMONTHCompact,                            // 200601
        MONTHYYYYCompact,                            // 012006
        YYYY,                                        // 2006
        MM,                                          // 01
        DD,                                          // 02
        Month,                                       // Jan
        MONTH,                                       // 01
        MonthLong,                                   // January
        Week,                                        // 1
        WeekdayShort,                                // Mon
        WeekdayLong,                                 // Monday
        WeekdayNumeric,                              // 1 (Monday)
        WeekdayNumericSundayFirst,                   // 0 (Sunday)
        WeekdayNumericISO,                           // 1 (Monday)
        WeekdayNumericISOZeroBased,                  // 0 (Monday)
        WeekdayNumericISOOneBased,                   // 1 (Monday)
        WeekdayNumericISOZeroBasedSundayFirst,       // 0 (Sunday)
        WeekdayNumericISOOneBasedSundayFirst,        // 1 (Sunday)
        WeekdayNumericISOZeroBasedMondayFirst,       // 0 (Monday)
        WeekdayNumericISOOneBasedMondayFirst,        // 1 (Monday)
        WeekdayNumericISOZeroBasedTuesdayFirst,      // 0 (Tuesday)
        WeekdayNumericISOOneBasedTuesdayFirst,       // 1 (Tuesday)
        WeekdayNumericISOZeroBasedWednesdayFirst,    // 0 (Wednesday)
        WeekdayNumericISOOneBasedWednesdayFirst,     // 1 (Wednesday)
        WeekdayNumericISOZeroBasedThursdayFirst,     // 0 (Thursday)
        WeekdayNumericISOOneBasedThursdayFirst,      // 1 (Thursday)
        WeekdayNumericISOZeroBasedFridayFirst,       // 0 (Friday)
        WeekdayNumericISOOneBasedFridayFirst,        // 1 (Friday)
        WeekdayNumericISOZeroBasedSaturdayFirst,     // 0 (Saturday)
        WeekdayNumericISOOneBasedSaturdayFirst,      // 1 (Saturday)
        ISOWeek,                                     // 2006-W01
        ISOWeekCompact,                              // 2006W01
        ISOWeekHyphen,                               // 2006-W01
        ISOWeekSlash,                                // 2006/W01
        ISOWeekDot,                                  // 2006.W01
        ISOWeekSpace,                                // 2006 W01
        Quarter,                                     // Q1
        YYQuarter,                                   // 06Q1
        YYYYQuarter,                                 // 2006Q1
        QuarterYY,                                   // Q106
        QuarterYYYY,                                 // Q12006
        QuarterHyphen,                               // Q1-2006
        QuarterSlash,                                // Q1/2006
        QuarterDot,                                  // Q1.2006
        QuarterSpace,                                // Q1 2006
    }

    enum Weekdays {
        Sunday    = 0,
        Monday    = 1,
        Tuesday   = 2,
        Wednesday = 3,
        Thursday  = 4,
        Friday    = 5,
        Saturday  = 6,
    }

    type ISOWeeks struct {
        year: int,
        week: int,
    }

    init(epochDays: int32) {
        self._epochDays = epochDays
    }

    init(year: int, month: int, day: int) DateError {
        if month not in 1..12 {
            return Err(DateError.OutOfRange)
        }

        let daysInMonth := _daysInMonth(year, month)
        if day not in 1..daysInMonth {
            return Err(DateError.InvalidDate)
        }

        // Convert civil date to days since 1970-01-01 (Unix epoch)
        // Algorithm based on Howard Hinnant's date algorithms
        let mut y := year
        let mut m := month
        let d := day

        // Shift so March is month 0 (makes leap day handling easier)
        if m <= 2 {
            y = y - 1
        }
        m = (m + 9) % 12

        let mut era: int
        if y >= 0 {
            era = y / 400
        } else {
            era = (y - 399) / 400
        }

        let yoe := y - era * 400                                  // [0, 399]
        let doy := (153 * m + 2) / 5 + d - 1                      // [0, 365]
        let doe := yoe * 365 + yoe / 4 - yoe / 100 + doy          // [0, 146096]

        let epochDays := era * 146097 + doe - 719468

        // Check that the result fits in int32
        if epochDays < -2147483648 || epochDays > 2147483647 {
            return Err(DateError.OutOfRange)
        }

        self._epochDays = int32(epochDays)
    }

    fn ToString(format: Format) Result[string, StringError] {
        return Ok("")
    }

    fn ToString(layout: string) Result[string, StringError] {
        return Ok("")
    }

    fn FromEpochDays(days: int32) date {
        return date { _epochDays: days }
    }

    fn FromYMD(year: int, month: int, day: int) Result[date, DateError] {
        // TODO: validera + räkna om till epochDays
        // let days := /* beräkning */
        return Ok(date { _epochDays: int32(day) })
    }

    static property Year: int {           // 1–9999
        get {
            return 0
        }
    }

    static property Month: int {          // 1–12
        get {
            return 0
        }
    }

    static property Day: int {            // 1–31
        get {
            return 0
        }
    }

    property DayOfYear: int {
        get {
            return 0
        }
    }

    property Weekday: Weekdays {    // enum
        get {
            return Weekdays.Sunday
        }
    }

    property ISOWeek: ISOWeeks {
        get {
            return ISOWeeks{ year: 0, week: 0 }
        }
    }

    static property Today: date {
        get {
            let now: datetime := _now
            return date { _epochDays: now._epochDays }
        }
    }

    // fn AddDays(n: int) date {
    // return new date{ year: 0, month: 0, day: 0 }
    // }
    // fn AddMonths(n: int) date {
    // return new date{ year: 0, month: 0, day: 0 }
    // }
    // fn AddYears(n: int) date {
    // return new date{ year: 0, month: 0, day: 0 }
    // }

    fn _HowardHinnant(year: int, month: int, day: int) int {
        // Shift so March is month 0 (makes leap day handling easier)
        if month <= 2 {
            year = year - 1
        }
        month = (month + 9) % 12

        let mut era: int
        if year >= 0 {
            era = year / 400
        } else {
            era = (year - 399) / 400
        }

        let yoe := year - era * 400                                  // [0, 399]
        let doy := (153 * month + 2) / 5 + day - 1                   // [0, 365]
        let doe := yoe * 365 + yoe / 4 - yoe / 100 + doy             // [0, 146096]

        return era * 146097 + doe - 719468
    }
}

// Helper (can live in the same module)
fn _daysInMonth(year: int, month: int) int {
    switch month {
        case 1, 3, 5, 7, 8, 10, 12:
            return 31
        case 4, 6, 9, 11:
            return 30
        case 2:
            if _isLeapYear(year) {
                return 29
            } else {
                return 28
            }
        default:
            return 0 // Invalid month
    }
}

fn _isLeapYear(year: int) bool {
    return (year % 4 == 0) && (year % 100 != 0 || year % 400 == 0)
}
