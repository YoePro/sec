module core

enum OverflowError error {
    Overflow,
}

enum DivisionByZeroError error {
    DivisionByZero,
}

enum DateError error {
    InvalidDate,
    OutOfRange,
}

enum TimeError error {
    InvalidTime,
    OutOfRange,
}

enum RangeError error {
    InvalidRange,
    StartAfterEnd,
    OutOfBounds,
}

enum IndexError error {
    OutOfBounds,
}

enum PrecisionError error {
    PrecisionLoss,
    ScaleOverflow,
    PrecisionExhausted,
}

enum FormatError error {
    InvalidFormat,
    UnsupportedFormat,
    InvalidSpecifier,
    InvalidPrecision,
}

enum EncodingError error {
    InvalidEncoding,
    InvalidUtf8,
    InvalidCodePoint,
}

enum MathError error {
    DomainError,
    Overflow,
    Underflow,
    NotFinite,
}

type StringError union error {
    InvalidUtf8(uint),
    InvalidCodePoint,
    AllocationFailed,
    OutOfBounds,
}
