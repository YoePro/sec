module main

type Values union { Data(int[4]), Empty }
fn Direct(needle: int, values: int[4]) bool {
    return needle in ref values[..]
}
fn Stored(needle: int, values: int[4]) bool {
    let view := ref values[..]
    let present := needle not in view
    return present
}
fn InAggregate(needle: int, values: int[4]) bool[1] {
    return [needle in ref values[..]]
}
fn ArmScoped(needle: int, values: Values) bool {
    return match values {
        Values.Data(ref data) => needle in ref data[..]
        Values.Empty => false
    }
}
