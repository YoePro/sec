module http

@noCopy
type Body struct {
    // Private streaming source/decoder state.
}

impl Body {
    init(data: byte[]) {
        // TODO: Implement http.Body.init
    }

    static fn Empty() Body { return new Body() }

    // TODO: Implement http.Body.FromBytes()
    static fn FromBytes(->data: byte[]) Body {
        return new Body(<-data)
    }

    static fn FromString(text: string) Result[Body, BodyError]

    property Length: Option[uint64] { get { return 0u } }
    property Replayable: bool { get { return false } }

    fn Read(buffer: ref mut byte[]) Result[uint, BodyError]

    fn ReadAllToArray(limit: uint64) Result[byte[], BodyError]

    fn Close() Result[void, BodyError]
}
