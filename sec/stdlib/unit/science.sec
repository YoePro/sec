module units

// =============================================================================
// Photometry, radiation, chemistry, and additional coherent SI quantities
// =============================================================================

/** Becquerel */
unit Bq physical
impl Bq {
    LongName: "Becquerel"
    Symbol: "Bq"
    BaseUnit: false
    Status: active
    Dimension: [time^-1]
    Scale: 1
    System: SI
}

