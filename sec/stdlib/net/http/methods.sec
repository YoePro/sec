module http

/*
* Sec Standard Library - HTTP Methods
*
* File:        stdlib/net/http/methods.sec
* Module:      http
* Revision:    1
* Created:     2026-08-30
* Updated:     2026-08-30
* Author:      Jonas Engström
*
* Purpose:
*   Defines the HTTP Method type and the well-known HTTP methods used by
*   the Sec standard library.
*
*   HTTP method names are case-sensitive tokens on the wire. Method is
*   therefore represented as a nominal string type rather than a closed
*   enum, allowing standard, extension, vendor-specific, and future methods
*   to remain representable.
*
*   Well-known methods registered by IANA are exposed as type-associated
*   static values, for example:
*
*       http.Method.GET
*       http.Method.POST
*       http.Method.PATCH
*
*   Unknown extension methods preserve their original wire representation.
*
*   FromString() recognizes known methods and returns their canonical form.
*   Unknown methods are preserved unchanged.
*
*   ToString() returns the exact method token represented by the value.
*
* References:
*   - RFC 9110 - HTTP Semantics
*     https://www.rfc-editor.org/rfc/rfc9110
*
*   - RFC 5789 - PATCH Method for HTTP
*     https://www.rfc-editor.org/rfc/rfc5789
*
*   - IANA HTTP Method Registry
*     https://www.iana.org/assignments/http-methods/
*
* Notes:
*   The set of HTTP methods is intentionally not treated as closed.
*   Applications and protocols may define additional valid method tokens
*   without requiring changes to this file.
*/
type Method string

impl Method {
    // Core HTTP semantics - RFC 9110
    let GET: Method := "GET"
    let HEAD: Method := "HEAD"
    let POST: Method := "POST"
    let PUT: Method := "PUT"
    let DELETE: Method := "DELETE"
    let CONNECT: Method := "CONNECT"
    let OPTIONS: Method := "OPTIONS"
    let TRACE: Method := "TRACE"

    // RFC 5789
    let PATCH: Method := "PATCH"

    // WebDAV and extensions
    let ACL: Method := "ACL"
    let BASELINE_CONTROL: Method := "BASELINE-CONTROL"
    let BIND: Method := "BIND"
    let CHECKIN: Method := "CHECKIN"
    let CHECKOUT: Method := "CHECKOUT"
    let COPY: Method := "COPY"
    let LABEL: Method := "LABEL"
    let LINK: Method := "LINK"
    let LOCK: Method := "LOCK"
    let MERGE: Method := "MERGE"
    let MKACTIVITY: Method := "MKACTIVITY"
    let MKCALENDAR: Method := "MKCALENDAR"
    let MKCOL: Method := "MKCOL"
    let MKREDIRECTREF: Method := "MKREDIRECTREF"
    let MKWORKSPACE: Method := "MKWORKSPACE"
    let MOVE: Method := "MOVE"
    let ORDERPATCH: Method := "ORDERPATCH"
    let PROPFIND: Method := "PROPFIND"
    let PROPPATCH: Method := "PROPPATCH"
    let REBIND: Method := "REBIND"
    let REPORT: Method := "REPORT"
    let SEARCH: Method := "SEARCH"
    let UNBIND: Method := "UNBIND"
    let UNCHECKOUT: Method := "UNCHECKOUT"
    let UNLINK: Method := "UNLINK"
    let UNLOCK: Method := "UNLOCK"
    let UPDATE: Method := "UPDATE"
    let UPDATEREDIRECTREF: Method := "UPDATEREDIRECTREF"
    let VERSION_CONTROL: Method := "VERSION-CONTROL"

    // HTTP/2 connection preface
    let PRI: Method := "PRI"

    // RFC 10008
    let QUERY: Method := "QUERY"

    property IsSafe: Option[bool] { get { return None } }
    property IsIdempotent: Option[bool] { get { return None } }

    fn ToString() string {
        return string(self)
    }

    static fn FromString(In: string) Method {
        let normalized := In.ToLower()

        switch normalized {
            case "get":
                return Method.GET

            case "head":
                return Method.HEAD

            case "post":
                return Method.POST

            case "put":
                return Method.PUT

            case "delete":
                return Method.DELETE

            case "connect":
                return Method.CONNECT

            case "options":
                return Method.OPTIONS

            case "trace":
                return Method.TRACE

            case "patch":
                return Method.PATCH

            case "acl":
                return Method.ACL

            case "baseline-control":
                return Method.BASELINE_CONTROL

            case "bind":
                return Method.BIND

            case "checkin":
                return Method.CHECKIN

            case "checkout":
                return Method.CHECKOUT

            case "copy":
                return Method.COPY

            case "label":
                return Method.LABEL

            case "link":
                return Method.LINK

            case "lock":
                return Method.LOCK

            case "merge":
                return Method.MERGE

            case "mkactivity":
                return Method.MKACTIVITY

            case "mkcalendar":
                return Method.MKCALENDAR

            case "mkcol":
                return Method.MKCOL

            case "mkredirectref":
                return Method.MKREDIRECTREF

            case "mkworkspace":
                return Method.MKWORKSPACE

            case "move":
                return Method.MOVE

            case "orderpatch":
                return Method.ORDERPATCH

            case "propfind":
                return Method.PROPFIND

            case "proppatch":
                return Method.PROPPATCH

            case "rebind":
                return Method.REBIND

            case "report":
                return Method.REPORT

            case "search":
                return Method.SEARCH

            case "unbind":
                return Method.UNBIND

            case "uncheckout":
                return Method.UNCHECKOUT

            case "unlink":
                return Method.UNLINK

            case "unlock":
                return Method.UNLOCK

            case "update":
                return Method.UPDATE

            case "updateredirectref":
                return Method.UPDATEREDIRECTREF

            case "version-control":
                return Method.VERSION_CONTROL

            case "pri":
                return Method.PRI

            case "query":
                return Method.QUERY

            default:
                // Unknown extension methods remain valid and preserve their
                // original case-sensitive wire representation.
                return Method(In)
        }
    }
}
