/*
 * Sec Standard Library: net/ip
 * File: tcp.sec
 *
 * Standards:
 * RFC 9293 - Transmission Control Protocol
 * https://www.rfc-editor.org/rfc/rfc9293
 *
 * Related:
 * RFC 1122 - Requirements for Internet Hosts
 * https://www.rfc-editor.org/rfc/rfc1122
 */
module net

// =====================================================================
// ERRORS
// =====================================================================

enum NetError error {
    ConnectionRefused,
    Timeout,
    InvalidPacketStructure,
    NetworkUnreachable,
    BufferTooSmall,
    UnsupportedIpVersion,
}

// =====================================================================
// IPv6
// =====================================================================

// Nested register for IPv6 addresses (128 bits).
// Mapped as eight 16-bit segments corresponding to standard IPv6 hex notation.
type Ipv6Address register[128] msb-first big-endian {
    Segment0: bit[16],
    Segment1: bit[16],
    Segment2: bit[16],
    Segment3: bit[16],
    Segment4: bit[16],
    Segment5: bit[16],
    Segment6: bit[16],
    Segment7: bit[16],
}

// Fixed-width wire layout for IPv6 header.
// Total size: 40 bytes (320 bits).
type Ipv6WireHeader register[320] msb-first big-endian {
    Version: bit[4],
    Dscp: bit[6],
    Ecn: IpEcn,
    FlowLabel: bit[20],
    PayloadLength: bit[16],
    NextHeader: IpProtocol,
    HopLimit: bit[8],
    SourceIp: Ipv6Address,
    DestinationIp: Ipv6Address,
}

// =====================================================================
// SEMANTIC REPRESENTATION (ZERO-COPY)
// =====================================================================

type Ipv4Packet struct {
    Header: Ipv4WireHeader,
    // Slice referencing the payload inside the original borrowed buffer
    Payload: ref byte[],
}

type Ipv6Packet struct {
    Header: Ipv6WireHeader,
    // Slice referencing the payload inside the original borrowed buffer
    Payload: ref byte[],
}

// Tagged runtime union for semantic alternatives after parsing
type IpPacket union {
    V4(Ipv4Packet),
    V6(Ipv6Packet),
}

// =====================================================================
// PARSING
// =====================================================================

// Takes a non-owning slice and parses it into an IpPacket.
// Does not allocate memory or copy the payload.
fn ParseIpPacket(buffer: ref byte[]) Result[IpPacket, NetError] {
    if buffer.Len < 20 {
        return Err(NetError.BufferTooSmall)
    }

    // The first byte contains Version (top 4 bits) and IHL (bottom 4 bits) in IPv4.
    // In IPv6, the top 4 bits are also the Version.
    let firstByte: byte := buffer[0]
    let version: uint8 := uint8(firstByte >> 4)

    if version == 4 {
        // Extract IHL via bitmask
        let ihl: uint8 := uint8(firstByte & 0x0F)
        let headerBytes: int := int(ihl) * 4

        if buffer.Len < headerBytes {
            return Err(NetError.BufferTooSmall)
        }

        // Register byte decoding is not available without a lowering-backed,
        // endian-aware primitive. Do not invent a runtime-only binary API.
        return Err(NetError.InvalidPacketStructure)

    } else if version == 6 {
        let headerBytes: int := 40 // IPv6 header is always 40 bytes

        if buffer.Len < headerBytes {
            return Err(NetError.BufferTooSmall)
        }

        // See the IPv4 branch: decoding remains explicitly unavailable until
        // register extraction/insertion has a semantics-preserving lowering.
        return Err(NetError.InvalidPacketStructure)
    }

    return Err(NetError.UnsupportedIpVersion)
}

// =====================================================================
// SOCKETS & OWNERSHIP
// =====================================================================

@noCopy
type TcpStream struct {
    _handle: int,
}

impl TcpStream {
    // Fallible initializer. Returns NetError if the connection fails.
    // Does not expose native OS handles to the caller.
    init(address: uint32, port: uint16) NetError {
        // Platform specific logic would go here
        self._handle = 1 // Mock valid handle
    }

    // Send borrows a slice. No ownership transfer of the data.
    fn Send(data: ref byte[]) Result[int, NetError] {
        // Write to native socket
        return Ok(0)
    }
}

// Consuming function that takes ownership of a stream
fn TerminateConnection(->stream: TcpStream) void {
    // Stream ownership ends here. Native socket cleanup remains pending until
    // destruction lowering and the platform socket binding are available.
}

// =====================================================================
// USAGE EXAMPLE
// =====================================================================

fn NetworkTask() void {
    // TcpStream is @noCopy, so this client cannot be accidentally copied.
    let mut client: TcpStream := try new TcpStream(0x7F000001, 80) {
        Err(_) => { return }
    }

    // Explicitly pass ownership of the client to the terminating function
    TerminateConnection(client)

    // Using 'client' here would cause a compile-time error
}
