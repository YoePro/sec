module main

type Handle struct { id: int }
impl Handle { free {} }
fn Observe(value: ref Handle) int { return value.id }
fn Consume(value: Handle) void {}

fn Borrowed() void {
    let mut target := Handle { id: 1 }
    let borrowed: ref Handle := ref target
    target = Handle { id: 2 }
    Observe(borrowed)
}

fn DeferredMove() void {
    let mut target := Handle { id: 1 }
    defer { Observe(target) }
    Consume(<-target)
}

fn DeferredDiscard() void {
    let mut target := Handle { id: 1 }
    defer { Observe(target) }
    discard target
}

fn InvalidRHS() void {
    let mut target := Handle { id: 1 }
    target = 5
}
