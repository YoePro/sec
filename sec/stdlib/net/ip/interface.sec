module ip

// TODO: Requires OS-Specific code.

/**
 * Identifies one network interface within the selected platform or IP stack.
 *
 * Description:
 * - Zero is representable and may mean an unspecified or default interface
 * where an API defines that behavior.
 * - Enumerated concrete interfaces normally have a nonzero index on platforms
 * with the conventional interface-index model.
 */
type InterfaceIndex uint32

/**
 * Describes one IP address assigned to a network interface.
 *
 * Description:
 * - The address is the actual host/interface address.
 * - Host bits are preserved and are not cleared as they are for Ipv4Network
 * or Ipv6Network.
 */
type InterfaceAddress union {
    V4 {
        Address:      Ipv4Address,
        PrefixLength: Ipv4PrefixLength,
    }

    V6 {
        Address:      Ipv6Address,
        PrefixLength: Ipv6PrefixLength,
    }
}

/**
 * Describes one network interface.
 *
 * Description:
 * - Index is the stable platform interface index where one exists.
 * - Name is the platform interface name.
 * - Mtu is the current interface MTU in bytes.
 */
type NetworkInterface struct {
    Index: InterfaceIndex,
    Name:  string,
    Mtu:   uint,
}

impl NetworkInterface {
    /**
     * Returns the IP addresses currently assigned to this interface.
     *
     * Returns:
     * - A newly allocated owning array containing IPv4 and IPv6 interface
     * addresses with their prefix lengths.
     *
     * Errors:
     * - NetworkError: The interface state could not be queried.
     *
     * Ownership:
     * - The returned array is owned by the caller.
     */
    fn AddressesToArray() Result[InterfaceAddress[], NetworkError] {
        // TODO: Implement through the target network-interface adapter.
        return Err(NetworkError.Unsupported)
    }
}

