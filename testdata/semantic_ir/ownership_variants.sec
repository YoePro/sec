type Packet union {
    Full { head: int },
    Spare(Handle),
}

fn FreshPacket() Packet {
    return Packet.Spare(Make(1))
}

fn GuardFieldsAndPayload() int {
    let packet := FreshPacket()
    match packet {
        Packet.Spare(handle) where handle.id > 0 => {
            return handle.id
