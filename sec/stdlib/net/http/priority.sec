module http

/*
* Sec Standard Library - net/http - Extensible HTTP priority values
*
* File:        stdlib/net/http/priority.sec
* Module:      http
* Revision:    2
* Updated:     2026-09-08
* Author:      Jonas Engström
*
* Purpose:
*   Extensible HTTP priority values.
*
* Standards:
*   - RFC 9218
*     https://www.rfc-editor.org/rfc/rfc9218
*   - RFC 9651
*     https://www.rfc-editor.org/rfc/rfc9651
*
* Rulebook:
*   stdlib/net/http/std-net-http.md
*/

type PriorityUrgency uint8 range 0..7 default 3

type Priority struct {
    Urgency: Option[PriorityUrgency],
    Incremental: Option[bool],
}

impl Priority {
    init() {
        self.Urgency = None
        self.Incremental = None
    }

    init(urgency: PriorityUrgency, incremental: bool) {
        self.Urgency = Some(urgency)
        self.Incremental = Some(incremental)
    }

    /**
    * Parse parses an HTTP Priority field value.
    *
    * The field value is parsed as an RFC 9651 Structured Fields Dictionary.
    * The registered `u` member is accepted only when it is an integer in the
    * inclusive range 0..7. The registered `i` member is accepted only when it is
    * a Boolean.
    *
    * Unknown members, members with unexpected types, and out-of-range urgency
    * values are ignored as required by RFC 9218.
    *
    * Absence of `u` or `i` is preserved. Request defaults and response update
    * semantics are applied by the caller, not by Parse.
    *
    * Returns StructuredFieldError only when the Structured Fields Dictionary
    * itself cannot be parsed.
    *
    * References:
    * - RFC 9218, Section 4
    * - RFC 9651, Structured Fields Dictionary
    */
    static fn Parse(value: HeaderValue) Result[Priority, StructuredFieldError] {
        let dictionary := try _StructuredFieldDictionary.Parse(value)
        let mut priority := new Priority()

        match dictionary.Integer("u") {
            Some(urgency) => {
                if urgency in 0..7 {
                    priority.Urgency = Some(PriorityUrgency(urgency))
                }
            }

            None => {}
        }

        match dictionary.Boolean("i") {
            Some(incremental) => {
                priority.Incremental = Some(incremental)
            }

            None => {}
        }

        return Ok(priority)
    }

    fn ToHeaderValue() Result[HeaderValue, StructuredFieldError] {
        return Err(StructuredFieldError.AllocationFailed)
    }
    property IsDefault: bool {
        get {
            match self.Urgency {
                Some(urgency) => {
                    if urgency != new PriorityUrgency() {
                        return false
                    }
                }

                None => {}
            }

            match self.Incremental {
                Some(incremental) => return !incremental
                None => return true
            }
        }
    }

    property EffectiveUrgency: PriorityUrgency {
        get {
            match self.Urgency {
                Some(urgency) => return urgency
                None => return new PriorityUrgency()
            }
        }
    }

    property EffectiveIncremental: bool {
        get {
            match self.Incremental {
                Some(incremental) => return incremental
                None => return false
            }
        }
    }
}

type _StructuredFieldValue union {
    Integer(int64)
    Boolean(bool)
    Other
}

type _StructuredFieldMember struct {
    Name: string,
    Value: _StructuredFieldValue,
}

type _StructuredFieldDictionary struct {
    _members: list[_StructuredFieldMember],
}

impl _StructuredFieldDictionary {

    /**
    * Parse parses an RFC 9651 Structured Fields Dictionary.
    *
    * Leading and trailing SP are ignored as required by the Structured
    * Fields parsing algorithm. Internal dictionary whitespace, members,
    * values, and parameters are parsed by _StructuredFieldParser.
    *
    * Returns StructuredFieldError.InvalidSyntax when the complete input
    * cannot be consumed as a valid Structured Fields Dictionary.
    */
    static fn Parse(value: HeaderValue) Result[_StructuredFieldDictionary, StructuredFieldError] {
        let mut parser := _StructuredFieldParser {
            _input: value.ToString(),
            _position: 0,
        }

        parser._SkipSP()

        let dictionary := try parser._ParseDictionary()

        parser._SkipSP()

        if !parser._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        return Ok(dictionary)
    }

    fn Integer(name: string) Option[int64] {
        for member in self._members {
            if member.Name == name {
                match member.Value {
                    _StructuredFieldValue.Integer(value) => return Some(value)
                    _ => return None
                }
            }
        }

        return None
    }

    fn Boolean(name: string) Option[bool] {
        for member in self._members {
            if member.Name == name {
                match member.Value {
                    _StructuredFieldValue.Boolean(value) => return Some(value)
                    _ => return None
                }
            }
        }

        return None
    }
}

type _StructuredFieldParser struct {
    _input: string,
    _position: uint,
}

impl _StructuredFieldParser {
    property _IsFinished: bool {
        get {
            return self._position >= self._input.Len
        }
    }

    fn _SkipOWS() void {
        while !self._IsFinished {
            let current := char(self._input.ByteAt(self._position))

            if current not in [' ', '\t'] {
                return
            }

            self._position += 1
        }
    }

    fn _SkipSP() void {
        while !self._IsFinished {
            let current := char(self._input.ByteAt(self._position))

            if current != ' ' {
                return
            }

            self._position += 1
        }
    }

    fn _ParseDictionary() Result[_StructuredFieldDictionary, StructuredFieldError] {
        let mut dictionary := _StructuredFieldDictionary {
            _members: list[_StructuredFieldMember] {},
        }

        while !self._IsFinished {
            let key := try self._ParseKey()

            let mut value: _StructuredFieldValue

            if self._Current == '=' {
                self._position += 1
                value = try self._ParseMemberValue()
            } else {
                value = _StructuredFieldValue.Boolean(true)
                try self._ParseParameters()
            }

            try dictionary._Set(key, value)

            self._SkipOWS()

            if self._IsFinished {
                return Ok(dictionary)
            }

            if self._Current != ',' {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            self._position += 1
            self._SkipOWS()

            if self._IsFinished {
                return Err(StructuredFieldError.InvalidSyntax)
            }
        }

        return Ok(dictionary)
    }

    static fn _IsKeyStart(value: char) bool {
        return value.IsLetter || value == '*'
    }

    static fn _IsKeyByte(value: char) bool {
        return value.IsLowerLetter || value.IsDigit || value in ['_', '-', '.', '*']
    }

    /**
    * Returns the character at the current parser position.
    *
    * The caller must establish that the parser is not finished before reading
    * this property.
    */
    property _Current: char {
        get {
            return char(self._input.ByteAt(self._position))
        }
    }

    /**
    * Parses one RFC 9651 key from the current parser position.
    *
    * A key begins with a lowercase ASCII letter or '*'. Remaining characters
    * may additionally contain decimal digits, '_', '-', '.', and '*'.
    *
    * The parser position is left immediately after the key.
    */
    fn _ParseKey() Result[string, StructuredFieldError] {
        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        if !_StructuredFieldParser._IsKeyStart(self._Current) {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        let start := self._position
        self._position += 1

        while !self._IsFinished {
            if !_StructuredFieldParser._IsKeyByte(self._Current) {
                break
            }

            self._position += 1
        }

        let key := try self._input.Slice(start, self._position) {
            Err(error) => return Err(StructuredFieldError.InvalidSyntax)
        }

        return Ok(key)
    }

    /**
    * Parses one Structured Fields dictionary member value.
    *
    * A member value is either an Item or an Inner List. Priority currently
    * retains Integer and Boolean values directly; other valid Structured Field
    * values are represented as _StructuredFieldValue.Other.
    *
    * Parameters are consumed as part of the member syntax even though Priority
    * does not currently interpret them.
    */
    fn _ParseMemberValue() Result[_StructuredFieldValue, StructuredFieldError] {
        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        if self._Current == '(' {
            try self._ParseInnerList()
            return Ok(_StructuredFieldValue.Other)
        }

        let value := try self._ParseBareItem()
        try self._ParseParameters()

        return Ok(value)
    }

    /**
    * Parses and discards Structured Fields parameters.
    *
    * Parameters are part of the enclosing Item or Inner List syntax. Priority
    * does not currently assign semantics to them, but they must still be parsed
    * correctly so valid extensions remain acceptable.
    */
    fn _ParseParameters() Result[void, StructuredFieldError] {
        while !self._IsFinished && self._Current == ';' {
            self._position += 1

            // RFC 9651 permits SP, but not arbitrary whitespace, after ';'.
            while !self._IsFinished && self._Current == ' ' {
                self._position += 1
            }

            let key := try self._ParseKey()

            if !self._IsFinished && self._Current == '=' {
                self._position += 1

                // Parameter values are bare items; they cannot themselves carry
                // another parameter list.
                let value := try self._ParseBareItem()
            }
        }

        return Ok()
    }

    /**
    * Stores one parsed Structured Fields dictionary member.
    *
    * If name already exists, its value is replaced in place. Otherwise a new
    * member is appended. This implements RFC 9651 duplicate-key semantics where
    * the last occurrence supplies the effective value.
    *
    * Allocation failure while appending leaves the dictionary unchanged.
    */
    fn _Set(name: string, value: _StructuredFieldValue) Result[void, StructuredFieldError] {
        let mut index: uint := 0

        while index < self._members.Len {
            if self._members[index].Name == name {
                self._members[index] = _StructuredFieldMember {
                    Name: name,
                    Value: value,
                }

                return Ok()
            }

            index += 1
        }

        try self._members.Append(_StructuredFieldMember {
            Name: name,
            Value: value,
        }) {
            Err(error) => return Err(StructuredFieldError.AllocationFailed)
        }

        return Ok()
    }

    /**
    * Parses one RFC 9651 bare item.
    *
    * The first character determines the Structured Field value type. The parser
    * position is left immediately after the bare item.
    *
    * Integer and Boolean values are retained because Priority interprets them.
    * Other valid Structured Field value types are parsed and represented as
    * _StructuredFieldValue.Other.
    */
    fn _ParseBareItem() Result[_StructuredFieldValue, StructuredFieldError] {
        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        let current := self._Current

        if current == '-' || current.IsDigit {
            let value := try self._ParseIntegerOrDecimal()
            return Ok(value)
        }

        if current == '"' {
            try self._ParseString()
            return Ok(_StructuredFieldValue.Other)
        }

        if current.IsLetter || current == '*' {
            try self._ParseToken()
            return Ok(_StructuredFieldValue.Other)
        }

        if current == ':' {
            try self._ParseByteSequence()
            return Ok(_StructuredFieldValue.Other)
        }

        if current == '?' {
            let value := try self._ParseBoolean()
            return Ok(value)
        }

        if current == '@' {
            try self._ParseDate()
            return Ok(_StructuredFieldValue.Other)
        }

        if current == '%' {
            try self._ParseDisplayString()
            return Ok(_StructuredFieldValue.Other)
        }

        return Err(StructuredFieldError.InvalidSyntax)
    }

    /**
    * Parses one RFC 9651 Inner List.
    *
    * Items inside the list are separated by one or more SP characters. Each item
    * may have its own parameters. Parameters following the closing ')' belong to
    * the Inner List itself.
    *
    * Priority does not currently retain Inner List contents, but the complete
    * syntax is validated and consumed so unknown dictionary members can be
    * ignored safely.
    */
    fn _ParseInnerList() Result[void, StructuredFieldError] {
        if self._IsFinished || self._Current != '(' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        while true {
            self._SkipSP()

            if self._IsFinished {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            if self._Current == ')' {
                self._position += 1
                try self._ParseParameters()
                return Ok()
            }

            let item := try self._ParseBareItem()
            try self._ParseParameters()

            if self._IsFinished {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            if self._Current != ' ' && self._Current != ')' {
                return Err(StructuredFieldError.InvalidSyntax)
            }
        }
    }

    /**
    * Parses an RFC 9651 Integer or Decimal.
    *
    * Integers are retained as _StructuredFieldValue.Integer. Decimals are
    * validated and consumed but represented as _StructuredFieldValue.Other
    * because Priority does not interpret Decimal values.
    */
    fn _ParseIntegerOrDecimal() Result[_StructuredFieldValue, StructuredFieldError] {
        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        let mut negative := false

        if self._Current == '-' {
            negative = true
            self._position += 1
        }

        if self._IsFinished || !self._Current.IsDigit {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        let mut integerDigits: uint := 0
        let mut integerValue: int64 := 0

        while !self._IsFinished && self._Current.IsDigit {
            integerDigits += 1

            if integerDigits > 15 {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            match self._Current.ToNumericValue() {
                Some(digit) => {
                    integerValue = integerValue * 10 + int64(digit)
                }

                None => {
                    return Err(StructuredFieldError.InvalidSyntax)
                }
            }

            self._position += 1
        }

        if !self._IsFinished && self._Current == '.' {
            if integerDigits > 12 {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            self._position += 1

            let mut fractionDigits: uint := 0

            while !self._IsFinished && self._Current.IsDigit {
                fractionDigits += 1

                if fractionDigits > 3 {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                self._position += 1
            }

            if fractionDigits == 0 {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            return Ok(_StructuredFieldValue.Other)
        }

        if negative {
            integerValue = -integerValue
        }

        return Ok(_StructuredFieldValue.Integer(integerValue))
    }

    /**
    * Parses and consumes an RFC 9651 String.
    *
    * String contents are not retained by the Priority parser.
    */
    fn _ParseString() Result[void, StructuredFieldError] {
        if self._IsFinished || self._Current != '"' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        while !self._IsFinished {
            let current := self._Current

            if current == '"' {
                self._position += 1
                return Ok()
            }

            if current == '\\' {
                self._position += 1

                if self._IsFinished {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                if self._Current != '"' && self._Current != '\\' {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                self._position += 1
                continue
            }

            if !current.IsAscii || current.IsControl {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            self._position += 1
        }

        return Err(StructuredFieldError.InvalidSyntax)
    }

    /**
    * Parses and consumes an RFC 9651 Token.
    *
    * Token contents are not retained by the Priority parser.
    */
    fn _ParseToken() Result[void, StructuredFieldError] {
        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        if !self._Current.IsLetter && self._Current != '*' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        while !self._IsFinished &&
        _StructuredFieldParser._IsTokenChar(self._Current) {
            self._position += 1
        }

        return Ok()
    }

    /**
    * Parses and consumes an RFC 9651 Byte Sequence.
    *
    * The Base64 payload is validated but not decoded because Priority does not
    * retain unknown Structured Field values.
    */
    fn _ParseByteSequence() Result[void, StructuredFieldError] {
        if self._IsFinished || self._Current != ':' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        let mut dataLength: uint := 0
        let mut paddingLength: uint := 0
        let mut paddingStarted := false

        while !self._IsFinished {
            let current := self._Current

            if current == ':' {
                self._position += 1

                let remainder := dataLength % 4

                if remainder == 1 {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                if remainder == 0 && paddingLength != 0 {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                if remainder == 2 && paddingLength > 2 {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                if remainder == 3 && paddingLength > 1 {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                return Ok()
            }

            if current == '=' {
                paddingStarted = true
                paddingLength += 1
                self._position += 1
                continue
            }

            if paddingStarted {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            if !_StructuredFieldParser._IsBase64Char(current) {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            dataLength += 1
            self._position += 1
        }

        return Err(StructuredFieldError.InvalidSyntax)
    }

    /**
    * Parses an RFC 9651 Boolean.
    *
    * "?1" represents true and "?0" represents false.
    */
    fn _ParseBoolean() Result[_StructuredFieldValue, StructuredFieldError] {
        if self._IsFinished || self._Current != '?' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        if self._IsFinished {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        if self._Current == '1' {
            self._position += 1
            return Ok(_StructuredFieldValue.Boolean(true))
        }

        if self._Current == '0' {
            self._position += 1
            return Ok(_StructuredFieldValue.Boolean(false))
        }

        return Err(StructuredFieldError.InvalidSyntax)
    }

    /**
    * Parses and consumes an RFC 9651 Date.
    *
    * Dates use the Integer wire representation prefixed by '@'. Decimal values
    * are not valid dates.
    */
    fn _ParseDate() Result[void, StructuredFieldError] {
        if self._IsFinished || self._Current != '@' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        let value := try self._ParseIntegerOrDecimal()

        match value {
            _StructuredFieldValue.Integer(_) => {
                return Ok()
            }

            _ => {
                return Err(StructuredFieldError.InvalidSyntax)
            }
        }
    }

    /**
    * Parses and consumes the textual representation of an RFC 9651 Display
    * String.
    *
    * Percent escapes are required to use lowercase hexadecimal digits.
    *
    * TODO:
    * Validate the decoded octet sequence as UTF-8 once the canonical Core UTF-8
    * validation API is available.
    */
    fn _ParseDisplayString() Result[void, StructuredFieldError] {
        if self._IsFinished || self._Current != '%' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        if self._IsFinished || self._Current != '"' {
            return Err(StructuredFieldError.InvalidSyntax)
        }

        self._position += 1

        while !self._IsFinished {
            let current := self._Current

            if current == '"' {
                self._position += 1
                return Ok()
            }

            if !current.IsAscii || current.IsControl {
                return Err(StructuredFieldError.InvalidSyntax)
            }

            if current == '%' {
                self._position += 1

                if self._IsFinished ||
                !_StructuredFieldParser._IsLowerHexDigit(self._Current) {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                self._position += 1

                if self._IsFinished ||
                !_StructuredFieldParser._IsLowerHexDigit(self._Current) {
                    return Err(StructuredFieldError.InvalidSyntax)
                }

                self._position += 1
                continue
            }

            self._position += 1
        }

        return Err(StructuredFieldError.InvalidSyntax)
    }

    static fn _IsTokenChar(value: char) bool {
        return value.IsLetterOrDigit ||
        value in [
            '!', '#', '$', '%', '&', '\'', '*', '+',
            '-', '.', '^', '_', '`', '|', '~', ':', '/',
        ]
    }
    static fn _IsBase64Char(value: char) bool {
        return value.IsLetterOrDigit || value in ['+', '/']
    }

    static fn _IsLowerHexDigit(value: char) bool {
        return value.IsDigit ||
        value in ['a', 'b', 'c', 'd', 'e', 'f']
    }
}
