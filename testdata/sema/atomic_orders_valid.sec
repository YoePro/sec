module main

fn LoadRelaxed(value: ref Atomic[int]) void {
    discard value.Load(MemoryOrder.Relaxed)
}

fn LoadAcquire(value: ref Atomic[int]) void {
    discard value.Load(MemoryOrder.Acquire)
}

fn LoadSeqCst(value: ref Atomic[int]) void {
    discard value.Load(MemoryOrder.SeqCst)
}

fn StoreRelaxed(value: ref Atomic[int]) void {
    value.Store(1, MemoryOrder.Relaxed)
}

fn StoreRelease(value: ref Atomic[int]) void {
    value.Store(1, MemoryOrder.Release)
}

fn StoreSeqCst(value: ref Atomic[int]) void {
    value.Store(1, MemoryOrder.SeqCst)
}

fn SwapRelaxed(value: ref Atomic[int]) void {
    discard value.Swap(1, MemoryOrder.Relaxed)
}

fn SwapAcquire(value: ref Atomic[int]) void {
    discard value.Swap(1, MemoryOrder.Acquire)
}

fn SwapRelease(value: ref Atomic[int]) void {
    discard value.Swap(1, MemoryOrder.Release)
}

fn SwapAcqRel(value: ref Atomic[int]) void {
    discard value.Swap(1, MemoryOrder.AcqRel)
}

fn SwapSeqCst(value: ref Atomic[int]) void {
    discard value.Swap(1, MemoryOrder.SeqCst)
}

fn FetchAddRelaxed(value: ref Atomic[int]) void {
    discard value.FetchAdd(1, MemoryOrder.Relaxed)
}

fn FetchAddAcquire(value: ref Atomic[int]) void {
    discard value.FetchAdd(1, MemoryOrder.Acquire)
}

fn FetchAddRelease(value: ref Atomic[int]) void {
    discard value.FetchAdd(1, MemoryOrder.Release)
}

fn FetchAddAcqRel(value: ref Atomic[int]) void {
    discard value.FetchAdd(1, MemoryOrder.AcqRel)
}

fn FetchAddSeqCst(value: ref Atomic[int]) void {
    discard value.FetchAdd(1, MemoryOrder.SeqCst)
}

