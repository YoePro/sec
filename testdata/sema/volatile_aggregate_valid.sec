module main

type Pair struct { first: uint32, second: uint32 }
type Word uint32

fn OrdinaryRead(pointer: RawPtr[Pair]) Pair {
    unsafe { return pointer.Read() }
}
fn OrdinaryWrite(pointer: RawPtr[Pair], value: Pair) void {
    unsafe { pointer.Write(value) }
}
fn Scalar(pointer: RawPtr[Word], value: Word) Word {
    unsafe {
        pointer.VolatileWrite(value)
        return pointer.VolatileRead()
    }
}
type Device struct {}
impl Device {
    fn VolatileRead() Pair { return Pair {} }
    fn VolatileWrite(value: Pair) void {}
}
fn OrdinaryMethods(device: Device, value: Pair) Pair {
    device.VolatileWrite(value)
    return device.VolatileRead()
}
