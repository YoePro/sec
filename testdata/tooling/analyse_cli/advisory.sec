module main

fn Walk(values: ref int[]) void {
    for index in uint(1)..<values.Len {
        let value := values[index]
    }
}

fn Helper(values: ref int[]) void {
    Walk(values)
}

fn Unrelated(values: ref int[]) void {
    for index in uint(1)..<values.Len {
        let value := values[index]
    }
}

fn Read(value: int) int {
    return value
}

fn Read(value: bool) int {
    return 0
}

fn main() void {
    let mut values: int[]
    Helper(ref values)
    Unrelated(ref values)
}
