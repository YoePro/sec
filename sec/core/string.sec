module core

type StringSplitIterator struct {
    source:          string,
    separator:       string,
    position:        uint,
    finished:        bool,
    retainSeparator: bool,
}

// rules/control-flow/flowcontrol_for.md section 37: explicit compiler-known
// Iterator conformance makes Split() results valid sources for `for value in`.
impl StringSplitIterator implements Iterator[string] {
    property IsFinished: bool {
        get {
            return self.finished
        }
    }

    fn Next() Option[string] {
        if self.finished {
            return None()
        }

        if self.position > self.source.SizeOf {
            self.finished = true
            return None()
        }

        // yield one rune at a time, with no leading/trailing empty strings.
        if self.separator.SizeOf == 0 {
            if self.position == self.source.SizeOf {
                self.finished = true
                return None()
            }

            let rest := __StringSliceUnchecked(self.source, self.position, self.source.SizeOf)

            for character in rest {
                let end := self.position + character.Utf8Length
                let part := __StringSliceUnchecked(self.source, self.position, end)
                self.position = end
                return Some(part)
            }

            self.finished = true
            return None()
        }

        // Separator cannot possibly occur in the remaining bytes.
        if self.separator.SizeOf > self.source.SizeOf - self.position {
            let part := __StringSliceUnchecked(self.source, self.position, self.source.SizeOf)
            self.finished = true
            return Some(part)
        }

        // self.position is a UTF-8 byte offset on a scalar boundary; the
        // internal byte search keeps every coordinate in bytes (MD-071).
        let found := self.source._ByteIndexOf(self.separator, self.position)

        return match found {
            Some(index) => {
                if index < self.position || index > self.source.SizeOf {
                    // Internal invariant
                    self.finished = true
                    return None()
                }

                if self.separator.SizeOf > self.source.SizeOf - index {
                    // A match must never extend beyond the source.
                    self.finished = true
                    return None()
                }

                let nextPosition := index + self.separator.SizeOf
                let mut partEnd: uint := index

                if self.retainSeparator {
                    partEnd = nextPosition
                }

                let part := __StringSliceUnchecked(self.source, self.position, partEnd)

                self.position = nextPosition
                return Some(part)
            }

            None => {
                let part := __StringSliceUnchecked(self.source, self.position, self.source.SizeOf)

                self.finished = true
                return Some(part)
            }
        }
    }
}

impl string {
    property IsEmpty: bool {
        get {
            return self.SizeOf == 0
        }
    }

    fn Empty() string {
        return ""
    }

    /**
     * Compares two strings lexicographically by Unicode scalar value order.
     *
     * Sec strings use valid UTF-8 encoding. UTF-8 preserves Unicode scalar value
     * ordering under lexicographic byte comparison, allowing Compare to operate
     * directly on the encoded bytes without decoding each rune.
     *
     * Returns:
     * - a negative value when self sorts before other,
     * - zero when both strings are equal,
     * - a positive value when self sorts after other.
     *
     * This comparison is ordinal. It does not perform locale-sensitive collation,
     * case folding, or Unicode normalization.
     */
    fn Compare(other: string) int {
        let mut index: uint := 0

        while index < self.SizeOf && index < other.SizeOf {
            let left := try self.GetByte(index) {
                Err(_) => {
                    assert false, "string.Compare: ByteAt failed inside proven bounds"
                }
            }

            let right := try other.GetByte(index) {
                Err(_) => {
                    assert false, "string.Compare: ByteAt failed inside proven bounds"
                }
            }

            if left < right {
                return -1
            }

            if left > right {
                return 1
            }
            index += 1
        }

        if self.SizeOf < other.SizeOf {
            return -1
        }

        if self.SizeOf > other.SizeOf {
            return 1
        }

        return 0
    }

    /**
     * Returns the encoded UTF-8 byte at the given byte index.
     *
     * Parameters:
     *   - index: Zero-based UTF-8 byte index (not a rune index); below self.SizeOf.
     * Errors:
     *   IndexError.OutOfBounds when index is not below self.SizeOf.
     */
    fn GetByte(index: uint) Result[byte, IndexError] {
        if index >= self.SizeOf {
            return Err(IndexError.OutOfBounds)
        }
        let offset := try int(index) {
            Err(_) => {
                return Err(IndexError.OutOfBounds)
            }
        }
        unsafe {
            return Ok(self.Ptr.Offset(offset).Read())
        }
    }

    /**
     * Returns a Unicode scalar at the specified rune index.
     *
     * Parameters:
     *   - index: Zero-based rune index, not a byte offset.
     * Errors:
     *   IndexError.OutOfBounds when index is not below self.Len.
     */
    fn GetRune(index: uint) Result[rune, IndexError] {
        let mut current: uint := 0

        for value in self {
            if current == index {
                return Ok(value)
            }

            current += 1
        }

        return Err(IndexError.OutOfBounds)
    }

    /**
     * Returns the encoded UTF-8 byte at the given byte index.
     *
     * Parameters:
     *   - index: Zero-based UTF-8 byte index (not a rune index).
     * Panics:
     *   When index is not below self.SizeOf.
     */
    fn ByteAt(index: uint) byte {
        if index >= self.SizeOf {
            panic "String index is out of bounds"
        }
        unsafe {
            return self.Ptr.Offset(try int(index) {
                Err(_) => {
                    panic "String index is out of bounds"
                }
            }).Read()
        }
    }

    /**
     * Returns the encoded UTF-8 byte at the given byte index as a char.
     *
     * This is byte access, not character or rune access: index is a UTF-8
     * byte index and a non-ASCII scalar spans several chars. Whether CharAt
     * is renamed or redesigned is not decided (MD-050/MD-071 correction § 3(5)).
     *
     * Parameters:
     *   - index: Zero-based UTF-8 byte index (not a rune index).
     * Panics:
     *   When index is not below self.SizeOf.
     */
    fn CharAt(index: uint) char {
        if index >= self.SizeOf {
            panic "String index is out of bounds"
        }

        unsafe {
            return char(self.Ptr.Offset(try int(index) {
                Err(_) => {
                    panic "String index is out of bounds"
                }
            }).Read())
        }
    }

    /**
     * Returns a Unicode scalar at the specified rune index.
     *
     * Parameters:
     *   - index: Zero-based rune index, not a byte offset.
     * Panics:
     *   When index is not below self.Len.
     */
    fn RuneAt(index: uint) rune {
        let mut current: uint := 0

        for value in self {
            if current == index {
                return value
            }

            current += 1
        }

        panic "String index is out of bounds"
    }

    /**
     * Decodes exactly the represented bytes as strict UTF-8 text.
     *
     * A string is always valid UTF-8 text, never a binary buffer (MD-050):
     * malformed input is an ordinary recoverable error, not a panic, and the
     * borrowed bytes are left unchanged.
     *
     * Parameters:
     *   - value: Borrowed byte array; no terminator or capacity bytes are read.
     * Returns:
     *   An independent, valid UTF-8 string on success.
     * Errors:
     *   StringError.InvalidUtf8(byteOffset) for malformed UTF-8, where
     *   byteOffset is the leading byte of the first invalid or truncated
     *   sequence.
     *   StringError.Allocation(error) if text storage cannot be acquired.
     * Allocation:
     *   May allocate; uses the active permitted allocation context.
     */
    fn FromByteArray(value: ref byte[]) Result[string, StringError] {
        let mut index: uint := 0

        while index < value.Len {
            let first := value[index]

            // ASCII occupies one byte and is always valid UTF-8.
            if first <= 0x7F {
                index += 1
                continue
            }

            // Two-byte sequence:
            // 110xxxxx 10xxxxxx
            //
            // C0 and C1 are excluded because they would encode an ASCII
            // code point using an overlong representation.
            if first in 0xC2..0xDF {
                if index + 1 >= value.Len ||
                !_IsUtf8Continuation(value[index + 1]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 2
                continue
            }

            // Three-byte sequence beginning with E0.
            //
            // The second byte must be A0..BF to exclude overlong
            // encodings of code points below U+0800.
            if first == 0xE0 {
                if index + 2 >= value.Len ||
                !(value[index + 1] in 0xA0..0xBF) ||
                !_IsUtf8Continuation(value[index + 2]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 3
                continue
            }

            // Ordinary three-byte UTF-8 sequences.
            if first in 0xE1..0xEC || first in 0xEE..0xEF {
                if index + 2 >= value.Len ||
                !_IsUtf8Continuation(value[index + 1]) ||
                !_IsUtf8Continuation(value[index + 2]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 3
                continue
            }

            // ED A0..BF would encode UTF-16 surrogate code points.
            // Unicode scalar values exclude U+D800..U+DFFF.
            if first == 0xED {
                if index + 2 >= value.Len ||
                !(value[index + 1] in 0x80..0x9F) ||
                !_IsUtf8Continuation(value[index + 2]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 3
                continue
            }

            // Four-byte sequence beginning with F0.
            //
            // The lower bound on the second byte prevents overlong
            // encodings of values below U+10000.
            if first == 0xF0 {
                if index + 3 >= value.Len ||
                !(value[index + 1] in 0x90..0xBF) ||
                !_IsUtf8Continuation(value[index + 2]) ||
                !_IsUtf8Continuation(value[index + 3]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 4
                continue
            }

            // Ordinary four-byte UTF-8 sequences.
            if first in 0xF1..0xF3 {
                if index + 3 >= value.Len ||
                !_IsUtf8Continuation(value[index + 1]) ||
                !_IsUtf8Continuation(value[index + 2]) ||
                !_IsUtf8Continuation(value[index + 3]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 4
                continue
            }

            // F4 is the highest legal UTF-8 leading byte.
            //
            // Restricting the second byte to 80..8F limits the encoded
            // scalar value to U+10FFFF.
            if first == 0xF4 {
                if index + 3 >= value.Len ||
                !(value[index + 1] in 0x80..0x8F) ||
                !_IsUtf8Continuation(value[index + 2]) ||
                !_IsUtf8Continuation(value[index + 3]) {
                    return Err(StringError.InvalidUtf8(index))
                }

                index += 4
                continue
            }

            // Continuation bytes used as leading bytes, C0/C1, and
            // F5..FF cannot begin a valid UTF-8 sequence.
            return Err(StringError.InvalidUtf8(index))
        }

        // The bytes are validated above; the byte-sequence materialization
        // copies exactly those bytes into independent storage and reports
        // allocation failure as StringError.Allocation.
        return value.ToString()
    }

    /**
     * Returns true when value is a UTF-8 continuation byte.
     *
     * UTF-8 continuation bytes have the bit pattern 10xxxxxx and
     * therefore occupy the inclusive range 0x80..0xBF.
     */
    fn _IsUtf8Continuation(value: byte) bool {
        return value in 0x80..0xBF
    }

    /**
     * Encodes an array of Unicode scalars as canonical UTF-8 text.
     *
     * Parameters:
     *   - value: Borrowed rune array; every rune is already a valid scalar.
     * Returns:
     *   An independent UTF-8 string preserving scalar order.
     * Errors:
     *   StringError.Allocation(error) if text storage cannot be acquired.
     * Allocation:
     *   May allocate; uses the active permitted allocation context.
     */
    fn FromRuneArray(value: ref rune[]) Result[string, StringError] {
        // The compiler-known rune-sequence materialization encodes each
        // scalar to canonical UTF-8 in order (compiler_known_members.md,
        // "Rune-sequence semantics"); safe runes cannot be invalid.
        return value.ToString()
    }

    /**
     * Materializes the UTF-8 encoding into a separate owning byte array.
     *
     * Returns:
     *   Exactly self.SizeOf bytes in encoded order; no terminator.
     * Errors:
     *   CollectionError for unavailable or insufficient result storage.
     * Allocation:
     *   May allocate; the returned mutable array never aliases string storage.
     */
    fn ToByteArray() Result[byte[], CollectionError] {
        let mut result: byte[]
        let mut index: uint := 0

        while index < self.SizeOf {
            try result.Append(self.ByteAt(index))
            index += 1
        }

        return Ok(result)
    }

    /**
     * Materializes the text into a separate owning rune array.
     *
     * Returns:
     *   Exactly self.Len Unicode scalar values in order.
     * Errors:
     *   CollectionError for unavailable or insufficient result storage.
     * Allocation:
     *   May allocate; the returned mutable array never aliases string storage.
     */
    fn ToRuneArray() Result[rune[], CollectionError] {
        let mut result: rune[]

        for value in self {
            try result.Append(value)
        }

        return Ok(result)
    }

    /**
     * Reports whether this string begins with prefix.
     *
     * Comparison is exact and case-sensitive and operates on the UTF-8 byte
     * representation. No Unicode normalization, case folding, or locale-sensitive
     * comparison is performed.
     *
     * An empty prefix does not match. If prefix contains more bytes than this
     * string, false is returned.
     *
     * The operation does not allocate.
     */
    fn StartsWith(prefix: string) bool {
        if prefix.SizeOf == 0 || prefix.SizeOf > self.SizeOf {
            return false
        }

        let mut index: uint := 0

        while index < prefix.SizeOf {
            let left := try self.GetByte(index) {
                Err(_) => return false
            }

            let right := try prefix.GetByte(index) {
                Err(_) => return false
            }

            if left != right {
                return false
            }

            index += 1
        }

        return true
    }

    /**
     * Reports whether this string ends with suffix.
     *
     * Comparison is exact and case-sensitive and operates on the UTF-8 byte
     * representation. No Unicode normalization, case folding, or locale-sensitive
     * comparison is performed.
     *
     * An empty suffix does not match. If suffix contains more bytes than this
     * string, false is returned.
     *
     * The operation does not allocate.
     */
    fn EndsWith(suffix: string) bool {
        if suffix.SizeOf == 0 || suffix.SizeOf > self.SizeOf {
            return false
        }

        let start := self.SizeOf - suffix.SizeOf
        let mut index: uint := 0

        while index < suffix.SizeOf {
            let left := try self.GetByte(start + index) {
                Err(_) => return false
            }

            let right := try suffix.GetByte(index) {
                Err(_) => return false
            }

            if left != right {
                return false
            }

            index += 1
        }

        return true
    }

    fn Contains(value: string) bool {
        return match self._ByteIndexOf(value, 0) {
            Some(_) => true
            None => false
        }
    }

    /**
     * Finds the first exact occurrence of value.
     *
     * Parameters:
     *   - value: Text to find; an empty value matches rune position zero.
     * Returns:
     *   Some(zero-based rune index) or None if no match exists.
     * Allocation:
     *   Does not allocate.
     */
    fn IndexOf(value: string) Option[uint] {
        return self.IndexOf(value, 0)
    }

    /**
     * Finds the first exact occurrence of value at or after start.
     *
     * Parameters:
     *   - value: UTF-8 text to find, interpreted as Unicode scalars.
     *   - start: Zero-based rune position, inclusive.
     * Returns:
     *   Some(rune index) or None, including an out-of-range start.
     * Allocation:
     *   Does not allocate.
     */
    fn IndexOf(value: string, start: uint) Option[uint] {
        if start > self.Len {
            return None()
        }

        if value.SizeOf == 0 {
            return Some(start)
        }

        let mut startByte: uint := 0

        match self._ByteOffsetOfRune(start) {
            Some(offset) => {
                startByte = offset
            }

            None => {
                return None()
            }
        }

        match self._ByteIndexOf(value, startByte) {
            Some(found) => {
                return Some(self._RuneIndexAtByte(found))
            }

            None => {
                return None()
            }
        }
    }

    /**
     * Finds the last exact occurrence of value.
     *
     * Parameters:
     *   - value: UTF-8 text to find; empty text matches at self.Len.
     * Returns:
     *   Some(zero-based rune index) or None if no match exists.
     * Allocation:
     *   Does not allocate.
     */
    fn LastIndexOf(value: string) Option[uint] {
        if value.SizeOf == 0 {
            return Some(self.Len)
        }

        match self._ByteLastIndexOf(value) {
            Some(found) => {
                return Some(self._RuneIndexAtByte(found))
            }

            None => {
                return None()
            }
        }
    }

    /**
     * Internal byte search: the UTF-8 byte offset of the first exact match of
     * value at or after the byte offset startByte.
     *
     * A match of valid UTF-8 text in valid UTF-8 text always begins on a
     * scalar boundary, because value begins with a leading byte. Public
     * members translate the result to rune coordinates (MD-071).
     */
    fn _ByteIndexOf(value: string, startByte: uint) Option[uint] {
        if startByte > self.SizeOf {
            return None()
        }

        if value.SizeOf == 0 {
            return Some(startByte)
        }

        if value.SizeOf > self.SizeOf - startByte {
            return None()
        }

        // Fast path: one-byte search value.
        if value.SizeOf == 1 {
            let needle := value.ByteAt(0)
            let mut index := startByte

            while index < self.SizeOf {
                if self.ByteAt(index) == needle {
                    return Some(index)
                }

                index += 1
            }

            return None()
        }

        let lastStart := self.SizeOf - value.SizeOf
        let mut index := startByte

        while index <= lastStart {
            let mut needleIndex: uint := 0

            while needleIndex < value.SizeOf {
                if self.ByteAt(index + needleIndex) != value.ByteAt(needleIndex) {
                    break
                }

                needleIndex += 1
            }

            if needleIndex == value.SizeOf {
                return Some(index)
            }

            index += 1
        }

        return None()
    }

    /**
     * Internal byte search: the UTF-8 byte offset of the last exact match of
     * a non-empty value.
     */
    fn _ByteLastIndexOf(value: string) Option[uint] {
        if value.SizeOf == 0 || value.SizeOf > self.SizeOf {
            return None()
        }

        let mut index := self.SizeOf - value.SizeOf

        for {
            let mut needleIndex: uint := 0

            while needleIndex < value.SizeOf {
                if self.ByteAt(index + needleIndex) != value.ByteAt(needleIndex) {
                    break
                }

                needleIndex += 1
            }

            if needleIndex == value.SizeOf {
                return Some(index)
            }

            if index == 0 {
                break
            }

            index -= 1
        }

        return None()
    }

    /**
     * Internal: the UTF-8 byte offset of the scalar boundary before the rune
     * at runeIndex, with runeIndex == self.Len giving self.SizeOf; None when
     * runeIndex exceeds self.Len.
     */
    fn _ByteOffsetOfRune(runeIndex: uint) Option[uint] {
        let mut current: uint := 0
        let mut offset: uint := 0

        for character in self {
            if current == runeIndex {
                return Some(offset)
            }

            offset += character.Utf8Length
            current += 1
        }

        if current == runeIndex {
            return Some(offset)
        }

        return None()
    }

    /**
     * Internal: the rune index of the scalar boundary at the UTF-8 byte offset
     * byteOffset, which must lie on a scalar boundary.
     */
    fn _RuneIndexAtByte(byteOffset: uint) uint {
        let mut current: uint := 0
        let mut position: uint := 0

        for character in self {
            if position >= byteOffset {
                return current
            }

            position += character.Utf8Length
            current += 1
        }

        return current
    }

    fn Trim() string {
        uint mut: position := 0, start := 0, end := 0
        bool mut: foundContent := false

        for character in self {
            let witdth := character.Utf8Length
            let next := position + witdth

            if character.IsWhitespace {
                if !foundContent {
                    start = next
                }
            } else {
                foundContent = true
                end = next
            }

            position = next
        }

        if !foundContent {
            return ""
        }

        return __StringSliceUnchecked(self, start, end)
    }

    fn TrimStart() string {
        uint mut: start := 0
        for character in self {
            if !character.IsWhitespace {
                break
            }

            start += character.Utf8Length
        }

        return __StringSliceUnchecked(self, start, self.SizeOf)
    }

    fn TrimEnd() string {
        uint mut: position := 0, end := 0

        for character in self {
            position += character.Utf8Length

            if !character.IsWhitespace {
                end = position
            }
        }

        return __StringSliceUnchecked(self, 0, end)
    }

    /**
     * Produces text from the half-open rune interval [start, end).
     *
     * Parameters:
     *   - start: Inclusive Unicode-scalar index.
     *   - end: Exclusive Unicode-scalar index.
     * Returns:
     *   The exact selected text without normalization.
     * Errors:
     *   RangeError.StartAfterEnd or RangeError.OutOfBounds.
     */
    fn Slice(start: uint, end: uint) Result[string, RangeError] {
        if start > end {
            return Err(RangeError.StartAfterEnd)
        }

        if end > self.Len {
            return Err(RangeError.OutOfBounds)
        }

        let mut startByte: uint := 0
        let mut endByte: uint := 0

        match self._ByteOffsetOfRune(start) {
            Some(offset) => {
                startByte = offset
            }

            None => {
                return Err(RangeError.OutOfBounds)
            }
        }

        match self._ByteOffsetOfRune(end) {
            Some(offset) => {
                endByte = offset
            }

            None => {
                return Err(RangeError.OutOfBounds)
            }
        }

        // Both bounds are resolved scalar-boundary byte offsets with
        // startByte <= endByte <= self.SizeOf before the private byte helper.
        return Ok(__StringSliceUnchecked(self, startByte, endByte))
    }

    /**
     * Creates a lazy iterator that yields substrings separated by `separator`.
     *
     * The operation does not materialize the complete result and does not allocate
     * merely to perform the split. The returned iterator keeps the source string,
     * separator, and current iteration state.
     *
     * Rules:
     * - rules/library/core-library.md — §5 String
     * - rules/library/core-library.md — §5.3 Required instance methods
     * - rules/library/core-library.md — §5.6 Allocation visibility
     */
    fn Split(separator: string) StringSplitIterator {
        return StringSplitIterator {
            source: self,
            separator: separator,
            position: 0,
            finished: false,
        }
    }

    /**
     * Splits the string using `separator` and materializes all resulting substrings
     * into a dynamic string array.
     *
     * This is the allocating counterpart to `Split()`. It consumes the lazy
     * `StringSplitIterator` produced by `Split()` and appends each produced
     * substring to the result array. Collection growth failures are propagated as
     * `CollectionError`.
     *
     * Rules:
     * - rules/library/core-library.md — §5 String
     * - rules/library/core-library.md — §5.6 Allocation visibility
     * - rules/collections/collections.md — §6.7 Append
     * - rules/collections/collections.md — §16 Collection errors
     */
    fn SplitToArray(separator: string) Result[string[], CollectionError] {
        let mut result: string[]

        for part in self.Split(separator) {
            try result.Append(part)
        }

        return Ok(result)
    }

    /**
     * Splits the string at the first occurrence of `separator`.
     *
     * Returns `Some` containing exactly two strings when the separator is found:
     * the part before the first occurrence and the remaining part after it.
     * Returns `None` when the separator is not present.
     *
     * The operation does not materialize a dynamic collection and uses string
     * slices for the two returned parts.
     *
     * Rules:
     * - rules/library/core-library.md — §5 String
     * - rules/library/core-library.md — §1.5 Private representation helpers
     *
     * NOTE:
     * SplitOnce is not yet listed explicitly in the current core-library
     * rulebook and must be added to the canonical string API specification.
     */
    fn SplitOnce(separator: string) Option[string[2]] {
        // Byte coordinates throughout: the internal search returns a byte
        // offset on a scalar boundary (MD-071).
        match self._ByteIndexOf(separator, 0) {
            Some(index) => {
                let afterSeparator := index + separator.SizeOf

                return Some([
                    __StringSliceUnchecked(self, 0, index),
                    __StringSliceUnchecked(self, afterSeparator, self.SizeOf),
                ])
            }

            None => {
                return None
            }
        }
    }

    /**
     * Split the string tto lines. NOT implemented yet
     */
    fn SplitLines() StringSplitIterator {
        // TODO: Implement string.SplitLines()
        return StringSplitIterator {
            source: self,
            separator: "\n", // <-- This is not correct but just to not get compiler error
            position: 0,
            finished: false,
        }
    }

    fn ToLower() string {
        // TODO: Implement a correct version of the ToLower-function
        let mut s: string
        for r in self {
            s += r.ToLower()
        }
        return s
    }

    fn ToUpper() string {
        // TODO: Implement a correct version of the ToUpper-function
        let mut s: string
        for r in self {
            s += r.ToUpper()
        }
        return s
    }

    /** Returns a copy of self */
    fn ToString() Result[string, StringError] {
        return Ok(self)
    }
}
