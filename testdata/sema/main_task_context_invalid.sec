module main

fn Observe() bool {
    return Task.Current().CancelRequested
}

fn Pause() void {
    Task.Yield()
}

fn Wrapper() bool {
    return Observe()
}

fn main() void {
    let current := Task.Current()
    Task.Yield()
    let wrapped := Wrapper()
    Pause()
    let observe := Observe
    let indirect := observe()
    defer {
        Pause()
    }
}
