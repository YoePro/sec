// ToScreamingKebabCase: conversion and boundary regression tests.

test "ToScreamingKebabCase empty input" {
    let result := try ToScreamingKebabCase("")
    testing.ExpectEqual("", result)
}

test "ToScreamingKebabCase single word" {
    let result := try ToScreamingKebabCase("hello")
    testing.ExpectEqual("HELLO", result)
}

test "ToScreamingKebabCase leading acronym" {
    let result := try ToScreamingKebabCase("HTTPServer")
    testing.ExpectEqual("HTTP-SERVER", result)
}

test "ToScreamingKebabCase internal acronym" {
    let result := try ToScreamingKebabCase("parseHTTPResponse")
    testing.ExpectEqual("PARSE-HTTP-RESPONSE", result)
}

test "ToScreamingKebabCase trailing acronym" {
    let result := try ToScreamingKebabCase("userID")
    testing.ExpectEqual("USER-ID", result)
}

test "ToScreamingKebabCase underscore input" {
    let result := try ToScreamingKebabCase("hello_world")
    testing.ExpectEqual("HELLO-WORLD", result)
}

test "ToScreamingKebabCase spaces" {
    let result := try ToScreamingKebabCase("Hello World")
    testing.ExpectEqual("HELLO-WORLD", result)
}

test "ToScreamingKebabCase repeated delimiters" {
    let result := try ToScreamingKebabCase("hello--__world")
    testing.ExpectEqual("HELLO-WORLD", result)
}

test "ToScreamingKebabCase number before word" {
    let result := try ToScreamingKebabCase("Version2Beta")
    testing.ExpectEqual("VERSION2-BETA", result)
}

test "ToScreamingKebabCase already screaming kebab" {
    let result := try ToScreamingKebabCase("HTTP-SERVER")
    testing.ExpectEqual("HTTP-SERVER", result)
}

