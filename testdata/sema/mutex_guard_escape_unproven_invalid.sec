module main

fn UnknownCallable(callback: fn() void) void {
    let work := try spawn callback() { Err(_) => { return } }
}

type Carrier struct { Callback: -> fn() void, }
fn ConsumeCarrier(-> value: Carrier) void { discard value }
fn OpaqueCarrier(-> value: Carrier) void {
    let work := try spawn ConsumeCarrier(<-value) { Err(_) => { return } }
    discard value
}

fn Take[T](-> value: T) void { discard value }
fn UnknownGeneric[T](-> value: T) void {
    let work := try spawn Take[T](<-value) { Err(_) => { return } }
    discard value
}

fn Plain() void {}
fn CreateCallback() fn() void { return Plain }
fn UnknownChildResult() void {
    let work := try spawn CreateCallback() { Err(_) => { return } }
}
