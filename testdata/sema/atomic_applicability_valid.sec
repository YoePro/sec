module main

type Count uint64
type AliasCount Count
type Flag bool
enum State uint8 { Idle, Running }
type NamedState State
type Pointer RawPtr[byte]
type Bounded int range 0..100
type InheritedBound Bounded

fn Signed(value: ref Atomic[int128], item: int128) int128 {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    discard value.FetchAdd(item)
    discard value.FetchSub(item)
    discard value.FetchAnd(item)
    discard value.FetchOr(item)
    discard value.FetchXor(item)
    return value.Load()
}

fn Unsigned(value: ref Atomic[uint128], item: uint128) uint128 {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    discard value.FetchAdd(item)
    discard value.FetchSub(item)
    discard value.FetchAnd(item)
    discard value.FetchOr(item)
    discard value.FetchXor(item)
    return value.Load()
}

fn Named(value: ref Atomic[Count], item: Count) Count {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    discard value.FetchAdd(item)
    discard value.FetchSub(item)
    discard value.FetchAnd(item)
    discard value.FetchOr(item)
    discard value.FetchXor(item)
    return value.Load()
}

