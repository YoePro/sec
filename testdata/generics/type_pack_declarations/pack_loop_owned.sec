module main
fn Count[...Types](values: ...Types) uint {
    let mut n: uint := 0
    for index, value in values {
        if index == 1 {
            continue
        }
        n = n + 1
        if n > 10 {
            break
        }
    }
    return n
}
fn Empty[...Types](values: ...Types) uint {
    let mut n: uint := 0
    for value in values {
        n = n + 1
    }
    return n
}
fn First[...Types](values: ...Types) uint {
    let first := values[0]
    return values.Len
}
fn main() int {
    let total := Count(7, true, 3)
    let none := Empty()
    let length := First(5, false)
    if total == 2 && none == 0 && length == 2 {
        return 0
    }
    return 1
}
