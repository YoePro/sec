module core

type datetime struct {
    _epochDays:                int32,
    _nanosecondsSinceMidnight: uint64,
}

enum DateTimeFormats {
    HTTP_RFC_7231
}

impl datetime {
    // { days: int32, nanosOfDay: uint64 }
    enum Format {
        RFC3339,        // 2006-01-02T15:04:05Z07:00
        RFC3339Nano,    // 2006-01-02T15:04:05.999999999Z07:00
        RFC2822,        // Mon, 02 Jan 2006 15:04:05 Z07:00
        ISO8601,        // 2006-01-02T15:04:05Z
        RFC7231,        // Mon, 02 Jan 2006 15:04:05 GMT
        HTTP,           // Mon, 02 Jan 2006 15:04:05 GMT
    }

    init(epochDays: int32, nanosOfDay: uint64) {
        self._epochDays = epochDays
        self._nanosecondsSinceMidnight = nanosOfDay
    }

    init(d: date, t: time) {
        self._epochDays = d._epochDays
        self._nanosecondsSinceMidnight = t._nanosecondsSinceMidnight
    }

    fn ToString(format: Format) Result[string, StringError] {
        match format {
            RFC3339 => {
                return Ok(self._format3339)
            }

            RFC3339Nano => {
                return Ok(self._format3339Nano)
            }

            RFC2822 => {
                return Ok(self._format2822)
            }
            ISO8601 => {
                return Ok(self._formatiso8601)
            }
            RFC7231 => {
                return Ok(self._format7231)
            }
            HTTP => {
                return Ok(self._format7231)
            }
        }
    }

    fn ToString(layout: string) Result[string, StringError] {
        // TODO: parse layout och bygg sträng
        return Ok("")
    }

    property _format3339: string {
        get {
            return ""
        }
    }

    property _format3339Nano: string {
        get {
            return ""
        }
    }

    property _format2822: string {
        get {
            return ""
        }
    }

    property _formatiso8601: string {
        get {
            return ""
        }
    }

    property _format7231: string {
        get {
            return ""
        }
    }

    static property Year: int {
        get {
            return 0
        }
    }

    static property Month: int {
        get {
            return 0
        }
    }

    static property Day: int {
        get {
            return 0
        }
    }

    static property Hour: int {
        get {
            return 0
        }
    }

    static property Minute: int {
        get {
            return 0
        }
    }

    static property Second: int {
        get {
            return 0
        }
    }

    static property Nanosecond: int {
        get {
            return 0
        }
    }

    static property Weekday: date.Weekdays {
        get {
            return date.Weekdays.Sunday
        }
    }

    static property DayOfYear: int {
        get {
            return 0
        }
    }

    static property ISOWeek: date.ISOWeeks {
        get {
            return date.ISOWeeks{ year: 0, week: 0 }
        }
    }

    static property Now: datetime {
        get {
            return _now
        }
    }
