type Pair struct {
    left: Handle,
    count: int,
    right: Handle,
}

type Nest struct {
    inner: Pair,
    tag: int,
}

fn MakePair() Pair {
    return Pair { left: Make(1), count: 2, right: Make(3) }
}

fn FieldMove() int {
    let pair := MakePair()
    Sink(<-pair.left)
    return pair.count
}

fn FieldMoves() Handle {
    let pair := MakePair()
    let left :<- pair.left
    Sink(<-left)
    return <-pair.right
}

fn ParameterFieldMove(->pair: Pair) Handle {
    return <-pair.right
}

fn ConditionalFieldMove(flag: bool) void {
    let mut pair := MakePair()
    if flag {
        Sink(<-pair.left)
    }
    pair.left = Make(4)
}

fn FieldReplaceAndReinitialize() void {
    let mut pair := MakePair()
    pair.right = Make(5)
    pair.count = 6
    Sink(<-pair.left)
    pair.left = Make(7)
}

fn NestedFieldMove() void {
    let mut nest := Nest { inner: MakePair(), tag: 1 }
    Sink(<-nest.inner.right)
    nest.inner.right = Make(8)
}

fn FieldMoveInLoop() void {
    let mut pair := MakePair()
    let mut index := 0
    while index < 2 {
        index = index + 1
        Sink(<-pair.left)
        pair.left = Make(index)
    }
}

type Holder struct {
