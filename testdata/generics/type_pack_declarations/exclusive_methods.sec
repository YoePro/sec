module main

type Counter struct { Total: uint }
impl Counter {
    fn Count[...Types](values: ...ref mut Types) uint { return values.Len }
    fn Add[...Types](base: uint, values: ...ref mut Types) uint {
        self.Total = self.Total + base + values.Len
        return self.Total
    }
}
fn Use() uint {
    let mut counter := Counter { Total: 0 }
    let mut first := 1
    let mut second := true
    discard counter.Count()
    discard counter.Count(first, second)
    return counter.Add(2, first, second)
}
