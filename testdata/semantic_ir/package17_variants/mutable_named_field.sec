module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

type Packet union {
    Full { count: int, label: int },
    Spare(Handle),
}

fn Fresh() Packet {
    return Packet.Spare(Make(1))
}

fn T() int {
    let mut packet := Fresh()
    match packet {
        Packet.Full { count } => {
            return count
        }
        Packet.Spare(handle) => {
            return handle.id
        }
    }
}
