module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

fn Bump(handle: ref mut Handle) void {
    handle.id = 1
}

fn T() void {
    Bump(Make(1))
}
