/** Binary search in one property's scalar ranges. Rules: rules/library/core-library.md §11.3. */
fn _UnicodeHasProperty(ch: rune, first: int, count: int) bool {
    let mut low := first
    let mut high := first + count - 1
    while low <= high {
        let middle := low + (high - low) / 2
        let offset := middle * 2
        let start := _unicodePropertyRanges[offset]
        let end := _unicodePropertyRanges[offset + 1]
        if ch < start {
            high = middle - 1
        } else if ch > end {
            low = middle + 1
        } else {
            return true
        }
    }
    return false
}

/** Unicode Alphabetic; UAX #44/UTS #51. Rules: rules/library/core-library.md §11.3. */
fn _UnicodeIsAlphabetic(ch: rune) bool {
    return _UnicodeHasProperty(ch, 0, 775)
}

/** Unicode ASCII_Hex_Digit; UAX #44/UTS #51. Rules: rules/library/core-library.md §11.3. */
fn _UnicodeIsAsciiHexDigit(ch: rune) bool {
    return _UnicodeHasProperty(ch, 775, 3)
}

