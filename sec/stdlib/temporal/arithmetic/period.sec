module arithmetic

/*
 * Sec Standard Library — temporal API scaffold
 * Canonical path: stdlib/temporal/arithmetic/period.sec
 * Module: arithmetic
 * Purpose: Calendar-relative period values and explicit month policies.
 * Status: Draft API, NOT IMPLEMENTED, not compiler-verified
 * Revision: 0.1
 * Updated: 2026-10-16
 * Governing rulebook: stdlib/temporal/arithmetic/std-temporal-arithmetic.md
 * Standards / dependencies: Sec std-temporal.md
 * NOTE: Stub results are explicit NotImplemented failures. No successful
 *       behavior is claimed by this file.
 */

/**
 * Represents a calendar-relative period.
 *
 * Description:
 * Components are evaluated in an explicitly selected order
 * and calendar system. They are not normalized automatically.
 *
 * A calendar period is not an elapsed duration.
 * Months and years may have different lengths.
 *
 * Ownership:
 * Copyable value without allocation.
 */
type CalendarPeriod struct {
    // Signed number of calendar-year transitions.
    Years: int,

    // Signed number of consecutive calendar-month transitions.
    // A Hebrew leap year may contain thirteen months.
    Months: int,

    // Signed number of seven-calendar-day steps.
    Weeks: int,

    // Signed number of calendar-day steps.
    Days: int,
}

/**
 * Defines how calendar arithmetic handles an invalid
 * day number in the target month.
 *
 * Description:
 * Applies to missing days, not missing leap months.
 * The policy is applied independently at each operation.
 *
 * It does not preserve month-end intent across repeated
 * calculations; recurrence owns that behavior.
 */
enum MonthEndPolicy {
    // Reject the operation if the target day does not exist.
    Reject,

    // Select the final valid day of the target month.
    Clamp,

    // Continue counting surplus days into the following month.
    RollForward,
}

/**
 * Defines the evaluation order of calendar-period components.
 *
 * Description:
 * Calendar arithmetic is not generally commutative.
 * Applying years before days can produce a different
 * result than applying days before years.
 *
 * Each nonzero component is applied as a separate step.
 * The result of one step becomes the input of the next.
 *
 * The selected MonthEndPolicy applies to each year or
 * month step that produces an invalid target day.
 *
 * Zero-valued components have no effect.
 *
 * Ownership:
 * Copyable enum value without allocation or I/O.
 */
enum PeriodOrder {
    // Apply calendar years, then months, then weeks, then days.
    //
    // Invalid target dates are resolved at each step before
    // the next component is applied. This order is useful
    // when calendar components represent the primary intent.
    YearsMonthsWeeksDays,

    // Apply calendar days, then weeks, then months, then years.
    //
    // Day and week adjustments occur before calendar month
    // and year transitions. This may produce a different
    // result than YearsMonthsWeeksDays.
    DaysWeeksMonthsYears,
}

/**
 * Represents failures in calendar-relative arithmetic.
 *
 * Description:
 * These errors arise when applying calendar periods,
 * changing calendar months or resolving target dates.
 *
 * Invalid calendar targets are distinguished from
 * numeric or representational limits and unsupported
 * calendar algorithms.
 *
 * This type is specific to temporal/arithmetic and
 * does not replace the compiler-known ArithmeticError.
 *
 * Ownership:
 * Copyable error value without allocation or I/O.
 */
enum TemporalArithmeticError error {
    // The requested operation has a declared API but has
    // not yet been implemented.
    //
    // Temporary implementation status. Successful calendar
    // arithmetic must not return this error merely because
    // a particular target date is invalid.
    NotImplemented,

    // The requested operation produces calendar coordinates
    // that cannot be resolved under the selected policy.
    //
    // Examples:
    // - Adding one month to January 31 with MonthEndPolicy.Reject.
    // - Moving a Hebrew leap-month date into a year where
    // that month does not exist.
    //
    // The error indicates a calendar-semantic failure,
    // not integer overflow or an unavailable algorithm.
    InvalidTarget,

    // The calculated result exceeds the supported range
    // of the core date representation or an intermediate
    // calculation cannot be represented safely.
    //
    // No wrapping, truncation, clamping or saturation
    // is permitted as an implicit fallback.
    OutOfRange,

    // The selected calendar system does not support the
    // requested arithmetic operation or its required
    // algorithm is unavailable.
    //
    // This does not indicate that the input date is invalid.
    // Unsupported systems must not silently fall back
    // to Gregorian arithmetic.
    UnsupportedSystem,
}
