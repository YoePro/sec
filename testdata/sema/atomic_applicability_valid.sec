    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn Enum(value: ref Atomic[State], item: State) State {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

