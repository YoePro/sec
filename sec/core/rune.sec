    /** Returns the integer value of a Roman numeral rune. */
    fn _toRomanValue() decimal {
        switch {
            case self in [73r, 105r]:
                return 1
            case self in [86r, 118r]:
                return 5
            case self in [88r, 120r]:
                return 10
            case self in [76r, 108r]:
                return 50
            case self in [67r, 99r]:
                return 100
            case self in [68r, 100r]:
                return 500
            case self in [77r, 109r]:
                return 1000
            case self in 8544r..8555r: // Ⅰ to Ⅻ
                return decimal(int(self) - 8543) // Map to 1-12
            case self in 8560r..8571r: // ⅰ to ⅻ
                return decimal(int(self) - 8559) // Map to 1-12
            case self in [8556r, 8572r]: // Ⅼ and ⅾ
                return 50
            case self in [8557r, 8573r]: // Ⅽ and
                return 100
            case self in [8558r, 8574r]: // Ⅾ and
                return 500
            case self in [8559r, 8575r]: // Ⅿ and
                return 1000
        }
        return 0
    }

    /** Returns the float value of a Unicode fraction rune. */
    fn _toFractionValue() decimal {
        switch {
            case self == 188r: return 0.25 // ¼
            case self == 189r: return 0.5  // ½
            case self == 190r: return 0.75 // ¾
            case self == 8531r: return 1.0 / 3.0 // ⅓
            case self == 8532r: return 2.0 / 3.0 // ⅔
            case self == 8533r: return 1.0 / 5.0 // ⅕
            case self == 8534r: return 2.0 / 5.0 // ⅖
            case self == 8535r: return 3.0 / 5.0 // ⅗
            case self == 8536r: return 4.0 / 5.0 // ⅘
            case self == 8537r: return 1.0 / 6.0 // ⅙
            case self == 8538r: return 5.0 / 6.0 // ⅚
            case self == 8539r: return 1.0 / 8.0 // ⅛
            case self == 8540r: return 3.0 / 8.0 // ⅜
            case self == 8541r: return 5.0 / 8.0 // ⅝
            case self == 8542r: return 7.0 / 8.0 // ⅞
        }
        return 0.0
    }

    fn _toConstantValue() Option[decimal] {
        switch {
            // Pi (π)
            case self in [
                    960r,       // U+03C0 GREEK SMALL LETTER PI
                    982r,       // U+03D6 GREEK PI SYMBOL
                    8508r,      // U+213C DOUBLE-STRUCK SMALL PI
                    120529r,    // U+1D6D1 MATHEMATICAL BOLD SMALL PI
                    120545r,    // U+1D6E1 MATHEMATICAL BOLD PI SYMBOL
                    120587r,    // U+1D70B MATHEMATICAL ITALIC SMALL PI
                    120603r,    // U+1D71B MATHEMATICAL ITALIC PI SYMBOL
                    120645r,    // U+1D745 MATHEMATICAL BOLD ITALIC SMALL PI
                    120661r,    // U+1D755 MATHEMATICAL BOLD ITALIC PI SYMBOL
                    120703r,    // U+1D77F MATHEMATICAL SANS-SERIF BOLD SMALL PI
                    120719r,    // U+1D78F MATHEMATICAL SANS-SERIF BOLD PI SYMBOL
                    120761r,    // U+1D7B9 MATHEMATICAL SANS-SERIF BOLD ITALIC SMALL PI
                    120777r,    // U+1D7C9 MATHEMATICAL SANS-SERIF BOLD ITALIC PI SYMBOL
                ]:
                return Some(3.141592653589793)

                // Euler's number e
            case self == 8519r: // U+2147 DOUBLE-STRUCK ITALIC SMALL E
                return Some(2.718281828459045)

                // Golden ratio φ
            case self in [
                    966r,       // U+03C6 GREEK SMALL LETTER PHI
                    981r,       // U+03D5 GREEK PHI SYMBOL
                    120535r,    // U+1D6D7 MATHEMATICAL BOLD SMALL PHI
                    120543r,    // U+1D6DF MATHEMATICAL BOLD PHI SYMBOL
                    120593r,    // U+1D711 MATHEMATICAL ITALIC SMALL PHI
                    120601r,    // U+1D719 MATHEMATICAL ITALIC PHI SYMBOL
                    120651r,    // U+1D74B MATHEMATICAL BOLD ITALIC SMALL PHI
                    120659r,    // U+1D753 MATHEMATICAL BOLD ITALIC PHI SYMBOL
                    120709r,    // U+1D785 MATHEMATICAL SANS-SERIF BOLD SMALL PHI
                    120717r,    // U+1D78D MATHEMATICAL SANS-SERIF BOLD PHI SYMBOL
                    120767r,    // U+1D7BF MATHEMATICAL SANS-SERIF BOLD ITALIC SMALL PHI
                    120775r,    // U+1D7C7 MATHEMATICAL SANS-SERIF BOLD ITALIC PHI SYMBOL
                ]:
                return Some(1.618033988749895)

                // Euler-Mascheroni constant γ
            case self in [
                    947r,       // U+03B3 GREEK SMALL LETTER GAMMA
                    8509r,      // U+213D DOUBLE-STRUCK SMALL GAMMA
                    120516r,    // U+1D6C4 MATHEMATICAL BOLD SMALL GAMMA
                    120574r,    // U+1D6FE MATHEMATICAL ITALIC SMALL GAMMA
                    120632r,    // U+1D738 MATHEMATICAL BOLD ITALIC SMALL GAMMA
                    120690r,    // U+1D772 MATHEMATICAL SANS-SERIF BOLD SMALL GAMMA
                    120748r,    // U+1D7AC MATHEMATICAL SANS-SERIF BOLD ITALIC SMALL GAMMA
                ]:
                return Some(0.5772156649015328)

                // Reduced Planck constant ℏ, numerical value in J·s.
            case self == 8463r: // U+210F PLANCK CONSTANT OVER TWO PI
                return Some(1.054571817e-34)
        }

        return None
    }
}
