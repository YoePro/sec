module main

type Views struct { Data: ref int[] }
impl Views { fn DataSlice() ref int[] { return self.Data } }

fn Window(values: ref int[]) ref int[] { return ref values[1..<3] }
fn Wrapped(values: ref int[]) Views { return Views { Data: values } }
fn Unwrap(values: Views) ref int[] { return values.Data }

fn Negative(values: int[4]) void {
    let view := ref values[-1..<2]
    discard view
}
fn Descending(values: int[4]) void {
    let view := ref values[3..<1]
    discard view
}
fn Bounds(values: int[4]) void {
    let view := ref values[..4]
    discard view
}
fn SharedToMutable(values: ref int[]) void {
    let view := ref mut values[..]
    discard view
}
fn MutableCopy(values: ref mut int[]) void {
    let copied := values
    discard copied
}
fn MovedHolder(values: ref mut int[]) void {
    let moved :<- values
    let view := ref values[..]
    discard view
    discard moved
}
fn DiscardedHolder(values: ref mut int[]) void {
    let moved :<- values
    discard moved
    let view := ref moved[..]
    discard view
}
fn StaticOverlap() uint {
    let mut values: int[8]
    let left := ref mut values[1..<4]
    let right := ref mut values[3..<6]
    return left.Len + right.Len
}
fn DynamicOverlap(start: uint, finish: uint) uint {
    let mut values: int[8]
    let left := ref mut values[start..<finish]
    let right := ref mut values[start..<finish]
    return left.Len + right.Len
}
fn EmptyIndex() int {
    let mut values: int[0]
    let empty := ref values[..]
    return empty[0]
}
fn LocalDirect() ref int[] {
    let values := [1, 2, 3, 4]
    return ref values[..]
}
fn LocalEmpty() ref int[] {
    let mut values: int[0]
    return ref values[..]
}
fn LocalCall() ref int[] {
    let values := [1, 2, 3, 4]
    return Window(ref values[..])
}
fn LocalCallRange() ref int[] {
    let values := [1, 2, 3, 4]
    return ref Window(ref values[..])[..]
}
fn LocalAggregate() Views {
    let values := [1, 2, 3, 4]
    return Wrapped(ref values[..])
}
fn LocalAggregateField() ref int[] {
    let values := [1, 2, 3, 4]
    let holder := Wrapped(ref values[..])
    return Unwrap(holder)
}
fn StaleReturned() Result[uint, AllocationError] {
    let mut memory: Arena := Arena {}
    let values := try memory.Alloc[int](8u)
    let view := Window(ref values[..])
    memory.Reset()
    return Ok(view.Len)
}

fn LocalMethodField() ref int[] {
    let values := [1, 2, 3, 4]
    let holder := Wrapped(ref values[..])
    return holder.DataSlice()
}
