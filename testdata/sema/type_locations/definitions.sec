module main

type Base int range 1..9 even
type Members int in [1, 3]
type Child Base default 3
type Refined Members even
type Tiny int8 default 128
type Ambiguous int range -9..9 odd
type Text string maxLen 2
type Values int[2] unique

type Container struct {
    ambiguous: Ambiguous,
    invalid: Child,
    callback: fn() void,
}

type GenericContainer[T] struct {
    item: T,
}
