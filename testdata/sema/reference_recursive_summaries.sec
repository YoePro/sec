module recursivereferences

fn Self(value: ref int, flag: bool) ref int {
    if flag { return value }
    return Self(value, true)
}

fn Alpha(value: ref int, flag: bool) ref int {
    if flag { return value }
    return Beta(value)
}

fn Beta(value: ref int) ref int {
    return Alpha(value, true)
}

fn Swap(left: ref int, right: ref int, flag: bool) ref int {
    if flag { return left }
    return Swap(right, left, true)
}

type Pair struct { first: int, second: int }

fn Field(value: ref Pair, flag: bool) ref int {
    if flag { return ref value.first }
    return Field(value, true)
}

impl Pair {
    static fn Recur(value: ref int, flag: bool) ref int {
        if flag { return value }
        return Pair.Recur(value, true)
    }

    fn First(flag: bool) ref int {
        if flag { return ref self.first }
        return self.First(true)
    }
}
