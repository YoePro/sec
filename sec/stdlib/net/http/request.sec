module http

/*
 * Sec Standard Library - net/http - Version-independent HTTP request values and server request metadata
 *
 * File:        stdlib/net/http/request.sec
 * Module:      http
 * Revision:    2
 * Updated:     2026-09-08
 * Author:      Jonas Engström
 *
 * Purpose:
 * Version-independent HTTP request values and server request metadata.
 *
 * Standards:
 * - RFC 9110
 *     https://www.rfc-editor.org/rfc/rfc9110
 *
 * Rulebook:
 * stdlib/net/http/std-net-http.md
 */

import (
    "net/url"
    "net/ip"
)

// HTTP request (std-net-http.md § 14.2).
//
// Request represents the protocol-level HTTP message. Transport metadata
// such as endpoints and TLS state belongs to ServerRequest/ConnectionInfo.
// The request is move-only through its owned Body.
type Request struct {
    // HTTP method, including extension methods.
    Method: Method,

    // The request-target in exactly one of its four forms.
    Target: RequestTarget,

    // Request header fields.
    Header: Header,

    // Request trailer fields.
    Trailer: Header,

    // Owned message body; empty unless set.
    Body: Body,
}

impl Request {
    /**
     * Creates a request with an empty header, trailer and body.
     */
    init(method: Method, target: RequestTarget) {
        self.Method = method
        self.Target = target
    }

    /** Creates a GET request for an absolute-form target. */
    static fn Get(url: url.URL) Request {
        return new Request(Method.GET, RequestTarget.Absolute(url))
    }

    /** Creates a HEAD request for an absolute-form target. */
    static fn Head(url: url.URL) Request {
        return new Request(Method.HEAD, RequestTarget.Absolute(url))
    }

    /** Creates a POST request for an absolute-form target that owns body. */
    static fn Post(url: url.URL, ->body: Body) Request {
        let mut request := new Request(Method.POST, RequestTarget.Absolute(url))
        request.SetBody(<-body)
        return request
    }

    /** Creates a PUT request for an absolute-form target that owns body. */
    static fn Put(url: url.URL, ->body: Body) Request {
        let mut request := new Request(Method.PUT, RequestTarget.Absolute(url))
        request.SetBody(<-body)
        return request
    }

    /** Creates a PATCH request for an absolute-form target that owns body. */
    static fn Patch(url: url.URL, ->body: Body) Request {
        let mut request := new Request(Method.PATCH, RequestTarget.Absolute(url))
        request.SetBody(<-body)
        return request
    }

    /** Creates a DELETE request for an absolute-form target. */
    static fn Delete(url: url.URL) Request {
        return new Request(Method.DELETE, RequestTarget.Absolute(url))
    }

    /**
     * Creates a QUERY request (RFC 10008) for an absolute-form target that
     * owns body.
     */
    static fn Query(url: url.URL, ->body: Body) Request {
        let mut request := new Request(Method.QUERY, RequestTarget.Absolute(url))
        request.SetBody(<-body)
        return request
    }

    /**
     * Replaces the body, closing the previous one first.
     *
     * Description:
     * A close failure of the previous body is not reported: the body is
     * being discarded and is released by its destructor either way.
     */
    fn SetBody(->body: Body) void {
        discard self.Body.Close()
        self.Body <- body
    }

    /**
     * Validates the request before transport selection.
     *
     * Description:
     * Checks that the method is a non-empty RFC 9110 token, that it is not
     * a reserved method (PRI, *), and that the target form matches the
     * method (RFC 9112 § 3.2): authority-form only and always for CONNECT,
     * asterisk-form only for OPTIONS, origin- or absolute-form otherwise.
     *
     * Errors:
     * - MessageError.InvalidMethod: The method is empty or not a token.
     * - MessageError.ReservedMethod: The method is PRI or "*".
     * - MessageError.InvalidTarget: The target form does not fit the method.
     *
     * Standards:
     * - RFC 9110 § 5.6.2 and § 9.1
     * - RFC 9112 § 3.2
     */
    fn Validate() Result[void, MessageError] {
        if self.Method.IsReserved {
            return Err(MessageError.ReservedMethod)
        }
        if !_IsMethodToken(string(self.Method)) {
            return Err(MessageError.InvalidMethod)
        }

        let isConnect := self.Method == Method.CONNECT
        match self.Target {
            RequestTarget.Authority(_) => {
                if !isConnect {
                    return Err(MessageError.InvalidTarget)
                }
            }

            RequestTarget.Asterisk => {
                if self.Method != Method.OPTIONS {
                    return Err(MessageError.InvalidTarget)
                }
            }

            RequestTarget.Origin(_) => {
                if isConnect {
                    return Err(MessageError.InvalidTarget)
                }
            }

            RequestTarget.Absolute(_) => {
                if isConnect {
                    return Err(MessageError.InvalidTarget)
                }
            }
        }

        return Ok()
    }

    /**
     * Returns the URL of an absolute-form target, otherwise None.
     */
    property Url: Option[url.URL] {
        get {
            match self.Target {
                RequestTarget.Absolute(value) => {
                    return Some(value)
                }

                RequestTarget.Origin(_) => {
                    return None
                }

                RequestTarget.Authority(_) => {
                    return None
                }

                RequestTarget.Asterisk => {
                    return None
                }
            }
        }
    }

    /**
     * Reports whether the body may carry content.
     *
     * Description:
     * False only when the body is known to be empty (known length zero);
     * it does not infer absence from the method name.
     */
    property HasBody: bool {
        get {
            match self.Body.Length {
                Some(length) => {
                    return length != 0
                }

                None => {
                    return true
                }
            }
        }
    }

    /**
     * Releases the owned body.
     */
    free {
        discard self.Body.Close()
    }
}

// Reports whether value is a non-empty RFC 9110 token:
// 1*tchar, tchar = ALPHA / DIGIT / "!#$%&'*+-.^_`|~".
fn _IsMethodToken(value: string) bool {
    if value.SizeOf == 0 {
        return false
    }
    for current in value {
        let isTchar := (current.IsAscii && current.IsLetterOrDigit) || current in [
            '!', '#', '$', '%', '&', '\'', '*', '+', '-', '.', '^', '_', '`', '|', '~',
        ]
        if !isTchar {
            return false
        }
    }
    return true
}

type OriginTarget string

impl OriginTarget {
    /**
     * Parses and validates an HTTP origin-form request target.
     *
     * Description:
     * Origin-form consists of an absolute path beginning with '/' followed by
     * an optional query component. Percent-encoded octets must contain exactly
     * two hexadecimal digits.
     *
     * Fragment identifiers, whitespace, control characters, non-ASCII
     * characters, and characters outside the RFC URI path/query grammar are
     * rejected.
     *
     * Parameters:
     * - value: Raw origin-form request target.
     *
     * Returns:
     * A validated OriginTarget preserving the original encoded representation.
     *
     * Errors:
     * - MessageError.InvalidTarget: value is not valid HTTP origin-form.
     *
     * Standards:
     * - RFC 9112 Section 3.2.1
     * - RFC 3986 Sections 3.3 and 3.4
     */
    static fn Parse(value: string) Result[OriginTarget, MessageError] {
        if value.SizeOf == 0 {
            return Err(MessageError.InvalidTarget)
        }

        if char(value.ByteAt(0)) != '/' {
            return Err(MessageError.InvalidTarget)
        }

        let mut index: uint := 0
        let mut query := false

        while index < value.SizeOf {
            let current := value.CharAt(index)

            if current == '%' {
                let remaining := value.SizeOf - index

                if remaining < 3 {
                    return Err(MessageError.InvalidTarget)
                }

                let high := value.CharAt(index + 1)
                let low  := value.CharAt(index + 2)

                if !high.IsHexDigit || !low.IsHexDigit {
                    return Err(MessageError.InvalidTarget)
                }

                index += 3
                continue
            }

            if current == '?' {
                query = true
                index += 1
                continue
            }

            if current == '/' {
                index += 1
                continue
            }

            if !_IsRequestTargetChar(current) {
                return Err(MessageError.InvalidTarget)
            }

            index += 1
        }

        return Ok(OriginTarget(value))
    }

    static fn _IsRequestTargetChar(value: char) bool {
        return value.IsLetterOrDigit ||
            rune(value) in [
                '-', '.', '_', '~',
                '!', '$', '&', '\'', '(', ')',
                '*', '+', ',', ';', '=',
                ':', '@',
            ]
    }

    /**
     * Returns the validated origin-form request target.
     */
    fn ToString() Result[string, StringError] {
        return Ok(string(self))
    }
}

type AuthorityTarget string

type RequestTarget union {
    Origin(OriginTarget),
    Absolute(url.URL),
    Authority(AuthorityTarget),
    Asterisk,
}

type ConnectionInfo struct {
    LocalEndpoint:  ip.Endpoint,
    RemoteEndpoint: ip.Endpoint,
    Version:        Version,
    Secure:         bool,
}

@noCopy
type ServerRequest struct {
    Message:    Request,
    Connection: ConnectionInfo,
}
