module main

type Handle struct { id: int }
impl Handle { free {} }

fn Make(id: int) Handle { return Handle { id: id } }
fn Echo(value: Handle) Handle { return <-value }
fn Read(value: ref Handle) int { return value.id }
fn Maybe(id: int) Result[Handle, IndexError] { return Ok(Make(id)) }

fn Returned(value: Option[int]) void {
    match value {
        Some(n) => Make(n)
        None => Make(0)
    }
}

fn Payload(value: Option[Handle], enabled: bool) void {
    match value {
        Some(handle) where enabled => Echo(<-handle)
        Some(handle) => Read(handle)
        None => {}
    }
}

fn ArmBlock(value: Option[int]) void {
    match value {
        Some(n) => {
            let local := Make(n)
            Make(90)
        }
        None => {}
    }
}

fn Temporary(value: Option[int]) void {
    match value {
        Some(n) => Read(Make(n))
        None => 0
    }
}

fn Tried(value: Option[int]) Result[int, IndexError] {
    match value {
        Some(n) => try Maybe(n)
        None => {}
    }
    return Ok(0)
}
