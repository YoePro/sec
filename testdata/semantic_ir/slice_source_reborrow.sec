module main

fn Full(values: int[8]) void {
    let source := ref values[1..<7]
    let child := ref source[..]
    let nested := ref child[1..<3]
    discard nested
    discard child
    discard source
}

fn Empty(values: int[0]) void {
    let source := ref values[..]
    let empty := ref source[..]
    discard empty
    discard source
}

fn Mutable() void {
    let mut values := [1, 2, 3, 4]
    let source := ref mut values[..]
    let child := ref mut source[1..<3]
    let shared := ref child[..]
    discard shared
    discard child
    discard source
}

fn Dynamic(values: int[8], start: int128, finish: uint256) void {
    let source := ref values[1..<7]
    let child := ref source[start..finish]
    discard child
    discard source
}

fn First() int { return 1 }
fn Last() int { return 3 }
fn Order(values: int[8]) void {
    let source := ref values[1..<7]
    let child := ref source[First()..<Last()]
    discard child
    discard source
}
