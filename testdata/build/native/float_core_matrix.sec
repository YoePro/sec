    let nan := float.NaN
    let infinity := float.Infinity
    let largest := float.Max
    let minimum := float.Min
    let epsilon := float.Epsilon
    let mut smallest: float := one
    let mut smallestNormal: float := one
    for i in 0..<1100 {
        let next := smallest / two
        if next.IsNormal() { smallestNormal = next }
        if next == zero { break }
        smallest = next
    }
    let largestSubnormal := smallestNormal - smallest
    if !one.IsNormal() || !largest.IsNormal() || !smallestNormal.IsNormal() || !largestSubnormal.IsSubnormal() || !smallest.IsSubnormal() {
