module http

/*
* Sec Standard Library - net/http - Cookie and Set-Cookie value types
*
* File:        stdlib/net/http/cookie.sec
* Module:      http
* Revision:    2
* Updated:     2026-09-08
* Author:      Jonas Engström
*
* Purpose:
*   Cookie and Set-Cookie value types.
*
* Standards:
*   - RFC 10025
*     https://www.rfc-editor.org/info/rfc10025
*
* Rulebook:
*   stdlib/net/http/std-net-http.md
*/

// HTTP cookie value types.
//
// Cookie is the common name/value pair carried by both Cookie and Set-Cookie.
// SetCookie contains that pair plus the response attributes that control how a
// user agent stores and later sends it.
//
// Primary specification:
//     RFC 10025 — HTTP State Management Mechanism
//
// Sec rulebook:
//     TODO: create the canonical net/http cookie rulebook before this API is
//     declared stable.

enum SameSite {
    Strict,
    Lax,
    None,
}

// Cookie is the name/value pair visible in an HTTP Cookie request header.
// Response-only attributes are intentionally absent because the request header
// does not carry them.
type Cookie struct {
    Name: string,
    Value: string,
}

impl Cookie {
    /**
    * Creates a cookie pair from a name and value.
    *
    * Construction does not imply HTTP validity. Validate() performs protocol
    * validation before serialization.
    *
    * Specification:
    *   - RFC 10025 — cookie-pair
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — Cookie construction
    */
    init(name: string, value: string) {
        self.Name = name
        self.Value = value
    }

    /**
    * Validates this cookie pair for HTTP serialization.
    *
    * Only the common name/value pair is validated here. Set-Cookie-specific
    * attributes are validated by SetCookie.Validate().
    *
    * Specification:
    *   - RFC 10025 — cookie-pair
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — Cookie validation
    */
    fn Validate() Result[void, CookieError] {
        // TODO: Implement http.Cookie.Validate
        return Err(CookieError.InvalidName)
    }

    /**
    * Serializes this cookie pair as "name=value".
    *
    * The operation must not silently apply URL decoding or reinterpret the
    * stored value.
    *
    * Specification:
    *   - RFC 10025 — Cookie header field
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — Cookie serialization
    */
    fn ToString() Result[string, CookieError] {
        // TODO: Implement http.Cookie.ToString()
        return Err(CookieError.InvalidName)
    }
}

// SetCookie is a Cookie pair plus response-side attributes from Set-Cookie.
//
// Pair makes the relationship explicit in the data model. Name and Value are
// surfaced as properties so ordinary callers do not need to write
// setCookie.Pair.Name or setCookie.Pair.Value.
type SetCookie struct {
    Pair: Cookie,

    Path: Option[string],
    Domain: Option[string],
    Expires: Option[datetime],
    MaxAge: Option[int64],

    Secure: bool,
    HttpOnly: bool,
    SameSite: Option[SameSite],

    // Contemporary extension; not part of the RFC 10025 core attribute set.
    Partitioned: bool,

    // Preserves unknown Set-Cookie extension attributes for forward
    // compatibility without allocating an empty dynamic array in the common
    // case.
    Extensions: Option[string[]],
}

impl SetCookie {
    /**
    * Creates a Set-Cookie value with only a cookie name and value.
    *
    * Optional attributes are absent and flag attributes are disabled until
    * explicitly configured by the caller.
    *
    * Specification:
    *   - RFC 10025 — Set-Cookie header field
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — SetCookie construction
    */
    init(name: string, value: string) {
        self.Pair = new Cookie(name, value)
        self.Path = None
        self.Domain = None
        self.Expires = None
        self.MaxAge = None
        self.Secure = false
        self.HttpOnly = false
        self.SameSite = None
        self.Partitioned = false
        self.Extensions = None
    }

    property Name: string {
        get {
            return self.Pair.Name
        }
    }

    property Value: string {
        get {
            return self.Pair.Value
        }
    }

    /**
    * Validates the complete Set-Cookie value.
    *
    * Validation includes the cookie pair, response attributes, security
    * prefix requirements, and cross-attribute requirements.
    *
    * Specification:
    *   - RFC 10025 — Set-Cookie processing and cookie name prefixes
    *   - Partitioned cookie extension requirements
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — SetCookie validation
    */
    fn Validate() Result[void, CookieError] {
        // TODO: Implement http.SetCookie.Validate
        return Err(CookieError.InvalidName)
    }

    /**
    * Serializes this value for one Set-Cookie response header field.
    *
    * Serialization is strict. Sec must not knowingly emit an invalid
    * Set-Cookie value by silently dropping or rewriting invalid attributes.
    *
    * Specification:
    *   - RFC 10025 — Set-Cookie header field
    *
    * Sec:
    *   - TODO: net/http cookie rulebook — SetCookie serialization
    */
    fn ToString() Result[string, CookieError] {
        // TODO: Implement http.SetCookie.ToString()
        return Err(CookieError.InvalidName)
    }
}
