type RedirectPolicy struct {
    MaxRedirects: uint8,
    AllowCrossOrigin: bool,
    PreserveSensitiveHeaders: bool,
}

impl RedirectPolicy {

    // TODO: Implement http.RedirectPolicy.Default()
    static fn Default() RedirectPolicy {
        return new RedirectPolicy()
    }
}
