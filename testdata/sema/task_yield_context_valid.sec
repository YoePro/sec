module main

fn Pause() void {
    Task.Yield()
}

fn ViaValue() void {
    let pause := Pause
    pause()
}

fn Deferred() void {
    defer {
        Pause()
    }
}

fn main() void {
    Thread.Yield()
    let direct := try spawn Pause() { Err(_) => { return } }
    await direct
    let indirect := try spawn ViaValue() { Err(_) => { return } }
    await indirect
    let deferred := try spawn Deferred() { Err(_) => { return } }
    await deferred
}
