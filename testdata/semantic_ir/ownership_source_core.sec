module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

type Pair struct {
    left:  Handle,
    count: int,
    right: Handle,
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn Sink(->handle: Handle) void {
}

fn Maybe(id: int) Result[Handle, IndexError] {
    return Ok(Make(id))
}

fn EarlyExit(flag: bool) int {
    let handle := Make(1)
    if flag {
        return handle.id
    }
    return 2
}

fn Moved() Handle {
    let handle := Make(1)
    let next   :<- handle
    return next
}

fn Consumed(flag: bool) void {
    let handle := Make(1)
    if flag {
        Sink(<-handle)
    }
}

fn Replaced() void {
    let mut handle := Make(1)
    handle = Make(2)
    let next :<- handle
    handle = Make(3)
    Sink(<-next)
}

fn Aggregate() int {
    let pair := Pair { left: Make(1), count: 2, right: Make(3) }
    return pair.count
}

fn Loops() int {
    for index in 0..<2 {
        let handle := Make(index)
        if index == 1 {
            break
        }
    }
    let mut count := 0
    while count < 2 {
        let handle := Make(count)
        count += 1
        if count == 1 {
            continue
        }
    }
    return count
}

fn Propagated() Result[int, IndexError] {
    let handle := try Maybe(1)
    return Ok(handle.id)
}

fn Handled() int {
    let handle := try Maybe(1) {
        Err(_) => {
            return 0
        }
    }
    return handle.id
}

fn Elements() Handle[2] {
    let first  := Make(1)
    let second := Make(2)
    return [<-first, <-second]
}

fn Parameter(handle: Handle) Handle {
    return handle
}

fn Elements2() Handle[2] {
    return [Make(1), Make(2)]
}

fn Discards() void {
    discard Make(1)
    Make(2)
    discard Elements2()
    Elements2()
}

fn NamedDiscards(flag: bool) void {
    let first := Make(1)
    discard first
    discard first
    let second := Make(2)
    Sink(<-second)
    discard second
    let third := Make(3)
    if flag {
        discard third
    }
    let mut fourth := Make(4)
    discard fourth
    fourth = Make(5)
}

fn Observe(value: int) void {
}

fn Deferred(flag: bool) int {
    let fixed     := 1
    let mut count := 2
    defer {
        Observe(fixed)
        Observe(count)
        count = 5
    }
    count = 3
    defer {
        Observe(9)
    }
    let handle := Make(1)
    if flag {
        return count
    }
    for index in 0..<2 {
        defer {
            Observe(fixed)
        }
    }
    return handle.id
}
