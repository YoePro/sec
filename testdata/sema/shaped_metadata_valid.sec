module main

fn ShapeFacts(a: uint, b: uint) uint {
    let s := Shape[3] { 2, 0, 4 }
    let copy := s
    let dynamic := Shape[2] { a, b }
    let built := new Shape[2]([a, b])
    let i: uint := 1
    return s.Rank + copy[0] + s[i] + dynamic.Rank + built[1]
}

fn StrideFacts() int {
    let st := Strides[3] { -1, 0, 4 }
    let built := new Strides[2]([3, -2])
    return st[0] + built[1]
}

fn LayoutName(l: TensorLayout[3]) int {
    switch l {
        case TensorLayout[3].DenseRowMajor:
            return 1
        case TensorLayout[3].DenseColumnMajor:
            return 2
        case TensorLayout[3].Strided:
            return 3
    }
}

fn AxesFacts(values: uint[3]) Result[uint, ShapeError] {
    let fixed := Axes[3] { 2, 0, 1 }
    let runtime := try new Axes[3](values)
    let selection := AxisList[2] { 1, 3 }
    let picked := try new AxisList[2]([0, 5])
    return Ok(fixed[0] + runtime.Rank + selection.Count + picked[1])
}

fn Errors() ShapeError {
    return ShapeError.DuplicateAxis
}
