module main
enum Wide uint16 { Small = 1, Large = 300 }
enum Fits int16 { Low = -128, High = 127, Alias = 127 }
enum Generic[T] uint16 { Small = 1, Large = 300 }
fn Constant() uint8 { return uint8(Wide.Small) }
fn Domain(value: Fits) int8 { return int8(value) }
fn Fallible(value: Wide) uint8 { return try uint8(value) { Err(_) => 0 } }
fn Concrete() uint8 { return uint8(Generic[int].Small) }
fn Read(value: Wide) uint8 { return 1 }
fn Ordinary(value: Wide) uint8 { return Read(value) }
fn Nested() uint8 { return uint8(Generic[Wide].Small) }
type Box[T] struct { Value: T }
type FixedBox Box[int]
fn Fixed() uint8 { return uint8(Generic[FixedBox].Small) }
enum Words string { One = "one" }
fn TextArg() uint8 { return uint8(Generic[Words].Small) }
enum PlanWide uint32 { Zero = 0, Maximum = 4294967295 }
fn Platform(value: PlanWide) int { return int(value) }
