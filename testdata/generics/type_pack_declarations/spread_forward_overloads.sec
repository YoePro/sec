module main

fn Pick(a: int) int {
    return 1
}

fn Pick(a: bool) int {
    return 2
}

fn Pick(a: int, b: int) int {
    return 3
}

fn Variadic(a: int, b: int) int {
    return a * 10 + b
}

fn Choose[...Types](values: ...Types) int {
    return Pick(values...)
}

fn Trailing[...Types](values: ...Types) int {
    return Variadic(values..., 7)
}

type Counter struct {
    Total: uint,
}

impl Counter {
    static fn Make[...Types](values: ...Types) uint {
        return values.Len
    }
}

fn ThroughStatic[...Types](values: ...Types) uint {
    return Counter.Make(values...)
}

fn main() int {
    if Choose(5) != 1 {
        return 1
    }
    if Choose(true) != 2 {
        return 2
    }
    if Choose(5, 6) != 3 {
        return 3
    }
    if Trailing(3) != 37 {
        return 4
    }
    if ThroughStatic(1, true) != 2 {
        return 5
    }
    return 0
}
