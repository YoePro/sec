module ip

type Port uint16

type Ipv4Endpoint struct {
    Address: Ipv4Address,
    Port:    Port,
}

type Ipv6Endpoint struct {
    Address: Ipv6Address,
    Port:    Port,
    Zone:    Option[InterfaceIndex],
}

type Endpoint union {
    V4(Ipv4Endpoint),
    V6(Ipv6Endpoint),
}

impl Ipv4Endpoint {
    init(address: Ipv4Address, port: Port) {
        self.Address = address
        self.Port = port
    }

    fn ToString() string {
        return "" + self.Address.ToString() + ":" + self.Port.ToString()
    }
}

impl Ipv6Endpoint {
    init(address: Ipv6Address, port: Port, zone: Option[InterfaceIndex]) {
        self.Address = address
        self.Port = port
        self.Zone = zone
    }

    fn ToString() string {
        return "" + self.Address.ToString() + ":" + self.Port.ToString()
    }
}

impl Endpoint {
    property Version: IpVersion {
        get {
            match self {
                V4(_) => {
                    return IpVersion.V4
                }
                V6(_) => {
                    return IpVersion.V6
                }
            }
        }
    }
    property Port: Port {
        get {
            match self {
                V4(ref v4) => {
                    return v4.Port
                }
                V6(ref v6) => {
                    return v6.Port
                }
            }
        }
    }
    property Address: Address {
        get {
            match self {
                V4(ref v4) => {
                    return v4.Address
                }
                V6(ref v6) => {
                    return v6.Address
                }
            }
        }
    }

    fn ToString() string {
        match self {
            V4(ref v4) => {
                return v4.ToString()
            }
            V6(ref v6) => {
                return v6.ToString()
            }
        }
    }
}
