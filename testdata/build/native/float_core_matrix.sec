fn main() int {
    let f32 := CoreF32(1.0, 2.0)
    if f32 != 0 { return f32 }
    let f64 := CoreF64(1.0, 2.0)
    if f64 != 0 { return f64 + 32 }
    let platform := CorePlatform(1.0, 2.0)
    if platform != 0 { return platform + 64 }
    return 0
}
