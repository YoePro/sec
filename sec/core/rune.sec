module core

// TODO: Implement rune correctly

impl rune {
    /** Returns the textual representation of this rune. */
    fn ToString() Result[string, StringError] {
        let runes: rune[1] := [self]
        return runes.ToString()
    }

    /** Reports whether this rune is an ASCII decimal digit. */
    property IsDigit: bool {
        get {
            return self in 48r..57r
        }
    }

    /** Reports whether this rune is a decimal digit in any Unicode numbering system. */
    property IsUnicodeDigit: bool {
        get {
            // Fast path: Standard ASCII digits
            if self <= 127r {
                return self in 48r..57r
            }

            // Compile-time constant array containing international decimal digit ranges (0-9)
            let r := [
                1632r..1641r,   // Arabic-Indic Digits (٠..٩)
                1776r..1785r,   // Extended Arabic-Indic Digits (۰..۹)
                2406r..2415r,   // Devanagari Digits (०..९)
                2416r..2425r,   // Bengali Digits
                2544r..2553r,   // Gurmukhi Digits
                2662r..2671r,   // Gujarati Digits
                2790r..2799r,   // Oriya Digits
                2918r..2927r,   // Tamil Digits
                3046r..3055r,   // Telugu Digits
                3174r..3183r,   // Kannada Digits
                3302r..3311r,   // Malayalam Digits
                3430r..3439r,   // Thai Digits
                3558r..3567r,   // Lao Digits
                3664r..3673r,   // Tibetan Digits
                65296r..65305r,  // Fullwidth Digits (０..９)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a letter, ASCII or Unicode. */
    property IsLetter: bool {
        get {
            // Fast path: ASCII
            if self <= 127r {
                return (self in 65r..90r) || (self in 97r..122r)
            }

            // Reuse our logic for bicameral scripts
            if self.IsLowerLetter || self.IsUpperLetter {
                return true
            }

            // Compile-time constant array for major unicameral scripts (Hebrew, Arabic, CJK, etc.)
            let r := [
                1425r..1524r,   // Hebrew
                1536r..1791r,   // Arabic
                2304r..2431r,   // Devanagari (Hindi)
                12352r..12447r, // Hiragana (Japanese)
                12448r..12543r, // Katakana (Japanese)
                19968r..40959r, // CJK Unified Ideographs (Chinese, Japanese, Korean)
                44032r..55215r,  // Hangul Syllables (Korean)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a lowercase letter */
    property IsLowerLetter: bool {
        get {
            // Fast path: ASCII är det absolut vanligaste fallet
            if self <= 127r {
                return self in 97r..122r
            }

            let r := [
                224r..246r,     // Latin-1 Supplement (à..ö)
                248r..255r,     // Latin-1 Supplement (ø..ÿ)
                257r..383r,     // Latin Extended-A
                385r..563r,     // Latin Extended-B
                565r..591r,     // Latin Extended-B (additional)
                945r..969r,     // Greek and Coptic (lowercase alpha..omega)
                970r..1019r,    // Greek symbols and Coptic lowercase additions
                1072r..1103r,   // Cyrillic (lowercase)
                1105r..1119r,   // Cyrillic extensions
                1377r..1416r,   // Armenian (lowercase)
                4304r..4338r,   // Georgian Mkhedruli (lowercase)
                11264r..11310r, // Glagolitic (lowercase)
                13824r..13923r, // Cherokee syllables (lowercase)
                65345r..65370r,  // Halfwidth and Fullwidth Forms (Fullwidth lowercase a..z)
            ]
            return self in r
        }
    }

    /** Reports whether this rune is an uppercase letter */
    property IsUpperLetter: bool {
        get {
            if self <= 127r {
                return self in 65r..90r
            }
            let r := [
                192r..214r,     // Latin-1 Supplement (À..Ö)
                216r..222r,     // Latin-1 Supplement (Ø..Þ)
                256r..382r,     // Latin Extended-A
                384r..562r,     // Latin Extended-B
                564r..590r,     // Latin Extended-B (additional)
                912r..939r,     // Greek and Coptic (uppercase Alpha..Omega)
                940r..944r,     // Greek uppercase additions and accented forms
                1040r..1071r,   // Cyrillic (uppercase)
                1024r..1039r,   // Cyrillic extensions
                1329r..1368r,   // Armenian (uppercase)
                4256r..4293r,   // Georgian Asomtavruli/Mtavruli (uppercase)
                11204r..11249r, // Glagolitic (uppercase)
                5024r..5108r,   // Cherokee syllables (uppercase)
                65313r..65338r,  // Halfwidth and Fullwidth Forms (Fullwidth uppercase A..Z)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is an ASCII letter or decimal digit. */
    property IsLetterOrDigit: bool {
        get {
            return self.IsLetter || self.IsDigit
        }
    }

    /** Reports whether this rune is a Unicode letter or decimal digit. */
    property IsUnicodeLetterOrDigit: bool {
        get {
            return self.IsLetter || self.IsUnicodeDigit
        }
    }

    /** Reports whether this rune belongs to a standard Unicode Emoji block. */
    property IsEmoji: bool {
        get {
            // Fast path: ASCII contains no standalone emojis
            if self <= 127r {
                return false
            }

            // Compile-time constant array containing main Unicode Emoji ranges
            let r := [
                8986r..8987r,     // Watch & Hourglass elements
                9200r..9203r,     // Alarm clock, Stopwatch, Timer
                9728r..9999r,     // Miscellaneous Symbols & Dingbats
                10084r..10175r,   // Heavy Dingbats additions
                11088r..11093r,   // Star and geometric shapes used as emoji
                126980r..127569r, // Mahjong, Dominoes, and Cultural Symbols
                127744r..128591r, // Transport, Map, and Miscellaneous Symbols
                128640r..128767r, // Transport and Map Symbols extended
                128768r..128895r, // Geometric Shapes Extended
                128992r..129039r, // Supplemental Symbols and Pictographs
                129292r..129791r, // Symbols and Pictographs Extended-A
                129792r..131071r,  // Extended Pictographs & future additions
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a whitespace character according to Unicode. */
    property IsWhitespace: bool {
        get {
            // Fast path: ASCII whitespace characters (\t, \n, \r, space)
            if self <= 127r {
                return self == 9r || self == 10r || self == 13r || self == 32r
            }

            // Compile-time constant array containing Unicode separator and whitespace spaces
            let r := [
                160r,         // No-Break Space
                8192r..8202r, // En Space, Em Space, Thin Space, Hair Space, etc.
                8232r,        // Line Separator
                8233r,        // Paragraph Separator
                8239r,        // Narrow No-Break Space
                8287r,        // Medium Mathematical Space
                12288r,        // Ideographic Space (CJK / Chinese-Japanese-Korean)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is an ASCII control character. */
    property IsControl: bool {
        get {
            return self < 32r || self in 127r..159r
        }
    }

    /** Reports whether this rune is a punctuation character according to Unicode. */
    property IsPunctuation: bool {
        get {
            // Fast path: ASCII punctuation characters
            if self <= 127r {
                return (self in 33r..47r) || (self in 58r..64r) || (self in 91r..96r) || (self in 123r..126r)
            }

            // Compile-time constant array containing Unicode punctuation ranges
            let r := [
                161r,         // Inverted Exclamation Mark
                162r,         // Cent Sign
                163r,         // Pound Sign
                164r,         // Currency Sign
                165r,         // Yen Sign
                166r,         // Broken Bar
                167r,         // Section Sign
                168r,         // Diaeresis
                169r,         // Copyright Sign
                170r,         // Feminine Ordinal Indicator
                171r,         // Left-Pointing Double Angle Quotation Mark
                172r,         // Not Sign
                173r,         // Soft Hyphen
                174r,         // Registered Sign
                175r,         // Macron
                176r..191r,   // Miscellaneous Symbols and Punctuation
                8943r..8959r, // Miscellaneous Technical Symbols and Punctuation
                11840r..11871r, // Supplemental Punctuation
                12289r..12319r,  // CJK Symbols and Punctuation (Asian quotes/brackets)
                65072r..65103r,  // Halfwidth and Fullwidth Forms (Fullwidth punctuation)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a printable character according to Unicode. */
    property IsPrintable: bool {
        get {
            return !self.IsControl
        }
    }

    /** Reports whether this rune is a hexadecimal 'digit' */
    property IsHexDigit: bool {
        get {
            // 0 - 9, A-F, a-f
            return (self in 48r..57r) || (self in 65r..70r) || (self in 97r..102r)
        }
    }

    /** Reports whether this rune belongs to the ASCII range. */
    property IsAscii: bool {
        get {
            return self <= 127r
        }
    }

    /** Reports whether this rune is an ASCII letter (A-Z, a-z). */
    property IsAsciiLetter: bool {
        get {
            return (self in 65r..90r) || (self in 97r..122r)
        }
    }

    /** Reports whether this rune is a newline character. */
    property IsNewline: bool {
        get {
            return self == 10r || self == 13r || self == 8232r || self == 8233r
        }
    }

    /** Reports whether this rune is a letter, digit, or underscore. */
    property IsLetterOrDigitOrUnderscore: bool {
        get {
            return self.IsLetterOrDigit || self == 95r
        }
    }

    /** Reports whether this rune is a symbol character according to Unicode. */
    property IsSymbol: bool {
        get {
            // Fast path: ASCII symbols
            if self <= 127r {
                return self == 36r || self == 43r || self == 60r || self == 61r || self == 62r || self == 94r || self == 124r || self == 126r
            }

            // Compile-time constant array containing Unicode symbol ranges
            let r := [
                162r,         // Cent Sign
                163r,         // Pound Sign
                164r,         // Currency Sign
                165r,         // Yen Sign
                166r,         // Broken Bar
                167r,         // Section Sign
                168r,         // Diaeresis
                169r,         // Copyright Sign
                170r,         // Feminine Ordinal Indicator
                171r,         // Left-Pointing Double Angle Quotation Mark
                172r,         // Not Sign
                173r,         // Soft Hyphen
                174r,         // Registered Sign
                175r,         // Macron
                176r..191r,   // Miscellaneous Symbols and Punctuation
                8943r..8959r, // Miscellaneous Technical Symbols and Punctuation
                11840r..11871r, // Supplemental Punctuation
                12289r..12319r,  // CJK Symbols and Punctuation (Asian quotes/brackets)
                65072r..65103r,  // Halfwidth and Fullwidth Forms (Fullwidth punctuation)
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a titlecase letter according to Unicode. */
    property IsTitleLetter: bool {
        get {
            // Fast path: ASCII titlecase letters are the same as uppercase letters
            if self <= 127r {
                return self in 65r..90r
            }

            // Compile-time constant array containing Unicode titlecase letters
            let r := [
                453r,         // Latin Capital Letter D with Stroke (titlecase)
                456r,         // Latin Capital Letter L with Stroke (titlecase)
                459r,         // Latin Capital Letter T with Stroke (titlecase)
                498r,         // Latin Capital Letter G with Stroke (titlecase)
                500r,         // Latin Capital Letter K with Stroke (titlecase)
                502r,         // Latin Capital Letter N with Stroke (titlecase)
                504r,         // Latin Capital Letter O with Stroke (titlecase)
                506r,         // Latin Capital Letter R with Stroke (titlecase)
                508r,         // Latin Capital Letter S with Stroke (titlecase)
                510r,         // Latin Capital Letter T with Stroke (titlecase)
                512r..575r,   // Latin Extended-A titlecase letters
                7680r..7935r, // Latin Extended-B titlecase letters
                11360r..11391r, // Glagolitic titlecase letters
            ]

            return self in r
        }
    }

    /** Reports whether this rune is a noncharacter according to Unicode. */
    property IsNoncharacter: bool {
        get {
            // TODO: Determine if this is the correct way to check for noncharacters in Unicode. Are emojis considered noncharacters? Should we include the range 0xFDD0..0xFDEF?
            // TODO: Validate this as it seems to be a compiler issue
            return (self in 0xFDD0r..0xFDEFr) // || (int(self) & 0xFFFE == 0xFFFE)
        }
    }

    /** Reports whether this rune is a valid Unicode code point. */
    property IsValid: bool {
        get {
            return self <= 0x10FFFFr && !self.IsNoncharacter
        }
    }

    /** Reports whether this rune is a combining mark according to Unicode. */
    property IsCombiningMark: bool {
        get {
            // Fast path: ASCII has no combining marks
            if self <= 127r {
                return false
            }

            // Compile-time constant array containing Unicode combining mark ranges
            let r := [
                768r..879r,     // Combining Diacritical Marks
                1155r..1159r,   // Combining Diacritical Marks Supplement
                1425r..1479r,   // Combining Diacritical Marks Extended
                65056r..65071r, // Combining Half Marks
                917760r..917999r, // Combining Diacritical Marks for Symbols
            ]

            return self in r
        }
    }

    /** Returns the maximum valid rune value (0x10FFFF) */
    static property MaxValue: rune {
        get {
            return 0x10FFFFr
        }
    }

    /** Return the minimum valid rune value (0) */
    static property MinValue: rune {
        get {
            return 0r
        }
    }

    /** Returns the Unicode replacement character (U+FFFD) */
    static property ReplacementCharacter: rune {
        get {
            return 0xFFFDr
        }
    }

    /** Returns the titlecase variant of a letter when possible. */
    fn ToTitle() rune {
        switch {
            case self == 454r:
                return 453r
            case self == 457r:
                return 456r
            case self == 460r:
                return 459r
            case self == 499r:
                return 498r
            case self.IsLowerLetter:
                return self.ToUpper()
        }

        return self
    }

    /** Returns the int value of a numeric rune or None(). */
    fn ToNumericValue() Option[decimal] {
        switch {
            case self.IsDigit: // ASCII digits
                return Some(decimal(int(self) - 48))
            case self.IsUnicodeDigit: // Unicode digits (0-9 in other scripts)
                return Some(decimal(int(self) % 10))
            case self.IsLetter: // Check for Roman numeral letters
                if self in [73r, 86r, 88r, 76r, 67r, 68r, 77r, 105r, 118r, 120r, 108r, 99r, 100r, 109r] {
                    return Some(self._toRomanValue())
                }
            case self in 8544r..8575r: // Unicode Roman Numerals block (Ⅰ to ⅿ)
                return Some(self._toRomanValue())
            case self in 188r..190r || self in 8531r..8542r: // Unicode fractions (¼, ½, ¾, ⅓, ⅔, etc.)
                return Some(self._toFractionValue())
            case self in [8730r, 8731r, 8732r, 8733r, 120645r]: // Unicode mathematical constants (√2, √3, π, e)
                return Some(self._toConstantValue())
        }

        return None()
    }

    /** Returns the number of UTF-8 bytes needed to encode this rune. */
    property Utf8Length: uint {
        get {
            if self <= 0x7Fr {
                return 1u
            }
            if self <= 0x7FFr {
                return 2u
            }
            if self <= 0xFFFFr {
                return 3u
            }
            return 4u
        }
    }

    /** Returns the lowercase variant of a letter when possible. */
    fn ToLower() rune {
        // Fast path: ASCII uppercase to lowercase ('A'..'Z' -> 'a'..'z')
        if self in 65r..90r {
            return rune(int(self) + 32)
        }

        // If it's already ASCII lowercase or not a letter, return as is
        if self <= 127r {
            return self
        }

        // Latin-1 Supplement: À..Ö -> à..ö, Ø..Þ -> ø..þ
        if (self in 192r..214r) || (self in 216r..222r) {
            return rune(int(self) + 32)
        }

        // Latin Extended-A & Cyrillic: Stride-2 pattern (Uppercase is even, Lowercase is Upper + 1)
        // Example: Ameliorated cases where U+0100 is 'Ā' and U+0101 is 'ā'
        if (self in 256r..382r) || (self in 1040r..1071r) {
            if int(self) % 2 == 0 {
                return rune(int(self) + 1)
            }
            return self
        }

        // Special case: Capital 'Ÿ' (376r) to lowercase 'ÿ' (255r)
        if self == 376r {
            return 255r
        }

        // Greek uppercase to lowercase (Alpha..Omega)
        if self in 912r..939r {
            return rune(int(self) + 32)
        }

        // Armenian uppercase to lowercase
        if self in 1329r..1368r {
            return rune(int(self) + 48)
        }

        // Fullwidth Latin: 'A'..'Z' -> 'a'..'z'
        if self in 65313r..65338r {
            return rune(int(self) + 32)
        }

        // Return unchanged if no lowercase variant exists
        return self
    }

    /** Returns the uppercase variant of a letter when possible. */
    fn ToUpper() rune {
        // Fast path: ASCII lowercase to uppercase ('a'..'z' -> 'A'..'Z')
        if self in 97r..122r {
            return rune(int(self) - 32)
        }

        // If it's already ASCII uppercase or not a letter, return as is
        if self <= 127r {
            return self
        }

        // Latin-1 Supplement: à..ö -> À..Ö, ø..þ -> Ø..Þ
        if (self in 224r..246r) || (self in 248r..254r) { // Skip 255r (ÿ) as its capital Ÿ is outside this block
            return rune(int(self) - 32)
        }

        // Latin Extended-A & Cyrillic: Stride-2 pattern (Lowercase is odd, Uppercase is Lower - 1)
        if (self in 257r..383r) || (self in 1072r..1103r) {
            if int(self) % 2 == 1 {
                return rune(int(self) - 1)
            }
            return self
        }

        // Special case: Lowercase 'ÿ' (255r) to uppercase 'Ÿ' (376r)
        if self == 255r {
            return 376r
        }

        // Greek lowercase to uppercase (alpha..omega)
        if self in 945r..969r {
            return rune(int(self) - 32)
        }

        // Armenian lowercase to uppercase
        if self in 1377r..1416r {
            return rune(int(self) - 48)
        }

        // Fullwidth Latin: 'a'..'z' -> 'A'..'Z'
        if self in 65345r..65370r {
            return rune(int(self) - 32)
        }

        // Return unchanged if no uppercase variant exists
        return self
    }

    /** Returns the integer value of a Roman numeral rune. */
    fn _toRomanValue() decimal {
        switch {
            case self in [73r, 105r]:
                return 1
            case self in [86r, 118r]:
                return 5
            case self in [88r, 120r]:
                return 10
            case self in [76r, 108r]:
                return 50
            case self in [67r, 99r]:
                return 100
            case self in [68r, 100r]:
                return 500
            case self in [77r, 109r]:
                return 1000
            case self in 8544r..8555r: // Ⅰ to Ⅻ
                return decimal(int(self) - 8543) // Map to 1-12
            case self in 8560r..8571r: // ⅰ to ⅻ
                return decimal(int(self) - 8559) // Map to 1-12
            case self in [8556r, 8572r]: // Ⅼ and ⅾ
                return 50
            case self in [8557r, 8573r]: // Ⅽ and
                return 100
            case self in [8558r, 8574r]: // Ⅾ and
                return 500
            case self in [8559r, 8575r]: // Ⅿ and
                return 1000
        }
        return 0
    }

    /** Returns the float value of a Unicode fraction rune. */
    fn _toFractionValue() decimal {
        switch {
            case self == 188r: return 0.25 // ¼
            case self == 189r: return 0.5  // ½
            case self == 190r: return 0.75 // ¾
            case self == 8531r: return 1.0 / 3.0 // ⅓
            case self == 8532r: return 2.0 / 3.0 // ⅔
            case self == 8533r: return 1.0 / 5.0 // ⅕
            case self == 8534r: return 2.0 / 5.0 // ⅖
            case self == 8535r: return 3.0 / 5.0 // ⅗
            case self == 8536r: return 4.0 / 5.0 // ⅘
            case self == 8537r: return 1.0 / 6.0 // ⅙
            case self == 8538r: return 5.0 / 6.0 // ⅚
            case self == 8539r: return 1.0 / 8.0 // ⅛
            case self == 8540r: return 3.0 / 8.0 // ⅜
            case self == 8541r: return 5.0 / 8.0 // ⅝
            case self == 8542r: return 7.0 / 8.0 // ⅞
        }
        return 0.0
    }

    fn _toConstantValue() decimal {
        switch {
            case self == 8730r:// √2
                return 1.4142135623730951
            case self == 8731r:// √3
                return 1.7320508075688772
            case self in [960r, 120645r, 120715r]:// π
                return 3.141592653589793
            case self == 8733r:// e
                return 2.718281828459045
            case self in [966r, 120659r, 120729r]: // Golden ratio 'phi' (𝜙, 𝝓)
                return 1.618033988749895
            case self in [947r, 8485r, 120640r]: // Euler-Mascheroni constant 'gamma' (γ, ℽ)
                return 0.5772156649015328
            case self == 8463r:// Reduced Planck constant 'h-bar' (ℏ)
                return 1.054571817e-34
        }
        return 0.0
    }
}
