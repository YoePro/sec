test "FromByteArray rejects overlong four byte sequence" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x8F)
    try bytes.Append(0xBF)
    try bytes.Append(0xBF)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(0, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray rejects scalar above Unicode limit" {
    let mut bytes: byte[]
    try bytes.Append(0xF4)
    try bytes.Append(0x90)
    try bytes.Append(0x80)
    try bytes.Append(0x80)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(0, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray rejects invalid byte after valid ASCII prefix" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x42)
    try bytes.Append(0x43)
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(3, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray rejects invalid byte after valid Unicode prefix" {
    let mut bytes: byte[]
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0xAC)
    try bytes.Append(0xC3)
    try bytes.Append(0x28)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(3, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray rejects invalid byte after mixed valid prefix" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    try bytes.Append(0xFF)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(3, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray leaves source bytes unchanged" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("å", result)
    testing.ExpectEqual(2, bytes.Len)
    testing.ExpectEqual(0xC3, bytes[0])
    testing.ExpectEqual(0xA5, bytes[1])
}

test "FromByteArray result is independent of source storage" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x42)
    let result := try FromByteArray(ref bytes)
    bytes[0] = 0x58
    testing.ExpectEqual("AB", result)
    testing.ExpectEqual(0x58, bytes[0])
}

test "FromByteArray round trip preserves mixed Unicode" {
    let original := "Aå€🦊e\u{0301}"
    let bytes := try ToByteArray(original)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual(original, result)
}

// FromByteArrayLossy: Unicode maximal-subpart replacement semantics.

test "FromByteArrayLossy empty input" {
    let mut bytes: byte[]
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("", result)
}

test "FromByteArrayLossy ASCII input" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x42)
    try bytes.Append(0x43)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("ABC", result)
}

test "FromByteArrayLossy embedded NUL" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x00)
    try bytes.Append(0x42)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("A\0B", result)
}

test "FromByteArrayLossy valid mixed UTF8" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0xAC)
    try bytes.Append(0xF0)
    try bytes.Append(0x9F)
    try bytes.Append(0xA6)
    try bytes.Append(0x8A)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("Aå€🦊", result)
}

test "FromByteArrayLossy valid encoded replacement rune" {
    let mut bytes: byte[]
    try bytes.Append(0xEF)
    try bytes.Append(0xBF)
    try bytes.Append(0xBD)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArrayLossy invalid continuation between ASCII" {
    let mut bytes: byte[]
    try bytes.Append(0x48)
    try bytes.Append(0x80)
    try bytes.Append(0x69)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("H\u{FFFD}i", result)
}

test "FromByteArrayLossy two isolated continuation bytes" {
    let mut bytes: byte[]
    try bytes.Append(0x80)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy invalid continuation after two byte lead" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    try bytes.Append(0x28)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}(", result)
}

test "FromByteArrayLossy truncated two byte input" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArrayLossy truncated three byte prefix" {
    let mut bytes: byte[]
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArrayLossy truncated four byte prefix" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x90)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArrayLossy ASCII after truncated three byte prefix" {
    let mut bytes: byte[]
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0x41)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}A", result)
}

test "FromByteArrayLossy ASCII interrupts after leading byte" {
    let mut bytes: byte[]
    try bytes.Append(0xE2)
    try bytes.Append(0x41)
    try bytes.Append(0x82)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}A\u{FFFD}", result)
}

test "FromByteArrayLossy ASCII interrupts four byte prefix" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x9F)
    try bytes.Append(0x41)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}A", result)
}

test "FromByteArrayLossy two complete invalid overlong bytes" {
    let mut bytes: byte[]
    try bytes.Append(0xC0)
    try bytes.Append(0xAF)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy invalid overlong three byte sequence" {
    let mut bytes: byte[]
    try bytes.Append(0xE0)
    try bytes.Append(0x9F)
    try bytes.Append(0xBF)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy high surrogate sequence" {
    let mut bytes: byte[]
    try bytes.Append(0xED)
    try bytes.Append(0xA0)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy low surrogate sequence" {
    let mut bytes: byte[]
    try bytes.Append(0xED)
    try bytes.Append(0xBF)
    try bytes.Append(0xBF)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy overlong four byte sequence" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x8F)
    try bytes.Append(0xBF)
    try bytes.Append(0xBF)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy code point above U10FFFF" {
    let mut bytes: byte[]
    try bytes.Append(0xF4)
    try bytes.Append(0x90)
    try bytes.Append(0x80)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}\u{FFFD}\u{FFFD}\u{FFFD}", result)
}

test "FromByteArrayLossy valid prefix before invalid suffix" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("å\u{FFFD}", result)
}

test "FromByteArrayLossy multiple malformed sequences with valid data" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0x42)
    try bytes.Append(0xC3)
    try bytes.Append(0x28)
    try bytes.Append(0x43)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("A\u{FFFD}B\u{FFFD}(C", result)
}

test "FromByteArrayLossy isolated leading FF" {
    let mut bytes: byte[]
    try bytes.Append(0xFF)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArrayLossy valid Unicode after invalid lead" {
    let mut bytes: byte[]
    try bytes.Append(0xFF)
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0xAC)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}€", result)
}

test "FromByteArrayLossy decomposed accent unchanged" {
    let mut bytes: byte[]
    try bytes.Append(0x65)
    try bytes.Append(0xCC)
    try bytes.Append(0x81)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("e\u{0301}", result)
}

test "FromByteArrayLossy leaves source bytes unchanged" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    try bytes.Append(0x28)
    let result := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual("\u{FFFD}(", result)
    testing.ExpectEqual(2, bytes.Len)
    testing.ExpectEqual(0xC3, bytes[0])
    testing.ExpectEqual(0x28, bytes[1])
}

test "FromByteArrayLossy result is independent of input array" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x80)
    let result := try FromByteArrayLossy(ref bytes)
    bytes[0] = 0x42
    testing.ExpectEqual("A\u{FFFD}", result)
    testing.ExpectEqual(0x42, bytes[0])
}

test "FromByteArrayLossy valid UTF8 matches strict decoding" {
    let original := "Räksmörgås € 🦊"
    let bytes := try ToByteArray(original)
    let strict := try FromByteArray(ref bytes)
    let lossyResult := try FromByteArrayLossy(ref bytes)
    testing.ExpectEqual(strict, lossyResult)
    testing.ExpectEqual(original, lossyResult)
}
