// ToDelimiterCase: custom rune delimiters and case selection.

test "ToDelimiterCase empty input" {
    let result := try ToDelimiterCase("", 45r, false)
    testing.ExpectEqual("", result)
}

test "ToDelimiterCase hyphen lowercase" {
    let result := try ToDelimiterCase("HTTPServer", 45r, false)
    testing.ExpectEqual("http-server", result)
}

test "ToDelimiterCase hyphen uppercase" {
    let result := try ToDelimiterCase("HTTPServer", 45r, true)
    testing.ExpectEqual("HTTP-SERVER", result)
}

test "ToDelimiterCase underscore lowercase" {
    let result := try ToDelimiterCase("helloWorld", 95r, false)
    testing.ExpectEqual("hello_world", result)
}

test "ToDelimiterCase underscore uppercase" {
    let result := try ToDelimiterCase("helloWorld", 95r, true)
    testing.ExpectEqual("HELLO_WORLD", result)
}

test "ToDelimiterCase dot lowercase" {
    let result := try ToDelimiterCase("XMLParser", 46r, false)
    testing.ExpectEqual("xml.parser", result)
}

test "ToDelimiterCase dot uppercase" {
    let result := try ToDelimiterCase("XMLParser", 46r, true)
    testing.ExpectEqual("XML.PARSER", result)
}

test "ToDelimiterCase space lowercase" {
    let result := try ToDelimiterCase("HelloWorld", 32r, false)
    testing.ExpectEqual("hello world", result)
}

test "ToDelimiterCase space uppercase" {
    let result := try ToDelimiterCase("HelloWorld", 32r, true)
    testing.ExpectEqual("HELLO WORLD", result)
}

test "ToDelimiterCase Unicode bullet delimiter lowercase" {
    let result := try ToDelimiterCase("myHTTPServer", 8226r, false)
    testing.ExpectEqual("my•http•server", result)
}

test "ToDelimiterCase emoji delimiter uppercase" {
    let result := try ToDelimiterCase("hello_world", 129418r, true)
    testing.ExpectEqual("HELLO🦊WORLD", result)
}

test "ToDelimiterCase repeated separators" {
    let result := try ToDelimiterCase("hello__- world", 45r, false)
    testing.ExpectEqual("hello-world", result)
}

test "ToDelimiterCase no separator in name" {
    let result := try ToDelimiterCase("HELLO", 46r, true)
    testing.ExpectEqual("HELLO", result)
}

test "ToDelimiterCase leading trailing separators" {
    let result := try ToDelimiterCase("___hello---", 46r, false)
    testing.ExpectEqual("hello", result)
}

test "ToDelimiterCase trailing acronym and digits" {
    let result := try ToDelimiterCase("userID2", 46r, false)
    testing.ExpectEqual("user.id2", result)
}

test "ToDelimiterCase numeric name" {
    let result := try ToDelimiterCase("12345", 45r, false)
    testing.ExpectEqual("12345", result)
}

test "ToDelimiterCase delimiter itself is the only character" {
    let result := try ToDelimiterCase("---", 45r, false)
    testing.ExpectEqual("", result)
}

// Cross-function consistency: shared word splitting and alias behavior.

test "Naming consistency KebabCase delegates to delimiter case" {
    let actual := try ToKebabCase("HTTPServer")
    let expected := try ToDelimiterCase("HTTPServer", 45r, false)
    testing.ExpectEqual(expected, actual)
}

test "Naming consistency ScreamingKebabCase delegates to delimiter case" {
    let actual := try ToScreamingKebabCase("parseHTTPResponse")
    let expected := try ToDelimiterCase("parseHTTPResponse", 45r, true)
    testing.ExpectEqual(expected, actual)
}

test "Naming consistency ConstantCase delegates to delimiter case" {
    let actual := try ToConstantCase("HTTPServer")
    let expected := try ToDelimiterCase("HTTPServer", 95r, true)
    testing.ExpectEqual(expected, actual)
}

test "Naming consistency ScreamingSnakeCase agrees with ConstantCase" {
    let actual := try ToScreamingSnakeCase("parseHTTPResponse")
    let expected := try ToConstantCase("parseHTTPResponse")
    testing.ExpectEqual(expected, actual)
}

test "Naming consistency SnakeCase agrees with delimiter underscore" {
    let actual := try ToSnakeCase("helloWorld")
    let expected := try ToDelimiterCase("helloWorld", 95r, false)
    testing.ExpectEqual(expected, actual)
}

// Idempotence: applying a conversion twice must not change its output.

test "ToSnakeCase is idempotent" {
    let once := try ToSnakeCase("HTTPServer")
    let twice := try ToSnakeCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToCamelCase is idempotent" {
    let once := try ToCamelCase("HTTPServer")
    let twice := try ToCamelCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToPascalCase is idempotent" {
    let once := try ToPascalCase("HTTPServer")
    let twice := try ToPascalCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToKebabCase is idempotent" {
    let once := try ToKebabCase("HTTPServer")
    let twice := try ToKebabCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToScreamingKebabCase is idempotent" {
    let once := try ToScreamingKebabCase("HTTPServer")
    let twice := try ToScreamingKebabCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToConstantCase is idempotent" {
    let once := try ToConstantCase("HTTPServer")
    let twice := try ToConstantCase(once)
    testing.ExpectEqual(once, twice)
}

test "ToScreamingSnakeCase is idempotent" {
    let once := try ToScreamingSnakeCase("HTTPServer")
    let twice := try ToScreamingSnakeCase(once)
    testing.ExpectEqual(once, twice)
}
