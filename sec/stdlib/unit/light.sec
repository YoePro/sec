// =============================================================================

/** Lumen */
unit lm physical
impl lm {
    LongName: "Lumen"
    Symbol: "lm"
    BaseUnit: false
    Status: active
    Dimension: [luminous_intensity^1]
    Scale: 1
    System: SI
}

