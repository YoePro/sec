module calendar

/*
 * Sec Standard Library — temporal/calendar
 * File: calendar/conversion.sec
 * Purpose: Pure conversion and stable-month/ordinal queries.
 * Status: Draft candidate API v0.2; NOT IMPLEMENTED, not compiler-verified
 * Revision: 0.2
 * Updated: 2026-11-15
 * Rulebook: stdlib/temporal/calendar/std-temporal-calendar.md
 * References: rules/types/temporal.md; rules/types/units.md;
 *             UTS #35, calendar month codes (conceptual reference).
 */

/**
 * Projects an absolute date into a calendar system.
 *
 * Description:
 * Supports proleptic Gregorian, Julian and fixed Hebrew
 * calendars. Hebrew years start at 1 Tishri AM 1.
 *
 * Parameters:
 * - value: Absolute core date.
 * - system: Target calendar system.
 *
 * Returns:
 * Calendar-specific year, month and day.
 *
 * Errors:
 * - CalendarError.OutOfRange: Date outside supported era.
 * - CalendarError.NotImplemented: Unsupported conversion.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn FromDate(value: date, system: CalendarSystem) Result[CalendarFields, CalendarError] {
    let mut z := int64(value.EpochDays)

    if system == CalendarSystem.Hebrew {
        return _fromHebrewDate(value)
    }

    // Delegate Islamic calendar arithmetic to its own module helper.
    if system == CalendarSystem.IslamicTabular {
        return _fromIslamicTabularDate(value)
    }

    let mut year:      int64 := 0
    let mut dayOfYear: int64 := 0

    match system {
        CalendarSystem.Gregorian => {
            z += 719468

            let era      := _floorDiv(z, 146097)
            let dayOfEra := z - era * 146097
            let yearOfEra := (
                dayOfEra -
                dayOfEra / 1460 +
                dayOfEra / 36524 -
                dayOfEra / 146096
            ) / 365

            year = yearOfEra + era * 400

            dayOfYear =
                  dayOfEra
                - (365 * yearOfEra +
                yearOfEra / 4 -
                yearOfEra / 100)
        }

        CalendarSystem.Julian => {
            z += 719470

            let era      := _floorDiv(z, 1461)
            let dayOfEra := z - era * 1461
            let yearOfEra := (
                dayOfEra - dayOfEra / 1460
            ) / 365

            year = yearOfEra + era * 4
            dayOfYear = dayOfEra - 365 * yearOfEra
        }

        _ => {
            return Err(CalendarError.NotImplemented)
        }
    }

    let monthIndex := (5 * dayOfYear + 2) / 153
    let day := dayOfYear -
    (153 * monthIndex + 2) / 5 + 1

    let mut month := monthIndex + 3

    if monthIndex >= 10 {
        month = monthIndex - 9
    }

    if month <= 2 {
        year += 1
    }

    let resultYear := try int(year) {
        Err(_) => return Err(CalendarError.OutOfRange)
    }

    return Ok(CalendarFields {
        Year: resultYear,
        Month: CalendarMonth {
            Number: int(month),
            IsLeap: false,
        },
        Day: int(day),
    })
}

/**
 * Projects an absolute date into Gregorian calendar coordinates.
 *
 * Parameters:
 * - value: Absolute core date.
 * Returns: Gregorian year, month and day.
 * Errors: Propagates CalendarError from FromDate.
 * Ownership: Pure, no allocation.
 */
fn FromDate(value: date) Result[CalendarFields, CalendarError] {
    return FromDate(value, CalendarSystem.Gregorian)
}

/**
 * Converts calendar coordinates into an absolute core date.
 *
 * Description:
 * Supports proleptic Gregorian, Julian and fixed Hebrew
 * calendars. Historical adoption and timezones are excluded.
 *
 * Parameters:
 * - fields: Calendar-specific year, month and day.
 * - system: Calendar used to interpret the fields.
 *
 * Returns:
 * Corresponding absolute core date.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid calendar year.
 * - CalendarError.InvalidMonth: Invalid month identity.
 * - CalendarError.InvalidDay: Invalid day of month.
 * - CalendarError.OutOfRange: Date exceeds supported range.
 * - CalendarError.NotImplemented: Unsupported conversion.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn ToDate(fields: CalendarFields, system: CalendarSystem) Result[date, CalendarError] {
    // Conversion is available for the four initial calendars.
    if system not in [
        CalendarSystem.Gregorian,
        CalendarSystem.Julian,
        CalendarSystem.Hebrew,
        CalendarSystem.IslamicTabular,
    ] {
        return Err(CalendarError.NotImplemented)
    }

    // Validate the complete calendar date.
    let month  := try MonthOrdinal(fields.Year, fields.Month, system)
    let maxDay := try DaysInMonth(fields.Year, fields.Month, system)

    if fields.Day not in 1..maxDay {
        return Err(CalendarError.InvalidDay)
    }

    // Hebrew years begin on Tishri 1. Accumulate the lengths
    // of preceding months using the stable month model.
    if system == CalendarSystem.Hebrew {
        return _toHebrewDate(fields, month)
    }

    // Year, month and day have already been validated.
    if system == CalendarSystem.IslamicTabular {
        return _toIslamicTabularDate(fields, month)
    }

    let mut year := int64(fields.Year)

    // Limit intermediate arithmetic to a safe range.
    if year < -6_000_000 || year > 6_000_000 {
        return Err(CalendarError.OutOfRange)
    }

    let m := int64(month)
    let d := int64(fields.Day)

    // Shift January and February into the preceding year.
    if m <= 2 {
        year -= 1
    }

    let mut mp := m - 3

    if m <= 2 {
        mp = m + 9
    }

    let dayOfYear := (153 * mp + 2) / 5 + d - 1
    let mut epochDays: int64 := 0

    match system {
        CalendarSystem.Gregorian => {
            let era       := _floorDiv(year, 400)
            let yearOfEra := year - era * 400
            let dayOfEra  := yearOfEra * 365 + yearOfEra / 4 - yearOfEra / 100 + dayOfYear

            epochDays = era * 146097 + dayOfEra - 719468
        }

        CalendarSystem.Julian => {
            let era       := _floorDiv(year, 4)
            let yearOfEra := year - era * 4
            let dayOfEra  := yearOfEra * 365 + dayOfYear

            epochDays = era * 1461 + dayOfEra - 719470
        }

        _ => {
            return Err(CalendarError.NotImplemented)
        }
    }

    let checkedDays := try int32(epochDays) {
        Err(_) => return Err(CalendarError.OutOfRange)
    }

    return Ok(new date(checkedDays))
}

/**
 * Converts Gregorian calendar coordinates into an absolute date.
 *
 * Parameters:
 * - fields: Gregorian year, month and day.
 * Returns: Absolute core date.
 * Errors: Propagates CalendarError from ToDate.
 * Ownership: Pure, no allocation.
 */
fn ToDate(fields: CalendarFields) Result[date, CalendarError] {
    return ToDate(fields, CalendarSystem.Gregorian)
}

/**
 * Validates complete calendar date coordinates.
 *
 * Description:
 * Verifies that the year and month form a valid calendar
 * combination and that the day exists within that month.
 * Does not apply historical calendar adoption rules.
 *
 * Parameters:
 * - fields: Calendar year, month and day.
 * - system: Calendar system used for validation.
 *
 * Returns:
 * Ok() when all calendar components are valid.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid calendar year.
 * - CalendarError.InvalidMonth: Invalid month identity.
 * - CalendarError.InvalidDay: Day outside the month.
 * - CalendarError.NotImplemented: Calendar rules incomplete.
 * - CalendarError.OutOfRange: Unsupported calculation range.
 *
 * Ownership:
 * Pure validation without allocation or I/O.
 */
fn ValidateFields(fields: CalendarFields, system: CalendarSystem) Result[void, CalendarError] {
    // DaysInMonth also validates the year and month identity.
    let maxDay := try DaysInMonth(fields.Year, fields.Month, system)

    // A valid day must exist within the selected calendar month.
    if fields.Day not in 1..maxDay {
        return Err(CalendarError.InvalidDay)
    }

    return Ok()
}

/**
 * Validates Gregorian calendar date coordinates.
 *
 * Parameters:
 * - fields: Calendar coordinates to validate.
 * Returns: Ok() when the date is valid.
 * Errors: Propagates CalendarError from ValidateFields.
 * Ownership: Pure, no allocation.
 */
fn ValidateFields(fields: CalendarFields) Result[void, CalendarError] {
    return ValidateFields(fields, CalendarSystem.Gregorian)
}

/**
 * Returns the number of months in a calendar year.
 *
 * Description:
 * Gregorian and Julian years always contain twelve months.
 * Hebrew years use the fixed 19-year lunisolar cycle.
 * Tabular Islamic years always contain twelve months.
 *
 * Parameters:
 * - year: Calendar year in the selected system.
 * - system: Calendar system used for the calculation.
 *
 * Returns:
 * Number of months, including intercalary months.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid year for the system.
 *
 * Ownership:
 * Pure calculation, no allocation or I/O.
 */
fn MonthsInYear(year: int, system: CalendarSystem) Result[int, CalendarError] {
    match system {
        CalendarSystem.Gregorian => {
            return Ok(12)
        }

        CalendarSystem.Julian => {
            return Ok(12)
        }

        CalendarSystem.Hebrew => {
            if year < 1 {
                return Err(CalendarError.InvalidYear)
            }

            let cycleYear := year % 19

            if cycleYear in [0, 3, 6, 8, 11, 14, 17] {
                return Ok(13)
            }

            return Ok(12)
        }

        CalendarSystem.IslamicTabular => {
            if year < 1 {
                return Err(CalendarError.InvalidYear)
            }

            return Ok(12)
        }
    }
}

/**
 * Returns the number of months in a Gregorian year.
 *
 * Parameters:
 * - year: Astronomically numbered Gregorian year.
 * Returns: Number of months, always twelve.
 * Errors: Propagates CalendarError from MonthsInYear.
 * Ownership: Pure, no allocation.
 */
fn MonthsInYear(year: int) Result[int, CalendarError] {
    return MonthsInYear(year, CalendarSystem.Gregorian)
}

/**
 * Returns the number of days in a calendar month.
 *
 * Description:
 * Applies calendar-specific month lengths and leap rules.
 * Hebrew Heshvan and Kislev depend on total year length.
 * Islamic tabular month 12 awaits a selected leap scheme.
 *
 * Parameters:
 * - year: Year in the selected calendar system.
 * - month: Stable calendar month identity.
 * - system: Calendar system defining the month rules.
 *
 * Returns:
 * Number of days in the selected month.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid calendar year.
 * - CalendarError.InvalidMonth: Invalid month identity.
 * - CalendarError.OutOfRange: Unsupported calculation range.
 * - CalendarError.NotImplemented: Unspecified Islamic
 *     tabular leap-year variant for month 12.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn DaysInMonth(year: int, month: CalendarMonth, system: CalendarSystem) Result[int, CalendarError] {
    // Validate the month identity against the selected year.
    let ordinal := try MonthOrdinal(year, month, system)

    match system {
        CalendarSystem.Gregorian => {
            if ordinal == 2 {
                let leap := year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)

                if leap {
                    return Ok(29)
                }

                return Ok(28)
            }

            if ordinal in [4, 6, 9, 11] {
                return Ok(30)
            }

            return Ok(31)
        }

        CalendarSystem.Julian => {
            if ordinal == 2 {
                if year % 4 == 0 {
                    return Ok(29)
                }

                return Ok(28)
            }

            if ordinal in [4, 6, 9, 11] {
                return Ok(30)
            }

            return Ok(31)
        }

        CalendarSystem.Hebrew => {
            // Bound intermediate calculations to the supported
            // integer domain of this initial implementation.
            if year > 10_000_000 {
                return Err(CalendarError.OutOfRange)
            }

            // Adar I exists only in leap years and has 30 days.
            // MonthOrdinal already validated this identity.
            if month.IsLeap {
                return Ok(30)
            }

            // Heshvan and Kislev depend on the year's total length.
            if month.Number in [2, 3] {
                let y    := int64(year)
                let days := _hebrewNewYear(y + 1) - _hebrewNewYear(y)

                // Heshvan has 30 days in complete years.
                if month.Number == 2 {
                    if days in [355, 385] {
                        return Ok(30)
                    }

                    return Ok(29)
                }

                // Kislev has 29 days in deficient years.
                if days in [353, 383] {
                    return Ok(29)
                }

                return Ok(30)
            }

            // Fixed 29-day months in the Hebrew calendar.
            if month.Number in [4, 6, 8, 10, 12] {
                return Ok(29)
            }

            // Tishri, Shevat, Nisan, Sivan and Av.
            return Ok(30)
        }

        CalendarSystem.IslamicTabular => {
            // The final month gains one day in leap years.
            if ordinal == 12 && _islamicTabularLeapYear(year) {
                return Ok(30)
            }

            // Odd months contain 30 days.
            if ordinal % 2 != 0 {
                return Ok(30)
            }

            // Even months contain 29 days.
            return Ok(29)
        }

        _ => {
            return Err(CalendarError.UnsupportedSystem)
        }
    }
}

/**
 * Returns the number of days in a Gregorian month.
 *
 * Parameters:
 * - year: Gregorian calendar year.
 * - month: Stable Gregorian month identity.
 * Returns: Number of days in the selected month.
 * Errors: Propagates CalendarError from DaysInMonth.
 * Ownership: Pure, no allocation.
 */
fn DaysInMonth(year: int, month: CalendarMonth) Result[int, CalendarError] {
    return DaysInMonth(year, month, CalendarSystem.Gregorian)
}

/**
 * Returns the stable identity of a month at a given position.
 *
 * Description:
 * Ordinals are one-based. Hebrew leap years insert Adar I
 * at ordinal 6, shifting Adar II and later months forward.
 * The returned month identity remains stable across years.
 *
 * Parameters:
 * - year: Year in the selected calendar system.
 * - ordinal: One-based month position within the year.
 * - system: Calendar system defining month order.
 *
 * Returns:
 * Stable calendar month identity.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid calendar year.
 * - CalendarError.InvalidMonth: Ordinal outside the year.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn MonthAt(year: int, ordinal: int, system: CalendarSystem) Result[CalendarMonth, CalendarError] {
    let count := try MonthsInYear(year, system)

    if ordinal < 1 || ordinal > count {
        return Err(CalendarError.InvalidMonth)
    }

    if system == CalendarSystem.Hebrew && count == 13 {
        if ordinal == 6 {
            return Ok(CalendarMonth {
                Number: 5,
                IsLeap: true,
            })
        }

        if ordinal > 6 {
            return Ok(CalendarMonth {
                Number: ordinal - 1,
                IsLeap: false,
            })
        }
    }

    return Ok(CalendarMonth {
        Number: ordinal,
        IsLeap: false,
    })
}

/**
 * Returns the Gregorian month at a given ordinal position.
 *
 * Parameters:
 * - year: Gregorian calendar year.
 * - ordinal: One-based month position.
 * Returns: Stable Gregorian month identity.
 * Errors: Propagates CalendarError from MonthAt.
 * Ownership: Pure, no allocation.
 */
fn MonthAt(year: int, ordinal: int) Result[CalendarMonth, CalendarError] {
    return MonthAt(year, ordinal, CalendarSystem.Gregorian)
}

/**
 * Returns a calendar month's ordinal position within a year.
 *
 * Description:
 * Converts a stable month identity into its one-based
 * position in the selected year. Hebrew leap years shift
 * Adar II and subsequent months by one position.
 *
 * Parameters:
 * - year: Year in the selected calendar system.
 * - month: Stable month identity.
 * - system: Calendar system defining month order.
 *
 * Returns:
 * One-based month ordinal.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid calendar year.
 * - CalendarError.InvalidMonth: Month identity is not
 *     present or valid in the selected year.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn MonthOrdinal(year: int, month: CalendarMonth, system: CalendarSystem) Result[int, CalendarError] {
    let count := try MonthsInYear(year, system)

    // Month identities range from 1 to 12, regardless of whether
    // the calendar year contains an additional leap month.
    if month.Number not in 1..12 {
        return Err(CalendarError.InvalidMonth)
    }

    if month.IsLeap {
        // Only the Hebrew calendar supports a leap month in our
        // current model, and only in years containing 13 months.
        // Adar I is represented by the stable identity M05L.
        if system != CalendarSystem.Hebrew || count != 13 || month.Number != 5 {
            return Err(CalendarError.InvalidMonth)
        }

        // Adar I occupies the sixth position in a Hebrew leap year.
        return Ok(6)
    }

    // In Hebrew calendar leap years, Adar I occupies position 6.
    // All subsequent months (M06–M12) therefore have their
    // ordinal positions shifted forward by one.
    if system == CalendarSystem.Hebrew && count == 13 && month.Number >= 6 {
        return Ok(month.Number + 1)
    }

    return Ok(month.Number)
}

/**
 * Returns the ordinal position of a Gregorian month.
 *
 * Parameters:
 * - year: Gregorian calendar year.
 * - month: Stable Gregorian month identity.
 * Returns: One-based month position.
 * Errors: Propagates CalendarError from MonthOrdinal.
 * Ownership: Pure, no allocation.
 */
fn MonthOrdinal(year: int, month: CalendarMonth) Result[int, CalendarError] {
    return MonthOrdinal(year, month, CalendarSystem.Gregorian)
}

/**
 * Divides two integers, rounding toward negative infinity.
 *
 * Description:
 * Unlike Sec's ordinary integer division, negative
 * non-integral quotients are rounded downward.
 * The divisor must be strictly positive.
 *
 * Parameters:
 * - value: Signed dividend.
 * - divisor: Strictly positive divisor.
 *
 * Returns:
 * Mathematical floor of value / divisor.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _floorDiv(value: int64, divisor: int64) int64 {
    let mut quotient := value / divisor

    if value % divisor < 0 {
        quotient -= 1
    }

    return quotient
}
