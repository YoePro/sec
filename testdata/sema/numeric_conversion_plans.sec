fn ConstantProof() float32 {
    let half: float64 := 0.5
    return float32(half)
}

fn IntervalProof(value: int256) float32 {
    if value >= 0 && value <= 100 {
        return float32(value)
    }
    return 0.0
}

fn LiteralShaping() float32 {
    return float32(0.1)
}

fn DecimalBoundary(value: decimal) Result[float64, ConversionError] {
    return Ok(try float64(value))
}
