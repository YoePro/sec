module http

/*
* Sec Standard Library - net/http - Extensible HTTP priority values
*
* File:        stdlib/net/http/priority.sec
* Module:      http
* Revision:    2
* Updated:     2026-09-08
* Author:      Jonas Engström
*
* Purpose:
*   Extensible HTTP priority values.
*
* Standards:
*   - RFC 9218
*     https://www.rfc-editor.org/rfc/rfc9218
*   - RFC 9651
*     https://www.rfc-editor.org/rfc/rfc9651
*
* Rulebook:
*   stdlib/net/http/std-net-http.md
*/

type PriorityUrgency uint8 range 0..7 default 3

type Priority struct {
    Urgency: Option[PriorityUrgency],
    Incremental: Option[bool],
}

impl Priority {
    init() {
        self.Urgency = None
        self.Incremental = None
    }

    init(urgency: PriorityUrgency, incremental: bool) {
        self.Urgency = Some(urgency)
        self.Incremental = Some(incremental)
    }

    /**
    * Parse parses an HTTP Priority field value.
    *
    * The field value is parsed as an RFC 9651 Structured Fields Dictionary.
    * The registered `u` member is accepted only when it is an integer in the
    * inclusive range 0..7. The registered `i` member is accepted only when it is
    * a Boolean.
    *
    * Unknown members, members with unexpected types, and out-of-range urgency
    * values are ignored as required by RFC 9218.
    *
    * Absence of `u` or `i` is preserved. Request defaults and response update
    * semantics are applied by the caller, not by Parse.
    *
    * Returns StructuredFieldError only when the Structured Fields Dictionary
    * itself cannot be parsed.
    *
    * References:
    * - RFC 9218, Section 4
    * - RFC 9651, Structured Fields Dictionary
    */
    static fn Parse(value: HeaderValue) Result[Priority, StructuredFieldError] {
        let dictionary := try _StructuredFieldDictionary.Parse(value)
        let mut priority := new Priority()

        match dictionary.Integer("u") {
            Some(urgency) => {
                if urgency in 0..7 {
                    priority.Urgency = Some(PriorityUrgency(urgency))
                }
            }

            None => {}
        }

        match dictionary.Boolean("i") {
            Some(incremental) => {
                priority.Incremental = Some(incremental)
            }

            None => {}
        }

        return Ok(priority)
    }

    fn ToHeaderValue() Result[HeaderValue, StructuredFieldError] {
        return Err(StructuredFieldError.AllocationFailed)
    }
    property IsDefault: bool {
        get {
            match self.Urgency {
                Some(urgency) => {
                    if urgency != new PriorityUrgency() {
                        return false
                    }
                }

                None => {}
            }

            match self.Incremental {
                Some(incremental) => return !incremental
                None => return true
            }
        }
    }

    property EffectiveUrgency: PriorityUrgency {
        get {
            match self.Urgency {
                Some(urgency) => return urgency
                None => return new PriorityUrgency()
            }
        }
    }

    property EffectiveIncremental: bool {
        get {
            match self.Incremental {
                Some(incremental) => return incremental
                None => return false
            }
        }
    }
}
