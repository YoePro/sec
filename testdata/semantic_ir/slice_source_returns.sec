module main

// P16-36 (package16 § 66): a function may return a slice derived from a
// slice parameter: the holder itself, a copy, or a reborrow of its complete
// extent. The return-origin summary names the parameter. Sub-slice returns
// need a slice projection spelling (MD-115).
fn Same(values: ref int[]) ref int[] {
    return values
}

fn Whole(values: ref mut int[]) ref mut int[] {
    return ref mut values
}

fn Copied(values: ref int[]) ref int[] {
    let copy := values
    return copy
}

fn Chain(values: ref int[]) ref int[] {
    return Same(values)
}

fn main() int {
    let mut data := [1, 2, 3, 4]
    let view := ref data[1..<3]
    let same := Chain(view)
    let first := same[0]
    discard same
    discard view
    let m := ref mut data[..]
    let whole := Whole(m)
    whole[0] = first
    discard whole
    discard m
    return first
}
