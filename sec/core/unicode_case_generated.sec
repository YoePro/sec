/** Unicode simple lowercase mapping of a scalar; unmapped scalars map to themselves. Rules: rules/library/core-library.md §11.3. */
fn _UnicodeSimpleLower(ch: rune) rune {
    let mut low: uint := 0
    let mut high: uint := _unicodeCaseLowerStrides.Len
    while low < high {
        let middle := low + (high - low) / 2
        if ch > _unicodeCaseLowerRanges[2 * middle + 1] {
            low = middle + 1
        } else if ch < _unicodeCaseLowerRanges[2 * middle] {
            high = middle
        } else {
            let offset := uint(ch) - uint(_unicodeCaseLowerRanges[2 * middle])
            if offset % _unicodeCaseLowerStrides[middle] != 0 {
                return ch
            }
            return try rune(int(ch) + _unicodeCaseLowerDeltas[middle]) {
                Err(_) => ch
            }
        }
    }
    return ch
}

