module main
fn Size[T](value: ref T) uint {
    return 1
}
fn Count[...Types](values: ...ref Types) uint {
    let mut n: uint := 0
    for ref value in values {
        n = n + Size(value)
    }
    return n
}
fn main() int {
    let a := 1
    let b := true
    let c := Count(ref a, ref b)
    if c == 2 { return 7 }
    return 1
}
