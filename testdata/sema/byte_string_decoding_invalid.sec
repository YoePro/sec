module main

fn Instance(bytes: ref byte[], text: string) Result[string, StringError] {
    return text.FromByteArray(bytes)
}

fn Internal(bytes: ref byte[]) Result[string, StringError] {
    return _stringFromUtf8(bytes)
}

fn Cast(bytes: byte[]) string {
    return string(bytes)
}

fn Implicit(bytes: byte[]) string {
    let text: string := bytes
    return text
}

fn Summary(bytes: byte[]) Result[string, StringError] {
    return bytes.ToString()
}

fn main() int {
    return 0
}

fn RuneInstance(runes: ref rune[], text: string) Result[string, StringError] {
    return text.FromRuneArray(runes)
}
