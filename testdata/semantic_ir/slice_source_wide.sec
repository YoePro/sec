@noPanic
fn EmptySigned128(values: int128[0]) uint {
    let view := ref values[..]
    let count := view.Len
    discard view
    return count
}

@noPanic
fn EmptySigned256(values: int256[0]) uint {
    let view := ref values[..]
    let count := view.Len
    discard view
    return count
}

