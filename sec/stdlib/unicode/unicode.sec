/** Reports whether ch is a Unicode letter. */
fn IsLetter(ch: rune) bool {
    if ch < 0r || ch > 0x10FFFFr {
        return false
    }

    if ch <= 0x007Fr {
        return (ch >= 0x0041r && ch <= 0x005Ar) ||
            (ch >= 0x0061r && ch <= 0x007Ar)
    }

    let mut low := 0
    let mut high := 749
    while low <= high {
        let middle := low + (high - low) / 2
        let current := letterRanges[middle]

        if ch < current.start {
            high = middle - 1
            continue
        }
        if ch > current.end {
            low = middle + 1
            continue
        }

        return true
    }

    return false
}
