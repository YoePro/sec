module fmt

import "str"

/**
 * Collects formatted UTF-8 text in an owned string builder.
 *
 * Description:
 * Implements the core formatting destination contract using
 * the standard library string builder.
 *
 * Each successful WriteText call appends the complete input
 * segment without changing its encoding or contents.
 *
 * Ownership:
 * Owns the builder and its accumulated storage.
 * The destination is move-only.
 *
 * Allocation:
 * May allocate when the builder grows or materializes a string.
 *
 * Rulebook:
 * stdlib/fmt/std-fmt.md, sections 2 and 11.
 * stdlib/str/stdlib_str.md, section 8.
 */
@noCopy
type _BuilderFormatSink struct {
    _builder: str.Builder,
}

impl _BuilderFormatSink implements FormatSink[CollectionError] {
    /**
     * Constructs an empty formatting destination.
     *
     * Errors:
     * - CollectionError: Builder initialization failed.
     *
     * Ownership:
     * Establishes ownership of the internal builder.
     *
     * Allocation:
     * Requests zero initial byte capacity.
     */
    init() CollectionError {
        self._builder = try new str.Builder(0)
    }

    /**
     * Appends a complete UTF-8 text segment.
     *
     * Parameters:
     * - text: Valid UTF-8 text to append.
     *
     * Returns:
     * - Ok(): The complete text was appended.
     *
     * Errors:
     * - CollectionError: Storage growth failed.
     *
     * Ownership:
     * Does not consume the source string.
     *
     * Allocation:
     * May grow internal storage.
     */
    fn WriteText(text: string) Result[void, CollectionError] {
        return self._builder.Append(text)
    }

    /**
     * Materializes the accumulated UTF-8 text.
     *
     * Returns:
     * - Ok(string): The complete formatted result.
     *
     * Errors:
     * - CollectionError: Materialization failed.
     *
     * Ownership:
     * The returned string is independently owned.
     *
     * Allocation:
     * May allocate result storage.
     */
    fn Finish() Result[string, CollectionError] {
        return self._builder.Finish()
    }
}

/**
 * Converts collection storage failures into string allocation failures.
 *
 * Parameters:
 * - failure: The original collection failure.
 *
 * Returns:
 * The corresponding string allocation error.
 *
 * Allocation:
 * Does not allocate.
 */
fn _CollectionToStringError(failure: CollectionError) StringError {
    match failure {
        AllocationFailed => {
            return StringError.Allocation(AllocationError.OutOfMemory)
        }

        CapacityExceeded => {
            return StringError.Allocation(AllocationError.InvalidSize)
        }

        SizeOverflow => {
            return StringError.Allocation(AllocationError.InvalidSize)
        }
    }
}

/**
 * Formats heterogeneous arguments into a new UTF-8 string.
 *
 * Description:
 * Uses the canonical core composite formatter with a
 * Builder-backed destination.
 *
 * Validates the format before converting arguments.
 * Produces no external output.
 *
 * Parameters:
 * - format: Composite format string.
 * - values: Heterogeneous borrowed formatting arguments.
 *
 * Returns:
 * - Ok(string): Newly materialized formatted text.
 *
 * Errors:
 * - StringError.Format: Invalid or unsupported format.
 * - StringError.Allocation: Storage or size failure.
 * - StringError: Failure from an argument's ToString().
 *
 * Ownership:
 * Does not consume or modify the arguments.
 * Owns all intermediate builder storage.
 *
 * Allocation:
 * May allocate for argument conversion, buffer growth
 * and final string materialization.
 *
 * Rulebook:
 * stdlib/fmt/std-fmt.md, sections 3, 8 and 11.
 */
fn SPrintf[...Types](format: string, values: ...ref Types) Result[string, StringError] {
    let mut sink := try new _BuilderFormatSink() {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    try _AppendCompositeFormat(ref mut sink, format, values...)

    return _FinishStringSink(ref mut sink)
}

/**
 * Converts and concatenates arguments into a new string.
 *
 * Description:
 * Appends default text representations in argument order.
 * No separators or newline characters are inserted.
 *
 * Parameters:
 * - values: Heterogeneous borrowed arguments.
 *
 * Returns:
 * - Ok(text): Complete formatted UTF-8 string.
 * An empty argument list produces an empty string.
 *
 * Errors:
 * - StringError: Conversion or allocation failure.
 *
 * Ownership:
 * Does not consume or modify arguments.
 *
 * Allocation:
 * May allocate temporary representations and result storage.
 */
fn SPrint[...Types](values: ...ref Types) Result[string, StringError] {
    let mut sink := try new _BuilderFormatSink() {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    try _AppendDefaultValues(ref mut sink, false, values...)

    return _FinishStringSink(ref mut sink)
}

/**
 * Converts arguments into a space-separated string with a newline.
 *
 * Description:
 * Appends default text representations separated by one ASCII
 * space and adds exactly one trailing LF character.
 *
 * Parameters:
 * - values: Heterogeneous borrowed arguments.
 *
 * Returns:
 * - Ok(text): Complete UTF-8 string including the newline.
 * An empty argument list produces "\n".
 *
 * Errors:
 * - StringError: Conversion or allocation failure.
 *
 * Ownership:
 * Does not consume or modify arguments.
 *
 * Allocation:
 * May allocate temporary representations and result storage.
 */
fn SPrintln[...Types](values: ...ref Types) Result[string, StringError] {
    let mut sink := try new _BuilderFormatSink() {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    try _AppendDefaultValues(ref mut sink, true, values...)

    try sink.WriteText("\n") {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    return _FinishStringSink(ref mut sink)
}

/**
 * Formats arguments into a new UTF-8 string ending with a newline.
 *
 * Description:
 * Uses the canonical composite formatter and appends exactly
 * one LF character after successful formatting.
 *
 * The newline is appended even when the format is empty.
 * No newline is appended when formatting fails.
 *
 * Parameters:
 * - format: Composite format string.
 * - values: Heterogeneous borrowed formatting arguments.
 *
 * Returns:
 * - Ok(text): Complete formatted text including the newline.
 *
 * Errors:
 * - StringError.Format: Invalid or unsupported format.
 * - StringError.Allocation: Storage or output size failure.
 * - StringError: Argument text conversion failure.
 *
 * Ownership:
 * Does not consume or modify the formatting arguments.
 * Owns and releases all temporary Builder storage.
 *
 * Allocation:
 * May allocate during conversion, Builder growth and
 * final string materialization.
 *
 * Rulebook:
 * stdlib/fmt/std-fmt.md, sections 3, 8 and 11.
 */
fn SPrintfln[...Types](format: string, values: ...ref Types) Result[string, StringError] {
    let mut sink := try new _BuilderFormatSink() {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    try _AppendCompositeFormat(ref mut sink, format, values...)

    try sink.WriteText("\n") {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    return _FinishStringSink(ref mut sink)
}

/**
 * Appends composite-formatted arguments to a string destination.
 *
 * Description:
 * Uses the canonical core formatter without materializing
 * the combined output string.
 *
 * Parameters:
 * - sink: Mutable Builder-backed formatting destination.
 * - format: Composite format string.
 * - values: Heterogeneous borrowed formatting arguments.
 *
 * Returns:
 * - Ok(): All formatted text was appended successfully.
 *
 * Errors:
 * - StringError.Format: Invalid or unsupported format.
 * - StringError.Allocation: Storage or output size failure.
 * - StringError: Argument text conversion failure.
 *
 * Ownership:
 * Does not consume the destination or arguments.
 *
 * Allocation:
 * May allocate during conversion and Builder growth.
 */
fn _AppendCompositeFormat[...Types](sink: ref mut _BuilderFormatSink, format: string, values: ...ref Types) Result[void, StringError] {
    let result := FormatComposite(
        format,
        ref mut sink,
        values...,
    )

    match result {
        Ok(_) => {
            return Ok()
        }

        Err(failure) => {
            match failure {
                Text(cause) => {
                    return Err(cause)
                }

                Sink(cause) => {
                    return Err(_CollectionToStringError(cause))
                }

                SizeOverflow => {
                    return Err(
                        StringError.Allocation(AllocationError.InvalidSize),
                    )
                }
            }
        }
    }
}

/**
 * Appends default representations of heterogeneous arguments.
 *
 * Description:
 * Converts each argument using ToString() and appends the
 * result to the supplied builder destination.
 *
 * Parameters:
 * - sink: Mutable destination receiving the text.
 * - separated: Insert one space between adjacent arguments.
 * - values: Heterogeneous borrowed arguments.
 *
 * Returns:
 * - Ok(): All arguments were appended.
 *
 * Errors:
 * - StringError: Argument conversion or storage failure.
 *
 * Ownership:
 * Does not consume the arguments or destination.
 *
 * Allocation:
 * May allocate during conversion or builder growth.
 */
fn _AppendDefaultValues[...Types](sink: ref mut _BuilderFormatSink, separated: bool, values: ...ref Types) Result[void, StringError] {
    let mut first := true

    for ref value in values {
        if separated && !first {
            try sink.WriteText(" ") {
                Err(error) => {
                    return Err(_CollectionToStringError(error))
                }
            }
        }

        let text := try value.ToString()

        try sink.WriteText(text) {
            Err(error) => {
                return Err(_CollectionToStringError(error))
            }
        }

        first = false
    }

    return Ok()
}

/**
 * Materializes a Builder-backed formatting destination.
 *
 * Parameters:
 * - sink: Mutable destination containing valid UTF-8.
 *
 * Returns:
 * - Ok(text): Independently owned result string.
 *
 * Errors:
 * - StringError.Allocation: Materialization failed.
 *
 * Ownership:
 * Does not consume the destination.
 *
 * Allocation:
 * May allocate the result string.
 */
fn _FinishStringSink(sink: ref mut _BuilderFormatSink) Result[string, StringError] {
    let text := try sink.Finish() {
        Err(error) => {
            return Err(_CollectionToStringError(error))
        }
    }

    return Ok(text)
}
