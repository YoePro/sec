module arithmetic

/*
 * Sec Standard Library — temporal API scaffold
 * Canonical path: stdlib/temporal/arithmetic/apply.sec
 * Module: arithmetic
 * Purpose: Explicit calendar-period arithmetic.
 * Status: Draft API, NOT IMPLEMENTED, not compiler-verified
 * Revision: 0.1
 * Updated: 2026-10-16
 * Governing rulebook: stdlib/temporal/arithmetic/std-temporal-arithmetic.md
 * Standards / dependencies: Sec std-temporal.md
 * NOTE: Stub results are explicit NotImplemented failures. No successful
 *       behavior is claimed by this file.
 */

import "temporal/calendar"

/**
 * Converts calendar errors to temporal arithmetic errors.
 *
 * Parameters:
 * - cause: Error returned by the calendar module.
 *
 * Returns:
 * Corresponding temporal arithmetic error.
 *
 * Ownership:
 * Pure conversion without allocation.
 */
fn _calendarArithmeticError(cause: calendar.CalendarError) TemporalArithmeticError {
    match cause {
        calendar.CalendarError.OutOfRange => return TemporalArithmeticError.OutOfRange
        calendar.CalendarError.NotImplemented => return TemporalArithmeticError.UnsupportedSystem
        calendar.CalendarError.UnsupportedSystem => return TemporalArithmeticError.UnsupportedSystem
        _ => return TemporalArithmeticError.InvalidTarget
    }
}

/**
 * Returns the mathematical floor of integer division.
 *
 * Description:
 * Sec integer division truncates toward zero. Calendar
 * month indexing requires floor division for negative years.
 *
 * Parameters:
 * - value: Signed dividend.
 * - divisor: Strictly positive divisor.
 *
 * Returns:
 * Floor of value divided by divisor.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _floorDivMonthIndex(value: int64, divisor: int64) int64 {
    let mut quotient := value / divisor

    if value % divisor < 0 {
        quotient -= 1
    }

    return quotient
}

/**
 * Finds the calendar month at a signed month offset.
 *
 * Description:
 * Gregorian and Julian calendars use twelve months per year.
 * The Islamic tabular calendar also uses twelve months,
 * starting at AH 1.
 *
 * Hebrew calendar uses a 235-month Metonic cycle containing
 * nineteen years. Leap-month identities are resolved through
 * calendar.MonthAt.
 *
 * The original day number is preserved without validation
 * against the target month. AddMonths resolves that afterward.
 *
 * Parameters:
 * - source: Valid source calendar coordinates.
 * - months: Signed month displacement.
 * - system: Selected calendar system.
 *
 * Returns:
 * Target year, month identity and original day number.
 *
 * Errors:
 * - TemporalArithmeticError.OutOfRange: Target outside range.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn _monthAtOffset(source: calendar.CalendarFields, months: int, system: calendar.CalendarSystem) Result[calendar.CalendarFields, TemporalArithmeticError] {
    // All currently supported months have at least 28 days.
    // No valid displacement across the entire int32 date
    // domain can require 160 million month transitions.
    if months < -160_000_000 || months > 160_000_000 {
        return Err(TemporalArithmeticError.OutOfRange)
    }

    let ordinal := try calendar.MonthOrdinal(source.Year, source.Month, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    let mut targetYear: int64 := 0
    let mut targetOrdinal := 0

    if system == calendar.CalendarSystem.Hebrew {
        // Months preceding Hebrew AM year Y.
        let y         := int64(source.Year)
        let preceding := (235 * y - 234) / 19
        let index     := preceding + int64(ordinal - 1) + int64(months)

        if index < 0 {
            return Err(TemporalArithmeticError.OutOfRange)
        }

        // Jump directly to the relevant 19-year cycle.
        let cycles := index / 235
        targetYear = cycles * 19 + 1

        let mut remaining := index % 235

        // At most nineteen years need examination.
        while true {
            let year := try int(targetYear) {
                Err(_) => return Err(TemporalArithmeticError.OutOfRange)
            }

            let count := try calendar.MonthsInYear(year, system) {
                Err(e) => return Err(_calendarArithmeticError(e))
            }

            if remaining < int64(count) {
                targetOrdinal = int(remaining) + 1
                break
            }

            remaining -= int64(count)
            targetYear += 1
        }
    } else {
        // Uniform twelve-month calendars.
        let mut yearIndex := int64(source.Year)

        if system == calendar.CalendarSystem.IslamicTabular {
            // Islamic years start at AH 1, not year zero.
            yearIndex -= 1
        }

        let index := yearIndex * 12 + int64(ordinal - 1) + int64(months)

        if system == calendar.CalendarSystem.IslamicTabular && index < 0 {
            return Err(TemporalArithmeticError.OutOfRange)
        }

        let targetYearIndex := _floorDivMonthIndex(index, 12)

        targetYear = targetYearIndex

        if system == calendar.CalendarSystem.IslamicTabular {
            targetYear += 1
        }

        targetOrdinal = int(index - targetYearIndex * 12) + 1
    }

    let year := try int(targetYear) {
        Err(_) => return Err(TemporalArithmeticError.OutOfRange)
    }

    let month := try calendar.MonthAt(year, targetOrdinal, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    return Ok(calendar.CalendarFields {
        Year: year,
        Month: month,
        Day: source.Day,
    })
}

/**
 * Resolves a target calendar date under a month-end policy.
 *
 * Description:
 * The target month must exist. If its requested day does
 * not exist, Reject fails, Clamp selects its last day,
 * and RollForward carries surplus days forward.
 *
 * Missing leap months are not resolved by this policy.
 *
 * Parameters:
 * - target: Target calendar coordinates.
 * - system: Calendar used to interpret the coordinates.
 * - policy: Resolution policy for a missing day number.
 *
 * Returns:
 * Absolute date after applying the policy.
 *
 * Errors:
 * - TemporalArithmeticError.InvalidTarget: Invalid target.
 * - TemporalArithmeticError.OutOfRange: Unrepresentable day.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn _resolveCalendarTarget(target: calendar.CalendarFields, system: calendar.CalendarSystem, policy: MonthEndPolicy) Result[date, TemporalArithmeticError] {
    let maxDay := try calendar.DaysInMonth(target.Year, target.Month, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    if target.Day <= maxDay {
        let resolved := try calendar.ToDate(target, system) {
            Err(e) => return Err(_calendarArithmeticError(e))
        }

        return Ok(resolved)
    }

    if policy == MonthEndPolicy.Reject {
        return Err(TemporalArithmeticError.InvalidTarget)
    }

    let adjusted := calendar.CalendarFields { Year: target.Year, Month: target.Month, Day: maxDay, }

    let finalDay := try calendar.ToDate(adjusted, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    if policy == MonthEndPolicy.Clamp {
        return Ok(finalDay)
    }

    // RollForward continues beyond the target month's end.
    let surplus   := int64(target.Day) - int64(maxDay)
    let epochDays := int64(finalDay.EpochDays) + surplus

    let checkedDays := try int32(epochDays) {
        Err(_) => return Err(TemporalArithmeticError.OutOfRange)
    }

    return Ok(new date(checkedDays))
}

/**
 * Adds calendar months to an absolute date.
 *
 * Description:
 * Moves directly to the requested month in the selected
 * calendar. Applies MonthEndPolicy once at the target.
 *
 * Hebrew leap months are counted as individual months.
 * Zero months preserves the date after calendar validation.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - months: Signed number of month transitions.
 * - system: Calendar used for the operation.
 * - policy: Policy for an invalid target day.
 *
 * Returns:
 * Absolute date after the month displacement.
 *
 * Errors:
 * - TemporalArithmeticError.InvalidTarget: Invalid target.
 * - TemporalArithmeticError.OutOfRange: Outside supported range.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn AddMonths(value: date, months: int, system: calendar.CalendarSystem, policy: MonthEndPolicy) Result[date, TemporalArithmeticError] {
    let source := try calendar.FromDate(value, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    if months == 0 {
        return Ok(value)
    }

    let target := try _monthAtOffset(source, months, system)

    return _resolveCalendarTarget(target, system, policy)
}

/**
 * Applies a calendar-relative period to an absolute date.
 *
 * Description:
 * Applies years, months, weeks and days as separate
 * operations in the order selected by PeriodOrder.
 *
 * Each step uses the result of the preceding step.
 * Invalid intermediate dates are not silently skipped.
 *
 * Year movement preserves the calendar month identity.
 * Month movement counts actual months, including leap
 * months. Week and day movement uses the absolute day axis.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - period: Signed calendar-period components.
 * - system: Calendar system for all operations.
 * - policy: Invalid-day resolution for year/month steps.
 * - order: Explicit component evaluation order.
 *
 * Returns:
 * Resulting absolute date after all components are applied.
 *
 * Errors:
 * - TemporalArithmeticError.InvalidTarget: Invalid target.
 * - TemporalArithmeticError.OutOfRange: Outside supported range.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn AddPeriod(
    value:  date,
    period: CalendarPeriod,
    system: calendar.CalendarSystem,
    policy: MonthEndPolicy,
    order:  PeriodOrder,
) Result[date, TemporalArithmeticError] {
    // Validate the calendar even for an entirely zero period.
    let mut current := try AddMonths(value, 0, system, policy)

    match order {
        PeriodOrder.YearsMonthsWeeksDays => {
            if period.Years != 0 {
                current = try _addCalendarYears(current, period.Years, system, policy)
            }

            if period.Months != 0 {
                current = try AddMonths(current, period.Months, system, policy)
            }

            if period.Weeks != 0 {
                current = try _addCalendarWeeks(current, period.Weeks, system)
            }

            if period.Days != 0 {
                current = try _addCalendarDays(current, int64(period.Days), system)
            }
        }

        PeriodOrder.DaysWeeksMonthsYears => {
            if period.Days != 0 {
                current = try _addCalendarDays(current, int64(period.Days), system)
            }

            if period.Weeks != 0 {
                current = try _addCalendarWeeks(current, period.Weeks, system)
            }

            if period.Months != 0 {
                current = try AddMonths(current, period.Months, system, policy)
            }

            if period.Years != 0 {
                current = try _addCalendarYears(current, period.Years, system, policy)
            }
        }
    }

    return Ok(current)
}

/**
 * Adds calendar years while preserving month identity.
 *
 * Description:
 * Keeps the source month code and requested day number.
 * A Hebrew leap month missing from the target year causes
 * InvalidTarget regardless of MonthEndPolicy.
 *
 * Year arithmetic does not mean twelve month transitions.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - years: Signed number of calendar years.
 * - system: Selected calendar system.
 * - policy: Policy for an invalid target day.
 *
 * Returns:
 * Absolute date after the year displacement.
 *
 * Errors:
 * - TemporalArithmeticError.InvalidTarget: Missing month/day.
 * - TemporalArithmeticError.OutOfRange: Unsupported target year.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn _addCalendarYears(value: date, years: int, system: calendar.CalendarSystem, policy: MonthEndPolicy) Result[date, TemporalArithmeticError] {
    if years == 0 {
        return Ok(value)
    }

    let source := try calendar.FromDate(value, system) {
        Err(e) => return Err(_calendarArithmeticError(e))
    }

    let sourceYear := int64(source.Year)
    let delta      := int64(years)

    // Bound the target year before performing the addition.
    let mut minYear: int64 := -6_000_000
    let maxYear:     int64 := 10_000_000

    if system in [
        calendar.CalendarSystem.Hebrew,
        calendar.CalendarSystem.IslamicTabular,
    ] {
        minYear = 1
    }

    if delta < minYear - sourceYear ||
        delta > maxYear - sourceYear {
        return Err(TemporalArithmeticError.OutOfRange)
    }

    let targetYear := try int(sourceYear + delta) {
        Err(_) => return Err(TemporalArithmeticError.OutOfRange)
    }

    // The month code remains unchanged, even when its
    // ordinal position differs between calendar years.
    let target := calendar.CalendarFields {
        Year: targetYear,
        Month: source.Month,
        Day: source.Day,
    }

    return _resolveCalendarTarget(target, system, policy)
}

/**
 * Adds calendar days to an absolute date.
 *
 * Description:
 * Uses the consecutive absolute-day representation.
 * Validates that the result is supported by the selected
 * calendar, including its permitted year numbering.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - days: Signed number of calendar days.
 * - system: Selected calendar system.
 *
 * Returns:
 * Resulting absolute date.
 *
 * Errors:
 * - TemporalArithmeticError.OutOfRange: Unrepresentable day.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _addCalendarDays(
    value:  date,
    days:   int64,
    system: calendar.CalendarSystem,
) Result[date, TemporalArithmeticError] {
    if days == 0 {
        return Ok(value)
    }

    let origin := int64(value.EpochDays)

    // Check before adding to avoid intermediate overflow.
    if days < -2_147_483_648 - origin ||
        days > 2_147_483_647 - origin {
        return Err(TemporalArithmeticError.OutOfRange)
    }

    let checkedDays := try int32(origin + days) {
        Err(_) => return Err(TemporalArithmeticError.OutOfRange)
    }

    let result := new date(checkedDays)

    // The result must remain inside the selected calendar era.
    match calendar.FromDate(result, system) {
        Ok(_) => return Ok(result)
        Err(e) => return Err(_calendarArithmeticError(e))
    }
}

/**
 * Adds calendar weeks to an absolute date.
 *
 * Description:
 * One calendar week consists of seven consecutive
 * calendar days. No timezone or elapsed-time duration
 * is introduced.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - weeks: Signed number of calendar weeks.
 * - system: Selected calendar system.
 *
 * Returns:
 * Resulting absolute date.
 *
 * Errors:
 * - TemporalArithmeticError.OutOfRange: Unrepresentable day.
 * - TemporalArithmeticError.UnsupportedSystem: Missing rules.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _addCalendarWeeks(value: date, weeks: int, system: calendar.CalendarSystem) Result[date, TemporalArithmeticError] {
    // A core date cannot span more than 614 million weeks.
    if weeks < -614_000_000 || weeks > 614_000_000 {
        return Err(TemporalArithmeticError.OutOfRange)
    }

    return _addCalendarDays(value, int64(weeks) * 7, system)
}
