module str

/*
 * Sec Standard Library - str - Sequence joining and concatenation
 *
 * File:        stdlib/str/join.sec
 * Module:      str
 * Revision:    1
 * Updated:     2026-10-05
 * Author:      Jonas Engström
 *
 * Purpose:
 * Materializes a sequence of strings as one string, optionally inserting a
 * separator between elements.
 *
 * Allocation:
 * Produces one materialized output string.
 *
 * Unicode:
 * Copies valid UTF-8 string data without changing rune contents.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 */

// TODO: Implement stdlib/str/join.sec

fn Join(values: Iterator[string], separator: string) Result[string, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}

fn Join(values: ref string[], separator: string) Result[string, CollectionError] {
    let mut totalBytes: uint := 0
    let mut count: uint := 0

    // Calculate the required UTF-8 byte capacity.
    for value in values {
        totalBytes += value.Len

        if count > 0 {
            totalBytes += separator.Len
        }

        count += 1
    }

    // Construct the output with the required capacity.
    let mut builder := try new Builder(totalBytes)
    let mut first := true

    for value in values {
        if !first {
            try builder.Append(separator)
        }

        try builder.Append(value)
        first = false
    }

    return builder.Finish()
}

fn Concat(values: Iterator[string]) Result[string, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}

fn Concat(values: ref string[]) Result[string, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}

fn AppendJoin(builder: ref mut Builder, values: Iterator[string], separator: string) Result[void, CollectionError] {
    return Err(CollectionError.AllocationFailed)
}
