module main

type Value union { Number(int), Empty }
enum Alias { First = 10, Same = 10, Second = 20 }
enum Bit: bit[1] { Off = 0, Disabled = 0, On = 1 }

fn Union(value: Value) int {
    match value {
        Number(number) => { return number }
        Empty => { return 0 }
    }
}
fn Optional(value: Option[int]) int {
    match value {
        Some(number) => { return number }
        None => { return 0 }
    }
}
fn Aliases(value: Alias) int {
    match value {
        Alias.Same => { return 10 }
        Alias.Second => { return 20 }
    }
}
fn Bits(value: Bit) int {
    match value {
        Bit.Disabled => { return 0 }
        Bit.On => { return 1 }
    }
}
fn Nested(value: Value, other: Option[int]) int {
    match value {
        Number(number) => {
            match other {
                Some(inner) => { return inner }
                None => { return number }
            }
        }
        Empty => { return 0 }
    }
}
fn NestedUnsafe(value: Option[int]) int {
    unsafe {
        match value {
            Some(number) => { return number }
            None => { return 0 }
        }
    }
}
fn PanicArm(value: Option[int]) int {
    match value {
        Some(number) => { return number }
        None => { panic "missing" }
    }
}
fn Guarded(value: Option[int], enabled: bool) int {
    match value {
        Some(number) where enabled => { return number }
        Some(number) => { return number }
        None => { return 0 }
    }
}
