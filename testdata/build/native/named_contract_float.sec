module main

// Runtime conversions into constrained named float types (contracts.md
// §§ 6(2), 12, 13.1): each range bound is a value of the base type (shaped
// like a literal, nearest-even) compared with ordered predicates, so NaN and
// out-of-range values fail; finite rejects NaN and infinities. main returns 42 only when every case
// holds.

type Ratio float64 range 0.0..1.0
type Below float64 range 0.0..<0.1
type Measured float32 finite
type Tenth float32 range 0.1..0.2

fn Code(error: ConversionError) int {
    match error {
        ConversionError.Contract(contract) => return Detail(contract)
        _ => return 9999
    }
}

fn Detail(contract: ContractError) int {
    match contract {
        ContractError.Violation { Kind: kind, DeclarationIndex: index } => {
            if index != 0 { return 8888 }
            match kind {
                ContractKind.Range => return 1
                ContractKind.Finite => return 6
                _ => return 7777
            }
        }
    }
}

fn ToRatio(x: float64) Result[Ratio, ConversionError] {
    let r := try Ratio(x)
    return Ok(r)
}

fn ToBelow(x: float64) Result[Below, ConversionError] {
    let b := try Below(x)
    return Ok(b)
}

fn ToMeasured(x: float32) Result[Measured, ConversionError] {
    let m := try Measured(x)
    return Ok(m)
}

fn ToTenth(x: float32) Result[Tenth, ConversionError] {
    let t := try Tenth(x)
    return Ok(t)
}

fn RatioCode(x: float64) int {
    match ToRatio(x) {
        Ok(r) => {
            if float64(r) != x { return 5555 }
            return 0
        }
        Err(error) => return Code(error)
    }
}

fn BelowCode(x: float64) int {
    match ToBelow(x) {
        Ok(_) => return 0
        Err(error) => return Code(error)
    }
}

fn MeasuredCode(x: float32) int {
    match ToMeasured(x) {
        Ok(_) => return 0
        Err(error) => return Code(error)
    }
}

fn TenthCode(x: float32) int {
    match ToTenth(x) {
        Ok(_) => return 0
        Err(error) => return Code(error)
    }
}

fn main() int {
    if RatioCode(0.0) != 0 { return 10 }
    if RatioCode(1.0) != 0 { return 11 }
    if RatioCode(-0.0) != 0 { return 12 }
    if RatioCode(1.0000000000000002) != 1 { return 13 }
    if RatioCode(float64.NaN) != 1 { return 14 }
    if RatioCode(float64.NegativeInfinity) != 1 { return 15 }
    if BelowCode(0.09999999999999999) != 0 { return 20 }
    if BelowCode(0.1) != 1 { return 21 }
    let one: float32 := 1.0
    if MeasuredCode(one) != 0 { return 30 }
    if MeasuredCode(float32.NaN) != 6 { return 31 }
    if MeasuredCode(float32.Infinity) != 6 { return 32 }
    let low: float32 := 0.1
    let high: float32 := 0.2
    let under: float32 := 0.099999994
    if TenthCode(low) != 0 { return 40 }
    if TenthCode(high) != 0 { return 41 }
    if TenthCode(under) != 1 { return 42 }
    return 42
}
