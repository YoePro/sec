module main

fn Ordinary(pointer: RawPtr[int], value: int) int {
    unsafe {
        pointer.Write(value)
        return pointer.Read()
    }
}

fn Volatile(pointer: RawPtr[int], value: int) int {
    unsafe {
        pointer.VolatileWrite(value)
        return pointer.VolatileRead()
    }
}

fn ReadOnly(pointer: RawPtr[int]) int {
    unsafe { return pointer.Read() }
}

fn Possess(pointer: RawPtr[int]) RawPtr[int] { return pointer }

fn Indirect(pointer: RawPtr[int], value: int) int {
    return Ordinary(pointer, value)
}
