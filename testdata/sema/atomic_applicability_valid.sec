    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn PointerOps(value: ref Atomic[RawPtr[byte]], item: RawPtr[byte]) RawPtr[byte] {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn NamedPointer(value: ref Atomic[Pointer], item: Pointer) Pointer {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn Constrained(value: ref Atomic[Bounded], item: Bounded) Bounded {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn InheritedConstraint(value: ref Atomic[InheritedBound], item: InheritedBound) InheritedBound {
    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    return value.Load()
}

fn Inferred(item: Count) Count {
    let value := Atomic(item)
    discard value.FetchAdd(item)
    return value.Load()
}
