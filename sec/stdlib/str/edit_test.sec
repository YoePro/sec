module str

/*
 * Sec Standard Library - str - Immutable byte-range editing tests
 *
 * File:        stdlib/str/edit_test.sec
 * Module:      str
 * Revision:    1
 * Updated:     2026-10-11
 *
 * Purpose:
 * Tests immutable insertion, deletion, and replacement at UTF-8 rune
 * boundaries, including error variants, byte offsets, and empty ranges.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 */

// Insert(string): beginning, middle, end, empty input, and UTF-8 boundaries.

test "Insert string at beginning" {
    let result := try Insert("abc", 0, "X")
    testing.ExpectEqual("Xabc", result)
}

test "Insert string in middle" {
    let result := try Insert("abc", 1, "XYZ")
    testing.ExpectEqual("aXYZbc", result)
}

test "Insert string at end" {
    let result := try Insert("abc", 3, "!")
    testing.ExpectEqual("abc!", result)
}

test "Insert string into empty input" {
    let result := try Insert("", 0, "Text")
    testing.ExpectEqual("Text", result)
}

test "Insert empty string leaves content unchanged" {
    let result := try Insert("abc", 1, "")
    testing.ExpectEqual("abc", result)
}

test "Insert empty string at end leaves content unchanged" {
    let result := try Insert("abc", 3, "")
    testing.ExpectEqual("abc", result)
}

test "Insert string before multibyte rune" {
    let result := try Insert("AåB", 1, "!")
    testing.ExpectEqual("A!åB", result)
}

test "Insert string after multibyte rune" {
    let result := try Insert("AåB", 3, "!")
    testing.ExpectEqual("Aå!B", result)
}

test "Insert string at combining rune boundary" {
    let result := try Insert("é", 1, "X")
    testing.ExpectEqual("eX́", result)
}

test "Insert string between emoji and suffix" {
    let result := try Insert("A🦊B", 5, ":")
    testing.ExpectEqual("A🦊:B", result)
}

test "Insert string rejects index inside two-byte rune" {
    try Insert("AåB", 2, "!") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
        Err(_) => {
            testing.Fail("Unkown Error")
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "Insert string rejects index inside four-byte rune" {
    try Insert("A🦊B", 3, "!") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(3, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "Insert string rejects invalid index even if insertion empty" {
    try Insert("AåB", 2, "") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "Insert string rejects index beyond length" {
    try Insert("AåB", 5, "!") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(5, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "Insert string rejects nonzero index into empty input" {
    try Insert("", 1, "X") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(1, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

// Insert(rune): direct rune encoding and the same byte-boundary validation.

test "Insert ASCII rune at beginning" {
    let result := try Insert("abc", 0, 88r)
    testing.ExpectEqual("Xabc", result)
}

test "Insert two-byte rune in middle" {
    let result := try Insert("AB", 1, 229r)
    testing.ExpectEqual("AåB", result)
}

test "Insert three-byte rune in middle" {
    let result := try Insert("AB", 1, 8364r)
    testing.ExpectEqual("A€B", result)
}

test "Insert four-byte rune in middle" {
    let result := try Insert("AB", 1, 129418r)
    testing.ExpectEqual("A🦊B", result)
}

test "Insert rune into empty input" {
    let result := try Insert("", 0, 129418r)
    testing.ExpectEqual("🦊", result)
}

test "Insert rune at end" {
    let result := try Insert("abc", 3, 88r)
    testing.ExpectEqual("abcX", result)
}

test "Insert rune after two-byte rune" {
    let result := try Insert("AåB", 3, 88r)
    testing.ExpectEqual("AåXB", result)
}

test "Insert rune rejects index inside two-byte rune" {
    try Insert("AåB", 2, 88r) {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "Insert rune rejects index inside four-byte rune" {
    try Insert("A🦊B", 4, 88r) {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "Insert rune rejects index beyond length" {
    try Insert("abc", 4, 88r) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

// RemoveRange: [startByte, endByte) is a half-open byte range.

test "RemoveRange removes middle bytes" {
    let result := try RemoveRange("abcdef", 2, 4)
    testing.ExpectEqual("abef", result)
}

test "RemoveRange removes prefix" {
    let result := try RemoveRange("abcdef", 0, 2)
    testing.ExpectEqual("cdef", result)
}

test "RemoveRange removes suffix" {
    let result := try RemoveRange("abcdef", 4, 6)
    testing.ExpectEqual("abcd", result)
}

test "RemoveRange removes complete content" {
    let result := try RemoveRange("abc", 0, 3)
    testing.ExpectEqual("", result)
}

test "RemoveRange leaves an empty middle interval unchanged" {
    let result := try RemoveRange("abc", 1, 1)
    testing.ExpectEqual("abc", result)
}

test "RemoveRange leaves an empty interval at end unchanged" {
    let result := try RemoveRange("abc", 3, 3)
    testing.ExpectEqual("abc", result)
}

test "RemoveRange accepts empty input and empty range" {
    let result := try RemoveRange("", 0, 0)
    testing.ExpectEqual("", result)
}

test "RemoveRange removes entire two-byte rune" {
    let result := try RemoveRange("AåB", 1, 3)
    testing.ExpectEqual("AB", result)
}

test "RemoveRange removes entire four-byte rune" {
    let result := try RemoveRange("A🦊B", 1, 5)
    testing.ExpectEqual("AB", result)
}

test "RemoveRange can remove combining rune independently" {
    let result := try RemoveRange("é", 1, 3)
    testing.ExpectEqual("e", result)
}

test "RemoveRange rejects start inside rune" {
    try RemoveRange("AåB", 2, 3) {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "RemoveRange rejects end inside rune" {
    try RemoveRange("AåB", 1, 2) {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "RemoveRange rejects end beyond length" {
    try RemoveRange("abc", 3, 4) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "RemoveRange rejects start greater than end" {
    try RemoveRange("abc", 2, 1) {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "RemoveRange prioritizes reversed range over out of bounds" {
    try RemoveRange("abc", 5, 4) {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "RemoveRange rejects empty interval beyond length" {
    try RemoveRange("abc", 4, 4) {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "RemoveRange rejects empty interval inside rune" {
    try RemoveRange("AåB", 2, 2) {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

// ReplaceRange: substitution, insertion, deletion, and error precedence.

test "ReplaceRange replaces middle interval" {
    let result := try ReplaceRange("abcdef", 2, 4, "XY")
    testing.ExpectEqual("abXYef", result)
}

test "ReplaceRange replaces prefix" {
    let result := try ReplaceRange("abc", 0, 1, "X")
    testing.ExpectEqual("Xbc", result)
}

test "ReplaceRange replaces suffix" {
    let result := try ReplaceRange("abc", 2, 3, "!")
    testing.ExpectEqual("ab!", result)
}

test "ReplaceRange replaces complete content" {
    let result := try ReplaceRange("abc", 0, 3, "XYZ")
    testing.ExpectEqual("XYZ", result)
}

test "ReplaceRange inserts at empty interval" {
    let result := try ReplaceRange("abc", 1, 1, "X")
    testing.ExpectEqual("aXbc", result)
}

test "ReplaceRange appends at empty interval" {
    let result := try ReplaceRange("abc", 3, 3, "X")
    testing.ExpectEqual("abcX", result)
}

test "ReplaceRange removes with empty replacement" {
    let result := try ReplaceRange("abc", 1, 2, "")
    testing.ExpectEqual("ac", result)
}

test "ReplaceRange removes all with empty replacement" {
    let result := try ReplaceRange("abc", 0, 3, "")
    testing.ExpectEqual("", result)
}

test "ReplaceRange leaves empty edit unchanged" {
    let result := try ReplaceRange("abc", 1, 1, "")
    testing.ExpectEqual("abc", result)
}

test "ReplaceRange inserts into empty input" {
    let result := try ReplaceRange("", 0, 0, "X")
    testing.ExpectEqual("X", result)
}

test "ReplaceRange replaces two-byte rune with emoji" {
    let result := try ReplaceRange("AåB", 1, 3, "🦊")
    testing.ExpectEqual("A🦊B", result)
}

test "ReplaceRange replaces emoji with two-byte rune" {
    let result := try ReplaceRange("A🦊B", 1, 5, "å")
    testing.ExpectEqual("AåB", result)
}

test "ReplaceRange removes combining rune without normalization" {
    let result := try ReplaceRange("é", 1, 3, "")
    testing.ExpectEqual("e", result)
}

test "ReplaceRange rejects start inside rune" {
    try ReplaceRange("AåB", 2, 3, "X") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "ReplaceRange rejects end inside rune" {
    try ReplaceRange("AåB", 1, 2, "X") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}

test "ReplaceRange rejects out of bounds end" {
    try ReplaceRange("abc", 1, 5, "X") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(5, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "ReplaceRange rejects reversed range" {
    try ReplaceRange("abc", 2, 1, "X") {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "ReplaceRange prioritizes reversed range over out of bounds" {
    try ReplaceRange("abc", 9, 8, "X") {
        Err(EditError.StartAfterEnd) => {
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.StartAfterEnd")
}

test "ReplaceRange validates empty edit beyond length" {
    try ReplaceRange("abc", 4, 4, "") {
        Err(EditError.OutOfBounds(position)) => {
            testing.ExpectEqual(4, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.OutOfBounds")
}

test "ReplaceRange validates empty edit inside rune" {
    try ReplaceRange("AåB", 2, 2, "") {
        Err(EditError.NotRuneBoundary(position)) => {
            testing.ExpectEqual(2, position)
            testing.Pass()
        }
    }

    testing.Fail("expected EditError.NotRuneBoundary")
}
