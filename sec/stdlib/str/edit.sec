module str

/*
 * Sec Standard Library - str - Position-based immutable string editing
 *
 * File:        stdlib/str/edit.sec
 * Module:      str
 * Revision:    2
 * Updated:     2026-11-17
 * Author:      Jonas Engström
 *
 * Purpose:
 * Creates new strings by inserting, removing, or replacing explicit rune
 * ranges in existing strings.
 *
 * Allocation:
 * Successful edits that change content materialize new string storage.
 *
 * Unicode:
 * Edit positions are zero-based rune indexes (MD-090), the unit of
 * string.IndexOf. Ranges are half-open and value.Len is a valid end
 * position. The prefix and suffix around an edit are borrowed StringView
 * ranges of the source (MD-126) appended to the result Builder.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md § 11
 */

type EditError union error {
    /**
     * A rune index lies outside the source string.
     */
    OutOfBounds(uint),

    /**
     * The requested range begins after it ends.
     */
    StartAfterEnd,

    /**
     * Result storage could not be allocated.
     */
    Allocation(CollectionError),
}

/**
 * Inserts a string at a rune index.
 *
 * Description:
 * Creates a new string by inserting insertion before the rune at
 * runeIndex. The source string remains unchanged.
 *
 * Position zero inserts at the beginning, while value.Len inserts at
 * the end. An empty insertion returns the original string.
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - runeIndex: The zero-based rune index where insertion occurs.
 * - insertion: The UTF-8 string to insert.
 *
 * Returns:
 * The string containing the inserted text.
 *
 * Errors:
 * - OutOfBounds: runeIndex exceeds value.Len.
 * - Allocation: Result storage could not be allocated.
 *
 * Allocation:
 * Materializes a new string for a non-empty insertion.
 * An empty insertion does not require new storage.
 */
fn Insert(value: string, runeIndex: uint, insertion: string) Result[string, EditError] {
    try _ValidateRuneIndex(value, runeIndex)

    if insertion.SizeOf == 0 {
        return Ok(value)
    }

    // The positions are validated, so the borrowed ranges cannot fail.
    let prefix := value[0..<runeIndex]
    let suffix := value[runeIndex..<value.Len]
    let capacity := value.SizeOf + insertion.SizeOf
    let mut builder := try new Builder(capacity) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(prefix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(insertion) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(suffix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    let result := try builder.Finish() {
        Err(error) => return Err(EditError.Allocation(error))
    }

    return Ok(result)
}

/**
 * Inserts a Unicode rune at a rune index.
 *
 * Description:
 * Creates a new string by inserting the UTF-8 encoding of insertion
 * before the rune at runeIndex. The source string remains unchanged.
 * The rune changes the inserted value, not the position unit.
 *
 * Position zero inserts at the beginning, while value.Len inserts at
 * the end. No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - runeIndex: The zero-based rune index where insertion occurs.
 * - insertion: The Unicode rune to insert.
 *
 * Returns:
 * A new UTF-8 string containing the inserted rune.
 *
 * Errors:
 * - OutOfBounds: runeIndex exceeds value.Len.
 * - Allocation: Result storage could not be allocated.
 *
 * Allocation:
 * Materializes a new string.
 * The rune is encoded directly without an intermediate string.
 */
fn Insert(value: string, runeIndex: uint, insertion: rune) Result[string, EditError] {
    try _ValidateRuneIndex(value, runeIndex)

    // The position is validated, so the borrowed ranges cannot fail.
    let prefix := value[0..<runeIndex]
    let suffix := value[runeIndex..<value.Len]
    let capacity := value.SizeOf + 4
    let mut builder := try new Builder(capacity) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(prefix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(insertion) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(suffix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    let result := try builder.Finish() {
        Err(error) => return Err(EditError.Allocation(error))
    }

    return Ok(result)
}

/**
 * Removes a rune range from a UTF-8 string.
 *
 * Description:
 * Creates a new string by removing the runes in the half-open range
 * [startRune, endRune). The source string remains unchanged.
 *
 * An empty range returns the original string after both positions
 * are validated. Removing [0, value.Len) produces an empty string.
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - startRune: Inclusive start rune index.
 * - endRune: Exclusive end rune index.
 *
 * Returns:
 * The string with the specified range removed.
 *
 * Errors:
 * - StartAfterEnd: startRune exceeds endRune.
 * - OutOfBounds: A position exceeds value.Len.
 * - Allocation: Result storage could not be allocated.
 *
 * Allocation:
 * Materializes a new string when content is removed.
 * An empty range does not require new storage.
 */
fn RemoveRange(value: string, startRune: uint, endRune: uint) Result[string, EditError] {
    if startRune > endRune {
        return Err(EditError.StartAfterEnd)
    }

    try _ValidateRuneIndex(value, startRune)
    try _ValidateRuneIndex(value, endRune)

    if startRune == endRune {
        return Ok(value)
    }

    // The positions are validated, so the borrowed ranges cannot fail.
    let prefix := value[0..<startRune]
    let suffix := value[endRune..<value.Len]
    let mut builder := try new Builder(value.SizeOf) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(prefix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(suffix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    let result := try builder.Finish() {
        Err(error) => return Err(EditError.Allocation(error))
    }

    return Ok(result)
}

/**
 * Replaces a rune range in a UTF-8 string.
 *
 * Description:
 * Creates a new string by replacing the runes in the half-open range
 * [startRune, endRune) with replacement. The source string remains
 * unchanged.
 *
 * An empty range inserts replacement at startRune. An empty
 * replacement removes the specified range. An empty range with an
 * empty replacement returns the original string.
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - startRune: Inclusive start rune index.
 * - endRune: Exclusive end rune index.
 * - replacement: The UTF-8 string inserted in place of the range.
 *
 * Returns:
 * The string with the specified range replaced.
 *
 * Errors:
 * - StartAfterEnd: startRune exceeds endRune.
 * - OutOfBounds: A position exceeds value.Len.
 * - Allocation: Result storage could not be allocated.
 *
 * Allocation:
 * Materializes a new string when content changes.
 * An empty edit does not require new storage.
 */
fn ReplaceRange(value: string, startRune: uint, endRune: uint, replacement: string) Result[string, EditError] {
    if startRune > endRune {
        return Err(EditError.StartAfterEnd)
    }

    try _ValidateRuneIndex(value, startRune)
    try _ValidateRuneIndex(value, endRune)

    if startRune == endRune && replacement.SizeOf == 0 {
        return Ok(value)
    }

    // The positions are validated, so the borrowed ranges cannot fail.
    let prefix := value[0..<startRune]
    let suffix := value[endRune..<value.Len]
    let capacity := value.SizeOf + replacement.SizeOf
    let mut builder := try new Builder(capacity) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(prefix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(replacement) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    try builder.Append(suffix) {
        Err(error) => return Err(EditError.Allocation(error))
    }

    let result := try builder.Finish() {
        Err(error) => return Err(EditError.Allocation(error))
    }

    return Ok(result)
}

/**
 * Validates a rune index as an edit position.
 *
 * Description:
 * Positions zero through value.Len are valid. Every rune index lies on a
 * rune boundary, so no position can split an encoded rune.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - runeIndex: The rune position to validate.
 *
 * Returns:
 * Ok when runeIndex is a valid edit position.
 *
 * Errors:
 * - OutOfBounds: runeIndex exceeds value.Len.
 *
 * Allocation:
 * Does not allocate.
 */
fn _ValidateRuneIndex(value: string, runeIndex: uint) Result[void, EditError] {
    if runeIndex > value.Len {
        return Err(EditError.OutOfBounds(runeIndex))
    }

    return Ok()
}

/**
 * Translates a validated UTF-8 byte boundary to its rune index.
 *
 * Description:
 * Kept for escape.sec, whose positions are UTF-8 byte offsets; the edit
 * functions use rune indexes directly (MD-090). byteIndex must lie on a
 * rune boundary; value.SizeOf maps to value.Len.
 *
 * Parameters:
 * - value: The source UTF-8 string.
 * - byteIndex: A validated byte boundary.
 *
 * Returns:
 * The number of runes before byteIndex.
 *
 * Allocation:
 * Does not allocate.
 */
fn _RuneIndexOfBoundary(value: string, byteIndex: uint) uint {
    let mut runes: uint := 0
    let mut position: uint := 0

    for character in value {
        if position >= byteIndex {
            return runes
        }

        position += character.Utf8Length
        runes += 1
    }

    return runes
}
