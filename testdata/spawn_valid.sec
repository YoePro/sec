module spawn_valid

// Every spawned task is awaited and every thread detached or joined (a
// value-producing one is joined) before its scope ends (owned-handle
// resolution, threads.md § 34). `spawn process` (not implemented yet) and
// spawning a callable returned by a call (its guard safety is unprovable) are
// covered by their own fixtures once supported.

fn Work() void {
}

fn Calculate() int {
    return 42
}

fn Add(left: int, right: int) int {
    return left + right
}

fn ExplicitTaskSpawn() void {
    let worker := try spawn task Work() { Err(_) => { return } }
    await worker
}

fn ImplicitTaskSpawn() void {
    let worker := try spawn Work() { Err(_) => { return } }
    await worker
}

fn ThreadSpawn() void {
    let worker := spawn thread Work()
    detach worker
}

fn SpawnReturningValue() void {
    let implicitTask := try spawn Calculate() { Err(_) => { return } }
    await implicitTask
    let explicitTask := try spawn task Calculate() { Err(_) => { return } }
    await explicitTask
    let workerThread := spawn thread Calculate()
    join workerThread
}

fn SpawnWithArguments() void {
    let implicitTask := try spawn Add(10, 20) { Err(_) => { return } }
    await implicitTask
    let explicitTask := try spawn task Add(30, 40) { Err(_) => { return } }
    await explicitTask
    let workerThread := spawn thread Add(50, 60)
    join workerThread
}

fn SpawnExpressionArgument() void {
    let worker := try spawn Add(1 + 2, 3 * 4) { Err(_) => { return } }
    await worker
}

fn SpawnNestedCallArgument() void {
    let worker := try spawn Add(Calculate(), Calculate()) { Err(_) => { return } }
    await worker
}

fn SpawnMethodCall() void {
    let worker := try spawn Worker.Run() { Err(_) => { return } }
    await worker
}

fn SpawnExplicitTaskMethodCall() void {
    let worker := try spawn task Worker.Run() { Err(_) => { return } }
    await worker
}

fn SpawnThreadMethodCall() void {
    let worker := spawn thread Worker.Run()
    detach worker
}

type Worker struct {
    value: int,
}

impl Worker {
    static fn Run() void {
    }

    fn Process() int {
        return value
    }
}

fn SpawnInstanceMethod(worker: ref Worker) void {
    let taskHandle := try spawn worker.Process() { Err(_) => { return } }
    await taskHandle
    let threadHandle := spawn thread worker.Process()
    join threadHandle
}

fn SpawnGenericFunction() void {
    let taskHandle := try spawn Identity[int](10) { Err(_) => { return } }
    await taskHandle
    let threadHandle := spawn thread Identity[int](20)
    join threadHandle
}

fn Identity[T](value: T) T {
    return value
}

fn SpawnQualifiedFunction() void {
    let taskHandle := try spawn Run() { Err(_) => { return } }
    await taskHandle
    let threadHandle := spawn thread Run()
    detach threadHandle
}

fn Run() void {
}

fn MultipleSpawnStatements() void {
    let first := try spawn Work() { Err(_) => { return } }
    await first
    let second := try spawn task Work() { Err(_) => { return } }
    await second
    let third := spawn thread Work()
    detach third
}

fn SpawnInIf(condition: bool) void {
    if condition {
        let worker := try spawn Work() { Err(_) => { return } }
        await worker
    } else {
        let worker := spawn thread Work()
        detach worker
    }
}

fn SpawnInLoop() void {
    for index in 0..<4 {
        let worker := try spawn Add(index, index) { Err(_) => { return } }
        await worker
    }
}

