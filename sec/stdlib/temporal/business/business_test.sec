test "Dataset exceptions override ordinary weekdays" {
    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let exceptions: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    let data := BusinessCalendarData {
        Calendar: BusinessCalendar {
            Identifier: "example:calendar",
            Revision: "2026-1",
        },
        FirstDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(1),
        ),
        LastDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(30),
        ),
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    // Friday is explicitly closed.
    testing.Expect(!(try IsBusinessDay(friday, data)))

    // Saturday is explicitly opened.
    testing.Expect(try IsBusinessDay(saturday, data))

    // Monday follows the ordinary weekly pattern.
    testing.Expect(try IsBusinessDay(monday, data))

    // Following must select the exceptional Saturday,
    // not the ordinarily working Monday.
    let adjusted := try AdjustBusinessDay(
        friday, data, BusinessDayAdjustment.Following,
    )

    testing.ExpectEqual(
        saturday.EpochDays,
        adjusted.EpochDays,
    )
}

