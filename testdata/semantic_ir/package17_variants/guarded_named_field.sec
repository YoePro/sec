module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

type Packet union {
    Full { head: Handle, size: int },
    Empty,
}

fn Fresh() Packet {
    return Packet.Empty
}

fn T() int {
    let packet := Fresh()
    match packet {
        Packet.Full(full) where full.size > 0 => {
            return full.size
        }
        Packet.Full(full) => {
            return 0
        }
        Packet.Empty => {
            return 0
        }
    }
}
