fn CorePlatform(x: float, low: float, high: float) Result[float, RangeError] {
    discard float.Min
    discard float.Max
    discard float.Epsilon
    discard float.Infinity
    discard float.NegativeInfinity
    discard float.NaN
    discard x.Abs()
    discard x.IsFinite()
    discard x.IsInfinite()
    discard x.IsNaN()
    discard x.IsNormal()
    discard x.IsSubnormal()
    discard x.Floor()
    discard x.Ceiling()
    discard x.Truncate()
    discard x.Round()
    discard x.Min(low)
    discard x.Max(high)
    let bounded := try x.Clamp(low, high)
    return Ok(bounded)
}

fn main() int {
    return 0
}
