        Err(_) => testing.Fail("Unexpected business error")
    }
}

test "Nth business day follows calendar exceptions" {
    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let exceptions: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    let data := BusinessCalendarData {
        Calendar: BusinessCalendar {
            Identifier: "example:monthly",
            Revision: "1",
        },
        FirstDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(1),
        ),
        LastDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(30),
        ),
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    // First business day is Monday, June 1.
    let first := try NthBusinessDayOfMonth(
        2026, 6, 1, data,
    )

    testing.Expect(try _matchesGregorianDate(
        first, 2026, 6, 1,
    ))

    // Last business day is Tuesday, June 30.
    let last := try LastBusinessDayOfMonth(
        2026, 6, data,
    )

    testing.Expect(try _matchesGregorianDate(
        last, 2026, 6, 30,
    ))

    // Third-to-last business day is exceptional Saturday.
    let thirdFromEnd: int := -3
    let result := try NthBusinessDayOfMonth(
        2026, 6, thirdFromEnd, data,
    )

    testing.ExpectEqual(saturday.EpochDays, result.EpochDays)
}

