module str

/*
 * Sec Standard Library - str - Allocating whitespace and layout transforms
 *
 * File:        stdlib/str/whitespace.sec
 * Module:      str
 * Revision:    1
 * Updated:     2026-10-05
 * Author:      Jonas Engström
 *
 * Purpose:
 * Produces new strings by collapsing whitespace, normalizing whitespace,
 * indenting/dedenting lines, and padding text.
 *
 * Allocation:
 * Content-changing operations materialize new string storage.
 *
 * Unicode:
 * General whitespace recognition uses the canonical rune/core Unicode
 * whitespace property. Indentation rules are separately specified.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 */

// TODO: Implement stdlib/str/whitespace.sec

/**
 * Collapses consecutive Unicode whitespace into single spaces.
 *
 * Description:
 * Replaces each internal sequence of Unicode White_Space
 * characters with one ASCII space (U+0020).
 *
 * Leading and trailing whitespace is removed.
 * Line breaks are treated as whitespace and are not preserved.
 *
 * Non-whitespace Unicode scalar values are preserved
 * without normalization.
 *
 * Parameters:
 * - value: The UTF-8 string to process.
 *
 * Returns:
 * A newly materialized string containing collapsed whitespace.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * Allocates storage for the resulting string.
 */
fn CollapseWhitespace(value: string) Result[string, CollectionError] {
    let mut builder := try new Builder(value.Len)
    let mut pendingSpace := false
    let mut hasContent := false

    for character in value {
        if _IsWhitespaceRune(character) {
            if hasContent {
                pendingSpace = true
            }
            continue
        }

        if pendingSpace {
            try builder.Append(32r)
            pendingSpace = false
        }

        try builder.Append(character)
        hasContent = true
    }

    return builder.Finish()
}

/**
 * Normalizes horizontal Unicode whitespace to ASCII spaces.
 *
 * Description:
 * Replaces each horizontal Unicode White_Space character
 * with one ASCII space (U+0020).
 *
 * Preserves LF, CR, CRLF, NEL, LS, and PS line separators.
 * Vertical tab and form feed are treated as whitespace
 * and replaced with ASCII spaces.
 *
 * Does not collapse consecutive whitespace characters
 * or trim the beginning or end of the string.
 *
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The UTF-8 string to normalize.
 *
 * Returns:
 * A newly materialized string containing normalized
 * whitespace.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * Allocates storage for the resulting string.
 */
fn NormalizeWhitespace(value: string) Result[string, CollectionError] {
    let mut builder := try new Builder(value.Len)

    for character in value {
        if character in [10r, 13r, 133r, 8232r, 8233r] {
            try builder.Append(character)
        } else if _IsWhitespaceRune(character) {
            try builder.Append(32r)
        } else {
            try builder.Append(character)
        }
    }

    return builder.Finish()
}

/**
 * Adds an indentation prefix to each line of a string.
 *
 * Description:
 * Prepends prefix to each line, including empty lines.
 * Recognizes LF, CR, CRLF, NEL, LS, and PS as line breaks.
 *
 * Original line separators and Unicode content are preserved.
 * A trailing line separator does not create an additional
 * indented empty line.
 *
 * Parameters:
 * - value: The UTF-8 text to indent.
 * - prefix: The text to prepend to each line.
 *
 * Returns:
 * A newly materialized string containing the indented text.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * Allocates storage for the resulting string.
 */
fn Indent(value: string, prefix: string) Result[string, CollectionError] {
    let mut builder := try new Builder(value.Len)
    let mut startOfLine := true
    let mut previousWasCR := false

    for character in value {
        // CRLF is one line separator, not two.
        if startOfLine && !(previousWasCR && character == 10r) {
            try builder.Append(prefix)
        }

        try builder.Append(character)

        if character == 13r {
            startOfLine = true
            previousWasCR = true
        } else if character == 10r || character == 133r || character == 8232r || character == 8233r {
            startOfLine = true
            previousWasCR = false
        } else {
            startOfLine = false
            previousWasCR = false
        }
    }

    return builder.Finish()
}

/**
 * Removes the common indentation from multiline text.
 *
 * Description:
 * Finds the longest identical prefix of ASCII spaces
 * and tabs shared by all content-bearing lines.
 *
 * Removes that prefix from every line that starts
 * with it.
 *
 * Empty and indentation-only lines do not participate
 * in determining the common indentation.
 *
 * Lines containing insufficient or different indentation
 * are preserved when the common prefix does not match.
 *
 * Original line separators are preserved, including
 * LF, CR, CRLF, NEL, LS, and PS.
 *
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The UTF-8 text to dedent.
 *
 * Returns:
 * The text with common indentation removed.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * Allocates a result when indentation is removed.
 * Does not require a temporary array of lines.
 */
fn Dedent(value: string) Result[string, CollectionError] {
    let mut common: Option[string] := None()
    let mut position: uint := 0
    let mut lineStart: uint := 0

    // First pass: determine the common indentation.
    for character in value {
        if character in [10r, 13r, 133r, 8232r, 8233r] {
            let line := try value.Slice(lineStart, position) {
                Err(_) => {
                    panic "Dedent: invalid line bounds"
                }
            }

            common = _UpdateDedentPrefix(common, line)

            position += 1
            lineStart = position
        } else {
            position += 1
        }
    }

    // Process the final line when no separator follows it.
    if lineStart < value.Len {
        let line := try value.Slice(lineStart, value.Len) {
            Err(_) => {
                panic "Dedent: invalid final line bounds"
            }
        }

        common = _UpdateDedentPrefix(common, line)
    }

    let indentation := match common {
        None => {
            return Ok(value)
        }
        Some(prefix) => prefix
    }

    if indentation.Len == 0 {
        return Ok(value)
    }

    // Second pass: construct the dedented text.
    let mut builder := try new Builder(value.Len)

    position = 0
    lineStart = 0

    for character in value {
        if character in [10r, 13r, 133r, 8232r, 8233r] {
            let line := try value.Slice(lineStart, position) {
                Err(_) => {
                    panic "Dedent: invalid output line bounds"
                }
            }

            try _AppendDedentedLine(builder, line, indentation)

            // Preserve the original line separator.
            try builder.Append(character)

            position += 1
            lineStart = position
        } else {
            position += 1
        }
    }

    if lineStart < value.Len {
        let line := try value.Slice(lineStart, value.Len) {
            Err(_) => {
                panic "Dedent: invalid output suffix bounds"
            }
        }

        try _AppendDedentedLine(builder, line, indentation)
    }

    return builder.Finish()
}

/**
 * Pads a string on the left to a minimum rune length.
 *
 * Description:
 * Prepends copies of the padding rune until the resulting
 * string contains at least targetLength Unicode scalar values.
 *
 * The target length counts runes, not UTF-8 bytes or
 * terminal display columns.
 *
 * If the input already contains at least targetLength runes,
 * it is returned unchanged.
 *
 * The original text is preserved without normalization.
 *
 * Parameters:
 * - value: The UTF-8 string to pad.
 * - targetLength: Minimum number of runes in the result.
 * - padding: Unicode scalar value used for padding.
 *
 * Returns:
 * A string padded to the requested minimum rune length.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn PadLeft(value: string, targetLength: uint, padding: rune) Result[string, CollectionError] {
    let mut runeCount: uint := 0

    for character in value {
        runeCount += 1
    }

    if runeCount >= targetLength {
        return Ok(value)
    }

    let mut builder := try new Builder(value.Len)

    try builder.AppendRepeat(padding, targetLength - runeCount) {
        Err(_) => {
            panic "PadLeft: padding count invariant violated"
        }
    }

    try builder.Append(value)

    return builder.Finish()
}

/**
 * Pads a string on the left with ASCII spaces.
 *
 * Description:
 * Prepends U+0020 spaces until the string contains at least
 * targetRuneCount Unicode scalar values.
 *
 * If the string is already long enough, it is returned
 * unchanged.
 *
 * Length is measured in runes, not UTF-8 bytes or
 * terminal display columns.
 *
 * Parameters:
 * - value: The UTF-8 string to pad.
 * - targetRuneCount: Minimum number of runes in the result.
 *
 * Returns:
 * The string padded with spaces on the left.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn PadLeft(value: string, targetRuneCount: uint) Result[string, CollectionError] {
    return PadLeft(value, targetRuneCount, 32r)
}

/**
 * Pads a string on the right to a minimum rune length.
 *
 * Description:
 * Appends copies of the padding rune until the resulting
 * string contains at least targetLength Unicode scalar values.
 *
 * The target length counts runes, not UTF-8 bytes or
 * terminal display columns.
 *
 * If the input already contains at least targetLength runes,
 * it is returned unchanged.
 *
 * The original text is preserved without normalization.
 *
 * Parameters:
 * - value: The UTF-8 string to pad.
 * - targetLength: Minimum number of runes in the result.
 * - padding: Unicode scalar value used for padding.
 *
 * Returns:
 * A string padded to the requested minimum rune length.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn PadRight(value: string, targetLength: uint, padding: rune) Result[string, CollectionError] {
    let mut runeCount: uint := 0

    for character in value {
        runeCount += 1
    }

    if runeCount >= targetLength {
        return Ok(value)
    }

    let paddingCount := try targetLength - runeCount {
        Err(_) => {
            panic "PadRight: padding count invariant violated"
        }
    }

    let mut builder := try new Builder(value.Len)

    try builder.Append(value)
    try builder.AppendRepeat(padding, paddingCount)

    return builder.Finish()
}

/**
 * Pads a string on the right with ASCII spaces.
 *
 * Description:
 * Appends U+0020 spaces until the string contains at least
 * targetRuneCount Unicode scalar values.
 *
 * If the string is already long enough, it is returned
 * unchanged.
 *
 * Length is measured in runes, not UTF-8 bytes or
 * terminal display columns.
 *
 * Parameters:
 * - value: The UTF-8 string to pad.
 * - targetRuneCount: Minimum number of runes in the result.
 *
 * Returns:
 * The string padded with spaces on the right.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn PadRight(value: string, targetRuneCount: uint) Result[string, CollectionError] {
    return PadRight(value, targetRuneCount, 32r)
}

/**
 * Centers a string by padding both sides with a rune.
 *
 * Description:
 * Adds padding runes to both sides until the resulting string
 * contains at least targetRuneCount Unicode scalar values.
 *
 * Padding is distributed as evenly as possible.
 * When an odd number of padding runes is required, the
 * additional rune is placed on the right.
 *
 * If the input already contains at least targetRuneCount
 * runes, it is returned unchanged.
 *
 * Length is measured in runes, not UTF-8 bytes or
 * terminal display columns.
 *
 * No Unicode normalization is performed.
 *
 * Parameters:
 * - value: The UTF-8 string to center.
 * - targetRuneCount: Minimum number of runes in the result.
 * - padding: Unicode scalar value used for padding.
 *
 * Returns:
 * The centered string with padding on both sides.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn Center(value: string, targetRuneCount: uint, padding: rune) Result[string, CollectionError] {
    let mut runeCount: uint := 0

    for character in value {
        runeCount += 1
    }

    if runeCount >= targetRuneCount {
        return Ok(value)
    }

    let paddingCount := try targetRuneCount - runeCount {
        Err(_) => {
            panic "Center: padding count invariant violated"
        }
    }

    let leftCount := try paddingCount / 2 {
        Err(_) => {
            panic "Center: padding division invariant violated"
        }
    }

    let rightCount := try paddingCount - leftCount {
        Err(_) => {
            panic "Center: right padding invariant violated"
        }
    }

    let mut builder := try new Builder(value.Len)

    try builder.AppendRepeat(padding, leftCount)
    try builder.Append(value)
    try builder.AppendRepeat(padding, rightCount)

    return builder.Finish()
}

/**
 * Centers a string using ASCII spaces.
 *
 * Description:
 * Pads both sides of the string with U+0020 spaces until
 * it contains at least targetRuneCount Unicode scalar values.
 *
 * When an odd number of spaces is required, the extra
 * space is placed on the right.
 *
 * If the string is already long enough, it is returned
 * unchanged.
 *
 * Parameters:
 * - value: The UTF-8 string to center.
 * - targetRuneCount: Minimum number of runes in the result.
 *
 * Returns:
 * The centered string padded with spaces.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May allocate when padding is required.
 */
fn Center(value: string, targetRuneCount: uint) Result[string, CollectionError] {
    return Center(value, targetRuneCount, 32r)
}

/**
 * Determines whether a rune has the Unicode White_Space property.
 *
 * Description:
 * Implements the White_Space property from Unicode 18.0.0.
 * Does not classify zero-width format characters as whitespace.
 *
 * Parameters:
 * - character: The Unicode scalar value to classify.
 *
 * Returns:
 * True if the rune has the White_Space property.
 *
 * Allocation:
 * Does not allocate.
 */
fn _IsWhitespaceRune(character: rune) bool {
    return character in 9r..13r ||
        character == 32r ||
        character == 133r ||
        character == 160r ||
        character == 5760r ||
        character in 8192r..8202r ||
        character in 8232r..8233r ||
        character == 8239r ||
        character == 8287r ||
        character == 12288r
}

/**
 * Appends a line after removing the common indentation.
 *
 * Description:
 * Removes the exact common indentation prefix from a line.
 *
 * Lines containing only ASCII spaces and tabs are
 * converted to empty lines, regardless of indentation
 * length.
 *
 * Content-bearing lines that do not start with the
 * common indentation are preserved unchanged.
 *
 * Line separators are handled by the caller.
 *
 * Parameters:
 * - builder: Destination for the resulting text.
 * - line: The line without its line separator.
 * - indentation: The common indentation to remove.
 *
 * Returns:
 * Success after appending the processed line.
 *
 * Errors:
 * - CollectionError: Allocation or capacity failure.
 *
 * Allocation:
 * May grow the destination builder.
 */
fn _AppendDedentedLine(builder: ref mut Builder, line: string, indentation: string) Result[void, CollectionError] {
    let mut indentationOnly := true

    for character in line {
        if character != 32r && character != 9r {
            indentationOnly = false
            break
        }
    }

    if indentationOnly {
        return Ok()
    }

    if line.StartsWith(indentation) {
        let suffix := try line.Slice(indentation.Len, line.Len) {
            Err(_) => {
                panic "Dedent: invalid line suffix bounds"
            }
        }

        try builder.Append(suffix)
    } else {
        try builder.Append(line)
    }

    return Ok()
}

/**
 * Updates the common indentation prefix using one line.
 *
 * Description:
 * Considers ASCII spaces and tabs as indentation.
 * Ignores empty and whitespace-only indentation lines.
 *
 * The common prefix must match exactly, including
 * the distinction between spaces and tabs.
 *
 * Parameters:
 * - current: Previously established common indentation.
 * - line: The line to examine, without its line separator.
 *
 * Returns:
 * The updated common indentation, or None when no
 * content-bearing line has been encountered.
 *
 * Allocation:
 * Uses non-allocating string slices.
 */
fn _UpdateDedentPrefix(current: Option[string], line: string) Option[string] {
    let mut length: uint := 0

    while length < line.Len {
        let character := line.ByteAt(length)

        if character != 32 && character != 9 {
            break
        }

        length += 1
    }

    // Ignore empty or indentation-only lines.
    if length == line.Len {
        return current
    }

    let indentation := try line.Slice(0, length) {
        Err(_) => {
            panic "Dedent: invalid indentation bounds"
        }
    }

    match current {
        None => {
            return Some(indentation)
        }
        Some(previous) => {
            let mut matched: uint := 0

            while matched < previous.Len &&
            matched < indentation.Len {
                if previous.ByteAt(matched) !=
                    indentation.ByteAt(matched) {
                    break
                }

                matched += 1
            }

            let shared := try previous.Slice(0, matched) {
                Err(_) => {
                    panic "Dedent: invalid common prefix bounds"
                }
            }

            return Some(shared)
        }
    }
}
