module str

/*
 * Sec Standard Library - str - String and rune/byte materialization tests
 *
 * File:        stdlib/str/collect_test.sec
 * Module:      str
 * Revision:    2
 * Updated:     2026-10-18
 *
 * Purpose:
 * Tests owning rune and byte arrays, UTF-8 encoding and decoding,
 * both FromRunes overloads, byte-to-string UTF-8 decoding,
 * strict invalid UTF-8 offsets, lossy decoding, and round trips.
 *
 * Rulebook:
 * stdlib/str/stdlib_str.md
 */

// Concrete pull iterator for exercising the generic FromRunes overload.
// It yields A, å, €, and 🦊, stopping at the requested number of runes.
type CollectTestRuneIterator struct {
    position: uint,
    limit:    uint,
}

impl CollectTestRuneIterator implements Iterator[rune] {
    fn Next() Option[rune] {
        if self.position >= self.limit {
            return None
        }

        let index := self.position
        self.position += 1

        if index == 0 {
            return Some(65r)
        }
        if index == 1 {
            return Some(229r)
        }
        if index == 2 {
            return Some(8364r)
        }
        return Some(129418r)
    }
}

// ToRuneArray: one element per Unicode scalar value, not per byte.

test "ToRuneArray returns an empty array for an empty string" {
    let runes := try ToRuneArray("")
    testing.ExpectEqual(0, runes.Len)
}

test "ToRuneArray decodes ASCII" {
    let runes := try ToRuneArray("ABC")
    testing.ExpectEqual(3, runes.Len)
    testing.ExpectEqual(65r, runes[0])
    testing.ExpectEqual(66r, runes[1])
    testing.ExpectEqual(67r, runes[2])
}

test "ToRuneArray decodes Swedish letters" {
    let runes := try ToRuneArray("åäö")
    testing.ExpectEqual(3, runes.Len)
    testing.ExpectEqual(229r, runes[0])
    testing.ExpectEqual(228r, runes[1])
    testing.ExpectEqual(246r, runes[2])
}

test "ToRuneArray decodes a three-byte rune" {
    let runes := try ToRuneArray("€")
    testing.ExpectEqual(1, runes.Len)
    testing.ExpectEqual(8364r, runes[0])
}

test "ToRuneArray decodes a four-byte rune" {
    let runes := try ToRuneArray("🦊")
    testing.ExpectEqual(1, runes.Len)
    testing.ExpectEqual(129418r, runes[0])
}

test "ToRuneArray decodes a mixed-width string" {
    let runes := try ToRuneArray("Aå€🦊")
    testing.ExpectEqual(4, runes.Len)
    testing.ExpectEqual(65r, runes[0])
    testing.ExpectEqual(229r, runes[1])
    testing.ExpectEqual(8364r, runes[2])
    testing.ExpectEqual(129418r, runes[3])
}

test "ToRuneArray preserves decomposed accents" {
    let runes := try ToRuneArray("é")
    testing.ExpectEqual(2, runes.Len)
    testing.ExpectEqual(101r, runes[0])
    testing.ExpectEqual(769r, runes[1])
}

test "ToRuneArray distinguishes composed and decomposed accents" {
    let composed := try ToRuneArray("é")
    let decomposed := try ToRuneArray("é")
    testing.ExpectEqual(1, composed.Len)
    testing.ExpectEqual(233r, composed[0])
    testing.ExpectEqual(2, decomposed.Len)
    testing.ExpectEqual(101r, decomposed[0])
    testing.ExpectEqual(769r, decomposed[1])
}

test "ToRuneArray preserves repeated runes" {
    let runes := try ToRuneArray("🦊🦊")
    testing.ExpectEqual(2, runes.Len)
    testing.ExpectEqual(129418r, runes[0])
    testing.ExpectEqual(129418r, runes[1])
}

// ToByteArray: preserve exact UTF-8 bytes without decoding or normalization.

test "ToByteArray returns an empty array for an empty string" {
    let bytes := try ToByteArray("")
    testing.ExpectEqual(0, bytes.Len)
}

test "ToByteArray copies ASCII bytes" {
    let bytes := try ToByteArray("ABC")
    testing.ExpectEqual(3, bytes.Len)
    testing.ExpectEqual(65, bytes[0])
    testing.ExpectEqual(66, bytes[1])
    testing.ExpectEqual(67, bytes[2])
}

test "ToByteArray copies a two-byte rune" {
    let bytes := try ToByteArray("å")
    testing.ExpectEqual(2, bytes.Len)
    testing.ExpectEqual(195, bytes[0])
    testing.ExpectEqual(165, bytes[1])
}

test "ToByteArray copies a three-byte rune" {
    let bytes := try ToByteArray("€")
    testing.ExpectEqual(3, bytes.Len)
    testing.ExpectEqual(226, bytes[0])
    testing.ExpectEqual(130, bytes[1])
    testing.ExpectEqual(172, bytes[2])
}

test "ToByteArray copies a four-byte rune" {
    let bytes := try ToByteArray("🦊")
    testing.ExpectEqual(4, bytes.Len)
    testing.ExpectEqual(240, bytes[0])
    testing.ExpectEqual(159, bytes[1])
    testing.ExpectEqual(166, bytes[2])
    testing.ExpectEqual(138, bytes[3])
}

test "ToByteArray preserves mixed-width UTF-8 bytes" {
    let bytes := try ToByteArray("Aå€🦊")
    testing.ExpectEqual(10, bytes.Len)
    testing.ExpectEqual(65, bytes[0])
    testing.ExpectEqual(195, bytes[1])
    testing.ExpectEqual(165, bytes[2])
    testing.ExpectEqual(226, bytes[3])
    testing.ExpectEqual(130, bytes[4])
    testing.ExpectEqual(172, bytes[5])
    testing.ExpectEqual(240, bytes[6])
    testing.ExpectEqual(159, bytes[7])
    testing.ExpectEqual(166, bytes[8])
    testing.ExpectEqual(138, bytes[9])
}

test "ToByteArray preserves decomposed UTF-8" {
    let bytes := try ToByteArray("é")
    testing.ExpectEqual(3, bytes.Len)
    testing.ExpectEqual(101, bytes[0])
    testing.ExpectEqual(204, bytes[1])
    testing.ExpectEqual(129, bytes[2])
}

test "ToByteArray length equals the source byte length" {
    let value := "å€🦊ABC"
    let bytes := try ToByteArray(value)
    testing.ExpectEqual(value.Len, bytes.Len)
}

test "ToByteArray agrees with the source at every byte offset" {
    let value := "Aå€🦊é"
    let bytes := try ToByteArray(value)
    let mut index: uint := 0

    while index < value.Len {
        testing.ExpectEqual(value.ByteAt(index), bytes[index])
        index += 1
    }
}

// FromRunes(ref rune[]): borrow the array and encode every rune in order.

test "FromRunes array handles an empty array" {
    let mut values: rune[]
    let result := try FromRunes(ref values)
    testing.ExpectEqual("", result)
}

test "FromRunes array encodes ASCII" {
    let mut values: rune[]
    try values.Append(65r)
    try values.Append(66r)
    try values.Append(67r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("ABC", result)
}

test "FromRunes array encodes two-byte runes" {
    let mut values: rune[]
    try values.Append(229r)
    try values.Append(228r)
    try values.Append(246r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("åäö", result)
}

test "FromRunes array encodes a three-byte rune" {
    let mut values: rune[]
    try values.Append(8364r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("€", result)
}

test "FromRunes array encodes a four-byte rune" {
    let mut values: rune[]
    try values.Append(129418r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("🦊", result)
}

test "FromRunes array encodes mixed-width runes" {
    let mut values: rune[]
    try values.Append(65r)
    try values.Append(229r)
    try values.Append(8364r)
    try values.Append(129418r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("Aå€🦊", result)
}

test "FromRunes array preserves decomposed accents" {
    let mut values: rune[]
    try values.Append(101r)
    try values.Append(769r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("é", result)
}

test "FromRunes array does not consume the source" {
    let mut values: rune[]
    try values.Append(65r)
    try values.Append(229r)
    let result := try FromRunes(ref values)
    testing.ExpectEqual("Aå", result)
    testing.ExpectEqual(2, values.Len)
    testing.ExpectEqual(65r, values[0])
    testing.ExpectEqual(229r, values[1])
}

test "FromRunes array result does not alias source storage" {
    let mut values: rune[]
    try values.Append(65r)
    try values.Append(66r)
    let result := try FromRunes(ref values)
    values[0] = 88r
    testing.ExpectEqual("AB", result)
    testing.ExpectEqual(88r, values[0])
}

// FromRunes[I: Iterator[rune]]: a concrete iterator satisfies the generic contract.

test "FromRunes iterator handles an empty sequence" {
    let result := try FromRunes(CollectTestRuneIterator {
        position: 0,
        limit: 0,
    })
    testing.ExpectEqual("", result)
}

test "FromRunes iterator handles a single rune" {
    let result := try FromRunes(CollectTestRuneIterator {
        position: 0,
        limit: 1,
    })
    testing.ExpectEqual("A", result)
}

test "FromRunes iterator encodes multiple rune widths" {
    let result := try FromRunes(CollectTestRuneIterator {
        position: 0,
        limit: 4,
    })
    testing.ExpectEqual("Aå€🦊", result)
}

test "FromRunes iterator respects its end position" {
    let result := try FromRunes(CollectTestRuneIterator {
        position: 1,
        limit: 3,
    })
    testing.ExpectEqual("å€", result)
}

// Round trips: materialization must preserve valid Unicode scalar sequences.

test "Rune array round trip preserves ASCII" {
    let runes := try ToRuneArray("Hello")
    let result := try FromRunes(ref runes)
    testing.ExpectEqual("Hello", result)
}

test "Rune array round trip preserves Swedish text" {
    let runes := try ToRuneArray("Räksmörgås")
    let result := try FromRunes(ref runes)
    testing.ExpectEqual("Räksmörgås", result)
}

test "Rune array round trip preserves mixed-width Unicode" {
    let runes := try ToRuneArray("Aå€🦊")
    let result := try FromRunes(ref runes)
    testing.ExpectEqual("Aå€🦊", result)
}

test "Rune array round trip preserves decomposed Unicode" {
    let runes := try ToRuneArray("é")
    let result := try FromRunes(ref runes)
    testing.ExpectEqual("é", result)
}

test "Rune array round trip preserves an empty string" {
    let runes := try ToRuneArray("")
    let result := try FromRunes(ref runes)
    testing.ExpectEqual("", result)
}

test "Rune and byte collections report different lengths" {
    let value := "Aå€🦊"
    let runes := try ToRuneArray(value)
    let bytes := try ToByteArray(value)
    testing.ExpectEqual(4, runes.Len)
    testing.ExpectEqual(10, bytes.Len)
}

// FromByteArray: strict UTF-8 decoding and zero-based invalid-sequence offsets.

test "FromByteArray empty input" {
    let mut bytes: byte[]
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("", result)
}

test "FromByteArray ASCII text" {
    let mut bytes: byte[]
    try bytes.Append(0x48)
    try bytes.Append(0x65)
    try bytes.Append(0x6C)
    try bytes.Append(0x6C)
    try bytes.Append(0x6F)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("Hello", result)
}

test "FromByteArray embedded NUL" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x00)
    try bytes.Append(0x42)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("A\0B", result)
}

test "FromByteArray two byte Swedish letter" {
    let mut bytes: byte[]
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("å", result)
}

test "FromByteArray three byte euro sign" {
    let mut bytes: byte[]
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0xAC)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("€", result)
}

test "FromByteArray four byte emoji" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x9F)
    try bytes.Append(0xA6)
    try bytes.Append(0x8A)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("🦊", result)
}

test "FromByteArray mixed UTF8 widths" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0xC3)
    try bytes.Append(0xA5)
    try bytes.Append(0xE2)
    try bytes.Append(0x82)
    try bytes.Append(0xAC)
    try bytes.Append(0xF0)
    try bytes.Append(0x9F)
    try bytes.Append(0xA6)
    try bytes.Append(0x8A)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("Aå€🦊", result)
}

test "FromByteArray lowest two byte scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xC2)
    try bytes.Append(0x80)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{0080}", result)
}

test "FromByteArray highest two byte scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xDF)
    try bytes.Append(0xBF)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{07FF}", result)
}

test "FromByteArray lowest three byte scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xE0)
    try bytes.Append(0xA0)
    try bytes.Append(0x80)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{0800}", result)
}

test "FromByteArray last BMP scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xEF)
    try bytes.Append(0xBF)
    try bytes.Append(0xBF)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{FFFF}", result)
}

test "FromByteArray lowest four byte scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xF0)
    try bytes.Append(0x90)
    try bytes.Append(0x80)
    try bytes.Append(0x80)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{10000}", result)
}

test "FromByteArray highest Unicode scalar" {
    let mut bytes: byte[]
    try bytes.Append(0xF4)
    try bytes.Append(0x8F)
    try bytes.Append(0xBF)
    try bytes.Append(0xBF)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{10FFFF}", result)
}

test "FromByteArray existing replacement character is valid" {
    let mut bytes: byte[]
    try bytes.Append(0xEF)
    try bytes.Append(0xBF)
    try bytes.Append(0xBD)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("\u{FFFD}", result)
}

test "FromByteArray decomposed accent" {
    let mut bytes: byte[]
    try bytes.Append(0x65)
    try bytes.Append(0xCC)
    try bytes.Append(0x81)
    let result := try FromByteArray(ref bytes)
    testing.ExpectEqual("e\u{0301}", result)
}

test "FromByteArray rejects isolated continuation byte" {
    let mut bytes: byte[]
    try bytes.Append(0x80)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(0, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

test "FromByteArray rejects second isolated continuation byte" {
    let mut bytes: byte[]
    try bytes.Append(0x41)
    try bytes.Append(0x80)
    match FromByteArray(ref bytes) {
        Ok(_) => {
            testing.Fail("expected StringError.InvalidUtf8")
        }
        Err(error) => {
            match error {
                StringError.InvalidUtf8(position) => {
                    testing.ExpectEqual(1, position)
                }
                _ => {
                    testing.Fail("expected StringError.InvalidUtf8")
                }
            }
        }
    }
}

