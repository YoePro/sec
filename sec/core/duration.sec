module core

type duration struct {
    _nanoseconds: int64,
}

impl duration {
    // int64

    // property Years: int64
    // property Months: int64
    property Weeks: int64 {
        get {
            return self._nanoseconds / 604800000000000
        }
    }

    property Days: int64 {
        get {
            return self._nanoseconds / 86400000000000
        }
    }

    property Hours: int64 {
        get {
            return self._nanoseconds / 3600000000000
        }
    }

    property Minutes: int64 {
        get {
            return self._nanoseconds / 60000000000
        }
    }

    property Seconds: int64 {
        get {
            return self._nanoseconds / 1000000000
        }
    }

    property Milliseconds: int64 {
        get {
            return self._nanoseconds / 1000000
        }
    }

    property Microseconds: int64 {
        get {
            return self._nanoseconds / 1000
        }
    }

    property Nanoseconds: int64 {
        get {
            return self._nanoseconds
        }
    }

    fn ToString() string {
        return ""
    }

    fn Abs() duration {
        if self._nanoseconds < 0 {
            return duration { _nanoseconds: -self._nanoseconds }
        }
        return self
    }

    fn Negate() duration {
        return duration { _nanoseconds: -self._nanoseconds }
    }

    fn FromDays(days: int64) duration {
        return duration { _nanoseconds: days * 86400000000000 }
    }

    fn FromHours(hours: int64) duration {
        return duration { _nanoseconds: hours * 3600000000000 }
    }

    fn FromMinutes(minutes: int64) duration {
        return duration { _nanoseconds: minutes * 60000000000 }
    }

    fn FromSeconds(secsonds: int64) duration {
        return duration { _nanoseconds: secsonds * 1000000000 }
    }

    fn FromMilliseconds(ms: int64) duration {
        return duration { _nanoseconds: ms * 1000000 }
    }

    fn FromMicroseconds(us: int64) duration {
        return duration { _nanoseconds: us * 1000 }
    }

    fn FromNanoseconds(nanos: int64) duration {
        return duration { _nanoseconds: nanos }
    }

    /*
     *     fn Parse(s: string) duration {
     *         // TODO: implement parsing of duration strings
     *         return duration { _nanoseconds: 0 }
     *     }
     *
     *     fn Since(start: time, end: time) duration {
     *         return duration { _nanoseconds: end.Nanoseconds - start.Nanoseconds }
     *     }
     *
     *     fn Until(start: time, end: time) duration {
     *         return duration { _nanoseconds: start.Nanoseconds - end.Nanoseconds }
     *     }
     */

}
