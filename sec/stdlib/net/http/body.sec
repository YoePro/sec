*
* Standards:
*   - RFC 9110
*     https://www.rfc-editor.org/rfc/rfc9110
*
* Rulebook:
*   stdlib/net/http/std-net-http.md
*/

@noCopy
type Body struct {
    // Private streaming source/decoder state.
}

impl Body {
    init(data: byte[]) {
        // TODO: Implement http.Body.init(byte[])
    }

    init(data: string) {
        // TODO: Implement http.Body.init(string)
    }

    static fn Empty() Body { return new Body() }

    // TODO: Implement http.Body.FromBytes()
    static fn FromBytes(->data: byte[]) Body {
        return new Body(<-data)
    }

    // TODO: Implement http.Body.FromString()
    static fn FromString(text: string) Result[Body, BodyError] {
        return Ok(new Body())
    }

    // TODO: Implement http.Body.Length
    property Length: Option[uint64] { get { return 0u } }

    // TODO: Implement http.Body.Replayable
    property Replayable: bool { get { return false } }

    // TODO: Implement http.Body.Read()
    fn Read(buffer: ref mut byte[]) Result[uint, BodyError] {
        return Ok(0)
    }

    // TODO: Implement http.Body.ReadAllToArray()
    fn ReadAllToArray(limit: uint64) Result[byte[], BodyError] {
        return Err(BodyError.Closed)
    }

    // TODO: Implement http.Body.Close()
    fn Close() Result[void, BodyError] {
        return Err(BodyError.Closed)
    }
}
