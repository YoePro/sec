    value.Store(item)
    discard value.Swap(item)
    discard value.CompareExchange(item, item)
    discard value.FetchAdd(item)
    discard value.FetchSub(item)
    discard value.FetchAnd(item)
    discard value.FetchOr(item)
    discard value.FetchXor(item)
    return value.Load()
}

