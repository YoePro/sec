test "CountBusinessDays supports reverse intervals" {
    let rules := BusinessCalendar {
        Identifier: "builtin:mon-fri",
        Revision: "1",
    }

    let start := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let endDate := try ResolveMonthlyDate(
        2026, 7, MonthlyDateRule.DayOfMonth(6),
    )

    let forward := try CountBusinessDays(
        start, endDate, rules,
    )

    let backward := try CountBusinessDays(
        endDate, start, rules,
    )

    testing.ExpectEqual(5, forward)
    testing.ExpectEqual(-5, backward)
}

