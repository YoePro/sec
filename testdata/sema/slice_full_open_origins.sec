module main

fn Same(values: ref int[]) ref int[] { return values }
fn Choose(left: ref int[], right: ref int[], first: bool) ref int[] {
    if first { return left }
    return right
}
fn Static() void {
    let data := [1, 2, 3, 4]
    let view := ref data[1..<3]
    let whole := ref Same(view)[..]
}
fn Empty() void {
    let data := [1, 2, 3, 4]
    let view := ref data[2..<2]
    let whole := ref Same(view)[..]
}
fn Dynamic(values: ref int[], start: int, end: int) void {
    let view := ref values[start..<end]
    let whole := ref Same(view)[..]
}
fn Alternatives(first: bool) void {
    let data := [1, 2, 3, 4]
    let left := ref data[..<2]
    let right := ref data[2..<4]
    let whole := ref Choose(left, right, first)[..]
}
