module main
@noCopy
type Resource struct { Raw: int }
type Pair struct { First: Resource, Second: Resource }
fn Use(value: ref Resource) void { }
fn Transfer() void {
    let source := Pair { First: Resource { Raw: 1 }, Second: Resource { Raw: 2 } }
    let destination := source.First
    Use(source.Second)
    discard destination
}
