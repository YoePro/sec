test "DueDate adjusts an exceptional second Tuesday" {
    let closedTuesday := try ResolveMonthlyDate(
        2026, 11, MonthlyDateRule.DayOfMonth(10),
    )

    let exceptions: BusinessDayException[1] := [
        BusinessDayException {
            Day: closedTuesday,
            Working: false,
        },
    ]

    let data := BusinessCalendarData {
        Calendar: BusinessCalendar {
            Identifier: "example:weekday-due",
            Revision: "1",
        },
        FirstDay: try ResolveMonthlyDate(
            2026, 11, MonthlyDateRule.DayOfMonth(1),
        ),
        LastDay: try ResolveMonthlyDate(
            2026, 11, MonthlyDateRule.DayOfMonth(30),
        ),
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    let rule := MonthlyDueDateRule.WeekdayOrdinal {
        Weekday: date.Weekdays.Tuesday,
        Position: 2,
    }

    let result := try DueDate(
        2026,
        11,
        rule,
        data,
        BusinessDayAdjustment.Following,
    )

    // Tuesday November 10 is closed in this dataset.
    // Following therefore selects Wednesday November 11.
    testing.Expect(try _matchesGregorianDate(
        result, 2026, 11, 11,
    ))
}

test "Combined calendars distinguish All and Any" {
    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let firstDay := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(1),
    )

    let lastDay := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(30),
    )

    // Calendar A closes Friday and opens Saturday.
    let exceptionsA: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    // Calendar B follows ordinary Monday-Friday rules.
    let exceptionsB: BusinessDayException[0] := []

    let week := BusinessWeekPattern {
        Monday: true,
        Tuesday: true,
        Wednesday: true,
        Thursday: true,
        Friday: true,
        Saturday: false,
        Sunday: false,
    }

    let calendars: BusinessCalendarData[2] := [
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:A",
                Revision: "1",
            },
            FirstDay: firstDay,
            LastDay: lastDay,
            Week: week,
            Exceptions: ref exceptionsA[..],
        },
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:B",
                Revision: "1",
            },
            FirstDay: firstDay,
            LastDay: lastDay,
            Week: week,
            Exceptions: ref exceptionsB[..],
        },
    ]

    // Friday: B is open, A is closed.
    testing.Expect(!(try IsBusinessDay(
        friday, calendars[..], BusinessCalendarCombination.All,
    )))

    testing.Expect(try IsBusinessDay(
        friday, calendars[..], BusinessCalendarCombination.Any,
    ))

    // Saturday: A is open, B is closed.
    testing.Expect(!(try IsBusinessDay(
        saturday, calendars[..], BusinessCalendarCombination.All,
    )))

    testing.Expect(try IsBusinessDay(
        saturday, calendars[..], BusinessCalendarCombination.Any,
    ))

    // Monday: both are open.
    testing.Expect(try IsBusinessDay(
        monday, calendars[..], BusinessCalendarCombination.All,
    ))

    // Following from Friday under All selects Monday.
    let adjusted := try AdjustBusinessDay(
        friday,
        calendars[..],
        BusinessCalendarCombination.All,
        BusinessDayAdjustment.Following,
    )

    testing.ExpectEqual(monday.EpochDays, adjusted.EpochDays)
}

test "Combined calendars require overlapping coverage" {
    let exceptions: BusinessDayException[0] := []

    let juneFirst := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(1),
    )

    let juneFifteenth := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(15),
    )

    let juneThirtieth := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(30),
    )

    let week := BusinessWeekPattern {
        Monday: true,
        Tuesday: true,
        Wednesday: true,
        Thursday: true,
        Friday: true,
        Saturday: false,
        Sunday: false,
    }

    let calendars: BusinessCalendarData[2] := [
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:first",
                Revision: "1",
            },
            FirstDay: juneFirst,
            LastDay: juneThirtieth,
            Week: week,
            Exceptions: ref exceptions[..],
        },
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:second",
                Revision: "1",
            },
            FirstDay: juneFifteenth,
            LastDay: juneThirtieth,
            Week: week,
            Exceptions: ref exceptions[..],
        },
    ]

    // June 1 is not covered by the second calendar.
    // Even Any must reject incomplete coverage.
    match IsBusinessDay(juneFirst, ref calendars[..], BusinessCalendarCombination.Any) {
        Ok(_) => testing.Fail("Incomplete coverage accepted")
        Err(BusinessError.OutsideCoverage) => {
        }
        Err(_) => testing.Fail("Unexpected business error")
    }
}

test "Combined calendars validate even after a known result" {
    let selectedDay := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let validExceptions: BusinessDayException[0] := []

    // Duplicate exception dates make the second dataset invalid.
    let invalidExceptions: BusinessDayException[2] := [
        BusinessDayException {
            Day: selectedDay,
            Working: false,
        },
        BusinessDayException {
            Day: selectedDay,
            Working: true,
        },
    ]

    let closedWeek := BusinessWeekPattern {
        Monday: false,
        Tuesday: false,
        Wednesday: false,
        Thursday: false,
        Friday: false,
        Saturday: false,
        Sunday: false,
    }

    let openWeek := BusinessWeekPattern {
        Monday: true,
        Tuesday: true,
        Wednesday: true,
        Thursday: true,
        Friday: true,
        Saturday: true,
        Sunday: true,
    }

    let calendars: BusinessCalendarData[2] := [
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:closed",
                Revision: "1",
            },
            FirstDay: selectedDay,
            LastDay: selectedDay,
            Week: closedWeek,
            Exceptions: ref validExceptions[..],
        },
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:invalid",
                Revision: "1",
            },
            FirstDay: selectedDay,
            LastDay: selectedDay,
            Week: openWeek,
            Exceptions: ref invalidExceptions[..],
        },
    ]

    // All would already be false from the first calendar,
    // but the second calendar must still be validated.
    match IsBusinessDay(
        selectedDay,
        calendars[..],
        BusinessCalendarCombination.All,
    ) {
        Ok(_) => testing.Fail("Invalid dataset accepted")
        Err(BusinessError.InvalidCalendarData) => {
        }
        Err(_) => testing.Fail("Unexpected error")
    }
}

