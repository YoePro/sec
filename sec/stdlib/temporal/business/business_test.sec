import "temporal/calendar"

/**
 * Checks whether an absolute date matches Gregorian coordinates.
 *
 * Parameters:
 * - value: Absolute date to examine.
 * - year: Expected Gregorian year.
 * - month: Expected Gregorian month.
 * - day: Expected Gregorian day.
 *
 * Returns:
 * True when all three components match.
 *
 * Errors:
 * - CalendarError: Calendar conversion failure.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _matchesGregorianDate(value: date, year: int, month: int, day: int) Result[bool, calendar.CalendarError] {
    let fields := try calendar.FromDate(value, calendar.CalendarSystem.Gregorian)

    return Ok(
        fields.Year == year &&
        fields.Month.Number == month &&
        fields.Day == day,
    )
}

test "ResolveMonthlyDate selects the twenty-seventh" {
    let result := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    testing.Expect(try _matchesGregorianDate(result, 2026, 6, 27))
}

test "ResolveMonthlyDate distinguishes month-end rules" {
    let fromEnd := try ResolveMonthlyDate(
        2025, 2, MonthlyDateRule.DaysBeforeMonthEnd(3),
    )

    let fromNext := try ResolveMonthlyDate(
        2025, 2, MonthlyDateRule.DaysBeforeNextMonth(3),
    )

    testing.Expect(try _matchesGregorianDate(fromEnd, 2025, 2, 25))
    testing.Expect(try _matchesGregorianDate(fromNext, 2025, 2, 26))
}

test "ResolveMonthlyDate handles leap February" {
    let result := try ResolveMonthlyDate(
        2024, 2, MonthlyDateRule.DaysBeforeMonthEnd(0),
    )

    testing.Expect(try _matchesGregorianDate(result, 2024, 2, 29))
}

test "ResolveMonthlyDate zero days before next month" {
    let result := try ResolveMonthlyDate(
        2025, 12, MonthlyDateRule.DaysBeforeNextMonth(0),
    )

    testing.Expect(try _matchesGregorianDate(result, 2026, 1, 1))
}

