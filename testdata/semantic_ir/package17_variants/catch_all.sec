module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

fn T() int {
    match FreshOption(1) {
        Some(handle) => {
            return handle.id
        }
        _ => {
            return 0
        }
    }
}
