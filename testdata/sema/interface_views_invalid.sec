module main

interface Counter {
    fn Value() int
    mut fn Increment() void
}

type Tally struct {
    count: int,
}

impl Tally implements Counter {
    fn Value() int {
        return self.count
    }
    fn Increment() void {
        self.count += 1
    }
}

type Lookalike struct {
    n: int,
}

impl Lookalike {
    fn Next() Option[int] {
        return None
    }
}

type Upto struct {
    next: int,
}

impl Upto implements Iterator[int] {
    fn Next() Option[int] {
        return None
    }
}

fn SharedBump(value: ref Counter) void {
    value.Increment()
}

fn Bump(value: ref mut Counter) void {
    value.Increment()
}

fn Drain(values: ref mut Iterator[int]) void {
    for _ in values {
    }
}

fn Peek(values: ref Iterator[int]) void {
    for _ in values {
    }
}

fn ByValue(values: Iterator[int]) void {
}

fn Calls() void {
    let tally := Tally { count: 0 }
    let mut other := Tally { count: 0 }
    Bump(tally)
    Bump(ref other)
    let mut look := Lookalike { n: 0 }
    Drain(ref mut look)
    let mut numbers := Upto { next: 0 }
    Drain(ref mut numbers)
}
