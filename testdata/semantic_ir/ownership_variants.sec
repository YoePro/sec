type Message union {
    Full { head: Handle, size: int },
    Blank,
}

type Lost union error {
    Gone(Handle),
    Detail { item: Handle, code: int },
    Other,
}

fn FreshMessage() Message {
    let head := Make(1)
    return Message.Full { head: <-head, size: 2 }
}

fn FailLost(id: int) Result[int, Lost] {
    return Err(Lost.Gone(Make(id)))
}

fn MessageLocal() int {
    let message := FreshMessage()
    match message {
        Message.Full(full) => {
