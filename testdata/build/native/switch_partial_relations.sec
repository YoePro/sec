module main

fn Pick(value: int) int {
    switch value {
    case 0..100:
        return 1
    case > 50:
        return 2
    case < 50:
        return 3
    }
    return 4
}

fn main() int {
    if Pick(75) != 1 { return 1 }
    if Pick(150) != 2 { return 2 }
    if Pick(-5) != 3 { return 3 }
    return 0
}
