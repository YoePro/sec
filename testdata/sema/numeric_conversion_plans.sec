module main

fn Convert_float_float(value: float) float {
    return float(value)
}

fn Convert_float_float32(value: float) Result[float32, ConversionError] {
    return Ok(try float32(value))
}

fn Convert_float_float64(value: float) float64 {
    return float64(value)
}

fn Convert_float_int(value: float) Result[int, ConversionError] {
    return Ok(try int(value))
