unit kat physical
impl kat {
    LongName: "Katal"
    Symbol: "kat"
    BaseUnit: false
    Status: active
    Dimension: [amount_of_substance^1, time^-1]
    Scale: 1
    System: SI
}

/** Mole per cubic metre */
unit mol_m3 physical
impl mol_m3 {
    LongName: "Mole per Cubic Metre"
    Symbol: "mol/m³"
    BaseUnit: false
    Status: active
    Dimension: [amount_of_substance^1, length^-3]
    Scale: 1
    System: SI
}

