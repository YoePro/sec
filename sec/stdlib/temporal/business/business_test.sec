        Calendar: BusinessCalendar {
            Identifier: "example:limited",
            Revision: "1",
        },
        FirstDay: first,
        LastDay: last,
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    match IsBusinessDay(outside, data) {
        Ok(_) => testing.Fail("Date outside coverage accepted")
        Err(BusinessError.OutsideCoverage) => {
        }
        Err(_) => testing.Fail("Unexpected business error")
    }
}

test "Dataset AddBusinessDays respects exceptional dates" {
    let thursday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(25),
    )

    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let monday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(29),
    )

    let exceptions: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    let data := BusinessCalendarData {
        Calendar: BusinessCalendar {
            Identifier: "example:exceptional-week",
            Revision: "1",
        },
        FirstDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(1),
        ),
        LastDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(30),
        ),
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    // Thursday + 1 working day = exceptional Saturday.
    let next := try AddBusinessDays(thursday, 1, data)

    testing.ExpectEqual(saturday.EpochDays, next.EpochDays)

    // Thursday + 2 working days = Monday.
    let second := try AddBusinessDays(thursday, 2, data)

    testing.ExpectEqual(monday.EpochDays, second.EpochDays)

    // Monday - 1 working day = exceptional Saturday.
    let backwards: int := -1
    let previous := try AddBusinessDays(monday, backwards, data)

    testing.ExpectEqual(saturday.EpochDays, previous.EpochDays)

    // Zero must preserve the original day.
    let unchanged := try AddBusinessDays(friday, 0, data)

    testing.ExpectEqual(friday.EpochDays, unchanged.EpochDays)
}

test "Dataset CountBusinessDays applies exceptional dates" {
    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let julyFirst := try ResolveMonthlyDate(
        2026, 7, MonthlyDateRule.DayOfMonth(1),
    )

    let exceptions: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    let data := BusinessCalendarData {
        Calendar: BusinessCalendar {
            Identifier: "example:counting",
            Revision: "1",
        },
        FirstDay: try ResolveMonthlyDate(
            2026, 6, MonthlyDateRule.DayOfMonth(1),
        ),
        LastDay: try ResolveMonthlyDate(
            2026, 7, MonthlyDateRule.DayOfMonth(1),
        ),
        Week: BusinessWeekPattern {
            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    // June 26 through June 30:
    // Friday closed, Saturday open, Monday and Tuesday open.
    let forward := try CountBusinessDays(friday, julyFirst, data)
    let reverse := try CountBusinessDays(julyFirst, friday, data)

    testing.ExpectEqual(3, forward)
    testing.ExpectEqual(-3, reverse)
}

