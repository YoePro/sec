module match_payload_discards

type Envelope union {
    Pending(Task[int])
    Fields { Work: Thread[int] }
    Empty
}

fn OptionIgnore(value: Option[Task[int]]) int {
    return match value {
        Some(_) => 1
        None => 0
    }
}

fn OptionBare(value: Option[Task[int]]) int {
    return match value {
        Some => 1
        None => 0
    }
}

fn OptionQualified(value: Option[Task[int]]) int {
    return match value {
        Option.Some => 1
        None => 0
    }
}

fn ResultIgnore(value: Result[Thread[int], ArithmeticError]) int {
    return match value {
        Ok(_) => 1
        Err(_) => 0
    }
}

fn UnionIgnore(value: Envelope) int {
    return match value {
        Pending(_) => 1
        Fields(ref fields) => 2
        Empty => 0
    }
}

fn UnionBare(value: Envelope) int {
    return match value {
        Pending => 1
        Fields(ref fields) => 2
        Empty => 0
    }
}

fn UnionQualified(value: Envelope) int {
    return match value {
        Envelope.Pending => 1
        Fields(ref fields) => 2
        Empty => 0
    }
}

fn FieldsIgnore(value: Envelope) int {
    return match value {
        Pending(ref work) => 1
        Fields(_) => 2
        Empty => 0
    }
}

fn FieldsBare(value: Envelope) int {
    return match value {
        Pending(ref work) => 1
        Fields => 2
        Empty => 0
    }
}

fn FieldsEmpty(value: Envelope) int {
    return match value {
        Pending(ref work) => 1
        Fields {} => 2
        Empty => 0
    }
}

fn Nested(value: Option[Option[Task[int]]]) int {
    return match value {
        Some(_) => 1
        None => 0
    }
}

fn Guarded(value: Option[Task[int]], condition: bool) int {
    return match value {
        Some(_) where condition => 1
        Some(ref work) => 2
        None => 0
    }
}

fn Statement(value: Option[Task[int]]) void {
    match value {
        Some(_) => { return }
        None => { return }
    }
}

type Failure union error {
    Pending(Task[int])
    Fields { Work: Thread[int] }
    Other
}

fn ErrorBare(value: Result[int, Failure]) int {
    return match value {
        Ok(n) => n
        Err(Failure.Pending) => 1
        Err(Failure.Fields(ref fields)) => 2
        Err(Failure.Other) => 0
    }
}

fn ErrorContextual(value: Result[int, Failure]) int {
    return match value {
        Ok(n) => n
        Err(.Pending) => 1
        Err(Failure.Fields(ref fields)) => 2
        Err(Failure.Other) => 0
    }
}

fn ErrorIgnore(value: Result[int, Failure]) int {
    return match value {
        Ok(n) => n
        Err(Failure.Pending(_)) => 1
        Err(Failure.Fields(ref fields)) => 2
        Err(Failure.Other) => 0
    }
}

fn ErrorFieldsEmpty(value: Result[int, Failure]) int {
    return match value {
        Ok(n) => n
        Err(Failure.Pending(ref work)) => 1
        Err(Failure.Fields {}) => 2
        Err(Failure.Other) => 0
    }
}
