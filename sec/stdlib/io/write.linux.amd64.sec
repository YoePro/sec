#target(os: "linux", arch: "amd64")
module io

import (
    "platform/linux"
    "platform/linux/amd64"
)
unsafe fn _sysWrite(fd: int, ptr: RawPtr[byte], len: uint) int {
    return amd64.RawSyscall(uint(amd64.SysCall.Write), uint(fd), uint(ptr), uint(len))
}

unsafe fn Write(fd: int, ptr: RawPtr[byte], len: uint) int {
    return _sysWrite(fd, ptr, len)
}

fn WriteString(value: string) void {
    unsafe {
        _sysWrite(STDOUT, value.Ptr, value.Len)
    }
}

fn Println(value: string) void {
    unsafe {
        _sysWrite(STDOUT, value.Ptr, value.Len)

        let nl := "\n"
        _sysWrite(STDOUT, nl.Ptr, 1)
    }
}

fn println(value: string) void {
    Println(value)
}
