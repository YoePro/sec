module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn Log(value: int) void {
}

fn T() void {
    let mut index := 0
    while index < 2 {
        index = index + 1
        let handle := Make(index)
        defer {
            Log(handle.id)
        }
    }
}
