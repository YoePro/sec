module core

type StringSplitIterator struct {
    source: string,
    separator: string,
    position: uint,
    finished: bool,
}

// rules/control-flow/flowcontrol_for.md section 37: explicit compiler-known
// Iterator conformance makes Split() results valid sources for `for value in`.
impl StringSplitIterator implements Iterator[string] {
    property IsFinished: bool {
        get {
            return self.finished
        }
    }

    fn Next() Option[string] {
        if self.finished {
            return None()
        }

        if self.position > self.source.Len {
            self.finished = true
            return None()
        }

        // yield one rune at a time, with no leading/trailing empty strings.
        if self.separator.Len == 0 {
            if self.position == self.source.Len {
                self.finished = true
                return None()
            }

            let rest := __StringSliceUnchecked(self.source, self.position, self.source.Len)

            for character in rest {
                let end := self.position + character.Utf8Length
                let part := __StringSliceUnchecked(self.source, self.position, end)
                self.position = end
                return Some(part)
            }

            self.finished = true
            return None()
        }

        // Separator cannot possibly occur in the remaining bytes.
        if self.separator.Len > self.source.Len - self.position {
            let part := __StringSliceUnchecked(self.source, self.position, self.source.Len)
            self.finished = true
            return Some(part)
        }

        let found := self.source.IndexOf(self.separator, self.position)

        return match found {
            Some(index) => {
                if index < self.position || index > self.source.Len {
                    // Internal invariant
                    self.finished = true
                    return None()
                }

                if self.separator.Len > self.source.Len - index {
                    // IndexOf must never return a match that extends beyond the source.
                    self.finished = true
                    return None()
                }

                let part := __StringSliceUnchecked(self.source, self.position, index)

                self.position = index + self.separator.Len
                return Some(part)
            }

            None => {
                let part := __StringSliceUnchecked(self.source, self.position, self.source.Len)

                self.finished = true
                return Some(part)
            }
        }
    }
}

impl string {
    /** Return the number of bytes the string has */
    property ByteLen: uint {
        get {
            // The core implementation reads the intrinsic backing length;
            // public source uses the canonical .Len property.
            return self.len
        }
    }

    /** Return the number of runes the string contains */
    property RuneLen: uint {
        get {
            // TODO: implement this
            return 0
        }
    }

    property IsEmpty: bool {
        get {
            return self.Len == 0
        }
    }

    fn Empty() string {
        return ""
    }

    fn Compare(other: string) int {
        uint mut: index := 0

        while index < self.Len && index < other.Len {
            let left := self.ByteAt(index)
            let right := other.ByteAt(index)

            if left < right {
                return -1
            }

            if left > right {
                return 1
            }

            index += 1
        }

        if self.Len < other.Len {
            return -1
        }

        if self.Len > other.Len {
            return 1
        }

        return 0
    }

    fn ByteAt(index: uint) byte {
        unsafe {
            return self.Ptr.Offset(int(index)).Read()
        }
    }

    fn FromByteArray(value: ref byte[]) string {
        // TODO: implement string.FromByteArray
        return ""
    }

    fn FromRuneArray(value: ref rune[]) string {
        // TODO: Implement string.FromRuneArray
        return ""
    }

    /** Materializes the string as an owning rune sequence. */
    fn ToRuneArray() rune[] {
        // TODO: Implement string.ToRuneArray.
        return []
    }

    fn StartsWith(prefix: string) bool {
        if prefix.Len > self.Len {
            return false
        }

        let mut index: uint := 0

        while index < prefix.Len {
            if self.ByteAt(index) != prefix.ByteAt(index) {
                return false
            }

            index += 1
        }

        return true
    }

    fn EndsWith(suffix: string) bool {
        if suffix.Len > self.Len {
            return false
        }

        let start := self.Len - suffix.Len
        let mut index: uint := 0

        while index < suffix.Len {
            if self.ByteAt(start + index) != suffix.ByteAt(index) {
                return false
            }

            index += 1
        }

        return true
    }

    fn Contains(value: string) bool {
        return match self.IndexOf(value) {
            Some(_) => true
            None => false
        }
    }

    fn IndexOf(value: string) Option[uint] {
        return self.IndexOf(value, 0)
    }

    fn IndexOf(value: string, start: uint) Option[uint] {
        if start > self.Len {
            return None()
        }

        if value.Len == 0 {
            return Some(start)
        }

        if value.Len > self.Len - start {
            return None()
        }

        // Fast path: one-byte separator/search value.
        if value.Len == 1 {
            let needle := value.ByteAt(0)
            let mut index := start

            while index < self.Len {
                if self.ByteAt(index) == needle {
                    return Some(index)
                }

                index += 1
            }

            return None()
        }

        let lastStart := self.Len - value.Len
        let mut index := start

        while index <= lastStart {
            let mut needleIndex: uint := 0

            while needleIndex < value.Len {
                if self.ByteAt(index + needleIndex) != value.ByteAt(needleIndex) {
                    break
                }

                needleIndex += 1
            }

            if needleIndex == value.Len {
                return Some(index)
            }

            index += 1
        }

        return None()
    }

    fn LastIndexOf(value: string) Option[uint] {
        if value.Len == 0 {
            return Some(self.Len)
        }

        if value.Len > self.Len {
            return None()
        }

        let mut index := self.Len - value.Len

        for {
            let mut needleIndex: uint := 0

            while needleIndex < value.Len {
                if self.ByteAt(index + needleIndex) != value.ByteAt(needleIndex) {
                    break
                }

                needleIndex += 1
            }

            if needleIndex == value.Len {
                return Some(index)
            }

            if index == 0 {
                break
            }

            index -= 1
        }

        return None()
    }

    fn Trim() string {
        uint mut: position := 0, start := 0, end := 0
        bool mut: foundContent := false

        for character in self {
            let witdth := character.Utf8Length
            let next := position + witdth

            if character.IsWhitespace {
                if !foundContent {
                    start = next
                }
            } else {
                foundContent = true
                end = next
            }

            position = next
        }

        if !foundContent {
            return ""
        }

        return __StringSliceUnchecked(self, start, end)
    }

    fn TrimStart() string {
        uint mut: start := 0
        for character in self {
            if !character.IsWhitespace {
                break
            }

            start += character.Utf8Length
        }

        return __StringSliceUnchecked(self, start, self.Len)
    }

    fn TrimEnd() string {
        uint mut: position := 0, end := 0

        for character in self {
            position += character.Utf8Length

            if !character.IsWhitespace {
                end = position
            }
        }

        return __StringSliceUnchecked(self, 0, end)
    }

    fn Slice(start: uint, end: uint) Result[string, RangeError] {
        if start > end {
            return Err(RangeError.StartAfterEnd)
        }

        if end > self.Len {
            return Err(RangeError.OutOfBounds)
        }

        // Bounds are established above before entering the private compiler intrinsic.
        return Ok(__StringSliceUnchecked(self, start, end))
    }

    /**
    * Creates a lazy iterator that yields substrings separated by `separator`.
    *
    * The operation does not materialize the complete result and does not allocate
    * merely to perform the split. The returned iterator keeps the source string,
    * separator, and current iteration state.
    *
    * Rules:
    *   - rules/library/core-library.md — §5 String
    *   - rules/library/core-library.md — §5.3 Required instance methods
    *   - rules/library/core-library.md — §5.6 Allocation visibility
    */
    fn Split(separator: string) StringSplitIterator {
        return StringSplitIterator {
            source: self,
            separator: separator,
            position: 0,
            finished: false,
        }
    }

    /**
    * Splits the string using `separator` and materializes all resulting substrings
    * into a dynamic string array.
    *
    * This is the allocating counterpart to `Split()`. It consumes the lazy
    * `StringSplitIterator` produced by `Split()` and appends each produced
    * substring to the result array. Collection growth failures are propagated as
    * `CollectionError`.
    *
    * Rules:
    *   - rules/library/core-library.md — §5 String
    *   - rules/library/core-library.md — §5.6 Allocation visibility
    *   - rules/collections/collections.md — §6.7 Append
    *   - rules/collections/collections.md — §16 Collection errors
    */
    fn SplitToArray(separator: string) Result[string[], CollectionError] {
        let mut result: string[]

        for part in self.Split(separator) {
            try result.Append(part)
        }

        return Ok(result)
    }

    /**
    * Splits the string at the first occurrence of `separator`.
    *
    * Returns `Some` containing exactly two strings when the separator is found:
    * the part before the first occurrence and the remaining part after it.
    * Returns `None` when the separator is not present.
    *
    * The operation does not materialize a dynamic collection and uses string
    * slices for the two returned parts.
    *
    * Rules:
    *   - rules/library/core-library.md — §5 String
    *   - rules/library/core-library.md — §1.5 Private representation helpers
    *
    * NOTE:
    *   SplitOnce is not yet listed explicitly in the current core-library
    *   rulebook and must be added to the canonical string API specification.
    */
    fn SplitOnce(separator: string) Option[string[2]] {
        match self.IndexOf(separator) {
            Some(index) => {
                let afterSeparator := index + separator.Len

                return Some([
                    __StringSliceUnchecked(self, 0, index),
                    __StringSliceUnchecked(self, afterSeparator, self.Len),
                ])
            }

            None => {
                return None
            }
        }
    }

    fn ToLower() string {
        // TODO: Implement a correct version of the ToLower-function
        let mut s: string
        for r in self {
            s += r.ToLower()
        }
        return s
    }

    fn ToUpper() string {
        // TODO: Implement a correct version of the ToUpper-function
        let mut s: string
        for r in self {
            s += r.ToUpper()
        }
        return s
    }

    /** Returns a copy of self */
    fn ToString() string {
        return self
    }

}
