module ip_tcp_stack

// =====================================================================
// ENUMS FOR IP & TCP PROTOCOLS
// =====================================================================

enum IpProtocol bit[8] {
    ICMP = 1,
    IGMP = 2,
    TCP  = 6,
    UDP  = 17,
}

enum IpFlags bit[3] {
    RESERVED       = 0b100,
    DONT_FRAGMENT  = 0b010,
    MORE_FRAGMENTS = 0b001,
}

enum IpError error {
    InvalidVersion,
    HeaderTooShort,
    TtlExpired,
    ChecksumMismatch,
    UnsupportedProtocol,
}

enum TcpError error {
    PortClosed,
    InvalidFlags,
    BufferFull,
}

// =====================================================================
// REGISTER LAYOUTS FOR HARDWARE/PACKET BOUNDARIES
// =====================================================================

// IPv4 Base Header Register Layout (160 bits = 20 bytes)
type Ipv4Header register[160] {
    Version: bit[4]
    Ihl: bit[4]
    Dscp: bit[6]
    Ecn: bit[2]
    TotalLength: bit[16]

    Identification: bit[16]
    Flags: IpFlags
    FragmentOffset: bit[13]

    TimeToLive: bit[8]
    Protocol: IpProtocol
    HeaderChecksum: bit[16]

    SourceAddress: bit[32]
    DestinationAddress: bit[32]
}

// TCP Base Header Register Layout (160 bits = 20 bytes)
type TcpHeader register[160] {
    SourcePort: bit[16]
    DestinationPort: bit[16]
    SequenceNumber: bit[32]
    AckNumber: bit[32]

    DataOffset: bit[4]
    Reserved: bit[4]
    CwrFlag: bit[1]         // Explicit Congestion Notification Echo / CWR
    EceFlag: bit[1]         // ECN-Echo
    UrgFlag: bit[1]
    AckFlag: bit[1]
    PshFlag: bit[1]
    RstFlag: bit[1]
    SynFlag: bit[1]
    FinFlag: bit[1]          // Total: 4 + 4 + 8 flags = 16 bits

    WindowSize: bit[16]
    Checksum: bit[16]
    UrgentPointer: bit[16]  // Total: 160 bits (20 bytes)
}

// =====================================================================
// IMPLEMENTATION BLOCKS
// =====================================================================

impl Ipv4Header {
    fn ValidateAndForward() Result[void, IpError] {
        if self.Version != 4 {
            return Err(IpError.InvalidVersion)
        }

        if self.Ihl < 5 {
            return Err(IpError.HeaderTooShort)
        }

        if self.TimeToLive <= 1 {
            self.TimeToLive = 0
            return Err(IpError.TtlExpired)
        }

        self.TimeToLive = self.TimeToLive - 1
        return Ok()
    }
}

impl TcpHeader {
    // Read-only reference context using ref
    fn ProcessSegment(appPort: uint16) Result[uint32, TcpError] {
        let destPort: uint16 := uint16(self.DestinationPort)

        if destPort != appPort {
            return Err(TcpError.PortClosed)
        }

        if self.SynFlag && self.FinFlag {
            return Err(TcpError.InvalidFlags)
        }

        let seqNum: uint32 := uint32(self.SequenceNumber)
        return Ok(seqNum)
    }
}

// =====================================================================
// ROUTING & PROCESSING LOGIC
// =====================================================================

// Ref mut explicitly used to modify the original IPv4 header in-place
fn RoutePacket(header: ref mut Ipv4Header) Result[void, IpError] {
    try header.ValidateAndForward()

    if header.Protocol != IpProtocol.TCP {
        return Err(IpError.UnsupportedProtocol)
    }

    return Ok()
}

// Read-only reference ref to prevent copying large register structs
fn DispatchTcpSegment(tcpHeader: ref TcpHeader, targetPort: uint16) Result[uint32, TcpError] {
    let seqNum: uint32 := try tcpHeader.ProcessSegment(targetPort)
    return Ok(seqNum)
}

fn ProcessIncomingFrame(ipHeader: ref mut Ipv4Header, tcpHeader: ref TcpHeader, localPort: uint16) void {
    try RoutePacket(ipHeader) {
        Err(IpError.InvalidVersion) => {
            return
        }

        Err(IpError.TtlExpired) => {
            return
        }

        Err(IpError.UnsupportedProtocol) => {
            return
        }

        Err(error) => {
            return
        }
    }

    try DispatchTcpSegment(tcpHeader, localPort) {
        Err(TcpError.PortClosed) => {
            return
        }

        Err(TcpError.InvalidFlags) => {
            return
        }

        Err(error) => {
            return
        }
    }
}
