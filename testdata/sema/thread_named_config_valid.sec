module main

type Holder struct {
    Config: ThreadConfig
}

fn Work() void {}

fn Named(config: ThreadConfig) void {
    let worker := try spawn thread <-config Work() { Err(_) => { return } }
    join worker
}

fn Projected(holder: Holder) void {
    let worker := try spawn thread <-holder.Config Work() { Err(_) => { return } }
    join worker
}

fn Conditional(config: ThreadConfig, start: bool) void {
    if start {
        let worker := try spawn thread <-config Work() { Err(_) => { return } }
        join worker
    } else {
        discard config
    }
}

fn Ordinary() void {
    let worker := try spawn thread Work() { Err(_) => { return } }
    join worker
    let work := try spawn task Work() { Err(_) => { return } }
    await work
}
