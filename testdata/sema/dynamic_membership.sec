module main

type Status int range 100..999 default 500
impl Status {
    property IsRegistered: bool {
        get {
            let regged: Status[] := [100, 200, 404, 511]
            return self in regged
        }
    }
}

fn Has(value: uint, values: uint[]) bool {
    let first := value in values
    let second := value in values
    return first && second
}

fn RuneSearch(value: rune, values: rune[]) bool {
    return value in values || 'a' in values
}

fn LiteralSearch() bool {
    let values: uint[] := [100, 200, 404, 511]
    return 404 in values
}
