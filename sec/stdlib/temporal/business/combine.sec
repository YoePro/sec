module business

/*
 * Sec Standard Library — temporal/business
 * File: business/combine.sec
 * Purpose: Combine multiple working-day calendars.
 * Status: Implementation candidate, not execution-verified
 * Revision: 0.1
 * Updated: 2026-11-22
 *
 * Governing rulebook:
 * stdlib/temporal/business/std-temporal-business.md
 *
 * No allocation, I/O or implicit dataset loading.
 */

/**
 * Inclusive coverage shared by combined business calendars.
 *
 * Description:
 * Both boundaries use absolute epoch days.
 * The structure is constructed only after successful
 * validation of every participating dataset.
 *
 * Ownership:
 * Copyable value without allocation.
 */
type _CombinedCoverage struct {
    First: int64,
    Last:  int64,
}

/**
 * Validates combined datasets and determines common coverage.
 *
 * Description:
 * Validates every supplied calendar, including calendars
 * that would not affect an already-known boolean result.
 *
 * Returns the intersection of their coverage periods.
 * An empty calendar sequence is invalid.
 *
 * Parameters:
 * - calendars: Borrowed sequence of business datasets.
 *
 * Returns:
 * Inclusive interval covered by every dataset.
 *
 * Errors:
 * - BusinessError.InvalidCalendarData:
 * Empty sequence or malformed dataset.
 * - BusinessError.OutsideCoverage:
 * The datasets have no common coverage.
 *
 * Ownership:
 * Borrows all datasets without transfer or allocation.
 */
fn _validateCombinedCoverage(calendars: ref BusinessCalendarData[]) Result[_CombinedCoverage, BusinessError] {
    if calendars.Len == 0u {
        return Err(BusinessError.InvalidCalendarData)
    }

    let mut initialized := false
    let mut first: int64 := 0
    let mut last:  int64 := 0

    for ref selected in calendars {
        try ValidateBusinessCalendarData(selected)

        let candidateFirst := int64(selected.FirstDay.EpochDays)
        let candidateLast  := int64(selected.LastDay.EpochDays)

        if !initialized {
            first = candidateFirst
            last = candidateLast
            initialized = true
        } else {
            if candidateFirst > first {
                first = candidateFirst
            }

            if candidateLast < last {
                last = candidateLast
            }
        }
    }

    if first > last {
        return Err(BusinessError.OutsideCoverage)
    }

    return Ok(_CombinedCoverage {
        First: first,
        Last: last,
    })
}

/**
 * Classifies a date using already validated combined calendars.
 *
 * Description:
 * The caller must first validate the entire nonempty
 * sequence through _validateCombinedCoverage.
 *
 * All requires every dataset to report a working day.
 * Any requires at least one dataset to report a working day.
 *
 * Every dataset is evaluated even when the combined
 * boolean outcome is already determined.
 *
 * Parameters:
 * - value: Absolute date to classify.
 * - calendars: Borrowed validated calendar datasets.
 * - combination: All or Any working-day requirement.
 *
 * Returns:
 * Combined business-day classification.
 *
 * Errors:
 * - BusinessError.OutsideCoverage:
 * Date lies outside a dataset's coverage.
 *
 * Ownership:
 * Borrows datasets without transfer or allocation.
 */
fn _isCombinedBusinessDayValidated(value: date, calendars: ref BusinessCalendarData[], combination: BusinessCalendarCombination) Result[bool, BusinessError] {
    let mut allWorking := true
    let mut anyWorking := false

    for ref selected in calendars {
        let working := try _isBusinessDayValidated(
            value, selected,
        )

        if !working {
            allWorking = false
        }

        if working {
            anyWorking = true
        }
    }

    match combination {
        BusinessCalendarCombination.All => {
            return Ok(allWorking)
        }

        BusinessCalendarCombination.Any => {
            return Ok(anyWorking)
        }
    }
}

/**
 * Determines whether a date satisfies combined calendars.
 *
 * Description:
 * Validates every calendar before evaluating the date.
 * All requires every calendar to be open.
 * Any requires at least one calendar to be open.
 *
 * The requested date must be covered by all datasets.
 *
 * Parameters:
 * - value: Absolute date.
 * - calendars: Borrowed calendar datasets.
 * - combination: All or Any classification.
 *
 * Returns:
 * Combined business-day classification.
 *
 * Errors:
 * - BusinessError.InvalidCalendarData: Invalid dataset.
 * - BusinessError.OutsideCoverage: Incomplete coverage.
 *
 * Ownership:
 * Borrows datasets without transfer or allocation.
 */
fn IsBusinessDay(value: date, calendars: ref BusinessCalendarData[], combination: BusinessCalendarCombination) Result[bool, BusinessError] {
    let coverage := try _validateCombinedCoverage(calendars)
    let epochDay := int64(value.EpochDays)

    if epochDay < coverage.First ||
        epochDay > coverage.Last {
        return Err(BusinessError.OutsideCoverage)
    }

    return _isCombinedBusinessDayValidated(
        value, calendars, combination,
    )
}

/**
 * Finds a business day satisfying combined calendars.
 *
 * Description:
 * Validates the complete calendar sequence once.
 * Subsequent date evaluations reuse that validation.
 *
 * The search includes the starting date.
 * Search is restricted to common dataset coverage.
 *
 * The function terminates with OutsideCoverage when
 * no qualifying date exists in the search direction.
 *
 * Parameters:
 * - value: Starting absolute date.
 * - calendars: Borrowed business-calendar datasets.
 * - combination: All or Any classification.
 * - direction: +1 for following, -1 for preceding.
 *
 * Returns:
 * First qualifying business day.
 *
 * Errors:
 * - BusinessError.InvalidCalendarData: Invalid dataset.
 * - BusinessError.OutsideCoverage: No covered result.
 * - BusinessError.OutOfRange: Date cannot be represented.
 *
 * Ownership:
 * Borrows datasets without transfer or allocation.
 */
fn _findCombinedBusinessDay(
    value:       date,
    calendars:   ref BusinessCalendarData[],
    combination: BusinessCalendarCombination,
    direction:   int,
) Result[date, BusinessError] {
    let coverage := try _validateCombinedCoverage(calendars)

    let mut current    := value
    let mut currentDay := int64(value.EpochDays)

    if currentDay < coverage.First ||
        currentDay > coverage.Last {
        return Err(BusinessError.OutsideCoverage)
    }

    while true {
        let working := try _isCombinedBusinessDayValidated(
            current, calendars, combination,
        )

        if working {
            return Ok(current)
        }

        if direction > 0 {
            if currentDay >= coverage.Last {
                return Err(BusinessError.OutsideCoverage)
            }

            currentDay += 1
        } else {
            if currentDay <= coverage.First {
                return Err(BusinessError.OutsideCoverage)
            }

            currentDay -= 1
        }

        let checkedDay := try int32(currentDay) {
            Err(_) => return Err(BusinessError.OutOfRange)
        }

        current = new date(checkedDay)
    }
}

/**
 * Adjusts a date using combined business calendars.
 *
 * Description:
 * None returns the original date without inspecting
 * calendar datasets.
 *
 * Following and Preceding search for a qualifying
 * business day in the requested direction.
 *
 * ModifiedFollowing and ModifiedPreceding reverse
 * direction when the initial result changes the
 * Gregorian month.
 *
 * Every required date must be covered by all datasets.
 *
 * Parameters:
 * - value: Unadjusted absolute date.
 * - calendars: Borrowed calendar datasets.
 * - combination: All or Any working-day requirement.
 * - policy: Business-day adjustment convention.
 *
 * Returns:
 * Adjusted absolute date.
 *
 * Errors:
 * - BusinessError.InvalidCalendarData: Invalid datasets.
 * - BusinessError.OutsideCoverage: Missing covered result.
 * - BusinessError.OutOfRange: Unrepresentable result.
 *
 * Ownership:
 * Borrows the datasets without ownership transfer.
 * No allocation or I/O.
 */
fn AdjustBusinessDay(
    value:       date,
    calendars:   ref BusinessCalendarData[],
    combination: BusinessCalendarCombination,
    policy:      BusinessDayAdjustment,
) Result[date, BusinessError] {
    if policy == BusinessDayAdjustment.None {
        return Ok(value)
    }

    let backward: int := -1
    let forward:  int := 1

    match policy {
        BusinessDayAdjustment.None => {
            return Ok(value)
        }

        BusinessDayAdjustment.Following => {
            return _findCombinedBusinessDay(
                value, calendars, combination, forward,
            )
        }

        BusinessDayAdjustment.Preceding => {
            return _findCombinedBusinessDay(
                value, calendars, combination, backward,
            )
        }

        BusinessDayAdjustment.ModifiedFollowing => {
            let following := try _findCombinedBusinessDay(
                value, calendars, combination, forward,
            )

            if try _sameGregorianMonth(value, following) {
                return Ok(following)
            }

            return _findCombinedBusinessDay(
                value, calendars, combination, backward,
            )
        }

        BusinessDayAdjustment.ModifiedPreceding => {
            let preceding := try _findCombinedBusinessDay(
                value, calendars, combination, backward,
            )

            if try _sameGregorianMonth(value, preceding) {
                return Ok(preceding)
            }

            return _findCombinedBusinessDay(
                value, calendars, combination, forward,
            )
        }
    }
}
