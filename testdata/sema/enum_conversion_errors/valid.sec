module main

enum Wide uint16 { Small = 1, Large = 300 }
enum Open bit[16] { Zero = 0 }

fn NarrowClosed(value: Wide) Result[uint8, ConversionError] {
    return Ok(try uint8(value))
}
fn NarrowOpen(value: Open) Result[uint8, ConversionError] {
    return Ok(try uint8(value))
}
fn Carrier(value: Wide) Result[uint8, ConversionError] {
    return uint8(value)
}
fn Handle(value: Wide) uint8 {
    return try uint8(value) {
        Err(ConversionError.OutOfRange) => 0
        Err(_) => 1
    }
}
fn MapError(value: Wide) Result[uint8, ArithmeticError] {
    return Ok(try uint8(value) { Err(_) => return Err(ArithmeticError.Overflow) })
}
fn Exact(value: Wide) uint16 { return uint16(value) }
fn Known() uint8 { return uint8(Wide.Small) }
