module main

type Slot uint256 range 0..<4

fn HugeConstant(values: int[9223372036854775809]) int {
    return values[uint256(9223372036854775808)]
}

fn DynamicSigned(values: int[4], index: int128) int {
    return values[index]
}

fn ProvenRange(values: int[4], index: Slot) int {
