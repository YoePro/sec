module calendar

/*
 * Sec Standard Library — temporal/calendar
 * File: calendar/partial_hebrew.sec
 * Purpose: Partial-date validation for the fixed Hebrew calendar.
 * Revision: 0.1
 * Updated: 2026-11-16
 *
 * Rulebook: stdlib/temporal/calendar/std-temporal-calendar.md
 *
 * Uses the modern calculated Hebrew calendar.
 * No sunset, historical adoption or observational rules.
 */

/**
 * Selects a witness year for a Hebrew date without a known year.
 *
 * Description:
 * AM 5784 is a leap year containing Adar I.
 * AM 5785 is a complete year with thirty-day Heshvan
 * and Kislev.
 *
 * The witness year is never inserted into the partial date.
 *
 * Parameters:
 * - value: Partial Hebrew date.
 *
 * Returns:
 * A year suitable for checking whether the known
 * components can coexist.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _hebrewPartialWitnessYear(value: PartialDate) int {
    if value.Year is Some(year) {
        return year
    }

    // A thirty-day Heshvan or Kislev requires a complete year.
    if value.Month is Some(month) {
        if month.Number in [2, 3] {
            if value.Day is Some(day) {
                if day == 30 {
                    return 5785
                }
            }
        }
    }

    // A leap year also permits Adar I.
    return 5784
}

/**
 * Tests whether a range of days intersects core date's range.
 *
 * Description:
 * The supplied first and last days belong to one Hebrew
 * month. Testing the endpoints is sufficient because the
 * dates between them are consecutive absolute days.
 *
 * Parameters:
 * - year: Valid Hebrew year.
 * - month: Valid month identity in the selected year.
 * - firstDay: First possible day.
 * - lastDay: Last possible day.
 *
 * Returns:
 * True when at least one candidate is representable.
 *
 * Errors:
 * - CalendarError: Unexpected calendar conversion failure.
 *
 * Ownership:
 * Pure calculation without allocation.
 */
fn _hebrewPartialWithinCore(year: int, month: CalendarMonth, firstDay: int, lastDay: int) Result[bool, CalendarError] {
    let first := CalendarFields {
        Year: year,
        Month: month,
        Day: firstDay,
    }

    match ToDate(first, CalendarSystem.Hebrew) {
        Ok(_) => return Ok(true)
        Err(CalendarError.OutOfRange) => {
        }
        Err(e) => return Err(e)
    }

    if firstDay == lastDay {
        return Ok(false)
    }

    let last := CalendarFields {
        Year: year,
        Month: month,
        Day: lastDay,
    }

    match ToDate(last, CalendarSystem.Hebrew) {
        Ok(_) => return Ok(true)
        Err(CalendarError.OutOfRange) => return Ok(false)
        Err(e) => return Err(e)
    }
}

/**
 * Validates a partial date in the fixed Hebrew calendar.
 *
 * Description:
 * Missing fields remain missing. An unspecified year is
 * checked using a suitable witness year.
 *
 * The search examines at most thirteen calendar months.
 * No date arrays or temporary collections are allocated.
 *
 * Parameters:
 * - value: Partial Hebrew calendar coordinates.
 *
 * Returns:
 * Ok() if at least one representable date exists.
 *
 * Errors:
 * - CalendarError.InvalidYear: Invalid Hebrew year.
 * - CalendarError.InvalidMonth: Invalid month identity.
 * - CalendarError.InvalidDay: No matching day exists.
 * - CalendarError.OutOfRange: No representable core date.
 *
 * Ownership:
 * Pure calculation without allocation or I/O.
 */
fn _validateHebrewPartial(value: PartialDate) Result[void, CalendarError] {
    let year := _hebrewPartialWitnessYear(value)

    if year < 1 {
        return Err(CalendarError.InvalidYear)
    }

    // Keep the calculations within the supported integer domain.
    if year > 10_000_000 {
        return Err(CalendarError.OutOfRange)
    }

    // Every Hebrew month contains between 29 and 30 days.
    if value.Day is Some(day) {
        if day not in 1..30 {
            return Err(CalendarError.InvalidDay)
        }
    }

    let monthCount := try MonthsInYear(year, CalendarSystem.Hebrew)

    let mut foundMonth := false
    let mut foundDay   := false
    let mut ordinal    := 1

    while ordinal <= monthCount {
        let month := try MonthAt(year, ordinal, CalendarSystem.Hebrew)

        // Missing month means any month may be considered.
        let mut matchesMonth := true

        if value.Month is Some(requested) {
            matchesMonth =
                  requested.Number == month.Number
               && requested.IsLeap == month.IsLeap
        }

        if matchesMonth {
            foundMonth = true

            let maxDay := try DaysInMonth(
                year,
                month,
                CalendarSystem.Hebrew,
            )

            let mut firstDay := 1
            let mut lastDay  := maxDay
            let mut validDay := true

            if value.Day is Some(day) {
                if day > maxDay {
                    validDay = false
                } else {
                    firstDay = day
                    lastDay = day
                }
            }

            if validDay {
                foundDay = true

                let representable := try _hebrewPartialWithinCore(
                    year,
                    month,
                    firstDay,
                    lastDay,
                )

                if representable {
                    return Ok()
                }
            }
        }

        ordinal += 1
    }

    // The requested month does not exist in this year.
    if !foundMonth {
        return Err(CalendarError.InvalidMonth)
    }

    // The requested day cannot occur in any matching month.
    if !foundDay {
        return Err(CalendarError.InvalidDay)
    }

    // Calendar coordinates are valid, but outside core date.
    return Err(CalendarError.OutOfRange)
}
