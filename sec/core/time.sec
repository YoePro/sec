module core

type time struct {
    _nanosecondsSinceMidnight: uint64,
}

type HourOfDay          uint<h>   range 0..23
type MinuteOfHour       uint<min> range 0..59
type SecondOfMinute     uint<s>   range 0..59
type NanosecondOfSecond uint<ns>  range 0..999999999

type MonthOfYear uint range 1..12
type DayOfMonth  uint range 1..31

impl time {
    enum Format {
        HHMM,                 // 15:04
        HHMMSS,               // 15:04:05
        HHMMSSNano,           // 15:04:05.999999999
        HHMMSSMilli,          // 15:04:05.999
        HHMMSSTenth,          // 15:04:05.9
        HHMMSSTwentieth,      // 15:04:05.99
        hhmm12,               // 03:04 PM
        hhmmss12,             // 03:04:05 PM
        hhmmss12Tenth,        // 03:04:05.9 PM
        hhmmss12Twentieth,    // 03:04:05.99 PM
        hhmmss12Nano,         // 03:04:05.999999999 PM
        hhmmss12Milli,        // 03:04:05.999 PM
    }

    // Internt / lågnivå
    init(nanosecondsSinceMidnight: uint64) TimeError {
        if nanosecondsSinceMidnight >= 86400000000000 {
            return Err(TimeError.OutOfRange)
        }
        self._nanosecondsSinceMidnight = nanosecondsSinceMidnight
    }

    // Vanlig konstruktion
    init(hour: int, minute: int, second: int) TimeError {
        if hour not in 0..23 || minute not in 0..59 || second not in 0..59 {
            return Err(TimeError.OutOfRange)
        }

        let ns := uint64(hour) * 3600000000000 + uint64(minute) * 60000000000 + uint64(second) * 1000000000
        self._nanosecondsSinceMidnight = ns
    }

    init(hour: int, minute: int, second: int, nanosecond: int) TimeError {
        if hour not in 0..23 || minute not in 0..59 || second not in 0..59 || nanosecond not in 0..999999999 {
            return Err(TimeError.OutOfRange)
        }

        let ns := uint64(hour) * 3600000000000 + uint64(minute) * 60000000000 + uint64(second) * 1000000000 + uint64(nanosecond)
        self._nanosecondsSinceMidnight = ns
    }

    static property Now: time {
        get {
            let now: datetime := _now
            return time { _nanosecondsSinceMidnight: now._nanosecondsSinceMidnight }
        }
    }

    static property HourOfDay: int<h> {
        get {
            return int<h>(datetime.Hour)
        }
    }

    property Hour: int<h> {
        get {
            return int<h>(self._nanosecondsSinceMidnight / 3600000000000)
        }
    }

    property Minute: int<min> {
        get {
            return int<min>((self._nanosecondsSinceMidnight % 3600000000000) / 60000000000)
        }
    }

    property Second: int<s> {
        get {
            return int<s>((self._nanosecondsSinceMidnight % 60000000000) / 1000000000)
        }
    }

    static property Millisecond: int<ns> {
        get {
            return 0
        }
    }

    fn ToString(format: datetime.Format) Result[string, StringError] {
        return Ok("")
    }

    fn ToString(layout: string) Result[string, StringError] {
        return Ok("")
    }
}
