module main

type Handle struct {
    id: int,
}

impl Handle {
    free {
    }
}

fn Make(id: int) Handle {
    return Handle { id: id }
}

fn FreshOption(id: int) Option[Handle] {
    return Some(Make(id))
}

type Slot union {
    Full(int),
    Empty,
}

impl Slot {
    free {
    }
}

fn Fresh() Slot {
    return Slot.Empty
}

fn T() void {
    let slot := Fresh()
}
