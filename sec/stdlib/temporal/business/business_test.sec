            Monday: true,
            Tuesday: true,
            Wednesday: true,
            Thursday: true,
            Friday: true,
            Saturday: false,
            Sunday: false,
        },
        Exceptions: ref exceptions[..],
    }

    match ValidateBusinessCalendarData(data) {
        Ok(_) => testing.Fail("Duplicate exception accepted")
        Err(BusinessError.InvalidCalendarData) => {
        }
        Err(_) => testing.Fail("Unexpected validation error")
    }
}

