module main

type Handle struct { id: int }
impl Handle { free {} }
type OwnedError union error { Held(Handle) Empty }

fn Identity[E: error](-> cause: E) E { return <-cause }
fn Wrap[E: error](-> cause: E) Result[int, E] { return Err(<-cause) }
fn Pass[E: error](-> result: Result[int, E]) Result[int, E] { return <-result }

fn CopyUnknown[E: error](cause: E) E {
    let duplicate := cause
    return <-cause
}
fn CopyCarrier[E: error](value: Result[int, E]) void {
    let duplicate := value
}
fn ReuseAfterCall[E: error](-> cause: E) E {
    let first := Identity(<-cause)
    return <-cause
}
fn MissingMove() void {
    let cause := OwnedError.Held(Handle { id: 1 })
    let result := Wrap(cause)
}
fn CopyMatched[E: error](-> result: Result[int, E], -> fallback: E) E {
    match Pass(<-result) {
        Ok(n) => return <-fallback
        Err(cause) => {
            let duplicate := cause
            return <-cause
        }
    }
}
fn DiscardUnknown[E: error](value: Result[int, E]) void {
    match value {
        Ok(n) => { discard n }
        Err(_) => {}
    }
}
fn ReuseProjection[E: error](-> value: Result[int, E]) Result[int, E] {
    let projected := value.Err()
    return <-value
}

fn Consume[E: error](-> cause: E) bool { return true }
fn ConsumingGuard[E: error](-> result: Result[int, E], -> fallback: E) E {
    match Pass(<-result) {
        Ok(n) => return <-fallback
        Err(cause) where Consume(<-cause) => return <-fallback
        Err(cause) => return <-cause
    }
}
fn DiscardTryUnknown[E: error](-> value: Result[int, E]) int {
    return try Pass(<-value) { Err(_) => 0 }
}
type AsyncError union error { Pending(Task[int]) }
fn DiscardKnownOwner(value: Result[int, AsyncError]) void {
    match value { Ok(n) => { discard n } Err(_) => {} }
}

fn ConsumingTryGuard[E: error](-> result: Result[int, E]) int {
    return try Pass(<-result) {
        Err(cause) where Consume(<-cause) => 0
        Err(cause) => 0
    }
}
