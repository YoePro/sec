        Err(BusinessError.OutsideCoverage) => {
        }
        Err(_) => testing.Fail("Unexpected business error")
    }
}

test "Combined monthly rules distinguish All and Any" {
    let juneFirst := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(1),
    )

    let juneLast := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(30),
    )

    let friday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(26),
    )

    let saturday := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(27),
    )

    let exceptionsA: BusinessDayException[2] := [
        BusinessDayException {
            Day: friday,
            Working: false,
        },
        BusinessDayException {
            Day: saturday,
            Working: true,
        },
    ]

    let exceptionsB: BusinessDayException[1] := [
        BusinessDayException {
            Day: friday,
            Working: true,
        },
    ]

    let week := BusinessWeekPattern {
        Monday: true,
        Tuesday: true,
        Wednesday: true,
        Thursday: true,
        Friday: true,
        Saturday: false,
        Sunday: false,
    }

    let calendars: BusinessCalendarData[2] := [
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:A",
                Revision: "1",
            },
            FirstDay: juneFirst,
            LastDay: juneLast,
            Week: week,
            Exceptions: ref exceptionsA[..],
        },
        BusinessCalendarData {
            Calendar: BusinessCalendar {
                Identifier: "example:B",
                Revision: "1",
            },
            FirstDay: juneFirst,
            LastDay: juneLast,
            Week: week,
            Exceptions: ref exceptionsB[..],
        },
    ]

    let thirdFromEnd: int := -3

    // All:
    // June 30 = last, June 29 = second,
    // June 25 = third-to-last.
    let thirdAll := try NthBusinessDayOfMonth(
        2026, 6, thirdFromEnd,
        ref calendars[..],
        BusinessCalendarCombination.All,
    )

    testing.Expect(try _matchesGregorianDate(
        thirdAll, 2026, 6, 25,
    ))

    // Any:
    // June 30 = last, June 29 = second,
    // June 27 = third-to-last.
    let thirdAny := try NthBusinessDayOfMonth(
        2026, 6, thirdFromEnd,
        ref calendars[..],
        BusinessCalendarCombination.Any,
    )

    testing.ExpectEqual(
        saturday.EpochDays, thirdAny.EpochDays,
    )

    let lastAll := try LastBusinessDayOfMonth(
        2026, 6,
        ref calendars[..],
        BusinessCalendarCombination.All,
    )

    testing.ExpectEqual(
        juneLast.EpochDays, lastAll.EpochDays,
    )

    // A civil due date on the exceptional Saturday.
    let civilRule := MonthlyDueDateRule.Civil(
        MonthlyDateRule.DayOfMonth(27),
    )

    // Under All, Saturday is not a business day.
    let dueAll := try DueDate(
        2026, 6, civilRule,
        ref calendars[..],
        BusinessCalendarCombination.All,
        BusinessDayAdjustment.Following,
    )

    testing.Expect(try _matchesGregorianDate(
        dueAll, 2026, 6, 29,
    ))

    // Under Any, calendar A makes Saturday a business day.
    let dueAny := try DueDate(
        2026, 6, civilRule,
        ref calendars[..],
        BusinessCalendarCombination.Any,
        BusinessDayAdjustment.Following,
    )

    testing.ExpectEqual(
        saturday.EpochDays, dueAny.EpochDays,
    )

    // BusinessOrdinal uses the combined monthly calculation.
    let ordinalDue := try DueDate(
        2026, 6,
        MonthlyDueDateRule.BusinessOrdinal(thirdFromEnd),
        ref calendars[..],
        BusinessCalendarCombination.Any,
        BusinessDayAdjustment.None,
    )

    testing.ExpectEqual(
        saturday.EpochDays, ordinalDue.EpochDays,
    )
}

test "Combined monthly selection requires full month coverage" {
    let juneFirst := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(1),
    )

    let juneSecond := try ResolveMonthlyDate(
        2026, 6, MonthlyDateRule.DayOfMonth(2),
