module scan

/**
 * Identifies a position in UTF-8 input.
 *
 * Description:
 * RuneIndex is the logical character position.
 * ByteOffset is the corresponding UTF-8 byte position.
 *
 * Both positions refer to the same source boundary.
 */
type _ScanPosition struct {
    RuneIndex:  uint,
    ByteOffset: uint,
}

/**
 * Represents a field extracted from formatted input.
 *
 * Description:
 * Text borrows the original input storage.
 * Next identifies the position immediately after the delimiter.
 *
 * Ownership:
 * Does not own or copy the input text.
 * The field view cannot outlive its source.
 *
 * Allocation:
 * Does not allocate.
 */
type _ScanField struct {
    Text: StringView,
    Next: _ScanPosition,
}

/**
 * Selects how a formatted input field ends.
 *
 * Description:
 * LiteralRun uses a sequence of validated format tokens.
 * Token stops at Unicode whitespace or end of input.
 */
type _ScanFieldBoundary union {
    // The field ends before the next matching literal run.
    LiteralRun(_ScanLiteralRun)

    // The field ends at whitespace or end of input.
    Token
}

/**
 * Reports a failure during internal scan field extraction.
 *
 * Description:
 * Preserves format parsing and string range errors separately.
 */
type _ScanFieldReadError union error {
    // The literal pattern is invalid.
    Pattern(FormatError)

    // The requested input range is invalid.
    Range(RangeError)

    /**
     * The input contains text, but the required literal
     * delimiter could not be found.
     */
    DelimiterNotFound
}

/**
 * Finds the next exact literal in input.
 *
 * Description:
 * Searches from a rune boundary and returns both the rune
 * index and UTF-8 byte offset of the first matching literal.
 *
 * An empty literal is not a valid delimiter.
 * Matching is case-sensitive and performs no normalization.
 *
 * Parameters:
 * - input: Borrowed source text.
 * - startRune: First rune position eligible for matching.
 * - literal: Non-empty borrowed delimiter text.
 *
 * Returns:
 * - Some(position): First matching delimiter.
 * - None: No match or invalid search position.
 *
 * Allocation:
 * Does not allocate.
 */
fn _FindNextLiteral(input: StringView, startRune: uint, literal: StringView) Option[_ScanPosition] {
    if startRune > input.Len || literal.IsEmpty() {
        return None()
    }

    let mut runeIndex  := startRune
    let mut byteOffset := input[..<startRune].SizeOf

    for character in input[startRune..] {
        if literal.SizeOf <= input.SizeOf - byteOffset {
            let mut matched: uint := 0

            while matched < literal.SizeOf {
                if input.ByteAt(byteOffset + matched) != literal.ByteAt(matched) {
                    break
                }

                matched += 1
            }

            if matched == literal.SizeOf {
                return Some(_ScanPosition {
                    RuneIndex: runeIndex,
                    ByteOffset: byteOffset,
                })
            }
        }

        runeIndex += 1
        byteOffset += character.Utf8Length
    }

    return None()
}

/**
 * Extracts text preceding the next literal delimiter.
 *
 * Description:
 * Finds the first exact delimiter occurrence after startRune.
 * Returns the preceding text as a borrowed StringView.
 * The delimiter is not consumed.
 *
 * Parameters:
 * - input: Source text.
 * - startRune: First rune of the field.
 * - literal: Non-empty delimiter to locate.
 *
 * Returns:
 * - Ok(Some(field)): Field and position at the delimiter.
 * - Ok(None): Delimiter not found.
 *
 * Errors:
 * - RangeError: Invalid rune range.
 *
 * Ownership:
 * Does not consume input or create independently owned text.
 *
 * Allocation:
 * Does not allocate.
 */
fn _ReadFieldUntilLiteral(
    input:     StringView,
    startRune: uint,
    literal:   StringView,
) Result[Option[_ScanField], RangeError] {
    if startRune > input.Len {
        return Err(RangeError.OutOfBounds)
    }

    let found := _FindNextLiteral(input, startRune, literal)

    match found {
        None => return Ok(None)

        Some(position) => {
            let field := try input[startRune..<position.RuneIndex]

            return Ok(Some(_ScanField {
                Text: field,
                Next: position,
            }))
        }
    }
}

/**
 * Reads the next whitespace-delimited field.
 *
 * Description:
 * Extracts a non-empty token from the current rune position.
 * Stops before the first Unicode whitespace character.
 *
 * The delimiter is not consumed. The caller decides
 * whether remaining input is acceptable.
 *
 * Parameters:
 * - input: Borrowed UTF-8 source text.
 * - startRune: Starting position in Unicode scalar units.
 *
 * Returns:
 * - Ok(Some(field)): Extracted token and its ending position.
 * - Ok(None): No token begins at the requested position.
 *
 * Errors:
 * - RangeError.OutOfBounds: Invalid starting position.
 *
 * Ownership:
 * Returns a borrowed StringView into input.
 *
 * Allocation:
 * Does not allocate.
 */
fn _ReadNextToken(input: StringView, startRune: uint) Result[Option[_ScanField], RangeError] {
    if startRune > input.Len {
        return Err(RangeError.OutOfBounds)
    }

    let prefix := try input[..<startRune]

    let mut endRune := startRune
    let mut endByte := prefix.SizeOf

    for character in input[startRune..] {
        if character.IsWhitespace {
            break
        }

        endRune += 1
        endByte += character.Utf8Length
    }

    if endRune == startRune {
        return Ok(None)
    }

    let field := try input[startRune..<endRune]

    return Ok(Some(_ScanField {
        Text: field,
        Next: _ScanPosition {
            RuneIndex: endRune,
            ByteOffset: endByte,
        },
    }))
}

/**
 * Extracts a field preceding a literal format run.
 *
 * Description:
 * Searches for the first complete occurrence of a literal
 * format run, including escaped braces.
 *
 * Returns the preceding text as a borrowed StringView.
 * The delimiter remains unconsumed.
 *
 * Parameters:
 * - input: Borrowed input text.
 * - startRune: First rune position of the field.
 * - format: Validated composite format.
 * - run: Literal sequence delimiting the field.
 *
 * Returns:
 * - Ok(Some(field)): Extracted field and delimiter position.
 * - Ok(None): Delimiter not found.
 *
 * Errors:
 * - Pattern: Invalid literal format run.
 * - Range: Invalid input range.
 *
 * Ownership:
 * Returned text borrows the original input.
 *
 * Allocation:
 * Does not allocate.
 */
fn _ReadFieldUntilLiteralRun(
    input:     StringView,
    startRune: uint,
    format:    StringView,
    run:       _ScanLiteralRun,
) Result[Option[_ScanField], _ScanFieldReadError] {
    if startRune > input.Len {
        return Err(
            _ScanFieldReadError.Range(RangeError.OutOfBounds),
        )
    }

    let found := try _FindNextLiteralRun(
        input,
        startRune,
        format,
        run,
    ) {
        Err(cause) => {
            return Err(_ScanFieldReadError.Pattern(cause))
        }
    }

    match found {
        None => return Ok(None)

        Some(position) => {
            let field := try input[startRune..<position.RuneIndex] {
                Err(cause) => {
                    return Err(_ScanFieldReadError.Range(cause))
                }
            }

            return Ok(Some(_ScanField {
                Text: field,
                Next: position,
            }))
        }
    }
}

/**
 * Extracts one formatted input field.
 *
 * Description:
 * Dispatches to either literal-run matching or token extraction.
 * Does not convert the field or assign destination values.
 *
 * A following delimiter remains unconsumed.
 *
 * Parameters:
 * - input: Borrowed input text.
 * - startRune: First rune position of the field.
 * - format: Validated composite format string.
 * - boundary: Field termination rule.
 *
 * Returns:
 * - Ok(Some(field)): Extracted field and ending position.
 * - Ok(None): No matching field was found.
 *
 * Errors:
 * - Pattern: Invalid literal format run.
 * - Range: Invalid input range.
 *
 * Ownership:
 * Returned text borrows the original input.
 *
 * Allocation:
 * Does not allocate.
 */
fn _ReadPlaceholderField(
    input:     StringView,
    startRune: uint,
    format:    StringView,
    boundary:  _ScanFieldBoundary,
) Result[Option[_ScanField], _ScanFieldReadError] {
    match boundary {
        LiteralRun(run) => {
            return _ReadFieldUntilLiteralRun(
                input,
                startRune,
                format,
                run,
            )
        }

        Token => {
            let result := try _ReadNextToken(input, startRune) {
                Err(cause) => {
                    return Err(_ScanFieldReadError.Range(cause))
                }
            }

            return Ok(result)
        }
    }
}
